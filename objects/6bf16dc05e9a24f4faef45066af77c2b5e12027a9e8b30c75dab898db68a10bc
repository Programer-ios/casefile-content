 "case:locations.drawing_room.art.props.1.label": "Sofa",
 "case:locations.drawing_room.art.props.2.label": "Tepih",
 "case:locations.drawing_room.art.props.3.label": "Sto za bridž",
 "case:locations.drawing_room.art.props.4.label": "Fotelja",
