 "case:locations.conservatory.art.props.7.label": "Staklena vrata ka predvorju",
 "case:locations.conservatory.description": "Lionelov staklenik, u koji se ulazi iz predvorja. Kiša i dalje dobuje po krovu. Toplo je, zeleno i — kada padne mrak — veoma skrovito.",
 "case:locations.conservatory.hotspots.hs_glass_door.label": "Staklena vrata",
 "case:locations.conservatory.hotspots.hs_glass_door.text": "Staklena vrata zimske bašte gledaju pravo preko predvorja na telefonski stočić. Ko god da je sinoć stajao tamo, video bi svakoga ko je sedeo ovde — a i sam bi bio viđen.",
 "case:locations.conservatory.hotspots.hs_orchids.label": "Orhideje",
 "case:locations.conservatory.hotspots.hs_orchids.text": "Lionelove nagrađivane orhideje, svaka s natpisom ispisanim njegovim preciznim rukopisom. Na jednom natpisu stoji samo: „Strpljenje je precizan instrument.“",
 "case:locations.conservatory.hotspots.hs_roof.label": "Stakleni krov",
 "case:locations.conservatory.hotspots.hs_roof.text": "Kiša udara po staklenom krovu. Sinoć je od devet sati lila kao iz kabla. Niko nije mogao da se prošeta terasom i vrati suv.",
 "case:locations.conservatory.hotspots.hs_wicker.label": "Pletena sofa",
 "case:locations.conservatory.hotspots.hs_wicker.text": "Pletena sofa, napola skrivena iza palmi; jastuci su joj još ugnuti.",
 "case:locations.conservatory.name": "Zimska bašta",
 "case:locations.conservatory.summary": "Staklo, orhideje i kiša.",
