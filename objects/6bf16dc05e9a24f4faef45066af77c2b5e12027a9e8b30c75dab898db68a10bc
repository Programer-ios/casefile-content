 "deductions:deductions.d_time_of_death.proofLabels.1": "Tableta koju nikad nije uzeo",
 "deductions:deductions.d_time_of_death.proofLabels.2": "Njegova navika u deset sati",
 "deductions:deductions.d_time_of_death.question": "Kada je Lionel zapravo umro?",
 "deductions:deductions.d_time_of_death.title": "Mrtav pre 22.00",
 "dialogues:statements.st_daniel_billiards.text": "Posle večere sam pio u sobi za bilijar. Nisam kročio u radnu sobu.",
 "dialogues:statements.st_daniel_boot_room.text": "Posle svađe sam se s terase vratio kroz ostavu za obuću.",
 "dialogues:statements.st_daniel_found_body.text": "U petnaest do jedanaest otac je već bio mrtav u mračnoj radnoj sobi. Podigao sam držač za knjige s poda i spalio svoju priznanicu.",
 "dialogues:statements.st_daniel_will.text": "Otac je u ponedeljak hteo da promeni testament i da me razbaštini.",
 "dialogues:statements.st_eleanor_calder.text": "Calder & Rowe je običan dobavljač mesinganih okova.",
 "dialogues:statements.st_eleanor_embezzle.text": "Izmislila sam Calder & Rowe i uzimala novac. Ali ja ga nisam ubila.",
 "dialogues:statements.st_eleanor_hall.text": "Kada je telo pronađeno, otišla sam u predvorje da telefoniram. Linija je bila u prekidu.",
 "dialogues:statements.st_eleanor_letters.text": "Oko dvadeset do deset odnela sam gospodinu Thorneu pisma na potpis. Bio je sasvim dobro kada sam izašla u petnaest do deset.",
 "dialogues:statements.st_eleanor_reels.text": "Svakog jutra prekucavam diktate gospodina Thornea i čuvam koturove na svojoj polici.",
 "dialogues:statements.st_eleanor_typing.text": "Od kraja večere do deset bila sam u svojoj kancelariji i kucala govor za zdravicu.",
 "dialogues:statements.st_finch_eleanor_knees.text": "Kada smo uleteli u radnu sobu, Eleanor je klečala iza stola, a zatim je otišla da telefonira.",
 "dialogues:statements.st_finch_library.text": "Između večere i bridža bio sam sam u biblioteci, s knjigom.",
 "dialogues:statements.st_finch_phone.text": "Od 21.32 do 21.51 razgovarao sam telefonom iz predvorja s Rupertom Hartleyjem.",
 "dialogues:statements.st_finch_saw_eleanor.text": "Oko dvadeset do deset Eleanor je otišla u radnu sobu s fasciklom i vratila se desetak minuta kasnije.",
 "dialogues:statements.st_harrow_blow.text": "Ubio ga je udarac u slepoočnicu, manje od sat vremena pre 23.15.",
 "dialogues:statements.st_harrow_conservatory.text": "Bio sam s Margaret u zimskoj bašti od pola deset do pet do deset.",
 "dialogues:statements.st_harrow_cyanide.text": "Lionel je otrovan cijanidom, koji ubija za nekoliko minuta. Rana na slepoočnici nastala je pri padu.",
 "dialogues:statements.st_harrow_drawing_room.text": "Celo veče sam bio u salonu.",
 "dialogues:statements.st_harrow_earlier.text": "S medicinske tačke gledišta, Lionel je mogao biti mrtav još od pola deset.",
 "dialogues:statements.st_harrow_pill.text": "Lionel je svako veče tačno u deset uzimao jednu tabletu digitalisa. Nikada nije propustio.",
 "dialogues:statements.st_hobbs_boot_room.text": "Od petka su kroz ostavu za obuću prošli samo gospođica Voss (u subotu u četiri) i gospodin Daniel (posle svađe).",
 "dialogues:statements.st_hobbs_ice.text": "U 21.25 odneo sam gospodinu svež led. Sam je sipao viski i bio je dobro.",
 "dialogues:statements.st_hobbs_lamp.text": "Gospodin nikada nije radio u mraku, a magnetofon se uvek uključuje u utičnicu pored police s knjigama.",
 "dialogues:statements.st_hobbs_voice.text": "U 22.15 čuo sam gospodina kako diktira: „Sa žaljenjem moram da odbijem vašu ponudu od četrnaestog.“",
 "dialogues:statements.st_margaret_conservatory.text": "Felix i ja bili smo zajedno u zimskoj bašti od pola deset do skoro deset.",
 "dialogues:statements.st_margaret_drawing_room.text": "Posle večere ostala sam u salonu sve do uzbune.",
 "dialogues:statements.st_margaret_eleanor_hall.text": "Pošto je telo pronađeno, Eleanor je sama otišla do telefona u predvorju.",
 "dialogues:statements.st_margaret_pill.text": "Lionel je svako veče uzimao digitalis tačno u deset. Za pet godina nijednom nije propustio.",
 "dialogues:statements.st_margaret_toast.text": "Lionel je rekao da će zdravica „izmiriti stare dugove i raščistiti teren“.",
 "dialogues:topics.t_daniel_boot_room.lines.0": "Posle svađe izašao sam na terasu da se ohladim. Po kiši, kao budala. Vratio sam se kroz ostavu za obuću, mokar do kože, i tamo zbacio cipele.",
 "dialogues:topics.t_daniel_boot_room.lines.1": "Nisam dirao nikakav otrov za zečeve, ako na to ciljate. Nisam ni znao da ga imamo u kući.",
 "dialogues:topics.t_daniel_boot_room.prompt": "Jeste li sinoć ulazili u ostavu za obuću?",
 "dialogues:topics.t_daniel_evening.lines.0": "Kuda ste otišli posle večere, gospodine Thorne?",
 "dialogues:topics.t_daniel_evening.lines.1": "Pošto je otac završio s mojim ponižavanjem? U sobu za bilijar, s flašom njegovog najboljeg škotskog viskija. Ostao sam tamo dok Hobbs nije počeo da viče iz sveg glasa.",
 "dialogues:topics.t_daniel_evening.lines.2": "Posle večere nisam kročio u radnu sobu, ako to pokušavate da izvučete iz mene.",
 "dialogues:topics.t_daniel_evening.prompt": "Kuda ste otišli posle večere?",
 "dialogues:topics.t_daniel_father.lines.0": "Precizan. Svake nedelje je lično podešavao svaki sat u ovoj kući. Voleo je da sve radi kao sat — i da svi skaču kad on zovne.",
 "dialogues:topics.t_daniel_father.lines.1": "Verovao je tačno dvema osobama: Hobbsu i onoj svojoj sekretarici. Meni sigurno nije.",
 "dialogues:topics.t_daniel_father.prompt": "Kakav je čovek bio vaš otac?",
 "dialogues:topics.t_daniel_found.lines.0": "Bilo je mračno. Stona lampa nije gorela — samo je žar tinjao u kaminu. Ležao je preko stola. Dvaput sam ga pozvao po imenu.",
 "dialogues:topics.t_daniel_found.lines.1": "Magnetofon je ćutao. U sobi je mirisalo na viski i dim od uglja. To je sve čega se sećam. To, i kako bežim.",
 "dialogues:topics.t_daniel_found.prompt": "Recite mi tačno šta ste videli u radnoj sobi.",
 "dialogues:topics.t_daniel_quarrel.lines.0": "Ceo sto vas je čuo kako mu pretite.",
 "dialogues:topics.t_daniel_quarrel.lines.1": "Otkupio je moju priznanicu — na tri hiljade funti — od nekog tipa iz Sohoa. Mahao mi je njome preko supe.",
 "dialogues:topics.t_daniel_quarrel.lines.2": "U ponedeljak je nameravao da promeni testament i da me razbaštini, osim ako ne počnem da radim u fabrici kao mlađi činovnik. Činovnik! U trideset drugoj!",
 "dialogues:topics.t_daniel_quarrel.lines.3": "Pa da, rekao sam da bih ga radije video u grobu. Ljudi svašta kažu.",
 "dialogues:topics.t_daniel_quarrel.prompt": "Oko čega ste se posvađali za večerom?",
 "dialogues:topics.t_daniel_suspicion.lines.0": "Gerald, na primer. Otac je saznao nešto o njemu i Hartleyju — likovao je zbog toga pre večere.",
 "dialogues:topics.t_daniel_suspicion.lines.1": "A Eleanor je cele nedelje nervozna kao mačka. Devetnaest godina mu vodi život. Pitajte nju čega se plaši.",
 "dialogues:topics.t_daniel_suspicion.prompt": "Šta mislite, ko je želeo smrt vašeg oca?",
 "dialogues:topics.t_eleanor_alarm.lines.0": "Izašla sam u predvorje da telefonom pozovem policiju. Linija je bila u prekidu — zbog oluje. Onda sam se vratila i sela pored gospođe Thorne.",
 "dialogues:topics.t_eleanor_alarm.prompt": "Šta ste uradili kada je telo pronađeno?",
 "dialogues:topics.t_eleanor_calder.lines.0": "Dobavljač mesinganih okova. Sasvim obična firma. Godinama izmirujem njihove fakture.",
 "dialogues:topics.t_eleanor_calder.lines.1": "Gospodin Thorne je ove nedelje doveo jednu u pitanje, koliko znam. Sve je dovodio u pitanje.",
 "dialogues:topics.t_eleanor_calder.prompt": "Šta je Calder & Rowe Supplies?",
 "dialogues:topics.t_eleanor_duties.lines.0": "Sve. Njegov rokovnik, pisma, knjige. Svake večeri je diktirao na koturove; ja sam ih svakog jutra prekucavala i odlagala koturove na svoju policu.",
 "dialogues:topics.t_eleanor_duties.lines.1": "Devetnaest godina. Ponekad sam bolje od njega znala šta misli.",
 "dialogues:topics.t_eleanor_duties.prompt": "Šta je obuhvatao vaš posao za gospodina Thornea?",
 "dialogues:topics.t_eleanor_evening.lines.0": "U svojoj kancelariji; kucala sam govor gospodina Thornea za ponoćnu zdravicu. Od kraja večere do deset, kada sam se pridružila ostalima na bridžu.",
 "dialogues:topics.t_eleanor_evening.lines.1": "Pretpostavljam da ćete želeti da vidite moju kancelariju — policajac Pike je već dvaput tražio ključ. Izvolite. Noću je zaključavam; papiri gospodina Thornea su poverljivi.",
 "dialogues:topics.t_eleanor_evening.lines.2": "Pruža vam mali mesingani ključ. Sekretaričina kancelarija vam je sada otvorena.",
 "dialogues:topics.t_eleanor_evening.prompt": "Gde ste bili posle večere?",
 "dialogues:topics.t_eleanor_reel.lines.0": "Onda ga je neko uzeo s moje police. Danju ne zaključavam kancelariju — bilo ko u kući mogao je da uđe.",
 "dialogues:topics.t_eleanor_reel.lines.1": "Teško da bih obeležila sopstvene koturove i onda jedan ostavila u mašini da ga vi nađete, zar ne?",
 "dialogues:topics.t_eleanor_reel.prompt": "Kotur u magnetofonu potiče s vaše police.",
 "dialogues:topics.t_eleanor_switch.lines.0": "Kako domišljato. I kako zgodno za svakoga ko u deset i petnaest nije bio ni blizu radne sobe.",
 "dialogues:topics.t_eleanor_switch.lines.1": "To se odnosi na nas četvoro — gospođu Thorne, doktora Harrowa, gospodina Fincha i mene. Moraćete da se potrudite više od toga.",
 "dialogues:topics.t_eleanor_switch.prompt": "Neko je upotrebio vremenski prekidač da lažira Lionelov glas.",
 "dialogues:topics.t_eleanor_toast.lines.0": "Njegovo povlačenje i ime naslednika. Nije mi rekao koga — nameravao je da ime upiše sam.",
 "dialogues:topics.t_eleanor_toast.lines.1": "Gospodin Thorne je voleo svoja iznenađenja.",
 "dialogues:topics.t_eleanor_toast.prompt": "Šta je trebalo da bude objavljeno u ponoć?",
 "dialogues:topics.t_finch_alarm.lines.0": "Felix se nagnuo nad Lionela. Margaret je pobledela kao papir. Ja sam, stidim se da kažem, stajao na vratima.",
 "dialogues:topics.t_finch_alarm.lines.1": "Eleanor je — sad kad pominjete — klečala iza stola, uz samu lajsnu. Pomislio sam da joj je pozlilo. Onda je ustala, sasvim pribrana, i rekla da će telefonom pozvati policiju.",
 "dialogues:topics.t_finch_alarm.prompt": "Kada ste svi uleteli u radnu sobu, šta ste videli?",
 "dialogues:topics.t_finch_company.lines.0": "Lionel i ja smo je zajedno podigli. Nismo se slagali oko toga kuda dalje. Među ortacima se to dešava.",
 "dialogues:topics.t_finch_company.lines.1": "Hartley Precision nam je ovog meseca dao ponudu. Lionel ju je odbio a da me nije ni pitao. Tipičan Lionel.",
 "dialogues:topics.t_finch_company.prompt": "Kako su stajale stvari u firmi Thorne Instruments?",
 "dialogues:topics.t_finch_evening.lines.0": "U biblioteci, s knjigom. Trollope. Sam, nažalost — nema ko da to potvrdi. Zatim bridž od deset.",
 "dialogues:topics.t_finch_evening.prompt": "Gde ste bili između večere i bridža?",
 "dialogues:topics.t_finch_note.lines.0": "Dakle, saznao je. Hteo je da me te večeri natera da podnesem ostavku — ili da to objavi umesto mene na svojoj dragocenoj ponoćnoj zdravici.",
 "dialogues:topics.t_finch_note.lines.1": "Bilo bi ponižavajuće. Ali ne bi vredelo da zbog toga ubijem prijatelja od četrdeset godina. Imam šezdeset; mogu da podnesem malo poniženja.",
 "dialogues:topics.t_finch_note.prompt": "Lionel vam je ostavio poruku. Znao je za Hartleyja.",
 "dialogues:topics.t_finch_saw.lines.0": "Od telefonskog stočića vidi se pravo niz hodnik do radne sobe, a kroz staklena vrata i unutra u zimsku baštu.",
 "dialogues:topics.t_finch_saw.lines.1": "Margaret i Felix bili su u zimskoj bašti — nerazdvojni, kao što su već mesecima. A Eleanor je oko dvadeset do deset prošla s fasciklom pod miškom, u pravcu radne sobe.",
 "dialogues:topics.t_finch_saw.lines.2": "Vratila se deset minuta kasnije, možda nešto više. Prošla je tik pored mene i nije me ni pogledala. Pretpostavio sam da je Lionel imao pisma za potpis.",
 "dialogues:topics.t_finch_saw.prompt": "Šta ste mogli da vidite od telefona?",
 "dialogues:topics.t_harrow_cause.lines.0": "Udarac u levu slepoočnicu. Bronzanim držačem za knjige, rekao bih — ležao je odmah pored njega. Jadnika je neko oborio za njegovim sopstvenim stolom.",
 "dialogues:topics.t_harrow_cause.lines.1": "Kada sam ga pregledao u jedanaest i petnaest, bio je mrtav manje od sat vremena. Hobbs ga je čuo kako diktira u deset i petnaest, eto vam vremenskog okvira.",
 "dialogues:topics.t_harrow_cause.prompt": "Kako je Lionel umro?",
 "dialogues:topics.t_harrow_earlier.lines.0": "Ako je bio cijanid — da. Lako. Ubija za nekoliko minuta, a ona soba je od vatre bila topla kao rerna.",
 "dialogues:topics.t_harrow_earlier.lines.1": "Hobbsov „diktat“ u deset i petnaest prihvatio sam kao svetu istinu. S medicinske tačke gledišta, Lionel je mogao biti mrtav još od pola deset.",
 "dialogues:topics.t_harrow_earlier.prompt": "Da li je mogao umreti ranije nego što ste mislili?",
 "dialogues:topics.t_harrow_evening.lines.0": "U salonu, celo veče. Konjak, a zatim bridž od deset. Margaret i ja smo igrali u paru protiv Eleanor i Geralda.",
 "dialogues:topics.t_harrow_evening.prompt": "Gde ste bili posle večere?",
 "dialogues:topics.t_harrow_lionel.lines.0": "Briljantan. Nemoguć. Od jedne šupe u Coventryju stvorio je Thorne Instruments i nikome nije opraštao što je sporiji od njega.",
 "dialogues:topics.t_harrow_lionel.lines.1": "Bili smo zajedno u pustinji ’42. Jednom mi je spasao život. Nikada mi nije dao da to zaboravim.",
 "dialogues:topics.t_harrow_lionel.prompt": "Kakav je bio Lionel?",
 "dialogues:topics.t_harrow_margaret.lines.0": "Nisam ponosan na to. Lionel mi je bio prijatelj. Ali ja nju volim — a on je voleo svoju firmu.",
 "dialogues:topics.t_harrow_margaret.prompt": "Vi i Margaret…",
 "dialogues:topics.t_harrow_pills.lines.0": "Digitalis. Jedna tableta svako veče tačno u deset, s čašom vode. Naterao sam ga da mi se zakune posle srčanog napada 1957.",
 "dialogues:topics.t_harrow_pills.lines.1": "Nikada nije propustio. Nijednom. Smrtno se plašio za svoje srce.",
 "dialogues:topics.t_harrow_pills.prompt": "Recite mi nešto o Lionelovim tabletama za srce.",
 "dialogues:topics.t_harrow_poisons.lines.0": "Ne iz moje torbe, ako na to mislite — ne nosim ništa slično. Ali svaka seoska kuća ima ponešto. Otrov za ose. Gas za zečeve.",
 "dialogues:topics.t_harrow_poisons.lines.1": "Pitajte Hobbsa šta baštovan drži u ostavi za obuću.",
 "dialogues:topics.t_harrow_poisons.prompt": "Odakle bi neko u ovakvoj kući nabavio cijanid?",
 "dialogues:topics.t_hobbs_affair.lines.0": "Nije na meni da o tome govorim.",
 "dialogues:topics.t_hobbs_affair.lines.1": "…Viđao sam ih u zimskoj bašti. Više puta. Nisam želeo da to povredi gospodina, pa sam držao jezik za zubima.",
 "dialogues:topics.t_hobbs_affair.prompt": "Da li ste znali za gospođu Thorne i doktora Harrowa?",
 "dialogues:topics.t_hobbs_body.lines.0": "U jedanaest i deset gospođa Thorne me je poslala da ga pozovem na zdravicu. U sobi je bilo mračno, osim žara u kaminu. Ležao je klonuo preko stola.",
 "dialogues:topics.t_hobbs_body.lines.1": "Trideset godina služim u ovoj kući. Nikada nisam čuo sebe da tako kriknem.",
 "dialogues:topics.t_hobbs_body.prompt": "Kako ste ga zatekli?",
 "dialogues:topics.t_hobbs_boot_room.lines.0": "Ta limenka je bila zatvorena kada je baštovan Jenkins otišao u petak. Lično sam proverio zalihe.",
 "dialogues:topics.t_hobbs_boot_room.lines.1": "Od tada? Gospođica Voss je juče u četiri sata svratila po svoje kaljače — da se prošeta pre kiše, rekla je. A gospodin Daniel je posle svađe ušao tuda, mokar do kože.",
 "dialogues:topics.t_hobbs_boot_room.prompt": "Ko je ulazio u ostavu za obuću?",
 "dialogues:topics.t_hobbs_ice.lines.0": "U devet i dvadeset pet odneo sam mu svež led. Sam je sipao viski — kao i uvek — i bio je odlično raspoložen. Čak je pevušio.",
 "dialogues:topics.t_hobbs_ice.lines.1": "Zatim sam u pola deset sišao na večeru s gospođom Bell.",
 "dialogues:topics.t_hobbs_ice.prompt": "Kada ste poslednji put videli gospodina Thornea?",
 "dialogues:topics.t_hobbs_lamp.lines.0": "Isključena iz struje? Gospodin nikada nije sedeo u mraku. Ta lampa je uvek gorela dok je radio.",
 "dialogues:topics.t_hobbs_lamp.lines.1": "A magnetofonu je mesto na stočiću pored police s knjigama. Uključuje se odmah tu, pored njega. Ne bi bilo nikakvog razloga da se kabl vuče preko cele sobe.",
 "dialogues:topics.t_hobbs_lamp.prompt": "Stona lampa je bila isključena iz struje.",
 "dialogues:topics.t_hobbs_routine.lines.0": "Viski u pola deset. Tableta tačno u deset. Vatra zagrnuta u deset i petnaest. Nedeljom je svaki sat u kući podešavao prema radio-signalu tačnog vremena.",
 "dialogues:topics.t_hobbs_routine.lines.1": "Gospodin je bio čovek navika. Svi koji su ga poznavali znali su ih.",
 "dialogues:topics.t_hobbs_routine.prompt": "Kakav je bio večernji raspored gospodina Thornea?",
 "dialogues:topics.t_hobbs_switches.lines.0": "To je jedan od naših. Držimo tri u plakaru u predvorju, za lampe dok je porodica u Londonu. Da odvrate provalnike.",
 "dialogues:topics.t_hobbs_switches.lines.1": "Svako u kući bi znao gde se drže.",
 "dialogues:topics.t_hobbs_switches.prompt": "Da li prepoznajete ovaj vremenski prekidač?",
 "dialogues:topics.t_hobbs_voice.lines.0": "U deset i petnaest popeo sam se da zagrnem vatru u radnoj sobi, kao i svake večeri.",
 "dialogues:topics.t_hobbs_voice.lines.1": "Kroz vrata sam čuo gospodina kako diktira. Jasno kao dan: „Sa žaljenjem moram da odbijem vašu ponudu od četrnaestog.“ Pa sam se povukao. Gospodin nikada nije dozvoljavao da ga prekidaju dok diktira.",
 "dialogues:topics.t_hobbs_voice.lines.2": "Svi u kući znaju to pravilo.",
 "dialogues:topics.t_hobbs_voice.prompt": "Recite mi šta se sinoć dogodilo u deset i petnaest.",
 "dialogues:topics.t_margaret_alarm.lines.0": "Hobbs je kriknuo i svi smo utrčali. Felix je otišao pravo do Lionela. Gerald je stajao na vratima kao kip.",
 "dialogues:topics.t_margaret_alarm.lines.1": "Eleanor je rekla da će telefonom pozvati policiju i izašla je u predvorje — sama. Linija je, naravno, bila u prekidu. A ja sam, bojim se, pala u nesvest.",
 "dialogues:topics.t_margaret_alarm.prompt": "Šta se dogodilo kada je telo pronađeno?",
 "dialogues:topics.t_margaret_daniel.lines.0": "Daniel je slab, a ne zao. U dugovima je otkako je otišao na Cambridge.",
 "dialogues:topics.t_margaret_daniel.lines.1": "Ako baš morate da znate, deo sam otplaćivala i sama. Lionel to nikada nije saznao. Molim vas, nemojte reći Danielu da sam vam rekla.",
 "dialogues:topics.t_margaret_daniel.prompt": "Da li je Daniel mogao ovo da uradi?",
 "dialogues:topics.t_margaret_eleanor.lines.0": "Lionel joj je sve poveravao. Knjige, banku, svoj potpis, rokovnik. Više nego što je ikada verovao meni.",
 "dialogues:topics.t_margaret_eleanor.lines.1": "Devetnaest godina uz njega. Ponekad mi se čini da je ona bila više udata za njega nego ja.",
 "dialogues:topics.t_margaret_eleanor.prompt": "Šta mislite o Eleanor Voss?",
 "dialogues:topics.t_margaret_evening.lines.0": "U salonu, s ostalima. Kafa, malo konjaka, a zatim bridž od deset.",
 "dialogues:topics.t_margaret_evening.lines.1": "Nisam izlazila odande dok Hobbs nije digao uzbunu.",
 "dialogues:topics.t_margaret_evening.prompt": "Gde ste bili posle večere?",
 "dialogues:topics.t_margaret_felix.lines.0": "Dve godine. Lionel je bio venčan s firmom Thorne Instruments mnogo pre nego što se oženio mnome.",
 "dialogues:topics.t_margaret_felix.lines.1": "Pre ili kasnije bih ga zamolila za razvod. Nikada ne bih morala da ga ubijem zbog toga. Molim vas — neka ovo ostane među nama.",
 "dialogues:topics.t_margaret_felix.prompt": "Koliko dugo ste vi i doktor Harrow…?",
 "dialogues:topics.t_margaret_health.lines.0": "Srce mu je bilo slabo. Felix mu je prepisao digitalis — jednu tabletu svako veče, tačno u deset.",
 "dialogues:topics.t_margaret_health.lines.1": "Lionel je nikada nije propustio. Nijednom za pet godina. Za srce se plašio više nego za bilo šta na svetu.",
 "dialogues:topics.t_margaret_health.prompt": "Da li je vaš suprug bio dobrog zdravlja?",
 "dialogues:topics.t_margaret_toast.lines.0": "Nije hteo da mi kaže. Bio je strašno zadovoljan sobom zbog toga.",
 "dialogues:topics.t_margaret_toast.lines.1": "Rekao je da će zdravica „izmiriti stare dugove i raščistiti teren“. Lionel je voleo tajne — pod uslovom da ih on čuva.",
 "dialogues:topics.t_margaret_toast.prompt": "Šta je Lionel nameravao da objavi u ponoć?",
 "evidence:evidence.bridge_scorepad.detail": "Blok s rezultatima sinoćne partije: „Rober 1 — 22.00“. Parovi M.T. i F.H. protiv E.V. i G.F. Tri robera; poslednji upis je u 23.05.\n\nTokom sata posle deset četvoro ljudi bilo je alibi jedno drugom.",
 "evidence:evidence.bridge_scorepad.name": "Blok s rezultatima bridža",
 "evidence:evidence.bridge_scorepad.summary": "Bridž od 22.00 do 23.05: Margaret i Harrow protiv Eleanor i Fincha.",
 "evidence:evidence.bronze_bookend.detail": "Težak bronzani konj, jedan iz para, s etiketom policajca Pikea. Na jednom uglu ima malo krvi. Pike je na njemu tražio otiske i okvirno ih uporedio s onima na čaši za viski koju je Daniel ostavio u sobi za bilijar: „Njegovi, gotovo sigurno.“\n\nZa smrtonosan udarac, rana koju je navodno naneo prilično je mala. Jedva je krvarila.",
 "evidence:evidence.bronze_bookend.name": "Bronzani držač za knjige",
 "evidence:evidence.bronze_bookend.summary": "Krv na jednom uglu — i Danielovi otisci prstiju.",
 "evidence:evidence.burnt_iou.detail": "Među pepelom u kaminu radne sobe — ugljenisan komadić papira koji nije sasvim izgoreo: „…obavezujem se da isplatim… iznos od £3.000… Daniel Thorne“.\n\nLeži na pepelu, a ne ispod njega. Bačen je u vatru kasno uveče, kada je vatra već bila dogorela.",
 "evidence:evidence.burnt_iou.name": "Spaljena priznanica",
 "evidence:evidence.burnt_iou.summary": "Ugljenisan komadić: „…£3.000… Daniel Thorne“.",
 "evidence:evidence.calder_invoice.detail": "Faktura firme „Calder & Rowe Supplies — mesingani okovi, Birmingham“ na £1.140, s oznakom da je plaćena. Lionel je ukupan iznos zaokružio crvenom olovkom i dopisao znak pitanja.\n\nOtkucani tekst je pomalo neujednačen: jedno slovo, gde god da se pojavi, stoji visoko i otiskuje se bledo.",
 "evidence:evidence.calder_invoice.name": "Faktura firme Calder & Rowe",
 "evidence:evidence.calder_invoice.summary": "Lionel ju je zaokružio crvenim i dopisao znak pitanja.",
 "evidence:evidence.carbon_hartley.detail": "Indigo-kopija s datumom 15. novembar, upućena ser Rupertu Hartleyju, Hartley Precision Ltd. (telefon WHItehall 4021):\n\n„Dragi Ruperte,\nSa žaljenjem moram da odbijem vašu ponudu od četrnaestog. Thorne Instruments nije na prodaju — ne dok sam živ. — L. Thorne“\n\nOtkucala Eleanor prema diktatu od četvrtka.",
 "evidence:evidence.carbon_hartley.name": "Indigo-kopija pisma Hartleyju",
 "evidence:evidence.carbon_hartley.summary": "15. novembar: „Sa žaljenjem moram da odbijem vašu ponudu od četrnaestog.“",
 "evidence:evidence.cold_grate.detail": "Vatra u Eleanorinoj kancelariji pripremljena je — papir, potpala i ugalj — ali nikada nije potpaljena. Ognjište je ledeno.\n\nŠta god da je Eleanor sinoć radila, nije provela sirovo novembarsko veče ovde, kucajući.",
 "evidence:evidence.cold_grate.name": "Hladan kamin",
 "evidence:evidence.cold_grate.summary": "Vatra u Eleanorinoj kancelariji bila je pripremljena, ali sinoć nije potpaljena.",
 "evidence:evidence.constable_notes.detail": "Subota, 17. novembar. Jaka kiša od 21.00.\n\n19.30 — Večera. Prisutni: pokojnik, gđa Margaret Thorne, g. Daniel Thorne, gđica Eleanor Voss, g. Gerald Finch, dr Felix Harrow. Služi batler A. Hobbs.\n20.45 — Svađa pokojnika i sina. Čulo se kako sin kaže: „Radije bih te video u grobu.“\n21.00 — Pokojnik se povlači u radnu sobu. Ne uznemiravati do ponoćne zdravice.\n22.00 — Bridž u salonu do 23.05.\n22.15 — Batler kroz vrata radne sobe čuje pokojnika kako diktira.\n22.45 — Sobarica vidi sina kako izlazi iz radne sobe.\n23.10 — Batler zatiče pokojnika klonulog za stolom. Rana na levoj slepoočnici; bronzani držač za knjige na podu. Dr Harrow: mrtav „manje od sat vremena“.\n23.15 — Telefonska linija u prekidu (oluja).\n00.30 — Radnu sobu zapečatio potpisani.\n\n— Policajac R. Pike",
 "evidence:evidence.constable_notes.name": "Beleške policajca Pikea",
 "evidence:evidence.constable_notes.summary": "Događaji te noći onako kako ih je zabeležio policajac.",
 "evidence:evidence.cook_statement.detail": "Izjava gospođe Bell, kuvarice, koju je uzeo policajac Pike:\n\n„Gospodin Hobbs je sišao u pola deset i večerao sa mnom u trpezariji za poslugu. U deset i petnaest popeo se da pogleda vatru u radnoj sobi i vratio se za manje od dva minuta; rekao je da gospodin diktira i da ne sme da se uznemirava. Posle toga se nije makao sve dok ga gospođa Thorne nije pozvala zvoncem u jedanaest i deset.“",
 "evidence:evidence.cook_statement.name": "Izjava gospođe Bell",
 "evidence:evidence.cook_statement.summary": "Kuvarica: Hobbs je od 21.30 bio u trpezariji za poslugu, osim dva minuta u 22.15.",
 "evidence:evidence.desk_diary.detail": "ČET 15 — Hartleyjeva ponuda: odbijena (izdiktirano). Calder & Rowe?? Takve firme nema u privrednom imeniku.\n\nSUB 17 — Zdravica u ponoć. Raščistiti teren.\n\nPON 19 — 10.00 Pemberton & Co.: potpuna revizija knjiga. 15.00 Osgood: novi testament.",
 "evidence:evidence.desk_diary.name": "Lionelov rokovnik",
 "evidence:evidence.desk_diary.summary": "Ponedeljak: revizija u 10.00, novi testament u 15.00.",
 "evidence:evidence.finch_note.detail": "Presavijena u fioci stola, poruka Lionelovim rukopisom, nikada poslata:\n\n„Geralde — znam za Hartleyja. Povuci se tiho pre zdravice ili ću u ponoć to objaviti umesto tebe. — L.“",
 "evidence:evidence.finch_note.name": "Neposlata poruka Finchu",
 "evidence:evidence.finch_note.summary": "Lionel je znao za Finchove poslove s Hartleyjem.",
 "evidence:evidence.half_signature.detail": "U Eleanorinoj korpi za odlaznu poštu — fascikla sa subotnjim pismima, otkucanim i potpisanim Lionelovom rukom.\n\nPoslednje je potpisano samo napola — „Lionel Th—“ — a mastilo se dugom, drhtavom linijom izvija preko ivice papira.",
 "evidence:evidence.half_signature.name": "Napola potpisano pismo",
 "evidence:evidence.half_signature.summary": "„Lionel Th—“, a pero je skliznulo s papira.",
 "evidence:evidence.love_note.detail": "Sitno presavijena i gurnuta ispod svilenih konaca za vez u Margaretinoj korpi za šivenje:\n\n„Najdraža moja M — u zimskoj bašti u pola deset, dok su svi zauzeti konjakom. Spali ovo. — F.“",
 "evidence:evidence.love_note.name": "Poruka iz korpe za šivenje",
 "evidence:evidence.love_note.summary": "„…u zimskoj bašti u pola deset… Spali ovo. — F.“",
 "evidence:evidence.maid_statement.detail": "Izjava Rosie Dunn, sobarice, koju je uzeo policajac Pike:\n\n„Od pola deset stalno sam išla gore-dole do sobe za bilijar — gospodin Daniel je neprestano zvonio za sodu i led. Do posle deset nije izlazio iz te sobe, gospodine; nije bio u stanju.\n\nU dvadeset do deset svratila sam u kancelariju gospođice Voss da joj naložim vatru. Nikoga nije bilo — lampa ugašena, pisaća mašina pod navlakom.\n\nU petnaest do jedanaest videla sam gospodina Daniela kako izlazi iz radne sobe, bled kao krpa.“",
 "evidence:evidence.maid_statement.name": "Izjava Rosie Dunn",
 "evidence:evidence.maid_statement.summary": "Sobarica: Daniel nije izlazio iz sobe za bilijar; Eleanorina kancelarija bila je prazna u 21.40.",
 "evidence:evidence.phone_pad.detail": "Gornji list telefonskog bloka je otcepljen, ali olovka se utisnula kroz njega. Kada se list ispod lagano zasenči olovkom, zapis se vraća:\n\n„Hartley — WHI 4021 — naručeno 21.32 — 19 min — 4 šil. 9 p. — G.F.“",
 "evidence:evidence.phone_pad.name": "Otisak na telefonskom bloku",
 "evidence:evidence.phone_pad.summary": "Razgovor od 19 minuta s brojem WHItehall 4021, koji je u 21.32 naručio „G.F.“",
 "evidence:evidence.pill_box.detail": "Srebrna kutijica za tablete sa sedam malih poklopaca, na kojima su ugravirani dani u nedelji. Svaka pregrada je za po jednu tabletu digitalisa.\n\nTableta za nedelju je tu — a i ona za subotu.",
 "evidence:evidence.pill_box.name": "Srebrna kutijica za tablete",
 "evidence:evidence.pill_box.summary": "Tableta za subotu nikada nije uzeta.",
 "evidence:evidence.rabbit_poison.detail": "Na polici u ostavi za obuću: limenka praška Vermitox za gasiranje zečeva. CIJANID — OTROV, upozorava etiketa.\n\nPoklopac je nedavno nasilu podignut — ogrebotine su sveže i sjajne — a na prašku unutra vidi se trag kašike.",
 "evidence:evidence.rabbit_poison.name": "Limenka otrova za zečeve",
 "evidence:evidence.rabbit_poison.summary": "Vermitox, prašak s cijanidom, nedavno otvoren.",
 "evidence:evidence.shawl_case.detail": "Na pletenoj sofi: Margaretin sivi šal od kašmira. Ispod jastuka, srebrna tabakera s ugraviranim inicijalima „F.H.“\n\nU saksiji s orhidejom su dva opuška, na jednom je trag karmina.",
 "evidence:evidence.shawl_case.name": "Šal i tabakera",
 "evidence:evidence.shawl_case.summary": "Margaretin šal i tabakera s inicijalima „F.H.“, u zimskoj bašti.",
 "evidence:evidence.tape_recorder.detail": "Grundig magnetofon s koturovima, na stočiću pored police s knjigama. Na koturu je urednim rukopisom ispisano „15 NOV — HARTLEY / BANK / MISC“; traka je premotana otprilike do trećine.\n\nČudno, kabl nije uključen u utičnicu odmah pored njega. Vodi preko tepiha do utičnice iza stola.",
 "evidence:evidence.tape_recorder.name": "Magnetofon",
 "evidence:evidence.tape_recorder.summary": "U njemu je kotur s natpisom „15 NOV — HARTLEY“; uključen je u utičnicu na drugom kraju sobe.",
 "evidence:evidence.tape_shelf.detail": "Koturovi s Lionelovim diktatima u kutijama s natpisima, uredno poređani po datumu, Eleanorinim rukopisom. Jedna kutija zjapi prazna: „15 NOV — HARTLEY / BANK / MISC“.\n\nEleanor svakog jutra prekucava koturove. Inače nikada ne napuštaju ovu policu.",
 "evidence:evidence.tape_shelf.name": "Polica s koturovima diktata",
 "evidence:evidence.tape_shelf.summary": "Jedna kutija je prazna: „15 NOV — HARTLEY / BANK / MISC“.",
 "evidence:evidence.time_switch.detail": "Zaglavljen ispod imenika u fioci telefonskog stočića: mehanički vremenski prekidač na navijanje, kakav se koristi za paljenje lampi dok je kuća prazna.\n\nGraničnici na brojčaniku su podešeni: UKLJ. u 22.14, ISKLJ. u 22.22.",
 "evidence:evidence.time_switch.name": "Mehanički vremenski prekidač",
 "evidence:evidence.time_switch.summary": "Sakriven u fioci telefonskog stočića. Podešen da se UKLJUČI u 22.14 i ISKLJUČI u 22.22.",
 "evidence:evidence.typewriter_flaw.detail": "Eleanorina pisaća mašina marke Imperial. Probni red koji je još u mašini otkriva njenu manu: svako malo „e“ otkucava se visoko i bledo.",
 "evidence:evidence.typewriter_flaw.name": "Eleanorina pisaća mašina",
 "evidence:evidence.typewriter_flaw.summary": "Njeno malo „e“ otkucava se visoko i bledo.",
 "evidence:evidence.unplugged_lamp.detail": "Prekidač stone lampe sa zelenim abažurom je uključen — ali lampa ne svetli. Utikač joj leži na tepihu iza stola.\n\nU jedinoj utičnici tamo pozadi, koju sto zaklanja od pogleda s vrata, nalazi se kabl magnetofona, sproveden preko cele sobe.",
 "evidence:evidence.unplugged_lamp.name": "Stona lampa isključena iz struje",
 "evidence:evidence.unplugged_lamp.summary": "Upaljena, a ne svetli. U njenoj utičnici je umesto nje kabl magnetofona.",
 "evidence:evidence.whisky_glass.detail": "Čaša od brušenog stakla na stolu, izglancana do sjaja i potpuno suva — na njoj nema nijednog otiska prsta. A ipak, u karafi pored nje nedostaje dobra mera pića otkako ju je Hobbs napunio pre večere.\n\nLionel je sipao sebi piće. Neko je posle toga pospremio.",
 "evidence:evidence.whisky_glass.name": "Izglancana čaša za viski",
 "evidence:evidence.whisky_glass.summary": "Besprekorno čista i suva, iako iz karafe nedostaje jedna mera.",
 "evidence:evidence.wilted_fern.detail": "Paprat u saksiji pored stola klonula je preko noći, a listovi su joj posmeđili na vrhovima. Zemlja je vlažna — neko je u nju nešto izlio — a kada se nagnete bliže, oseća se slab, slatkast miris gorkih badema.",
 "evidence:evidence.wilted_fern.name": "Uvela paprat",
 "evidence:evidence.wilted_fern.summary": "Klonula preko noći; zemlja miriše na gorke bademe.",
 "suspects:suspects.daniel.bio": "Lionelov jedini sin, iz prvog braka. Šarmantan, besposlen i dužan tri hiljade funti jednom londonskom bukmejkeru. Za večerom je pred svima pretio ocu.",
 "suspects:suspects.daniel.dismissal": "Je l’ to najbolje što imate? Moj krojač mi je držao strože pridike.",
 "suspects:suspects.daniel.name": "Daniel Thorne",
 "suspects:suspects.daniel.rebuttal": "Ja? Pitajte Rosie — celo veče je ulazila u sobu za bilijar i izlazila iz nje. Kada sam ja ušao u onu radnu sobu, otac je već bio mrtav. Uhvatili ste pogrešnog Thornea.",
 "suspects:suspects.daniel.role": "Sin",
 "suspects:suspects.eleanor.bio": "Lionelova privatna sekretarica već devetnaest godina. Vodi njegov rokovnik, prepisku, koturove s diktatima i knjige firme. Staložena, precizna, nezamenljiva.",
 "suspects:suspects.eleanor.dismissal": "Sigurna sam da vam se to učinilo značajnim.",
 "suspects:suspects.eleanor.name": "Eleanor Voss",
 "suspects:suspects.eleanor.rebuttal": "Sedela sam za stolom za bridž kada je Hobbs čuo gospodina Thornea kako diktira — pred tri svedoka. Dozvolili ste da vas mašta ponese.",
 "suspects:suspects.eleanor.role": "Sekretarica",
 "suspects:suspects.finch.bio": "Suosnivač firme Thorne Instruments i trideset godina član uprave uz Lionela. Pronicljiv i tih, a u poslednje vreme u sukobu s Lionelom oko budućnosti firme.",
 "suspects:suspects.finch.dismissal": "Za pregovaračkim stolom sedeo sam naspram boljih blefera od vas.",
 "suspects:suspects.finch.name": "Gerald Finch",
 "suspects:suspects.finch.rebuttal": "Dvadeset minuta sam telefonom razgovarao s Rupertom Hartleyjem — centrala će to potvrditi. Izdao sam Lionelovu firmu, da. Nisam ga otrovao. Tražite nekoga ko je zaista bio u toj sobi.",
 "suspects:suspects.finch.role": "Ortak",
 "suspects:suspects.harrow.bio": "Porodični lekar i Lionelov prijatelj još iz rata. Sinoć je pregledao telo i izjasnio se o uzroku smrti.",
 "suspects:suspects.harrow.dismissal": "Ja sam lekar, a ne budala. To ne dokazuje baš ništa.",
 "suspects:suspects.harrow.name": "dr Felix Harrow",
 "suspects:suspects.harrow.rebuttal": "Bio sam u zimskoj bašti s Margaret, neka mi Bog oprosti — i Gerald nas je tamo video. Lionela bih otrovao koliko i rođenu majku. Potražite onoga ko je bio u toj radnoj sobi.",
 "suspects:suspects.harrow.role": "Lekar",
 "suspects:suspects.hobbs.bio": "Batler u kući Larkspur House već trideset godina. Diskretan, tačan i bezgranično odan. Poslednji je čuo Lionela Thornea živog — ili bar svi tako veruju.",
 "suspects:suspects.hobbs.dismissal": "Uz dužno poštovanje, ne razumem baš najbolje.",
 "suspects:suspects.hobbs.name": "Albert Hobbs",
 "suspects:suspects.hobbs.rebuttal": "Od pola deset bio sam u trpezariji za poslugu — gospođa Bell će vam to potvrditi. Trideset godina sam služio gospodina Thornea. Pre bih sebi odsekao ruku.",
 "suspects:suspects.hobbs.role": "Batler",
 "suspects:suspects.margaret.bio": "Lionelova druga supruga, s kojom je u braku devet godina. Elegantna, nemirna i usamljena u kući u kojoj se sve odvija u minut. Po sadašnjem testamentu ona nasleđuje Larkspur House.",
 "suspects:suspects.margaret.dismissal": "Ne vidim kakve to veze ima sa mnom.",
 "suspects:suspects.margaret.name": "Margaret Thorne",
 "suspects:suspects.margaret.rebuttal": "Kako se usuđujete. Bila sam s Felixom u zimskoj bašti kada se to dogodilo — Gerald nas je video kroz staklo. Šta god da sam drugo uradila, svog muža nisam ubila.",
 "suspects:suspects.margaret.role": "Supruga"
}
