 "dialogues:statements.st_daniel_billiards.text": "کھانے کے بعد میں بلیئرڈ کے کمرے میں پیتا رہا۔ میں نے کمرۂ مطالعہ میں قدم تک نہیں رکھا۔",
 "dialogues:statements.st_daniel_boot_room.text": "جھگڑے کے بعد میں ٹیرس سے جوتوں کی کوٹھری کے راستے اندر آیا۔",
 "dialogues:statements.st_daniel_found_body.text": "پونے گیارہ بجے والد صاحب اندھیرے کمرۂ مطالعہ میں پہلے ہی مر چکے تھے۔ میں نے فرش سے بک اینڈ اٹھایا اور اپنا قرض نامہ جلا دیا۔",
 "dialogues:statements.st_daniel_will.text": "پیر کو والد صاحب اپنی وصیت بدل کر مجھے بے دخل کرنے والے تھے۔",
 "dialogues:statements.st_eleanor_calder.text": "فرم Calder & Rowe پیتل کے پرزے فراہم کرنے والی ایک عام سی کمپنی ہے۔",
 "dialogues:statements.st_eleanor_embezzle.text": "فرم Calder & Rowe میں نے گھڑی تھی اور رقم میں نے لی۔ لیکن میں نے انہیں قتل نہیں کیا۔",
 "dialogues:statements.st_eleanor_hall.text": "جب لاش ملی تو میں فون کرنے ہال میں گئی۔ لائن بند تھی۔",
 "dialogues:statements.st_eleanor_letters.text": "دس بجنے میں کوئی بیس منٹ پر میں مسٹر تھورن کے پاس دستخط کے لیے خطوط لے گئی۔ پونے دس بجے جب میں وہاں سے نکلی تو وہ بالکل ٹھیک تھے۔",
 "dialogues:statements.st_eleanor_reels.text": "میں ہر صبح مسٹر تھورن کا املا ٹائپ کرتی ہوں اور ریلیں اپنی شیلف پر رکھتی ہوں۔",
 "dialogues:statements.st_eleanor_typing.text": "کھانا ختم ہونے سے دس بجے تک میں اپنے دفتر میں ٹائپ کر رہی تھی: جام کے موقع کی تقریر۔",
 "dialogues:statements.st_finch_eleanor_knees.text": "جب ہم دوڑ کر کمرۂ مطالعہ میں پہنچے تو ایلینر میز کے پیچھے گھٹنوں کے بل بیٹھی تھی، پھر وہ فون کرنے چلی گئی۔",
 "dialogues:statements.st_finch_library.text": "کھانے کے بعد سے برج تک میں کتب خانے میں اکیلا تھا، ایک کتاب کے ساتھ۔",
 "dialogues:statements.st_finch_phone.text": "21:32 سے 21:51 تک میں ہال کے ٹیلی فون پر روپرٹ ہارٹلی سے بات کر رہا تھا۔",
 "dialogues:statements.st_finch_saw_eleanor.text": "دس بجنے میں کوئی بیس منٹ پر ایلینر ایک فولڈر لے کر کمرۂ مطالعہ کی طرف گئی، اور کوئی دس منٹ بعد واپس آئی۔",
 "dialogues:statements.st_harrow_blow.text": "کنپٹی پر لگی ضرب سے اس کی موت ہوئی، 23:15 سے ایک گھنٹے سے بھی کم پہلے۔",
 "dialogues:statements.st_harrow_conservatory.text": "ساڑھے نو بجے سے دس بجنے میں پانچ منٹ تک میں مارگریٹ کے ساتھ شیشہ گھر میں تھا۔",
 "dialogues:statements.st_harrow_cyanide.text": "لائنل کو سائنائیڈ سے زہر دیا گیا، جو چند منٹوں میں مار دیتا ہے۔ کنپٹی کا زخم گرتے وقت لگا۔",
 "dialogues:statements.st_harrow_drawing_room.text": "میں ساری شام دیوان خانے میں تھا۔",
 "dialogues:statements.st_harrow_earlier.text": "طبی اعتبار سے، یہ ممکن ہے کہ لائنل ساڑھے نو بجے ہی مر چکا ہو۔",
 "dialogues:statements.st_harrow_pill.text": "لائنل ہر رات ٹھیک دس بجے ڈیجیٹلس کی ایک گولی لیتا تھا۔ کبھی ناغہ نہیں کرتا تھا۔",
 "dialogues:statements.st_hobbs_boot_room.text": "جمعے کے بعد سے جوتوں کی کوٹھری سے صرف مس ووس (ہفتے کو چار بجے) اور مسٹر ڈینیئل (جھگڑے کے بعد) گزرے۔",
 "dialogues:statements.st_hobbs_ice.text": "21:25 پر میں صاحب کے لیے تازہ برف لے گیا۔ انہوں نے وہسکی خود انڈیلی اور وہ بھلے چنگے تھے۔",
 "dialogues:statements.st_hobbs_lamp.text": "صاحب کبھی اندھیرے میں کام نہیں کرتے تھے، اور ریکارڈر کا پلگ ہمیشہ کتابوں کی الماری کے پاس ہی لگتا ہے۔",
 "dialogues:statements.st_hobbs_voice.text": "22:15 پر میں نے صاحب کو املا کرواتے سنا: “مجھے افسوس ہے کہ آپ کی چودہ تاریخ کی پیشکش سے مجھے معذرت کرنی ہوگی۔”",
 "dialogues:statements.st_margaret_conservatory.text": "فیلکس اور میں ساڑھے نو بجے سے لگ بھگ دس بجے تک شیشہ گھر میں ساتھ تھے۔",
 "dialogues:statements.st_margaret_drawing_room.text": "کھانے کے بعد میں شور مچنے تک دیوان خانے میں ہی رہی۔",
 "dialogues:statements.st_margaret_eleanor_hall.text": "لاش ملنے کے بعد ایلینر اکیلی ہال کے ٹیلی فون کی طرف گئی۔",
 "dialogues:statements.st_margaret_pill.text": "لائنل ہر رات عین دس بجے اپنی ڈیجیٹلس لیتے تھے۔ پانچ برس میں ایک بار بھی ناغہ نہیں ہوا۔",
 "dialogues:statements.st_margaret_toast.text": "لائنل نے کہا تھا کہ یہ جام “پرانے حساب چکائے گا اور میدان صاف کر دے گا”۔",
 "dialogues:topics.t_daniel_boot_room.lines.0": "تکرار کے بعد میں غصہ ٹھنڈا کرنے ٹیرس پر نکل گیا۔ بارش میں، احمقوں کی طرح۔ شرابور ہو کر جوتوں کی کوٹھری کے راستے اندر آیا اور جوتے وہیں اتار پھینکے۔",
 "dialogues:topics.t_daniel_boot_room.lines.1": "میں نے کسی خرگوش مار زہر کو ہاتھ تک نہیں لگایا، اگر بات اس طرف جا رہی ہے۔ مجھے تو یہ بھی معلوم نہیں تھا کہ گھر میں ایسی کوئی چیز رکھی ہے۔",
 "dialogues:topics.t_daniel_boot_room.prompt": "کیا آپ کل رات جوتوں کی کوٹھری میں گئے تھے؟",
 "dialogues:topics.t_daniel_evening.lines.0": "کھانے کے بعد آپ کہاں گئے تھے، مسٹر تھورن؟",
 "dialogues:topics.t_daniel_evening.lines.1": "جب والد صاحب مجھے ذلیل کر کے فارغ ہو گئے؟ بلیئرڈ کے کمرے میں، ان کی بہترین اسکاچ کی بوتل کے ساتھ۔ میں وہیں رہا، یہاں تک کہ ہابز نے چیخنا شروع کر دیا۔",
 "dialogues:topics.t_daniel_evening.lines.2": "کھانے کے بعد میں نے کمرۂ مطالعہ میں قدم تک نہیں رکھا، اگر آپ اسی کی ٹوہ میں ہیں۔",
 "dialogues:topics.t_daniel_evening.prompt": "کھانے کے بعد آپ کہاں گئے؟",
 "dialogues:topics.t_daniel_father.lines.0": "نپے تلے۔ اس گھر کی ہر گھڑی وہ ہر اتوار خود ملاتے تھے۔ انہیں پسند تھا کہ ہر چیز گھڑی کی سوئی پر چلے — اور ہر آدمی ان کے اشارے پر۔",
 "dialogues:topics.t_daniel_father.lines.1": "وہ ٹھیک دو لوگوں پر بھروسا کرتے تھے: ہابز پر، اور اپنی اس سیکریٹری پر۔ مجھ پر تو ہرگز نہیں۔",
 "dialogues:topics.t_daniel_father.prompt": "آپ کے والد کس قسم کے آدمی تھے؟",
 "dialogues:topics.t_daniel_found.lines.0": "اندھیرا تھا۔ میز کا لیمپ بجھا ہوا تھا — بس آتش دان دہک رہا تھا۔ وہ میز پر اوندھے پڑے تھے۔ میں نے دو بار انہیں پکارا۔",
 "dialogues:topics.t_daniel_found.lines.1": "ٹیپ مشین خاموش تھی۔ کمرے میں وہسکی اور کوئلے کے دھویں کی بو تھی۔ بس اتنا ہی یاد ہے۔ یہ، اور بھاگنا۔",
 "dialogues:topics.t_daniel_found.prompt": "مجھے ٹھیک ٹھیک بتائیے کہ آپ نے کمرۂ مطالعہ میں کیا دیکھا۔",
 "dialogues:topics.t_daniel_quarrel.lines.0": "پوری میز نے آپ کو انہیں دھمکی دیتے سنا۔",
 "dialogues:topics.t_daniel_quarrel.lines.1": "انہوں نے میرا قرض نامہ — پورے تین ہزار پاؤنڈ کا — سوہو کے ایک آدمی سے خرید لیا تھا۔ سوپ کے دوران وہ کاغذ میرے منہ کے آگے لہراتے رہے۔",
 "dialogues:topics.t_daniel_quarrel.lines.2": "پیر کو وہ اپنی وصیت بدل کر مجھے بے دخل کرنے والے تھے، الا یہ کہ میں کارخانے میں جونیئر کلرک کے طور پر کام شروع کر دوں۔ کلرک! بتیس برس کی عمر میں!",
 "dialogues:topics.t_daniel_quarrel.lines.3": "تو ہاں، میں نے کہا تھا کہ میں انہیں قبر میں دیکھنا زیادہ پسند کروں گا۔ لوگ کہہ دیتے ہیں ایسی باتیں۔",
 "dialogues:topics.t_daniel_quarrel.prompt": "کھانے پر جھگڑا کس بات پر ہوا تھا؟",
 "dialogues:topics.t_daniel_suspicion.lines.0": "ایک تو جیرالڈ۔ والد صاحب کو اس کے اور ہارٹلی کے بارے میں کچھ پتا چل گیا تھا — کھانے سے پہلے وہ اس پر بڑے مزے لے رہے تھے۔",
 "dialogues:topics.t_daniel_suspicion.lines.1": "اور ایلینر سارا ہفتہ بلی کی طرح چونکتی رہی ہے۔ انیس برس سے وہ ان کی زندگی چلا رہی ہے۔ اس سے پوچھیے کہ اسے کس بات کا ڈر ہے۔",
 "dialogues:topics.t_daniel_suspicion.prompt": "آپ کے خیال میں کون آپ کے والد کی موت چاہتا تھا؟",
 "dialogues:topics.t_eleanor_alarm.lines.0": "میں پولیس کو فون کرنے ہال میں گئی۔ لائن بند تھی — طوفان کی وجہ سے۔ پھر میں واپس آ کر مسز تھورن کے پاس بیٹھ گئی۔",
 "dialogues:topics.t_eleanor_alarm.prompt": "جب لاش ملی تو آپ نے کیا کیا؟",
 "dialogues:topics.t_eleanor_calder.lines.0": "پیتل کے پرزے فراہم کرنے والی ایک کمپنی۔ بالکل عام سی۔ میں برسوں سے ان کے بل چکاتی آئی ہوں۔",
 "dialogues:topics.t_eleanor_calder.lines.1": "میرا خیال ہے، اس ہفتے مسٹر تھورن نے ایک بل پر سوال اٹھایا تھا۔ وہ ہر چیز پر سوال اٹھاتے تھے۔",
 "dialogues:topics.t_eleanor_calder.prompt": "یہ Calder & Rowe Supplies کیا ہے؟",
 "dialogues:topics.t_eleanor_duties.lines.0": "سب کچھ۔ ان کی ڈائری، ان کے خطوط، حسابات۔ وہ ہر شام ریلوں پر املا کرواتے تھے؛ میں ہر صبح اسے ٹائپ کرتی اور ریلیں اپنی شیلف پر ترتیب سے رکھ دیتی۔",
 "dialogues:topics.t_eleanor_duties.lines.1": "انیس برس۔ بعض دن میں ان کے دل کی بات ان سے بہتر جانتی تھی۔",
 "dialogues:topics.t_eleanor_duties.prompt": "مسٹر تھورن کے لیے آپ کا کام کیا تھا؟",
 "dialogues:topics.t_eleanor_evening.lines.0": "اپنے دفتر میں، آدھی رات کے جام کے لیے مسٹر تھورن کی تقریر ٹائپ کر رہی تھی۔ کھانا ختم ہونے سے دس بجے تک، پھر میں برج کے لیے باقی لوگوں کے پاس چلی گئی۔",
 "dialogues:topics.t_eleanor_evening.lines.1": "میرا خیال ہے آپ کو میرا دفتر بھی دیکھنا ہوگا — کانسٹیبل پائیک دو بار چابی مانگ چکے ہیں۔ یہ لیجیے۔ رات کو میں اسے مقفل رکھتی ہوں؛ مسٹر تھورن کے کاغذات خفیہ ہیں۔",
 "dialogues:topics.t_eleanor_evening.lines.2": "وہ آپ کو پیتل کی ایک چھوٹی سی چابی تھما دیتی ہے۔ سیکریٹری کا دفتر اب آپ کے لیے کھلا ہے۔",
 "dialogues:topics.t_eleanor_evening.prompt": "کھانے کے بعد آپ کہاں تھیں؟",
 "dialogues:topics.t_eleanor_reel.lines.0": "تو پھر کسی نے اسے میری شیلف سے اٹھایا ہوگا۔ دن میں میں دفتر مقفل نہیں کرتی — گھر کا کوئی بھی فرد اندر آ سکتا تھا۔",
 "dialogues:topics.t_eleanor_reel.lines.1": "بھلا میں اپنی ہی ریلوں پر لیبل لگا کر پھر ایک کو مشین میں کیوں چھوڑ دیتی کہ آپ کو مل جائے؟",
 "dialogues:topics.t_eleanor_reel.prompt": "ریکارڈر میں لگی ریل آپ کی شیلف سے آئی تھی۔",
 "dialogues:topics.t_eleanor_switch.lines.0": "کیا خوب ترکیب ہے۔ اور اس کے لیے کتنی آسانی کی بات جو سوا دس بجے کمرۂ مطالعہ کے آس پاس بھی نہیں تھا۔",
 "dialogues:topics.t_eleanor_switch.lines.1": "یہ بات تو ہم چاروں پر صادق آتی ہے — مسز تھورن، ڈاکٹر ہیرو، مسٹر فنچ اور میں۔ آپ کو اس سے بہتر کچھ لانا ہوگا۔",
 "dialogues:topics.t_eleanor_switch.prompt": "لائنل کی آواز کا دھوکا دینے کے لیے کسی نے ٹائم سوئچ استعمال کیا۔",
 "dialogues:topics.t_eleanor_toast.lines.0": "ان کی سبکدوشی، اور ان کے جانشین کا نام۔ انہوں نے مجھے نہیں بتایا تھا کہ کون — نام وہ خود لکھنا چاہتے تھے۔",
 "dialogues:topics.t_eleanor_toast.lines.1": "مسٹر تھورن کو لوگوں کو حیران کرنا پسند تھا۔",
 "dialogues:topics.t_eleanor_toast.prompt": "آدھی رات کا اعلان کیا تھا؟",
 "dialogues:topics.t_finch_alarm.lines.0": "فیلکس لائنل پر جھک گیا۔ مارگریٹ کا رنگ کاغذ کی طرح سفید پڑ گیا۔ اور میں — کہتے ہوئے شرم آتی ہے — دروازے میں کھڑا رہا۔",
 "dialogues:topics.t_finch_alarm.lines.1": "ایلینر — اب آپ نے ذکر کیا تو یاد آیا — میز کے پیچھے، دیوار کی جڑ کے پاس گھٹنوں کے بل بیٹھی تھی۔ میں سمجھا اسے غش آ گیا ہے۔ پھر وہ بڑے اطمینان سے اٹھی اور بولی کہ وہ پولیس کو فون کرے گی۔",
 "dialogues:topics.t_finch_alarm.prompt": "جب آپ سب دوڑ کر کمرۂ مطالعہ میں پہنچے تو آپ نے کیا دیکھا؟",
 "dialogues:topics.t_finch_company.lines.0": "لائنل نے اور میں نے اسے مل کر کھڑا کیا تھا۔ آگے کس طرف جانا ہے، اس پر ہمارا اختلاف تھا۔ شراکت داروں میں ہوتا ہے۔",
 "dialogues:topics.t_finch_company.lines.1": "اس مہینے Hartley Precision نے ہمیں ایک پیشکش کی۔ لائنل نے مجھ سے مشورہ کیے بغیر اسے ٹھکرا دیا۔ لائنل ایسا ہی تھا۔",
 "dialogues:topics.t_finch_company.prompt": "آپ کی کمپنی Thorne Instruments میں حالات کیسے تھے؟",
 "dialogues:topics.t_finch_evening.lines.0": "کتب خانے میں، ایک کتاب کے ساتھ۔ ٹرولوپ۔ اکیلا، افسوس — کوئی میری گواہی دینے والا نہیں۔ پھر دس بجے سے برج۔",
 "dialogues:topics.t_finch_evening.prompt": "کھانے اور برج کے درمیان آپ کہاں تھے؟",
 "dialogues:topics.t_finch_note.lines.0": "تو اسے پتا چل گیا تھا۔ وہ چاہتا تھا کہ میں اسی رات استعفا دے دوں — ورنہ اپنے لاڈلے آدھی رات کے جام پر وہ میری طرف سے خود اعلان کر دیتا۔",
 "dialogues:topics.t_finch_note.lines.1": "یہ ذلت کی بات ہوتی۔ مگر اس کے لیے چالیس برس پرانے دوست کو قتل کرنا بنتا نہیں تھا۔ میں ساٹھ برس کا ہوں؛ تھوڑی سی ذلت سہہ سکتا ہوں۔",
 "dialogues:topics.t_finch_note.prompt": "لائنل آپ کے لیے ایک رقعہ چھوڑ گئے تھے۔ انہیں ہارٹلی والی بات معلوم تھی۔",
 "dialogues:topics.t_finch_saw.lines.0": "ٹیلی فون کی میز سے راہداری کے آخر میں کمرۂ مطالعہ سیدھا نظر آتا ہے، اور شیشے کے دروازے سے سامنے شیشہ گھر کے اندر بھی۔",
 "dialogues:topics.t_finch_saw.lines.1": "مارگریٹ اور فیلکس شیشہ گھر میں تھے — شیر و شکر، جیسے کئی مہینوں سے ہیں۔ اور دس بجنے میں کوئی بیس منٹ پر ایلینر بغل میں ایک فولڈر دبائے پاس سے گزری، کمرۂ مطالعہ کی طرف۔",
 "dialogues:topics.t_finch_saw.lines.2": "دس منٹ بعد وہ واپس آئی، شاید کچھ زیادہ۔ میری طرف دیکھے بغیر پاس سے گزر گئی۔ میں نے سمجھا لائنل کو کچھ خطوں پر دستخط کرنے ہوں گے۔",
 "dialogues:topics.t_finch_saw.prompt": "ٹیلی فون کے پاس سے آپ کو کیا نظر آ رہا تھا؟",
 "dialogues:topics.t_harrow_cause.lines.0": "بائیں کنپٹی پر ضرب۔ میرے خیال میں کانسی کا بک اینڈ — وہ اس کے بالکل پاس پڑا تھا۔ بے چارے کو اس کی اپنی میز پر وار کر کے گرا دیا گیا۔",
 "dialogues:topics.t_harrow_cause.lines.1": "سوا گیارہ بجے جب میں نے اس کا معائنہ کیا تو اسے مرے ایک گھنٹا بھی نہیں ہوا تھا۔ ہابز نے سوا دس بجے اسے املا کرواتے سنا، تو بس یہی وقفہ بنتا ہے۔",
 "dialogues:topics.t_harrow_cause.prompt": "لائنل کی موت کیسے ہوئی؟",
 "dialogues:topics.t_harrow_earlier.lines.0": "اگر سائنائیڈ تھا — تو ہاں۔ بڑی آسانی سے۔ یہ منٹوں میں مار دیتا ہے، اور آتش دان کی وجہ سے وہ کمرہ تنور کی طرح گرم تھا۔",
 "dialogues:topics.t_harrow_earlier.lines.1": "میں نے سوا دس بجے کے ہابز والے “املا” کو حرفِ آخر مان لیا تھا۔ طبی اعتبار سے، یہ ممکن ہے کہ لائنل ساڑھے نو بجے ہی مر چکا ہو۔",
 "dialogues:topics.t_harrow_earlier.prompt": "کیا ان کی موت آپ کے اندازے سے پہلے ہو سکتی تھی؟",
 "dialogues:topics.t_harrow_evening.lines.0": "دیوان خانے میں، ساری شام۔ برانڈی، پھر دس بجے سے برج۔ مارگریٹ اور میری جوڑی ایلینر اور جیرالڈ کے مقابلے میں تھی۔",
 "dialogues:topics.t_harrow_evening.prompt": "کھانے کے بعد آپ کہاں تھے؟",
 "dialogues:topics.t_harrow_lionel.lines.0": "ذہین۔ ناقابلِ برداشت۔ اس نے کوونٹری کے ایک چھپر سے Thorne Instruments کھڑی کی اور کسی کو اپنے سے سست ہونے پر کبھی معاف نہیں کیا۔",
 "dialogues:topics.t_harrow_lionel.lines.1": "سن 42 میں ہم صحرا میں اکٹھے تھے۔ ایک بار اس نے میری جان بچائی تھی۔ مجھے یہ بات کبھی بھولنے نہیں دی گئی۔",
 "dialogues:topics.t_harrow_lionel.prompt": "لائنل کیسے آدمی تھے؟",
 "dialogues:topics.t_harrow_margaret.lines.0": "مجھے اس پر فخر نہیں۔ لائنل میرا دوست تھا۔ مگر میں اس سے محبت کرتا ہوں — اور لائنل کو اپنی کمپنی سے محبت تھی۔",
 "dialogues:topics.t_harrow_margaret.prompt": "آپ اور مارگریٹ…",
 "dialogues:topics.t_harrow_pills.lines.0": "ڈیجیٹلس۔ ہر رات ٹھیک دس بجے ایک گولی، پانی کے ایک گلاس کے ساتھ۔ 1957 میں دل کے دورے کے بعد میں نے اس سے اس کا حلف لیا تھا۔",
 "dialogues:topics.t_harrow_pills.lines.1": "وہ کبھی نہیں چوکا۔ ایک بار بھی نہیں۔ اسے اپنے دل کا بڑا خوف تھا۔",
 "dialogues:topics.t_harrow_pills.prompt": "مجھے لائنل کی دل کی گولیوں کے بارے میں بتائیے۔",
 "dialogues:topics.t_harrow_poisons.lines.0": "میرے بیگ سے تو نہیں، اگر آپ کا یہی خیال ہے — میں ایسی کوئی چیز ساتھ نہیں رکھتا۔ مگر ہر دیہی حویلی میں کچھ نہ کچھ ہوتا ہے۔ بھڑ مار دوا۔ خرگوشوں کی گیس۔",
 "dialogues:topics.t_harrow_poisons.lines.1": "ہابز سے پوچھیے کہ مالی جوتوں کی کوٹھری میں کیا رکھتا ہے۔",
 "dialogues:topics.t_harrow_poisons.prompt": "ایسے گھر میں کسی کو سائنائیڈ کہاں سے مل سکتا ہے؟",
 "dialogues:topics.t_hobbs_affair.lines.0": "یہ کہنا میرا کام نہیں۔",
 "dialogues:topics.t_hobbs_affair.lines.1": "…میں نے انہیں شیشہ گھر میں دیکھا ہے۔ ایک سے زیادہ بار۔ میں نہیں چاہتا تھا کہ صاحب کو اس سے دکھ پہنچے، اس لیے زبان بند رکھی۔",
 "dialogues:topics.t_hobbs_affair.prompt": "کیا آپ کو مسز تھورن اور ڈاکٹر ہیرو کے بارے میں علم تھا؟",
 "dialogues:topics.t_hobbs_body.lines.0": "گیارہ بج کر دس منٹ پر مسز تھورن نے مجھے صاحب کو جام کے لیے بلانے بھیجا۔ انگاروں کے سوا کمرے میں اندھیرا تھا۔ وہ اپنی میز پر اوندھے پڑے تھے۔",
 "dialogues:topics.t_hobbs_body.lines.1": "تیس برس سے اس گھر کی خدمت کر رہا ہوں۔ اپنے منہ سے ایسی چیخ میں نے کبھی نہیں سنی تھی۔",
 "dialogues:topics.t_hobbs_body.prompt": "آپ نے انہیں کس حال میں پایا؟",
 "dialogues:topics.t_hobbs_boot_room.lines.0": "جمعے کو جب مالی جینکنز گیا تو وہ ڈبا سربمہر تھا۔ میں نے سامان کی پڑتال خود کی تھی۔",
 "dialogues:topics.t_hobbs_boot_room.lines.1": "تب سے؟ کل چار بجے مس ووس اپنے ربڑ کے جوتے لینے آئی تھیں — کہنے لگیں، بارش سے پہلے ذرا چہل قدمی۔ اور مسٹر ڈینیئل جھگڑے کے بعد اسی راستے اندر آئے، سر سے پاؤں تک بھیگے ہوئے۔",
 "dialogues:topics.t_hobbs_boot_room.prompt": "جوتوں کی کوٹھری میں کون کون گیا ہے؟",
 "dialogues:topics.t_hobbs_ice.lines.0": "نو بج کر پچیس منٹ پر میں ان کے لیے تازہ برف لے گیا۔ انہوں نے وہسکی خود انڈیلی — ہمیشہ خود ہی انڈیلتے تھے — اور خوب ہشاش بشاش تھے۔ گنگنا بھی رہے تھے۔",
 "dialogues:topics.t_hobbs_ice.lines.1": "پھر ساڑھے نو بجے میں نیچے مسز بیل کے ساتھ اپنا کھانا کھانے چلا گیا۔",
 "dialogues:topics.t_hobbs_ice.prompt": "آپ نے مسٹر تھورن کو آخری بار کب دیکھا؟",
 "dialogues:topics.t_hobbs_lamp.lines.0": "پلگ نکلا ہوا؟ صاحب کبھی اندھیرے میں نہیں بیٹھتے تھے۔ جب وہ کام کرتے تو وہ لیمپ ہمیشہ جلتا رہتا تھا۔",
 "dialogues:topics.t_hobbs_lamp.lines.1": "اور ریکارڈر کی جگہ کتابوں کی الماری کے پاس سائیڈ ٹیبل پر ہے۔ اس کا پلگ وہیں ساتھ ہی لگتا ہے۔ تار کو پورے کمرے کے پار لے جانے کی کوئی ضرورت ہی نہیں۔",
 "dialogues:topics.t_hobbs_lamp.prompt": "میز کے لیمپ کا پلگ نکلا ہوا تھا۔",
 "dialogues:topics.t_hobbs_routine.lines.0": "ساڑھے نو بجے وہسکی۔ ٹھیک دس بجے ان کی گولی۔ سوا دس بجے آگ دبائی جاتی۔ اتوار کو وہ گھر کی ہر گھڑی ریڈیو کے وقت کے اشاروں سے ملاتے تھے۔",
 "dialogues:topics.t_hobbs_routine.lines.1": "صاحب معمولات کے پابند آدمی تھے۔ جو بھی انہیں جانتا تھا، ان کے معمولات بھی جانتا تھا۔",
 "dialogues:topics.t_hobbs_routine.prompt": "مسٹر تھورن کا شام کا معمول کیا تھا؟",
 "dialogues:topics.t_hobbs_switches.lines.0": "یہ ہمارا ہی ہے۔ ہم ہال کی الماری میں تین رکھتے ہیں، جب گھر والے لندن میں ہوں تو لیمپوں کے لیے۔ چوروں کو دور رکھنے کی خاطر۔",
 "dialogues:topics.t_hobbs_switches.lines.1": "گھر کے ہر فرد کو معلوم ہوگا کہ وہ کہاں رکھے جاتے ہیں۔",
 "dialogues:topics.t_hobbs_switches.prompt": "کیا آپ اس ٹائم سوئچ کو پہچانتے ہیں؟",
 "dialogues:topics.t_hobbs_voice.lines.0": "سوا دس بجے میں کمرۂ مطالعہ کی آگ دبانے اوپر گیا، جیسے ہر رات جاتا ہوں۔",
 "dialogues:topics.t_hobbs_voice.lines.1": "دروازے کے پار سے میں نے صاحب کو املا کرواتے سنا۔ بالکل صاف: “مجھے افسوس ہے کہ آپ کی چودہ تاریخ کی پیشکش سے مجھے معذرت کرنی ہوگی۔” سو میں لوٹ آیا۔ صاحب املا کے دوران کسی مداخلت کی اجازت نہیں دیتے تھے۔",
 "dialogues:topics.t_hobbs_voice.lines.2": "گھر کا ہر فرد یہ اصول جانتا ہے۔",
 "dialogues:topics.t_hobbs_voice.prompt": "مجھے کل رات سوا دس بجے کے بارے میں بتائیے۔",
 "dialogues:topics.t_margaret_alarm.lines.0": "ہابز چیخا اور ہم سب دوڑ کر اندر گئے۔ فیلکس سیدھا لائنل کی طرف گیا۔ جیرالڈ دروازے میں بت بنا کھڑا رہا۔",
 "dialogues:topics.t_margaret_alarm.lines.1": "ایلینر نے کہا کہ وہ پولیس کو فون کرے گی اور ہال میں چلی گئی — اکیلی۔ لائن ظاہر ہے بند تھی۔ اور افسوس، میں بے ہوش ہو گئی تھی۔",
 "dialogues:topics.t_margaret_alarm.prompt": "جب لاش ملی تو کیا ہوا؟",
 "dialogues:topics.t_margaret_daniel.lines.0": "ڈینیئل کمزور ہے، بدکار نہیں۔ کیمبرج کے زمانے سے قرض میں ڈوبا ہوا ہے۔",
 "dialogues:topics.t_margaret_daniel.lines.1": "اگر آپ کو جاننا ہی ہے تو — اس میں سے کچھ میں خود ادا کرتی رہی ہوں۔ لائنل کو کبھی پتا نہیں چلا۔ خدارا ڈینیئل کو مت بتائیے گا کہ میں نے آپ کو بتایا ہے۔",
 "dialogues:topics.t_margaret_daniel.prompt": "کیا یہ کام ڈینیئل کا ہو سکتا ہے؟",
 "dialogues:topics.t_margaret_eleanor.lines.0": "لائنل ہر معاملے میں اس پر بھروسا کرتے تھے۔ حساب کتاب، بینک، ان کے دستخط، ان کی ڈائری۔ مجھ پر انہوں نے کبھی اتنا بھروسا نہیں کیا۔",
 "dialogues:topics.t_margaret_eleanor.lines.1": "انیس برس ان کے پہلو میں۔ بعض دن تو لگتا ہے کہ وہ مجھ سے زیادہ ان کی بیوی تھی۔",
 "dialogues:topics.t_margaret_eleanor.prompt": "ایلینر ووس کے بارے میں آپ کی کیا رائے ہے؟",
 "dialogues:topics.t_margaret_evening.lines.0": "دیوان خانے میں، باقی سب کے ساتھ۔ کافی، تھوڑی سی برانڈی، پھر دس بجے سے برج۔",
 "dialogues:topics.t_margaret_evening.lines.1": "جب تک ہابز نے شور نہیں مچایا، میں وہاں سے نہیں اٹھی۔",
 "dialogues:topics.t_margaret_evening.prompt": "کھانے کے بعد آپ کہاں تھیں؟",
 "dialogues:topics.t_margaret_felix.lines.0": "دو برس۔ لائنل کا بیاہ مجھ سے بہت پہلے Thorne Instruments سے ہو چکا تھا۔",
 "dialogues:topics.t_margaret_felix.lines.1": "آخرکار میں ان سے طلاق مانگ لیتی۔ اس کے لیے مجھے انہیں قتل کرنے کی کبھی ضرورت نہ پڑتی۔ خدارا — بات اپنے تک رکھیے گا۔",
 "dialogues:topics.t_margaret_felix.prompt": "آپ اور ڈاکٹر ہیرو کب سے…؟",
 "dialogues:topics.t_margaret_health.lines.0": "ان کا دل کمزور تھا۔ فیلکس نے انہیں ڈیجیٹلس پر رکھا ہوا تھا — ہر رات دس بجے ایک گولی، عین وقت پر۔",
 "dialogues:topics.t_margaret_health.lines.1": "لائنل نے کبھی ناغہ نہیں کیا۔ پانچ برس میں ایک بار بھی نہیں۔ دنیا کی کسی بھی چیز سے زیادہ انہیں اپنے دل کا ڈر تھا۔",
 "dialogues:topics.t_margaret_health.prompt": "کیا آپ کے شوہر کی صحت ٹھیک تھی؟",
 "dialogues:topics.t_margaret_toast.lines.0": "وہ مجھے بتاتے ہی نہیں تھے۔ اس بات پر خود سے بے حد خوش تھے۔",
 "dialogues:topics.t_margaret_toast.lines.1": "انہوں نے کہا تھا کہ یہ جام “پرانے حساب چکائے گا اور میدان صاف کر دے گا”۔ لائنل کو معما بہت پسند تھا — بشرطیکہ راز ان کے پاس ہو۔",
 "dialogues:topics.t_margaret_toast.prompt": "لائنل آدھی رات کو کیا اعلان کرنے والے تھے؟",
 "evidence:evidence.bridge_scorepad.detail": "کل رات کے کھیل کا اسکور پیڈ: “پہلا ربر — 22:00”۔ جوڑیاں: ایم۔ ٹی۔ اور ایف۔ ایچ۔ بمقابلہ ای۔ وی۔ اور جی۔ ایف۔ تین ربر؛ آخری اندراج کا وقت 23:05 درج ہے۔\n\nدس بجے کے بعد کے ایک گھنٹے میں چار لوگ ایک دوسرے کے گواہ تھے۔",
 "evidence:evidence.bridge_scorepad.name": "برج کا اسکور پیڈ",
 "evidence:evidence.bridge_scorepad.summary": "22:00 سے 23:05 تک برج: مارگریٹ اور ہیرو بمقابلہ ایلینر اور فنچ۔",
 "evidence:evidence.bronze_bookend.detail": "کانسی کا ایک بھاری گھوڑا، جوڑی میں سے ایک، جس پر کانسٹیبل پائیک نے پرچی باندھ دی ہے۔ ایک کونے پر ذرا سا خون لگا ہے۔ پائیک نے اس پر پاؤڈر چھڑک کر انگلیوں کے نشانات کا بلیئرڈ کے کمرے میں چھوڑے گئے ڈینیئل کے وہسکی کے گلاس سے موٹا موٹا موازنہ کیا ہے: “اسی کے ہیں، سمجھو ذرا بھی فرق نہیں۔”\n\nایک جان لیوا ضرب کے حساب سے، اس سے لگنے والا مبینہ زخم چھوٹا سا تھا۔ اس سے خون بمشکل ہی نکلا۔",
 "evidence:evidence.bronze_bookend.name": "کانسی کا بک اینڈ",
 "evidence:evidence.bronze_bookend.summary": "ایک کونے پر خون — اور ڈینیئل کی انگلیوں کے نشانات۔",
 "evidence:evidence.burnt_iou.detail": "کمرۂ مطالعہ کے آتش دان کی راکھ میں ایک جھلسا ہوا ٹکڑا جو پوری طرح نہیں جلا: “…ادا کرنے کا وعدہ… مبلغ 3,000 پاؤنڈ… ڈینیئل تھورن”۔\n\nیہ راکھ کے اوپر پڑا ہے، نیچے نہیں۔ اسے رات گئے، آگ مدھم پڑ جانے کے بعد، آتش دان میں پھینکا گیا تھا۔",
 "evidence:evidence.burnt_iou.name": "جلا ہوا قرض نامہ",
 "evidence:evidence.burnt_iou.summary": "ایک جھلسا ہوا ٹکڑا: “…3,000 پاؤنڈ… ڈینیئل تھورن”۔",
 "evidence:evidence.calder_invoice.detail": "ایک بل، “Calder & Rowe Supplies — پیتل کے پرزے، برمنگھم” کی طرف سے، 1,140 پاؤنڈ کا، جس پر “ادا شدہ” درج ہے۔ لائنل نے کل رقم کے گرد سرخ پنسل سے دائرہ کھینچ کر سوالیہ نشان لگا دیا ہے۔\n\nٹائپنگ ذرا ناہموار ہے: ایک حرف جہاں بھی آتا ہے، ذرا اوپر بیٹھتا ہے اور مدھم چھپتا ہے۔",
 "evidence:evidence.calder_invoice.name": "فرم Calder & Rowe کا بل",
 "evidence:evidence.calder_invoice.summary": "لائنل نے سرخ رنگ سے گھیر کر سوالیہ نشان لگایا ہے۔",
 "evidence:evidence.carbon_hartley.detail": "15 نومبر کی تاریخ والی ایک کاربن کاپی، بنام سر روپرٹ ہارٹلی، Hartley Precision Ltd. (ٹیلی فون WHItehall 4021):\n\n“عزیزی روپرٹ — مجھے افسوس ہے کہ آپ کی چودہ تاریخ کی پیشکش سے مجھے معذرت کرنی ہوگی۔ Thorne Instruments برائے فروخت نہیں — جب تک میرے دم میں دم ہے، ہرگز نہیں۔ — ایل۔ تھورن”\n\nایلینر نے جمعرات کے املا سے ٹائپ کی۔",
 "evidence:evidence.carbon_hartley.name": "ہارٹلی کے نام خط کی کاربن کاپی",
 "evidence:evidence.carbon_hartley.summary": "15 نومبر: “مجھے افسوس ہے کہ آپ کی چودہ تاریخ کی پیشکش سے مجھے معذرت کرنی ہوگی۔”",
 "evidence:evidence.cold_grate.detail": "ایلینر کے دفتر کے آتش دان میں آگ کا سامان تیار رکھا ہے — کاغذ، پتلی لکڑیاں اور کوئلہ — مگر اسے کبھی جلایا نہیں گیا۔ آتش دان برف کی طرح ٹھنڈا ہے۔\n\nکل رات ایلینر نے جو بھی کیا ہو، نومبر کی وہ ٹھٹھرتی شام اس نے یہاں بیٹھ کر ٹائپ کرتے ہوئے نہیں گزاری۔",
 "evidence:evidence.cold_grate.name": "ٹھنڈا آتش دان",
 "evidence:evidence.cold_grate.summary": "ایلینر کے دفتر میں آگ کا سامان تیار تھا، مگر کل رات آگ جلائی ہی نہیں گئی۔",
 "evidence:evidence.constable_notes.detail": "ہفتہ، 17 نومبر۔ 21:00 سے موسلا دھار بارش۔\n\n19:30 — کھانا۔ موجود: متوفی، مسز مارگریٹ تھورن، مسٹر ڈینیئل تھورن، مس ایلینر ووس، مسٹر جیرالڈ فنچ، ڈاکٹر فیلکس ہیرو۔ بٹلر اے۔ ہابز خدمت پر۔\n20:45 — متوفی اور بیٹے میں جھگڑا۔ بیٹے کو کہتے سنا گیا: “میں تو آپ کو قبر میں دیکھنا زیادہ پسند کروں گا۔”\n21:00 — متوفی کمرۂ مطالعہ میں چلا گیا۔ آدھی رات کے جام تک مخل نہ ہونے کی ہدایت۔\n22:00 — دیوان خانے میں برج، 23:05 تک۔\n22:15 — بٹلر نے کمرۂ مطالعہ کے دروازے کے پار متوفی کو املا کرواتے سنا۔\n22:45 — خادمہ نے بیٹے کو کمرۂ مطالعہ سے نکلتے دیکھا۔\n23:10 — بٹلر نے متوفی کو میز پر اوندھا پڑا پایا۔ بائیں کنپٹی پر زخم؛ کانسی کا بک اینڈ فرش پر۔ ڈاکٹر ہیرو: موت “گھنٹے بھر کے اندر”۔\n23:15 — ٹیلی فون لائن بند پائی گئی (طوفان)۔\n00:30 — کمرۂ مطالعہ میری طرف سے سربمہر۔\n\n— کانسٹیبل آر۔ پائیک",
 "evidence:evidence.constable_notes.name": "کانسٹیبل پائیک کی یادداشتیں",
 "evidence:evidence.constable_notes.summary": "رات کے واقعات، جیسے کانسٹیبل نے درج کیے۔",
 "evidence:evidence.cook_statement.detail": "باورچن مسز بیل کا بیان، کانسٹیبل پائیک کے روبرو:\n\n“مسٹر ہابز ساڑھے نو بجے نیچے آئے اور ملازموں کے کمرے میں میرے ساتھ کھانا کھایا۔ سوا دس بجے وہ کمرۂ مطالعہ کی آگ دیکھنے اوپر گئے اور دو منٹ کے اندر لوٹ آئے، کہنے لگے صاحب املا کروا رہے ہیں اور انہیں تنگ نہ کیا جائے۔ پھر وہ اپنی جگہ سے نہیں ہلے، یہاں تک کہ گیارہ بج کر دس منٹ پر مسز تھورن نے گھنٹی بجا کر انہیں بلایا۔”",
