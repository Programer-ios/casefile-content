 "case:timeline.events.tl_meeting.text": "Damjan meets E.D. in the rear vestibule",
 "case:timeline.events.tl_passport.teaser": "One passport leaves Emil’s rack.",
 "case:timeline.events.tl_passport.text": "Elena’s passport is returned early",
