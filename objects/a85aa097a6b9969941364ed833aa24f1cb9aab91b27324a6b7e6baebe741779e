{
 "case:accusation.methods.0": "Guranje s merdevina na gvozdenu stalažu",
 "case:accusation.methods.1": "Udarac srebrnom jabukom njenog sopstvenog štapa",
 "case:accusation.methods.2": "Otrov u kakau koji joj je Agnes odnela",
 "case:accusation.methods.3": "Gušenje njenim sopstvenim šalom",
 "case:accusation.motives.0": "Da muževljev falsifikat ostane skriven od policije — a Penhallow u njegovim rukama",
 "case:accusation.motives.1": "Da se seme mesečeve orhideje proda jednom američkom rasadniku",
 "case:accusation.motives.2": "Da se vrtovi spasu od prodaje za kamp za odmor",
 "case:accusation.motives.3": "Da tajna veridba ne izađe na videlo",
 "case:accusation.motives.4": "Da posle dvadeset godina kao plaćena družbenica najzad bude slobodna",
 "case:accusation.proofLabels.0": "Prilika — s njom u trenutku smrti",
 "case:accusation.proofLabels.1": "Lažna udovica — ko je zvonio u 23.32",
 "case:accusation.proofLabels.2": "Motiv — zašto baš u petak noću",
 "case:accusation.successTitle": "Slučaj zatvoren",
 "case:briefing.0": "Penhallow House, Cornwall. Subota, 27. jul 1963. Deset sati ujutru.",
 "case:briefing.1": "Selo već dvadeset godina ledi Hester Penhallow zove Udovicom iz staklenika. Od telegrama iz Burme 1943. nosila je crninu, sve do vela, i živela među biljkama koje joj je muž slao kući — a pre svega uz mesečevu orhideju, koja u Engleskoj nijednom nije procvetala. Sinoć je, samo za jednu noć, procvetala.",
 "case:briefing.2": "Bdela je sama, zaključana u stakleniku, i obećala da će zazvoniti kada se cvet otvori. U 23.32 oglasilo se zvono i četvoro ljudi s terase videlo ju je kroz staklo, s lampom u ruci, pored velikog belog cveta. Jutros u petnaest do šest baštovan ju je pronašao mrtvu u podnožju merdevina.",
 "case:briefing.3": "U utorak vam je pisala i zamolila vas da dođete: neko iz njene porodice učinio je „nešto kriminalno“. Pismo je do vas stiglo prekasno. Narednik Polglase iz St Austella ima teoriju i osumnjičenog, a vama je prepustio jutro, dok ne stigne službenik mrtvozornika.",
 "case:briefing.4": "Otkrijte ko je ubio ledi Penhallow, kako i zašto — i pripremite se da to dokažete.",
 "case:epilogue.0": "Celia Penhallow izdržala je dva dana. Onda joj je narednik Polglase pred oči stavio fotografiju doktorke Ellery: visoku crnu priliku s visoko podignutom lampom. Dugo ju je gledala, a onda je, sasvim mirno, rekla: „Uvek sam igrala za galeriju.“",
 "case:epilogue.1": "Hester joj je to rekla još u šest sati: Julian je falsifikovao njen potpis na hipoteci na imanje Home Farm, a ujutru će ugovor otići gospodinu Kittowu, i od gospodina Kittowa u policiju. U dvadeset do jedanaest Celia je sišla u staklenik da je moli. Hester joj je odgovorila da će Julian za to odgovarati, kako bi i Edmund želeo. Njen štap bio je naslonjen na stalažu.",
 "case:epilogue.2": "Potom je Celia uradila ono čemu ju je naučilo jedanaest godina u repertoarskim pozorištima: čekala je svoj šlagvort. Tri četvrt sata sedela je pored tela, dok se mesečeva orhideja pored njega otvarala. Onda je stavila veo i šal, zazvonila i pred publikom od četvoro ljudi odigrala ulogu svog života. Zatim je veo i šal ponovo stavila na Hester, zaključala vrata da nijedan lekar ne bi video telo pre jutra, spalila ugovor u kotlarnici i otišla u kuću da pije šampanjac.",
 "case:epilogue.3": "Proučila je sve o Hester Penhallow, osim jedine stvari koja je bila važna. Hester nikada ne bi dozvolila da se taj cvet otvori i zatvori netaknut.",
 "case:epilogue.4": "Julian Penhallow osuđen je na tri godine zatvora zbog falsifikovanja. Novi testament nikada nije potpisan, pa je Penhallow ipak pripao njemu, a on ga je iz ćelije poklonio fondaciji National Trust — s vrtovima, staklenikom i svim ostalim. Marian Ellery odbila je dvadeset hiljada dolara gospodina Lindqvista i odnela seme u Kew. Edwin Kittow zadržao je prsten koji je za septembar kupio u Truru.",
 "case:epilogue.5": "U novembru je na mesečevoj orhideji sazrela jedna jedina zelena čaura. Prvi sejanci procvetali su u Kewu u proleće 1971. Jory Trevenna otputovao je, u svom nedeljnom odelu, da ih vidi i sam im je izabrao ime: zavedeni su kao „Udovica iz staklenika“. Svakog poslednjeg petka u julu on i dalje celu noć bdi u stakleniku. Neko mora, kaže.",
 "case:hints.h_accuse.levels.0": "Pregledajte tablu. Ko je bio s Hester kada je umrla, ko je zvonio u 23.32 i kome je bilo potrebno da ona zauvek ućuti pre jutra?",
 "case:hints.h_accuse.levels.1": "Za svaki deo optužbe potrebna je kartica: prilika, lažna udovica i motiv. Ako neka nedostaje, prethodni nagoveštaji već su vas uputili na nju. Ponovo pročitajte beležnicu.",
 "case:hints.h_accuse.levels.2": "Ubica je Celia Penhallow: udarac srebrnom jabukom Hesterinog sopstvenog štapa, da policija ne bi saznala za Julianov falsifikat. Dokažite to Celijinim priznanjem da je išla u staklenik, njenim kućnim ogrtačem i papučama prekrivenim koksnom prašinom i zaključkom o falsifikatu.",
 "case:hints.h_accuse_ready.levels.0": "Možda već imate dovoljno za hapšenje. Ko je bio s Hester kada je umrla, ko je zvonio i zašto je to moralo da bude baš u petak noću?",
 "case:hints.h_accuse_ready.levels.1": "Samo je jedna osoba propustila zvono, te noći bila u stakleniku i znala šta Hester namerava da uradi ujutru.",
 "case:hints.h_accuse_ready.levels.2": "Optužite Celiju Penhallow: udarac srebrnom jabukom Hesterinog sopstvenog štapa, da policija ne bi saznala za muževljev falsifikat. Dokažite to njenim priznanjem da je išla u staklenik (ili hronologijom), njenim kućnim ogrtačem i papučama (ili izjavom Joryja ili doktorke Ellery) i svojim zaključkom o falsifikatu (ili pismom firme Lorimer & Dane).",
 "case:hints.h_bell_ringer.levels.0": "Uporedite ženu kod zvona sa ženom na fotografiji iz 21.25.",
 "case:hints.h_bell_ringer.levels.1": "Pogledajte koliko je visoka u odnosu na nosač lampe, pogledajte njene ruke i rub njene odeće. Ledi Penhallow nije mogla da napravi ni korak bez nečega.",
 "case:hints.h_bell_ringer.levels.2": "Odgovorite „Nekoga u njenom velu i šalu“ uz fotografiju iz 23.32 i fotografiju iz 21.25 (ili štap od abonosa).",
 "case:hints.h_bloom.levels.0": "Hester je na taj cvet čekala dvadeset pet godina. Da li je dočekala svoju priliku?",
 "case:hints.h_bloom.levels.1": "Pročitajte njen dnevnik cvetanja ili pitajte doktorku Ellery šta bi Hester uradila čim se cvet otvori. Zatim se setite šta je Jory zatekao u zoru.",
 "case:hints.h_bloom.levels.2": "Odgovorite „Ne — nikada je ne bi ostavila neoprašenu“ uz Joryjevu izjavu o zori (ili mesečevu orhideju) i dnevnik cvetanja (ili izjavu doktorke Ellery o oprašivanju).",
 "case:hints.h_celia_alive.levels.0": "Celia se kune da je Hester bila živa i da je pisala kada je ona otišla, u deset do jedanaest. Proverite šta je Hester napisala.",
 "case:hints.h_celia_alive.levels.1": "Hester je svakih četvrt sata beležila stanje cveta u dnevnik.",
 "case:hints.h_celia_alive.levels.2": "Osporite Celijinu izjavu „živa, pisala je u svoj dnevnik“ dnevnikom cvetanja ili svojim zaključkom o vremenu smrti.",
 "case:hints.h_celia_knew.levels.0": "Celia kaže da nije znala ništa ni o kakvom falsifikatu. Ko bi joj to rekao?",
 "case:hints.h_celia_knew.levels.1": "Ponovo pročitajte Hesterinu belešku na pismu firme Lorimer & Dane — ili pitajte gospodina Kittowa šta mu je Hester rekla.",
 "case:hints.h_celia_knew.levels.2": "Osporite Celijinu izjavu „Ne znam baš ništa ni o kakvom falsifikatu“ pismom firme Lorimer & Dane ili izjavom gospodina Kittowa o veridbi.",
 "case:hints.h_celia_rose.levels.0": "Celia kaže da je šetala alejom ruža i da se nije ni približila stakleniku. Da li nešto od njenih stvari govori drugačije?",
 "case:hints.h_celia_rose.levels.1": "Ko god da je zvonio, ispod šala je nosio nešto svetlo i izašao je kroz kotlarnicu. Pogledajte u orman u Plavoj sobi ili pitajte doktorku Ellery za miris.",
 "case:hints.h_celia_rose.levels.2": "Osporite Celijinu izjavu „Šetala sam alejom ruža“ njenim kućnim ogrtačem i papučama, otiscima u koksnoj prašini ili izjavom Joryja ili doktorke Ellery.",
 "case:hints.h_forgery.levels.0": "Šta je bilo ono „nešto kriminalno“ iz njenog pisma?",
 "case:hints.h_forgery.levels.1": "Potpis govori više kada znate kojim je mastilom ona pisala. Pitajte Agnes o njenim navikama i pretražite posudu za pepeo ispod kotla.",
 "case:hints.h_forgery.levels.2": "Odgovorite „Dokaz da je Julian falsifikovao njen potpis na hipoteci od £20.000“ uz pismo firme Lorimer & Dane i nagoreli ugovor (ili Agnesinu izjavu o zelenom mastilu).",
 "case:hints.h_jory_dawn.levels.0": "Neko je u zoru bio u stakleniku, pre policije. Šta je video?",
 "case:hints.h_jory_dawn.levels.1": "Pronašao ju je Jory Trevenna.",
 "case:hints.h_jory_dawn.levels.2": "Ispitajte Joryja i pitajte ga kako ju je pronašao.",
 "case:hints.h_jory_pipe.levels.0": "Jory kaže da je u deset već bio u krevetu. Da li je?",
 "case:hints.h_jory_pipe.levels.1": "Neko je sinoć dugo stajao kod vrata ograđenog vrta i pušio.",
 "case:hints.h_jory_pipe.levels.2": "Na terasi i u vrtovima pregledajte vrata ograđenog vrta, a zatim Joryjevu izjavu „u deset sam već bio u krevetu“ osporite ostacima iz lule.",
 "case:hints.h_julian_alibi.levels.0": "Sada kada znate kada je umrla, ponovo razmotrite narednikovog osumnjičenog.",
 "case:hints.h_julian_alibi.levels.1": "Izjava gospođe Pascoe kaže gde je Julian bio od deset i petnaest do jedanaest i deset.",
 "case:hints.h_julian_alibi.levels.2": "Odgovorite „Ne — bio je u biblioteci s Kittowom dok je ona umirala“ uz izjavu gospođe Pascoe (ili gospodina Kittowa) i svoj zaključak o vremenu smrti.",
 "case:hints.h_julian_forgery.levels.0": "Julian se kune da je svoj posao pošteno održao na površini.",
 "case:hints.h_julian_forgery.levels.1": "Pisaći sto ledi Penhallow govori drugačije.",
 "case:hints.h_julian_forgery.levels.2": "Osporite Julianovu izjavu „pošteno održao na površini“ pismom firme Lorimer & Dane.",
 "case:hints.h_julian_lawn.levels.0": "Julian kaže da posle zvona nije izlazio iz salona. Policija misli drugačije.",
 "case:hints.h_julian_lawn.levels.1": "Ponovo pročitajte beleške narednika Polglasea ili pitajte Agnes Quill šta je videla sa svog prozora.",
 "case:hints.h_julian_lawn.levels.2": "Osporite Julianovu izjavu „nisam izlazio iz salona“ beleškama narednika Polglasea ili Agnesinom izjavom o travnjaku.",
 "case:hints.h_julian_money.levels.0": "Julian kaže da su mu poslovi u savršenom redu.",
 "case:hints.h_julian_money.levels.1": "Njegov smoking prebačen je preko fotelje u Plavoj sobi.",
 "case:hints.h_julian_money.levels.2": "Osporite Julianovu izjavu „u savršenom redu“ pismom banke Westminster Bank.",
 "case:hints.h_kittow.levels.0": "Gospodin Kittow kaže da je sve bilo isključivo profesionalno.",
 "case:hints.h_kittow.levels.1": "Ledi Penhallow je u bugačici čuvala jedno pismo.",
 "case:hints.h_kittow.levels.2": "Osporite izjavu gospodina Kittowa „isključivo profesionalan“ njegovim pismom iz njene bugačice.",
 "case:hints.h_marian.levels.0": "Doktorka Ellery kaže da je ovde zbog Kewa. Da li je to istina?",
 "case:hints.h_marian.levels.1": "U njenoj torbi je telegram koji je stigao s mnogo daljeg mesta.",
 "case:hints.h_marian.levels.2": "Osporite izjavu doktorke Ellery „u ime Kewa“ telegramom iz Miamija.",
 "case:hints.h_photo.levels.0": "Četvoro ljudi videlo ju je u 23.32. Da li je neko od njih zabeležio ono što je video?",
 "case:hints.h_photo.levels.1": "Doktorka Ellery imala je fotoaparat na terasi kada se oglasilo zvono.",
 "case:hints.h_photo.levels.2": "Pitajte doktorku Ellery šta je videla kada se oglasilo zvono, a zatim pogledajte svežu fotografiju u njenoj mračnoj komori.",
 "case:hints.h_scene.levels.0": "Mesto zločina je darežljivo prema onima koji pogledaju dvaput. Da li ste temeljno pregledali staklenik?",
 "case:hints.h_scene.levels.1": "Pogledajte s čega je navodno pala, čime se služila pri hodu i šta je pisala.",
 "case:hints.h_scene.levels.2": "U stakleniku pregledajte merdevine, štap od abonosa i stočić s dnevnikom.",
 "case:hints.h_scent.levels.0": "Miris mesečeve orhideje prianja uz svakoga ko joj je bio blizu.",
 "case:hints.h_scent.levels.1": "Doktorka Ellery taj miris poznaje bolje od ikoga. Ko je posle zvona ušao u salon?",
 "case:hints.h_scent.levels.2": "Pitajte doktorku Ellery da li je nešto primetila kada je Celia u 23.45 sišla.",
 "case:hints.h_sitting.levels.0": "Papiri same ledi Penhallow mogli bi vam reći šta je nameravala da preda svom advokatu.",
 "case:hints.h_sitting.levels.1": "Njena dnevna soba je zaključana. Ključ čuva njena družbenica.",
 "case:hints.h_sitting.levels.2": "Pitajte Agnes Quill da li možete da vidite sobe ledi Penhallow.",
 "case:hints.h_struck.levels.0": "Doktor Tresidder kaže da je pala s merdevina. Da li se staklenik slaže s njim?",
 "case:hints.h_struck.levels.1": "Uporedite ranu opisanu u narednikovim beleškama s njenim štapom. Zatim se zapitajte da li se iko popeo na te merdevine.",
 "case:hints.h_struck.levels.2": "Na tabli odgovorite „Ubijena udarcem srebrne jabuke sopstvenog štapa“ uz štap od abonosa i merdevine (ili gvozdenu stalažu).",
 "case:hints.h_timeline.levels.0": "Svi događaji te noći sada su u zapisniku. Možete li ih poređati?",
 "case:hints.h_timeline.levels.1": "Otvorite hronologiju u beležnici. Prvo postavite događaje čije vreme znate, a zatim zaključite gde je mesto ostalima.",
 "case:hints.h_timeline.levels.2": "Pravi redosled: zaključava se, Agnesin kakao, poslednji upis u dnevnik, Celia silazi, udarac, cvet se otvara, zvono, prilika iz kotlarnice, Celia u salonu, Julian na vratima, Jory u zoru.",
 "case:hints.h_tod.levels.0": "Ako je umrla pre nego što se cvet otvorio, kada se on otvorio?",
 "case:hints.h_tod.levels.1": "Njen poslednji upis daje vreme prvog mirisa — i koliko je, po Edmundovim rečima, cvetu potrebno da se otvori.",
 "case:hints.h_tod.levels.2": "Odgovorite „Između 22.25 i otprilike 23.05“ uz dnevnik cvetanja i svoj zaključak „Mrtva pre nego što se cvet otvorio“.",
 "case:hints.h_way_out.levels.0": "Vrata staklenika bila su zaključana iznutra. Kako je onda izašao onaj ko je zvonio?",
 "case:hints.h_way_out.levels.1": "Pitajte Joryja za vrata kotlarnice i ponovo pogledajte stepenice kotlarnice.",
 "case:hints.h_way_out.levels.2": "Odgovorite „Dole kroz kotlarnicu i napolje kroz njena spoljna vrata“ uz vrata kotlarnice (ili Joryjevu izjavu o njima) i otiske u koksnoj prašini (ili nagoreli ugovor).",
 "case:hints.h_who_absent.levels.0": "Četvoro ljudi gledalo je s terase kada se oglasilo zvono. Ko nije?",
 "case:hints.h_who_absent.levels.1": "Narednikove beleške kažu ko je propustio zvono. Pitajte je gde je bila, a zatim pogledajte kroz prozor njene spavaće sobe.",
 "case:hints.h_who_absent.levels.2": "Pitajte Celiju Penhallow gde je bila sinoć, pregledajte prozor u Plavoj sobi i njime osporite njenu izjavu „gledala sam Hester sa svog prozora“.",
 "case:locations.blue_room.art.props.0.label": "Prozor — sever",
 "case:locations.blue_room.art.props.1.label": "Toaletni sto",
 "case:locations.blue_room.art.props.2.label": "Krevet",
 "case:locations.blue_room.art.props.3.label": "Orman",
 "case:locations.blue_room.art.props.4.label": "Fotelja",
 "case:locations.blue_room.art.props.5.label": "Tepih",
 "case:locations.blue_room.description": "Najbolja gostinska soba na severnom pročelju, s izbledelim plavim tapetama. U krevetu se spavalo s obe strane. Julianova odeća prebačena je preko fotelje; Celijina je uredno sklonjena.",
 "case:locations.blue_room.hotspots.hs_br_bed.label": "Krevet",
 "case:locations.blue_room.hotspots.hs_br_bed.text": "Spavalo se s obe strane. Na Julianovoj strani je bočica tableta za spavanje: kako je rekao naredniku, popio je dve kada je u jedan došao u sobu i spavao kao zaklan sve do uzbune. Šta god da je njegova žena tokom noći radila, on to ne bi ni znao.",
 "case:locations.blue_room.hotspots.hs_br_chair.label": "Julianov smoking",
 "case:locations.blue_room.hotspots.hs_br_chair.text": "Julianov smoking prebačen je preko fotelje. U unutrašnjem džepu nešto šušti.",
 "case:locations.blue_room.hotspots.hs_br_dressing.label": "Toaletni sto",
 "case:locations.blue_room.hotspots.hs_br_dressing.text": "Među bočicama parfema stoji fotografija u srebrnom ramu: mlada glumica s krunom, u dugoj haljini. „Celia Lane kao ledi Magbet, Bristol Old Vic, 1954.“ Čak i na fotografiji privlači pogled.",
 "case:locations.blue_room.hotspots.hs_br_wardrobe.label": "Orman",
 "case:locations.blue_room.hotspots.hs_br_wardrobe.text": "Prilici kod zvona video se svetao rub ispod crnog šala, a izašla je kroz kotlarnicu. Otvarate orman.",
 "case:locations.blue_room.hotspots.hs_br_window.label": "Prozor",
 "case:locations.blue_room.hotspots.hs_br_window.text": "Razmičete zavesu i gledate napolje.",
 "case:locations.blue_room.name": "Plava soba",
 "case:locations.blue_room.summary": "Spavaća soba Juliana i Celije.",
 "case:locations.darkroom.art.props.0.label": "Zamračen prozor",
 "case:locations.darkroom.art.props.1.label": "Kamena sudopera",
 "case:locations.darkroom.art.props.2.label": "Radni sto",
 "case:locations.darkroom.art.props.3.label": "Zaštitna lampa",
 "case:locations.darkroom.art.props.4.label": "Uveličavač",
 "case:locations.darkroom.art.props.5.label": "Konopac za sušenje",
 "case:locations.darkroom.art.props.6.label": "Kredenac",
 "case:locations.darkroom.art.props.7.label": "Ka hodniku",
 "case:locations.darkroom.description": "Stara perionica uz zadnji hodnik, koju je doktorka Ellery zamračila i napunila hemikalijama. Miriše na sirće i fiksir. Iznad sudopere još svetli crvena zaštitna lampa.",
 "case:locations.darkroom.hotspots.hs_dr_line.label": "Fotografije na konopcu",
 "case:locations.darkroom.hotspots.hs_dr_line.text": "Na konopcu za sušenje, prikačene drvenim štipaljkama, vise fotografije: pupoljak orhideje, staklenik na dnevnom svetlu — i jedna same ledi Penhallow.",
 "case:locations.darkroom.hotspots.hs_dr_newprint.label": "Sveža fotografija",
 "case:locations.darkroom.hotspots.hs_dr_newprint.text": "Na kraju konopca, još vlažna i uvijena: fotografija koju je doktorka Ellery jutros izradila od jedinog snimka, napravljenog kada se oglasilo zvono.",
 "case:locations.darkroom.hotspots.hs_dr_safelight.label": "Zaštitna lampa",
 "case:locations.darkroom.hotspots.hs_dr_safelight.text": "Crvena lampa iznad sudopere. Dok gori, vrata moraju da ostanu zatvorena, inače je ceo noćni rad upropašćen. Savršeno mesto za samoću — i niko ne može da vidi da ste unutra.",
 "case:locations.darkroom.hotspots.hs_dr_satchel.label": "Torba doktorke Ellery",
 "case:locations.darkroom.hotspots.hs_dr_satchel.text": "Na kuki pored kredenca visi platnena torba: sveske, svetlomer, rezervni film. I telegram, presavijen u sitan četvorougao.",
 "case:locations.darkroom.hotspots.hs_dr_trays.label": "Kadice za razvijanje",
 "case:locations.darkroom.hotspots.hs_dr_trays.text": "Tri emajlirane kadice i sveska ispisana urednim rukopisom: „22.05 — negativi pupoljka u tanku. 22.40 — prve kopije. 22.50 — gđa P. na vratima!! 23.10 — isprano; na terasu.“ Fotografije s tih negativa vise na konopcu, s datumom i rednim brojem.",
 "case:locations.darkroom.name": "Mračna komora",
 "case:locations.darkroom.summary": "Mračna komora doktorke Ellery, u staroj perionici.",
 "case:locations.gardens.art.props.0.label": "Kuća — južno pročelje",
 "case:locations.gardens.art.props.1.label": "Salon",
 "case:locations.gardens.art.props.2.label": "Vrata perionice",
 "case:locations.gardens.art.props.3.label": "Terasa",
 "case:locations.gardens.art.props.4.label": "Travnjak",
 "case:locations.gardens.art.props.5.label": "Sunčani sat",
 "case:locations.gardens.art.props.6.label": "Tisova živica",
 "case:locations.gardens.art.props.7.label": "Aleja ruža",
 "case:locations.gardens.art.props.8.label": "Staklenik",
 "case:locations.gardens.art.props.9.label": "Ograđeni vrt",
 "case:locations.gardens.description": "Terasa se proteže celom dužinom južnog pročelja. Ispod nje travnjak se četrdeset jardi spušta do staklenika. Na istoku su ograđeni vrt i aleja ruža iza visoke tisove živice. Trava je još siva od rose.",
 "case:locations.gardens.hotspots.hs_gd_garden_door.label": "Vrata perionice",
 "case:locations.gardens.hotspots.hs_gd_garden_door.text": "Obična vrata na istočnom kraju kuće, koja vode u hodnik stare perionice — sporedno stepenište, mračna komora, prolaz za poslugu. Kroz njih je svako mogao da uđe i izađe a da ga ne vide ni iz salona ni s terase.",
 "case:locations.gardens.hotspots.hs_gd_rose.label": "Aleja ruža",
 "case:locations.gardens.hotspots.hs_gd_rose.text": "Travnata staza između starih ruža, iza tisove živice visoke deset stopa i guste kao zid. Odavde se ne vidi čak ni krov staklenika, mada bi se njegovo zvono sasvim dobro čulo. Prijatno mesto za šetnju u toploj noći — i niko vas tu ne bi video.",
 "case:locations.gardens.hotspots.hs_gd_stokehole.label": "Vrata kotlarnice",
 "case:locations.gardens.hotspots.hs_gd_stokehole.text": "Ispod istočnog kraja staklenika kratko stepenište od opeke spušta se do vrata kotlarnice. Čvrsta hrastovina, bez ključaonice i bez kvake s ove strane. Kada se iznutra zatvore rezom, ne može se ući. Kada je reza otvorena, svako može da izađe.",
 "case:locations.gardens.hotspots.hs_gd_tripod.label": "Tragovi stativa",
 "case:locations.gardens.hotspots.hs_gd_tripod.text": "Tri mala udubljenja u šljunku na ivici terase, gde je stajao stativ doktorke Ellery. Odavde su njih četvoro gledali kada se oglasilo zvono.",
 "case:locations.gardens.hotspots.hs_gd_view.label": "Pogled niz travnjak",
 "case:locations.gardens.hotspots.hs_gd_view.text": "S terase do staklenika ima četrdeset jardi, niz padinu travnjaka. Čak je i jutros staklo zamagljeno od toplote iznutra. Sinoć, s upaljenom lampom, mora da je svetleo kao fenjer.",
 "case:locations.gardens.hotspots.hs_gd_wall_door.label": "Vrata ograđenog vrta",
 "case:locations.gardens.hotspots.hs_gd_wall_door.text": "Vrata u zidu povrtnjaka, pored istočnog kraja staklenika. Na stepeniku je nešto istreseno i zgaženo.",
 "case:locations.gardens.name": "Terasa i vrtovi",
 "case:locations.gardens.summary": "Odavde su ukućani iščekivali zvono.",
 "case:locations.glasshouse.art.props.0.label": "Stakleni zid",
 "case:locations.glasshouse.art.props.1.label": "Stakleni zid",
 "case:locations.glasshouse.art.props.10.label": "Stepenice kotlarnice",
 "case:locations.glasshouse.art.props.11.label": "Rezervoar za kišnicu",
 "case:locations.glasshouse.art.props.12.label": "Vrata ka travnjaku",
 "case:locations.glasshouse.art.props.2.label": "Stakleni zid",
 "case:locations.glasshouse.art.props.3.label": "Cevi za grejanje",
 "case:locations.glasshouse.art.props.4.label": "Stalaža",
 "case:locations.glasshouse.art.props.5.label": "Drvolika paprat",
 "case:locations.glasshouse.art.props.6.label": "Stalaža",
 "case:locations.glasshouse.art.props.7.label": "Nosač lampe",
 "case:locations.glasshouse.art.props.8.label": "Stalaža za orhideje",
 "case:locations.glasshouse.art.props.9.label": "Stočić s dnevnikom",
 "case:locations.glasshouse.description": "Veliki staklenik ser Edmunda u dnu travnjaka, sagrađen 1912. za biljke koje je slao kući. Kotao ga održava toplim kao noć u džungli. Narednik Polglase dao je da se telo odnese u St Austell. Vazduh još miriše na karanfilić i ljiljan.",
 "case:locations.glasshouse.hotspots.hs_gh_ashpan.label": "Posuda za pepeo ispod kotla",
 "case:locations.glasshouse.hotspots.hs_gh_ashpan.text": "Neko je nešto spalio u Joryjevom kotlu. Izvlačite posudu za pepeo ispod rešetke ložišta i prosejavate pepeo baštenskom lopaticom.",
 "case:locations.glasshouse.hotspots.hs_gh_bell.label": "Ručka zvona",
 "case:locations.glasshouse.hotspots.hs_gh_bell.text": "Pored vrata, ručka zvona na mesinganom lancu vodi gore do brodskog zvona na slemenu krova. Jedno povlačenje — i čuje se u celom vrtu. Svako ko stoji unutra mogao bi da zazvoni.",
 "case:locations.glasshouse.hotspots.hs_gh_door.label": "Staklena vrata",
 "case:locations.glasshouse.hotspots.hs_gh_door.text": "Vrata ka travnjaku zaključavaju se iznutra. U zoru je ključ bio u bravi, s unutrašnje strane, a vrata su bila zaključana. Jory ga je sam okrenuo da bi otrčao po pomoć. Ko god da je sinoć otišao odavde, nije izašao ovuda.",
 "case:locations.glasshouse.hotspots.hs_gh_flask.label": "Termos s kakaom",
 "case:locations.glasshouse.hotspots.hs_gh_flask.text": "Termos s kakaom Agnes Quill; jedna šolja je nasuta i popijena. Ostatak se ohladio i uhvatio skramu. U njemu nema ničeg osim kakaa i previše šećera, kaže narednik. Probao ga je.",
 "case:locations.glasshouse.hotspots.hs_gh_ladder.label": "Merdevine",
 "case:locations.glasshouse.hotspots.hs_gh_ladder.text": "Drvene merdevine leže na boku preko pločica, onako kako ih je narednik zatekao.",
 "case:locations.glasshouse.hotspots.hs_gh_lamp.label": "Lampa",
 "case:locations.glasshouse.hotspots.hs_gh_lamp.text": "Petrolejska lampa visi o svom gvozdenom nosaču iznad stalaže za orhideje, plamena smanjenog na plavo zrnce. Jory ju je napunio juče po podne; u njoj ima dovoljno petroleja za još jednu noć.",
 "case:locations.glasshouse.hotspots.hs_gh_log.label": "Stočić s dnevnikom",
 "case:locations.glasshouse.hotspots.hs_gh_log.text": "Mali sto od bambusa na kraju staze, a na njemu knjiga s tvrdim koricama, nalivpero, četkica od samurove dlake i bočica zelenog mastila.",
 "case:locations.glasshouse.hotspots.hs_gh_orchid.label": "Mesečeva orhideja",
 "case:locations.glasshouse.hotspots.hs_gh_orchid.text": "Na počasnom mestu na stalaži, u korpi od tikovih letvica: mesečeva orhideja. Jedan jedini cvet — i već je precvetao.",
 "case:locations.glasshouse.hotspots.hs_gh_outline.label": "Obris kredom",
 "case:locations.glasshouse.hotspots.hs_gh_outline.text": "Obris koji je narednik Polglase iscrtao kredom u podnožju stalaže za orhideje. Ležala je na boku, s velom preko kose i šalom oko ramena, kaže Jory, uredna kao da je sela na pločice da se odmori.",
 "case:locations.glasshouse.hotspots.hs_gh_prints.label": "Koksna prašina na stepenicama",
 "case:locations.glasshouse.hotspots.hs_gh_prints.text": "Neko prerušen u ledi Penhallow izašao je iz ovog staklenika i ostavio ga zaključanog za sobom. Vraćate se s baterijskom lampom do stepenica kotlarnice i ponovo, pažljivije, gledate.",
 "case:locations.glasshouse.hotspots.hs_gh_staging.label": "Ivica stalaže",
 "case:locations.glasshouse.hotspots.hs_gh_staging.text": "Gvozdena ivica stalaže za orhideje, u visini glave jedne starice — ako je pala s trećeg stepenika.",
 "case:locations.glasshouse.hotspots.hs_gh_stick.label": "Štap od abonosa",
 "case:locations.glasshouse.hotspots.hs_gh_stick.text": "Ispod stalaže, među mahovinom i otpalim etiketama, leži štap sa srebrnom jabukom.",
 "case:locations.glasshouse.hotspots.hs_gh_stokehole.label": "Stepenice kotlarnice",
 "case:locations.glasshouse.hotspots.hs_gh_stokehole.text": "Na istočnom kraju gvozdene stepenice vode dole, u mrak. Kotlarnica: kotao, gomila koksa i čvrsta vrata koja vode napolje, u podnožje zida ograđenog vrta.",
 "case:locations.glasshouse.name": "Staklenik",
 "case:locations.glasshouse.summary": "Ovde je ledi Penhallow bdela — i umrla.",
 "case:locations.library.art.props.0.label": "Police s knjigama",
 "case:locations.library.art.props.1.label": "Ser Edmund",
 "case:locations.library.art.props.2.label": "Kamin",
 "case:locations.library.art.props.3.label": "Fotelja",
 "case:locations.library.art.props.4.label": "Fotelja",
 "case:locations.library.art.props.5.label": "Pisaći sto",
 "case:locations.library.art.props.6.label": "Tepih",
 "case:locations.library.art.props.7.label": "Stočić s pićem",
 "case:locations.library.art.props.8.label": "Prozor",
 "case:locations.library.description": "Biblioteka ser Edmunda: dnevnici s botaničkih ekspedicija, botaničke table i četrdeset godišta časopisa Kew Bulletin. Od sinoć niko nije pospremao. Na stočiću s pićem još stoje dve čaše, a u sobi se oseća dim cigara.",
 "case:locations.library.hotspots.hs_lb_briefcase.label": "Aktovka gospodina Kittowa",
 "case:locations.library.hotspots.hs_lb_briefcase.text": "Pored pisaćeg stola stoji otključana aktovka od svinjske kože s utisnutim inicijalima „E.K.“ Gospodin Kittow vam je rekao da slobodno pogledate.",
 "case:locations.library.hotspots.hs_lb_glasses.label": "Dve čaše",
 "case:locations.library.hotspots.hs_lb_glasses.text": "Dve čaše za viski i poslužavnik gospođe Pascoe. Pepeljara puna do vrha: ostaci cigara i opušci mnogih cigareta. Kittow puši cigare; Julian pali cigaretu za cigaretom. Ovde su proveli dugo vremena.",
 "case:locations.library.hotspots.hs_lb_portrait.label": "Portret ser Edmunda",
 "case:locations.library.hotspots.hs_lb_portrait.text": "Ser Edmund Penhallow 1938. godine, naslikan u safari-jakni, s botaničkom kutijom preko ramena, kako se smeje nečemu tik izvan rama. Ispod portreta, zelenim mastilom na kartici: „Nestao, Šanska brda, mart 1943. Uvek se vraćao kući.“",
 "case:locations.library.hotspots.hs_lb_window.label": "Prozor",
 "case:locations.library.hotspots.hs_lb_window.text": "Biblioteka gleda na istok, na dvorište sa štalama. Odavde se ne vide ni staklenik, ni terasa, ni travnjak. Ko god da je sinoć sedeo u ovoj sobi, nije video ništa od vrta dok nije izašao na terasu.",
 "case:locations.library.name": "Biblioteka",
 "case:locations.library.summary": "Ovde su se Julian i gospodin Kittow raspravljali oko testamenta.",
 "case:locations.sitting_room.art.props.0.label": "Prozor prema travnjaku",
 "case:locations.sitting_room.art.props.1.label": "Pisaći sto",
 "case:locations.sitting_room.art.props.2.label": "Stolica",
 "case:locations.sitting_room.art.props.3.label": "Ormar s herbarijumom",
 "case:locations.sitting_room.art.props.4.label": "Kamin",
 "case:locations.sitting_room.art.props.5.label": "Tepih",
 "case:locations.sitting_room.art.props.6.label": "Sofa",
 "case:locations.sitting_room.description": "Mala, svetla soba na južnom pročelju, u kojoj je Hester pisala pisma i bavila se botanikom. Na svakom zidu su uramljeni presovani primerci biljaka. S prozora je mogla da gleda svoj staklenik u dnu travnjaka.",
 "case:locations.sitting_room.hotspots.hs_sr_blotter.label": "Bugačica",
 "case:locations.sitting_room.hotspots.hs_sr_blotter.text": "Bugačica u zelenom kožnom povezu. U koricama, presavijeno tamo gde bi ga ona našla, a niko drugi ne bi, nalazi se pismo.",
 "case:locations.sitting_room.hotspots.hs_sr_cabinet.label": "Ormar s herbarijumom",
 "case:locations.sitting_room.hotspots.hs_sr_cabinet.text": "Edmundovi presovani primerci u fiokama od mahagonija, svaki obeležen dvaput — njegovim smeđim mastilom i njenim zelenim. U donjoj fioci je jedan jedini požuteli telegram: „S ŽALJENJEM VAS OBAVEŠTAVAMO SER EDMUND PENHALLOW NESTAO VEROVATNO POGINUO.“",
 "case:locations.sitting_room.hotspots.hs_sr_desk.label": "Pisaći sto",
 "case:locations.sitting_room.hotspots.hs_sr_desk.text": "Njena pisma, odgovorena i neodgovorena, u dve uredne gomile. Jedno leži odvojeno od ostalih, ispod pritiskača za papir u obliku puža.",
 "case:locations.sitting_room.hotspots.hs_sr_diary.label": "Rokovnik",
 "case:locations.sitting_room.hotspots.hs_sr_diary.text": "Njen rokovnik otvoren je na ovoj nedelji, sve zelenim mastilom: „Pet 26 — 18.00, Celia. CVETANJE!“ i „Sub 27 — 10.00, Edwin. Testament.“ Ispod petka, sitnijim rukopisom: „Oprosti mu ako dođe.“",
 "case:locations.sitting_room.hotspots.hs_sr_ink.label": "Mastionica",
 "case:locations.sitting_room.hotspots.hs_sr_ink.text": "Srebrna mastionica s dve posudice. Obe su napunjene zelenim mastilom. U sobi nema bočice mastila nijedne druge boje, a ni pera s crnim mastilom.",
 "case:locations.sitting_room.hotspots.hs_sr_window.label": "Prozor",
 "case:locations.sitting_room.hotspots.hs_sr_window.text": "Odavde se pogled pruža pravo niz travnjak, do staklenika. Južni prozor, kao i onaj gospođice Quill u susednoj sobi. S ove strane kuće zvono, lampa i beli cvet bili bi kao na dlanu.",
 "case:locations.sitting_room.lockedHint": "Zaključano. Ključ je kod Agnes Quill.",
 "case:locations.sitting_room.name": "Dnevna soba ledi Penhallow",
 "case:locations.sitting_room.summary": "Njena privatna soba iznad terase.",
 "case:setting": "Penhallow House · Cornwall · jul 1963.",
 "case:sketchCredit": "SKICA: NAR. W. POLGLASE · NIJE U RAZMERI",
 "case:sketchTitle": "PENHALLOW HO.",
 "case:stayLabel": "Ostani u kući Penhallow",
 "case:tagline": "Botaničarka, testament i orhideja koja cveta samo noću.",
 "case:timeline.conclusion": "Ledi Penhallow je u 22.25 bila živa, a pre nego što se njena orhideja otvorila, oko 23.05, već je bila mrtva. Zna se da je u tom razmaku samo jedna osoba bila s njom: Celia, koja je sišla u dvadeset do jedanaest i izašla kroz kotlarnicu nekoliko minuta posle zvona.",
 "case:timeline.events.tl_bell.text": "Oglašava se zvono, a „udovica“ podiže lampu prema terasi",
 "case:timeline.events.tl_bell.time": "23.32",
 "case:timeline.events.tl_bloom.teaser": "Šta je bilo s cvetom.",
 "case:timeline.events.tl_bloom.text": "Mesečeva orhideja se otvara — i niko je ne oprašuje",
 "case:timeline.events.tl_celia_goes.teaser": "Neko je između pola jedanaest i jedanaest otišao u staklenik — i o tome ćuti.",
 "case:timeline.events.tl_celia_goes.text": "Celia potajno silazi do staklenika",
 "case:timeline.events.tl_cocoa.teaser": "Neko ju je video živu pošto se zaključala.",
 "case:timeline.events.tl_cocoa.text": "Agnes donosi kakao — ledi Penhallow je živa i zdrava",
 "case:timeline.events.tl_cocoa.time": "22.15",
 "case:timeline.events.tl_drawing_room.text": "Celia silazi u salon u kućnom ogrtaču",
 "case:timeline.events.tl_drawing_room.time": "23.45",
 "case:timeline.events.tl_found.teaser": "Šta je baštovan uradio u zoru.",
 "case:timeline.events.tl_found.text": "Jory pronalazi telo — i oprašuje orhideju",
 "case:timeline.events.tl_found.time": "05.45",
 "case:timeline.events.tl_julian.teaser": "Neko je posle ponoći sišao do staklenika.",
 "case:timeline.events.tl_julian.text": "Julian zatiče staklenik zaključan, a lampu prigušenu",
 "case:timeline.events.tl_julian.time": "00.15",
 "case:timeline.events.tl_last_entry.teaser": "Poslednje što se zna da je uradila.",
 "case:timeline.events.tl_last_entry.text": "Ledi Penhallow upisuje poslednju belešku u dnevnik cvetanja",
 "case:timeline.events.tl_last_entry.time": "22.25",
 "case:timeline.events.tl_lock.text": "Ledi Penhallow se zaključava sa svojom orhidejom",
 "case:timeline.events.tl_lock.time": "21.30",
 "case:timeline.events.tl_stokehole.teaser": "Neko u vrtu video je više nego što je rekao.",
 "case:timeline.events.tl_stokehole.text": "Bleda prilika iskrada se iz kotlarnice",
 "case:timeline.events.tl_struck.teaser": "Kako je zaista umrla.",
 "case:timeline.events.tl_struck.text": "Ledi Penhallow pada pod udarcem sopstvenog štapa",
 "case:timeline.prompt": "Poređajte događaje od petka uveče onim redom kojim su se zaista odigrali. Vremena koja se pouzdano znaju su prikazana; za ostale zaključite gde im je mesto.",
 "case:timeline.title": "Rekonstrukcija noći cvetanja",
 "case:title": "Udovica iz staklenika",
 "deductions:contradictions.c_celia_alive.insight": "Hester je svakih četvrt sata beležila stanje svoje orhideje, a posle 22.25 nije zapisala ništa. Ko god da je izašao kroz kotlarnicu, izašao je nekoliko minuta posle zvona, a ne u deset do jedanaest. Celia za sobom nije ostavila živu ženu.",
 "deductions:contradictions.c_celia_alive.response.0": "Onda je… mora da je prestala da piše. Bila je umorna. Stare žene se, znate, umore.",
 "deductions:contradictions.c_celia_alive.response.1": "Ruke su joj se u krilu pronašle i čvrsto se drže jedna za drugu. Hester Penhallow je, po svemu što se o njoj zna, dvadeset pet godina čekala da napiše sledeći red.",
 "deductions:contradictions.c_celia_alive.title": "Hester je bila mrtva pre nego što je Celia otišla",
 "deductions:contradictions.c_celia_bed.insight": "Plava soba gleda na sever, na prilazni put. Celia nije gledala Hester sa svog prozora. Nije bila u krevetu kada se oglasilo zvono.",
 "deductions:contradictions.c_celia_bed.response.0": "…Možda sam se zbunila. Imala sam migrenu.",
 "deductions:contradictions.c_celia_bed.response.1": "Dobro. Nisam bila u krevetu. Nisam mogla mirno da ležim, pa sam obukla kućni ogrtač i iskrala se u vrt — u aleju ruža, da udahnem vazduha. Bila sam tamo kada sam čula zvono, a onda sam ušla.",
 "deductions:contradictions.c_celia_bed.response.2": "Nisam to rekla jer bi Julian digao paniku. To je sve.",
 "deductions:contradictions.c_celia_bed.title": "Celia nije mogla da vidi staklenik",
 "deductions:contradictions.c_celia_knew.insight": "Hester je Celiji rekla za Julianov falsifikat u petak u šest sati. Ujutru je dokaz trebalo da ode gospodinu Kittowu, a od njega u policiju.",
 "deductions:contradictions.c_celia_knew.response.0": "…Zapisala je to? Naravno da jeste. Sve je zapisivala.",
 "deductions:contradictions.c_celia_knew.response.1": "Da. Pozvala me je u šest i pokazala mi pismo. Rekla je da Julian ima ovu noć da dođe k njoj i prizna, a da će ujutru sve otići gospodinu Kittowu. A onda u policiju.",
 "deductions:contradictions.c_celia_knew.response.2": "Julianu nisam ništa rekla. Mislila sam da ću je sama ubediti. Uvek sam umela da ubedim ljude. Svakoga osim Hester.",
 "deductions:contradictions.c_celia_knew.title": "Celia je znala za falsifikat",
 "deductions:contradictions.c_celia_rose_walk.insight": "Celia nije šetala među ružama. Te noći bila je u stakleniku i izašla je kroz kotlarnicu. Sada priznaje da je u dvadeset do jedanaest otišla kod Hester i kune se da ju je ostavila živu.",
 "deductions:contradictions.c_celia_rose_walk.response.0": "…",
 "deductions:contradictions.c_celia_rose_walk.response.1": "Dobro. Da. U dvadeset do jedanaest sišla sam do staklenika i ona me je pustila unutra. Preklinjala sam je da ne potpiše taj testament — da razmisli šta će to učiniti Julianu. Nije htela da sluša. Nikada me nije slušala.",
 "deductions:contradictions.c_celia_rose_walk.response.2": "Otišla sam u deset do jedanaest, kroz kotlarnicu, da me niko ne bi video kako prelazim travnjak. Bila je živa. Sedela je i pisala u onaj svoj dnevnik, mirna kao da se ništa ne događa.",
 "deductions:contradictions.c_celia_rose_walk.title": "Celia je bila u stakleniku",
 "deductions:contradictions.c_jory_bed.insight": "Jory nije bio u krevetu. Pola noći stajao je kod vrata ograđenog vrta, gledao u staklenik i video kako neko posle zvona izlazi kroz kotlarnicu.",
 "deductions:contradictions.c_jory_bed.response.0": "…To je moje. Ne mogu reć’ da nije.",
 "deductions:contradictions.c_jory_bed.response.1": "Nisam mog’o da spavam, ne dok joj se cvet otvara. Stajao sam kod vrata od ograđenog vrta još od pre jedanaest, pušio i gledao u staklo. Čuo sam zvono, video kako se lampa diže i spušta. Milostiva je rekla da se niko ne približava, pa sam ćut’o.",
 "deductions:contradictions.c_jory_bed.response.2": "A koji minut posle, nešto je izašlo iz kotlarnice — dugačko i bledo, ko spavaćica — i požurilo uz zid, ka kući. Pomislio sam da je to duh milostive, Bog da mi oprosti. Da sam to rek’o, celo bi mi se selo smejalo.",
 "deductions:contradictions.c_jory_bed.title": "Jory je posmatrao staklenik",
 "deductions:contradictions.c_julian_drawing_room.insight": "Julian je lagao: u dvanaest i petnaest iskrao se do staklenika. Kaže da su vrata bila zaključana, lampa prigušena, a da mu se strina nije javila.",
 "deductions:contradictions.c_julian_drawing_room.response.0": "…Ma, za ime Boga. Da. Dobro.",
 "deductions:contradictions.c_julian_drawing_room.response.1": "U dvanaest i petnaest izašao sam malo na vazduh, a noge su me same odnele niz travnjak. Hteo sam još jednom da pokušam s njom pre nego što Kittow izvadi pero. Vrata su bila zaključana, a lampa skroz prigušena. Kucao sam, zvao je, a ona se nije javila.",
 "deductions:contradictions.c_julian_drawing_room.response.2": "Nisam to rekao jer sam tačno znao kako će izgledati. A i izgleda baš tako, zar ne?",
 "deductions:contradictions.c_julian_drawing_room.title": "Julian je sišao do staklenika",
 "deductions:contradictions.c_julian_forgery.insight": "U maju je Julian falsifikovao strinin potpis da bi uz hipoteku na imanje Home Farm pozajmio £20.000. To je ono „nešto kriminalno“ iz njenog pisma.",
 "deductions:contradictions.c_julian_forgery.response.0": "…Odakle vam to?",
 "deductions:contradictions.c_julian_forgery.response.1": "Penhallow Motors izdiše već dve godine. Do maja mi je trebalo dvadeset hiljada, inače bi banka uzela sve. Imanje Home Farm bi ionako jednog dana pripalo meni — govorio sam sebi da je to zajam na račun mog sopstvenog nasledstva. Nedelju dana sam vežbao njen potpis.",
 "deductions:contradictions.c_julian_forgery.response.2": "Da. Falsifikovao sam ga. Ali nisam je zbog toga ubio. Nisam ni znao da je otkrila — meni nije rekla ni reč.",
 "deductions:contradictions.c_julian_forgery.title": "Julian je falsifikovao hipoteku",
 "deductions:contradictions.c_julian_money.insight": "Julianov posao propada: banka preti sudskim postupkom ako ne plati do kraja meseca. On se kune da je firmu pošteno održao na površini.",
 "deductions:contradictions.c_julian_money.response.0": "…To je moja privatna prepiska. Ma, kakve to sad ima veze.",
 "deductions:contradictions.c_julian_money.response.1": "Dobro. Penhallow Motors je na kolenima. U Plymouthu niko neće novog Zephyra kad ne može da otplati ni starog, a banka do kraja meseca traži šest hiljada.",
 "deductions:contradictions.c_julian_money.response.2": "Ali pošteno sam ga održao na površini, manje-više. Nikada nisam uradio ništa kriminalno, ako na to mislite.",
 "deductions:contradictions.c_julian_money.title": "Julian je pred propašću",
 "deductions:contradictions.c_kittow_professional.insight": "Edwin Kittow i Hester Penhallow bili su tajno vereni. A o zločinu u porodici rekla mu je više nego što je on hteo da prizna.",
 "deductions:contradictions.c_kittow_professional.response.0": "…Ah. Čuvala ga je u bugačici. Kako je to na nju ličilo.",
 "deductions:contradictions.c_kittow_professional.response.1": "Da. Zaprosio sam je 1946, pa 1950, i ponovo ovog proleća. Ovog proleća je pristala. Septembar, u crkvi Svetog Mewana. Nameravali smo da kažemo porodici čim testament bude potpisan.",
 "deductions:contradictions.c_kittow_professional.response.2": "Postoji još nešto što treba da znate. U petak po podne rekla mi je da ima dokaz o zločinu u porodici i da će mi ga dati jutros. Rekla je da će u šest reći „njegovoj ženi“, kako bi on imao pristojnosti da najpre dođe k njoj i prizna. Nije pomenula njegovo ime. Nije ni bilo potrebno.",
 "deductions:contradictions.c_kittow_professional.title": "Kittow je trebalo da se oženi njome",
 "deductions:contradictions.c_marian_kew.insight": "Marian Ellery više nije u Kewu. U Penhallow je došla za račun firme Lindqvist Orchids iz Miamija, koja seme mesečeve orhideje želi „po svaku cenu“.",
 "deductions:contradictions.c_marian_kew.response.0": "…Prekopali ste mi torbu. Pa dobro. I ja bih tako postupila.",
 "deductions:contradictions.c_marian_kew.response.1": "Kew me je otpustio prošlog oktobra. Objavila sam neke Hesterine rezultate pod svojim imenom, a ona je pisala direktoru. Onda mi je oprostila, što je bilo još gore, i ipak me pozvala ovamo: rekla je da Edmundov cvet zaslužuje da bude valjano zabeležen. Sada mi stanarinu plaća Lindqvist. Hteo je da mu obezbedim seme.",
 "deductions:contradictions.c_marian_kew.response.2": "„Po svaku cenu“ — tako Amerikanci pišu telegrame. To ne znači ubistvo. I shvatite jedno: da sam je ja ubila, taj cvet bi do jedanaest sati bio oprašen. Da ga pustim da se zatvori netaknut — to bih mogla koliko i da ga spalim.",
 "deductions:contradictions.c_marian_kew.title": "Doktorka Ellery radi za jedan američki rasadnik",
 "deductions:deductions.d_bell_ringer.conclusion": "Prilika kod zvona bila je za glavu viša od Hester, kretala se bez štapa bez kojeg ona nije mogla da napravi ni korak, a ispod crnine joj se video svetao rub. Ko god da je zvonio, nosio je njen veo i šal, posle ih je vratio na njeno telo i hteo je da cela kuća poveruje da je Hester u 23.32 bila živa. Četvoro ljudi gledalo je s terase. Ko nije bio tamo?",
 "deductions:deductions.d_bell_ringer.options.0": "Samu ledi Penhallow",
 "deductions:deductions.d_bell_ringer.options.1": "Nekoga u njenom velu i šalu",
 "deductions:deductions.d_bell_ringer.options.2": "Joryja Trevennu, u obilasku",
 "deductions:deductions.d_bell_ringer.options.3": "Nikoga — samo varku svetlosti lampe na zamagljenom staklu",
 "deductions:deductions.d_bell_ringer.proofLabels.0": "Prilika kod zvona",
 "deductions:deductions.d_bell_ringer.proofLabels.1": "Zašto to nije mogla biti Hester",
 "deductions:deductions.d_bell_ringer.question": "Koga su ukućani videli u stakleniku u 23.32?",
 "deductions:deductions.d_bell_ringer.title": "Lažna udovica kod zvona",
 "deductions:deductions.d_dead_before_bloom.conclusion": "U zoru je mesečeva orhideja još bila otvorena i netaknuta. Hester je nameravala da je opraši čim se otvori, i na to je čekala dvadeset pet godina. Bila je mrtva pre nego što se cvet otvorio.",
 "deductions:deductions.d_dead_before_bloom.options.0": "Da — oprašila ju je, kako je i planirala",
 "deductions:deductions.d_dead_before_bloom.options.1": "Da — u 23.32 četvoro ljudi videlo ju je pored cveta",
 "deductions:deductions.d_dead_before_bloom.options.2": "Ne — nikada je ne bi ostavila neoprašenu",
 "deductions:deductions.d_dead_before_bloom.proofLabels.0": "Cvet u zoru",
 "deductions:deductions.d_dead_before_bloom.proofLabels.1": "Šta je nameravala čim se otvori",
 "deductions:deductions.d_dead_before_bloom.question": "Da li je ledi Penhallow bila živa kada se njena orhideja otvorila?",
 "deductions:deductions.d_dead_before_bloom.title": "Mrtva pre nego što se cvet otvorio",
 "deductions:deductions.d_forgery.conclusion": "Hipoteka na imanje Home Farm potpisana je imenom „Hester Penhallow“, crnim mastilom, iako ona nije pisala ničim osim zelenim. Celiji je to rekla u šest sati. Ujutru je ugovor trebalo da ode Kittowu i policiji, a te noći neko ga je spalio u kotlarnici.",
 "deductions:deductions.d_forgery.options.0": "Samo novi testament, kojim razbaštinjuje Juliana",
 "deductions:deductions.d_forgery.options.1": "Dokaz da je Julian falsifikovao njen potpis na hipoteci od £20.000",
 "deductions:deductions.d_forgery.options.2": "Dokaz da je doktorka Ellery prodavala orhideju u Ameriku",
 "deductions:deductions.d_forgery.options.3": "Obaveštenje o svojoj veridbi s gospodinom Kittowom",
 "deductions:deductions.d_forgery.proofLabels.0": "Šta je otkrila",
 "deductions:deductions.d_forgery.proofLabels.1": "Dokaz da je potpis falsifikovan",
 "deductions:deductions.d_forgery.question": "Šta je ledi Penhallow nameravala da u subotu ujutru preda svom advokatu?",
 "deductions:deductions.d_forgery.title": "Julian je falsifikovao njen potpis",
 "deductions:deductions.d_julian_alibi.conclusion": "Gospođa Pascoe slušala je kako se Julian i Kittow svađaju u biblioteci od deset i petnaest do jedanaest i deset. Hester je umrla u tom razmaku. Kada je Julian u 00.15 pokucao na vrata staklenika, bila je mrtva već više od sat vremena.",
 "deductions:deductions.d_julian_alibi.options.0": "Da — u 00.15 bio je kod staklenika",
 "deductions:deductions.d_julian_alibi.options.1": "Da — iskrao se iz biblioteke",
 "deductions:deductions.d_julian_alibi.options.2": "Ne — bio je u biblioteci s Kittowom dok je ona umirala",
 "deductions:deductions.d_julian_alibi.proofLabels.0": "Gde je bio Julian",
 "deductions:deductions.d_julian_alibi.proofLabels.1": "Kada je umrla",
 "deductions:deductions.d_julian_alibi.question": "Da li je Julian mogao da ubije strinu?",
 "deductions:deductions.d_julian_alibi.title": "Julian to nije uradio",
 "deductions:deductions.d_struck.conclusion": "Niko se nije penjao na merdevine, a stalaža je čista. Okrugla rana je veličine srebrne jabuke njenog štapa, koji je neko obrisao i gurnuo pod stalažu. Pad je bio insceniran.",
 "deductions:deductions.d_struck.options.0": "Pala je s merdevina i udarila o gvozdenu stalažu",
 "deductions:deductions.d_struck.options.1": "Ubijena udarcem srebrne jabuke sopstvenog štapa",
 "deductions:deductions.d_struck.options.2": "Srce joj je otkazalo od uzbuđenja",
 "deductions:deductions.d_struck.options.3": "Otrovana kakaom koji joj je Agnes donela",
 "deductions:deductions.d_struck.proofLabels.0": "Oružje",
 "deductions:deductions.d_struck.proofLabels.1": "Zašto to nije bio pad",
 "deductions:deductions.d_struck.question": "Kako je ledi Penhallow umrla?",
 "deductions:deductions.d_struck.title": "Ubijena sopstvenim štapom",
 "deductions:deductions.d_time_of_death.conclusion": "Poslednji upis unela je u 22.25, pri prvom mirisu. Četrdeset minuta kasnije cvet se otvorio, a ona ga nikada nije oprašila. Umrla je između 22.25 i otprilike 23.05, pola sata pre nego što ju je iko „video“ kod zvona.",
 "deductions:deductions.d_time_of_death.options.0": "Između 22.25 i otprilike 23.05",
 "deductions:deductions.d_time_of_death.options.1": "Između 23.32 i 01.00",
 "deductions:deductions.d_time_of_death.options.2": "Između 01.00 i 05.45",
 "deductions:deductions.d_time_of_death.options.3": "Pre nego što joj je Agnes u 22.15 donela kakao",
 "deductions:deductions.d_time_of_death.proofLabels.0": "Njen poslednji znak života",
 "deductions:deductions.d_time_of_death.proofLabels.1": "Zašto je bila mrtva pre cvetanja",
 "deductions:deductions.d_time_of_death.question": "Kada je ledi Penhallow zaista umrla?",
 "deductions:deductions.d_time_of_death.title": "Mrtva već u jedanaest i pet",
 "deductions:deductions.d_way_out.conclusion": "Staklena vrata bila su zaključana iznutra, s ključem u bravi. Jedini drugi izlaz vodi kroz kotlarnicu, a reza na njenim vratima može se otvoriti samo iznutra. Neko je posle zvona sišao niz te stepenice, otvorio rezu na spoljnim vratima i iskrao se u mrak.",
 "deductions:deductions.d_way_out.options.0": "Kroz staklena vrata, zaključavši ih za sobom drugim ključem",
 "deductions:deductions.d_way_out.options.1": "Dole kroz kotlarnicu i napolje kroz njena spoljna vrata",
 "deductions:deductions.d_way_out.options.2": "Krio se u kotlarnici dok Jory nije došao u zoru",
 "deductions:deductions.d_way_out.options.3": "Gore, kroz otvor za provetravanje na krovu",
 "deductions:deductions.d_way_out.proofLabels.0": "Jedini drugi izlaz",
 "deductions:deductions.d_way_out.proofLabels.1": "Neko ga je te noći upotrebio",
 "deductions:deductions.d_way_out.question": "Kako je onaj ko je zvonio izašao iz staklenika zaključanog iznutra?",
 "deductions:deductions.d_way_out.title": "Napolje kroz kotlarnicu",
 "dialogues:statements.st_agnes_celia.text": "Gospođa Celia je propustila zvono. Sišla je u petnaest do dvanaest u svom bledoplavom kućnom ogrtaču i rekla da ju je ono probudilo.",
 "dialogues:statements.st_agnes_cocoa.text": "U deset i petnaest odnela sam joj kakao. Bila je dobro i svakih četvrt sata upisivala je u dnevnik.",
 "dialogues:statements.st_agnes_ink.text": "Od 1943. sve je pisala zelenim mastilom — pisma, etikete, čekove. Nikada nekom drugom bojom.",
 "dialogues:statements.st_agnes_lawn.text": "U dvanaest i petnaest videla sam sa svog prozora gospodina Juliana kako ide niz travnjak ka stakleniku.",
 "dialogues:statements.st_agnes_stick.text": "Milostiva nije mogla da napravi ni korak bez svog štapa, a na merdevine se nije penjala deset godina.",
 "dialogues:statements.st_celia_bed.text": "Od pola jedanaest bila sam u krevetu. Probudilo me je zvono i gledala sam Hester sa svog prozora.",
 "dialogues:statements.st_celia_didnt_know.text": "Ne znam baš ništa ni o kakvom falsifikatu ni o hipoteci.",
 "dialogues:statements.st_celia_knew.text": "Hester mi je u šest sati rekla da je Julian falsifikovao njen potpis i da će ujutru dokaz otići gospodinu Kittowu.",
 "dialogues:statements.st_celia_plead.text": "U dvadeset do jedanaest otišla sam u staklenik da molim Hester zbog testamenta. Kada sam otišla, u deset do jedanaest, bila je živa, pisala je u svoj dnevnik.",
 "dialogues:statements.st_celia_rose_walk.text": "Nisam mogla da spavam. Šetala sam alejom ruža dok nisam čula zvono, a onda sam ušla. Nisam se ni približila stakleniku.",
 "dialogues:statements.st_jory_bed.text": "U devet sam zagrnuo vatru u kotlu, a u deset sam već bio u krevetu.",
 "dialogues:statements.st_jory_dawn.text": "U petnaest do šest mesečeva orhideja je još bila otvorena i niko je nije oprašio. Oprašio sam je ja, njenom četkicom.",
 "dialogues:statements.st_jory_figure.text": "Koji minut pošto se lampa spustila, video sam kako bleda prilika u nečemu dugačkom izlazi iz kotlarnice i žuri uz zid, ka kući.",
 "dialogues:statements.st_jory_ladder.text": "Milostiva se nikad nije penjala na te merdevine. Vise na svojoj kuki kraj vrata i nisu skidane od Duhova.",
 "dialogues:statements.st_jory_stokehole.text": "U devet sam zatvorio rezu na vratima kotlarnice. U zoru je reza bila otvorena, a neko je nešto spalio u mom kotlu.",
 "dialogues:statements.st_julian_debts.text": "Penhallow Motors je u nevolji, ali sam firmu pošteno održao na površini. Nikada nisam uradio ništa kriminalno.",
 "dialogues:statements.st_julian_drawing_room.text": "Posle zvona nisam izlazio iz salona dok svi nismo otišli gore u jedan.",
 "dialogues:statements.st_julian_forgery.text": "Falsifikovao sam potpis strine Hester na hipoteci od £20.000 na imanje Home Farm.",
 "dialogues:statements.st_julian_glasshouse.text": "U dvanaest i petnaest sišao sam do staklenika. Vrata su bila zaključana, lampa prigušena, a ona se nije javljala.",
 "dialogues:statements.st_julian_library.text": "Od deset i petnaest do jedanaest i petnaest raspravljao sam se s Kittowom u biblioteci.",
 "dialogues:statements.st_julian_money.text": "Moji poslovi su u savršenom redu. Nije mi trebao novac strine Hester.",
 "dialogues:statements.st_julian_will.text": "Strina Hester je jutros trebalo da potpiše novi testament po kome ja ostajem bez Penhallowa.",
 "dialogues:statements.st_kittow_engaged.text": "Hester i ja trebalo je da se venčamo u septembru. Rekla mi je da će u petak u šest reći Celiji za Julianov zločin, kako bi on mogao da prizna pre subote.",
 "dialogues:statements.st_kittow_library.text": "Od deset i petnaest do jedanaest i petnaest bio sam u biblioteci s Julianom.",
 "dialogues:statements.st_kittow_professional.text": "Moj odnos s ledi Penhallow bio je isključivo profesionalan.",
 "dialogues:statements.st_kittow_will.text": "Po novom testamentu Julian bi dobio £1.000. Po starom, koji sada važi, on nasleđuje Penhallow.",
 "dialogues:statements.st_marian_darkroom.text": "Od deset do jedanaest i deset bila sam u svojoj mračnoj komori. Zatim sam postavila fotoaparat na terasi.",
 "dialogues:statements.st_marian_kew.text": "Ovde sam u ime Kewa, da zabeležim cvetanje.",
 "dialogues:statements.st_marian_lindqvist.text": "Kew me je prošle godine otpustio. Plaća me firma Lindqvist Orchids iz Miamija, koja želi seme.",
 "dialogues:statements.st_marian_photo.text": "U trenutku kada se oglasilo zvono, napravila sam jedan snimak s terase. Fotografija se suši u mojoj mračnoj komori.",
 "dialogues:statements.st_marian_pollinate.text": "Mesečeva orhideja se otvara otprilike četrdeset minuta posle prvog mirisa. Hester bi je oprašila istog trena kad se otvori — pre bi umrla nego što bi to propustila.",
 "dialogues:statements.st_marian_scent.text": "Kada je Celia u 23.45 ušla u salon, snažno je mirisala na mesečevu orhideju, kao da je stajala nad njom.",
 "dialogues:topics.t_agnes_evening.lines.0": "U deset i petnaest odnela sam joj termos s kakaom. Rekla je da niko ne sme da joj priđe, ali za večerom nije ništa okusila. Izgrdila me je i pustila unutra, i popila šolju dok sam ja stajala pored nje. Svakih četvrt sata upisivala je u dnevnik, srećna kao devojčica. Onda je za mnom zaključala vrata.",
 "dialogues:topics.t_agnes_evening.lines.1": "Bila sam na terasi s ostalima kada se oglasilo zvono. U ponoć sam otišla gore na spavanje, a u dvanaest i petnaest pogledala sam kroz prozor i videla gospodina Juliana na travnjaku, na mesečini, kako ide dole ka stakleniku. Rekla sam to naredniku. Sada mi je žao zbog toga.",
 "dialogues:topics.t_agnes_evening.prompt": "Recite mi šta se sinoć dešavalo.",
 "dialogues:topics.t_agnes_hester.lines.0": "Kuk ju je jako mučio. Nije mogla da napravi ni korak bez štapa, čak ni preko sopstvene spavaće sobe — a na merdevine se nije penjala deset godina. Za to je bio Jory.",
 "dialogues:topics.t_agnes_hester.lines.1": "I pisala je zelenim mastilom. Samo zelenim, otkako je ’43. stigao onaj telegram — to je bila Edmundova boja. Pisma, etikete, čekovi. Sve zelenim.",
 "dialogues:topics.t_agnes_hester.prompt": "Kakve je navike imala ledi Penhallow?",
 "dialogues:topics.t_agnes_rooms.lines.0": "Njena dnevna soba je zaključana. Jedini rezervni ključ držala je kod mene. Pretpostavljam da to sada više nije važno.",
 "dialogues:topics.t_agnes_rooms.lines.1": "Vadi iz džepa mali ključ i trenutak ga drži u ruci pre nego što vam ga pruži. Dnevna soba ledi Penhallow vam je sada otvorena.",
 "dialogues:topics.t_agnes_rooms.prompt": "Mogu li da vidim sobe ledi Penhallow?",
 "dialogues:topics.t_agnes_terrace.lines.0": "Gospodin Julian, gospodin Kittow, doktorka Ellery sa svojim fotoaparatom i ja. Videli smo kako podiže lampu i odmahuje nam da idemo, pa smo se vratili unutra.",
 "dialogues:topics.t_agnes_terrace.lines.1": "Gospođa Celia se u pola jedanaest povukla gore zbog glavobolje. U salon je sišla u petnaest do dvanaest, u svom bledoplavom kućnom ogrtaču, razrogačenih očiju, i rekla da ju je zvono probudilo i da je gledala sa svog prozora.",
 "dialogues:topics.t_agnes_terrace.prompt": "Ko je bio na terasi kada se oglasilo zvono?",
 "dialogues:topics.t_agnes_will.lines.0": "Po starom testamentu, dve hiljade funti. Po novom, kućica kod kapije doživotno i trista funti godišnje. Rekla mi je to u junu, a ja sam plakala kao dete.",
 "dialogues:topics.t_agnes_will.lines.1": "Pa ako se pitate — imala sam sve razloge na svetu da želim da bude živa bar do deset sati jutros.",
 "dialogues:topics.t_agnes_will.prompt": "Da li se ledi Penhallow pobrinula za vas?",
 "dialogues:topics.t_celia_evening.lines.0": "Gore, u krevetu. Strašno me je bolela glava — u pola jedanaest poželela sam svima laku noć i otišla pravo gore.",
 "dialogues:topics.t_celia_evening.lines.1": "Probudilo me je zvono. Prišla sam prozoru, i eno nje — dole u stakleniku, s lampom, pored onog ogromnog belog cveta. Kao nešto iz Šekspira. Posle nisam mogla da zaspim, pa sam obukla kućni ogrtač i sišla kod ostalih.",
 "dialogues:topics.t_celia_evening.prompt": "Gde ste bili sinoć?",
 "dialogues:topics.t_celia_forgery.lines.0": "Falsifikovao? Julian? Ne budite smešni. Julian ne bi umeo da falsifikuje ni opravdanje za školu.",
 "dialogues:topics.t_celia_forgery.lines.1": "Ne znam baš ništa ni o kakvoj hipoteci. Julian posao drži za sebe. Pitajte njega.",
 "dialogues:topics.t_celia_forgery.prompt": "Da li ste znali da je vaš muž falsifikovao strinin potpis?",
 "dialogues:topics.t_celia_hester.lines.0": "Smatrala je da se Julian oženio ispod svog staleža. Glumicom! Nikada to nije rekla. Nije ni morala.",
 "dialogues:topics.t_celia_hester.lines.1": "Ali umela je da bude dobra. Jednom, u maju, pokazala mi je svoju orhideju i pričala s njom kao da Edmund stoji tu pored nas. Iskreno da vam kažem, pomalo sam joj zavidela. Zamislite da nekoga toliko volite.",
 "dialogues:topics.t_celia_hester.prompt": "Kako ste se slagali s ledi Penhallow?",
 "dialogues:topics.t_celia_stage.lines.0": "Jedanaest godina u repertoarskim pozorištima. Bristol, Bath, jedna sezona u Stratfordu. Bila sam prilično dobra ledi Magbet, ako smem sama da se pohvalim.",
 "dialogues:topics.t_celia_stage.lines.1": "Scena mesečarenja. Svako veče cela kuća je zadržavala dah. Onda sam se udala za Juliana, i za Penhallow Motors, i to je bilo to.",
 "dialogues:topics.t_celia_stage.prompt": "Čujem da ste bili glumica.",
 "dialogues:topics.t_jory_dawn.lines.0": "Dođem ja u petnaest do šest da naložim, ko svako jutro, kroz kotlarnicu. Spoljna vrata bila su s otvorenom rezom — doći ću i do toga. Popnem se uz stepenice, kad tamo milostiva, leži kraj stalaže, a merdevine pored nje. Hladna.",
 "dialogues:topics.t_jory_dawn.lines.1": "A cvet još otvoren, jedva. Beo ko tanjir. Niko ga nije dir’o — četkica joj leži kraj knjige, čista, a polen još stoji u cvetu. Dvadeset pet godina je čekala tu noć.",
 "dialogues:topics.t_jory_dawn.lines.2": "Pa sam ja to uradio umesto nje. Njenom četkicom, ko što me naučila, i vez’o ga parčetom kanapa. Nije prošlo ni pet minuta, a on se zatvorio. Onda sam otrč’o do kuće.",
 "dialogues:topics.t_jory_dawn.prompt": "Recite mi kako ste je pronašli.",
 "dialogues:topics.t_jory_evening.lines.0": "U devet sam zagrnuo vatru u kotlu i otiš’o kući. U deset sam već bio u krevetu, ko i uvek. Milostiva nije ’tela nikog blizu stakla, a ja radim šta mi se kaže.",
 "dialogues:topics.t_jory_evening.prompt": "Gde ste bili sinoć?",
 "dialogues:topics.t_jory_julian.lines.0": "Kamp za odmor. Kućice na travnjaku ser Edmunda i bazen u mom povrtnjaku. To on ’oće.",
 "dialogues:topics.t_jory_julian.lines.1": "Al’ ovo ću reći u njegovu korist: za krv nema stomaka ništa više od kokoške. Onesvestio se na svinjokolju kad mu je bilo dvanaest godina.",
 "dialogues:topics.t_jory_julian.prompt": "Šta mislite o gospodinu Julianu?",
 "dialogues:topics.t_jory_ladder.lines.0": "Milostiva? Već deset godina nije. Nije mogla, s onim kukom. Šta god je bilo visoko, zvala je mene.",
 "dialogues:topics.t_jory_ladder.lines.1": "A gore nije bilo ničega zbog čega bi se penjala. Lampa visi na nosaču, tamo gde sam je ja okačio. Te merdevine vise na svojoj kuki kraj vrata. Poslednji put su skidane za Duhove.",
 "dialogues:topics.t_jory_ladder.prompt": "Da li bi se ona popela na merdevine?",
 "dialogues:topics.t_jory_stokehole.lines.0": "Ta vrata zatvaram rezom u devet, svako veče otkad znam za sebe. Reza je samo s unutrašnje strane, vidite — iz vrta ne mogu ni da se otvore ni da se zatvore. Jutros su stajala s otvorenom rezom.",
 "dialogues:topics.t_jory_stokehole.lines.1": "A neko je čeprkao po mom kotlu. Vratanca od ložišta otvorena, a vatra bukti ko u kovačnici — a ja sam je ostavio zagrnutu, da tinja. Neko je unutra nešto spalio.",
 "dialogues:topics.t_jory_stokehole.prompt": "A vrata kotlarnice?",
 "dialogues:topics.t_julian_aunt.lines.0": "Dvadeset godina u crnini zbog čoveka koji je umro u nekoj džungli. Razgovarala je s njegovim biljkama. Ne govorim to iz zlobe — stvarno jeste. Naglas, svako jutro.",
 "dialogues:topics.t_julian_aunt.lines.1": "Bila je pametna, to joj se mora priznati. Pametnija od strica Edmunda, kaže Kittow, a Kittow bi to trebalo da zna. Samo to nikome nije pokazivala.",
 "dialogues:topics.t_julian_aunt.prompt": "Kakva je bila vaša strina?",
 "dialogues:topics.t_julian_celia.lines.0": "Celia? Bože sačuvaj. Pre bih umro. Ona misli da posao cveta — to joj već godinu dana govorim svake nedelje.",
 "dialogues:topics.t_julian_celia.lines.1": "Sinoć je rano otišla gore, s jednom od svojih glavobolja. Celo leto loše spava. I to je valjda moja krivica.",
 "dialogues:topics.t_julian_celia.prompt": "Da li je vaša žena znala za hipoteku?",
 "dialogues:topics.t_julian_evening.lines.0": "Gde ste bili posle večere, gospodine Penhallow?",
 "dialogues:topics.t_julian_evening.lines.1": "Od deset i petnaest u biblioteci s Kittowom; pokušavao sam da ga urazumim oko tog testamenta. Bojim se da je bilo prilično glasno. Onda smo svi u koloni izašli na terasu da čekamo zvono strine Hester.",
 "dialogues:topics.t_julian_evening.lines.2": "Kada je zazvonilo, videli smo je jasno kao dan kako drži podignutu lampu. Onda smo se vratili unutra i do jedan sedeli uz šampanjac, čekajući da ponovo zazvoni. Nisam izlazio iz salona dok svi mi ostali nismo otišli gore.",
 "dialogues:topics.t_julian_evening.prompt": "Gde ste bili sinoć?",
 "dialogues:topics.t_julian_glasshouse.lines.0": "Vrata su bila zaključana. Lampa unutra bila je skroz prigušena, jedva je svetlucala; jedva sam razaznao belinu onog cveta. Pokucao sam dvaput i zvao je po imenu. Ništa.",
 "dialogues:topics.t_julian_glasshouse.lines.1": "Mislio sam da se duri, ili da je zadremala u stolici. Nisam obilazio pozadi — nisam ni znao da pozadi ima ulaz. Otišao sam.",
 "dialogues:topics.t_julian_glasshouse.lines.2": "Ali taj miris. Ta njena orhideja. Probijao je kroz staklo kao zid.",
 "dialogues:topics.t_julian_glasshouse.prompt": "Recite mi tačno šta ste zatekli kod staklenika.",
 "dialogues:topics.t_julian_money.lines.0": "Penhallow Motors? Cveta. Najbolja godina dosad. Svi hoće Zephyra.",
 "dialogues:topics.t_julian_money.lines.1": "Ako pitate da li mi je trebao novac strine Hester, odgovor je ne. Moji poslovi su u savršenom redu.",
 "dialogues:topics.t_julian_money.prompt": "Kako vam ide posao?",
 "dialogues:topics.t_julian_quarrel.lines.0": "Uz supu je objavila da jutros u deset potpisuje novi testament. Penhallow fondaciji National Trust — s kućom, okućnicom i staklenikom. Stric Edmund mi je obećao ovo imanje kad mi je bilo devet godina.",
 "dialogues:topics.t_julian_quarrel.lines.1": "Imam sasvim pristojnu ponudu od firme Sunnyside Holiday Camps. Kućice na travnjaku, bazen tamo gde je povrtnjak. Ljudima treba odmor. Pogledala me je kao da sam predložio da prodamo Edmundove kosti.",
 "dialogues:topics.t_julian_quarrel.lines.2": "Pa da, posvađali smo se. Rekao sam da će se pokajati. To nije pretnja. To ljudi tako kažu.",
 "dialogues:topics.t_julian_quarrel.prompt": "Oko čega ste se posvađali za večerom?",
 "dialogues:topics.t_kittow_evening.lines.0": "U biblioteci s Julianom, od deset i petnaest do jedanaest i petnaest, dok je on vikao na mene. Hteo je da nagovorim Hester da ne potpiše. Rekao sam mu da je advokat dužan da poštuje želje svoje klijentkinje, a ne njenog naslednika.",
 "dialogues:topics.t_kittow_evening.lines.1": "Gospođa Pascoe donela nam je viski u dvadeset do jedanaest, i usuđujem se da kažem da je čula svaku reč. Zatim smo izašli na terasu zbog zvona, pa se vratili u salon i ostali tamo do jedan.",
 "dialogues:topics.t_kittow_evening.prompt": "Gde ste bili sinoć?",
 "dialogues:topics.t_kittow_hester.lines.0": "Četrdeset godina zastupam ovu porodicu. Sastavio sam testament ser Edmunda pre nego što je 1941. otplovio, a Hesterin posle onog telegrama.",
 "dialogues:topics.t_kittow_hester.lines.1": "Moj odnos s ledi Penhallow bio je isključivo profesionalan, uveravam vas.",
 "dialogues:topics.t_kittow_hester.prompt": "Koliko ste dobro poznavali ledi Penhallow?",
 "dialogues:topics.t_kittow_hester_heart.lines.0": "Ovog leta smejala se više nego za čitavih dvadeset godina pre toga. Odlučila je da joj je to dozvoljeno.",
 "dialogues:topics.t_kittow_hester_heart.lines.1": "Rekla je da je orhideja Edmundova i da posle sinoćne noći može da ga pusti da počiva u miru. Onda bi nosila sivo. Za početak samo sivo.",
 "dialogues:topics.t_kittow_hester_heart.prompt": "Kakva je bila, Edwine — zaista?",
 "dialogues:topics.t_kittow_will.lines.0": "Trebalo je da bude potpisan jutros u deset, pred gospođom Pascoe i vikarom. Svedok nikada ne sme da bude neko ko nešto dobija — meni je ostavljen Edmundov sat, pa ga ja nisam mogao potpisati kao svedok. Testament ostavlja Penhallow i njegove vrtove fondaciji National Trust, uz fond za održavanje. Julian dobija hiljadu funti i stričeve knjige.",
 "dialogues:topics.t_kittow_will.lines.1": "Po starom testamentu — onom iz 1950, koji sada važi — on nasleđuje sve. Nacrt ćete naći u mojoj aktovci u biblioteci. Nemam tajni od policije, a ni od vas.",
 "dialogues:topics.t_kittow_will.prompt": "Recite mi nešto o novom testamentu.",
 "dialogues:topics.t_marian_bell.lines.0": "Hester, s lampom podignutom pored cveta. Podigla je ruku prema nama — prilično svečano za nju, učinilo mi se. Onda se okrenula, a lampa se spustila.",
 "dialogues:topics.t_marian_bell.lines.1": "Napravila sam jedan snimak, u trenutku kada se oglasilo zvono. Pola sekunde pri potpuno otvorenoj blendi, kroz zamagljeno staklo, sa četrdeset jardi — zato ne očekujte mnogo. Razvila sam ga jutros, čim sam ustala. Fotografija visi na konopcu u mojoj mračnoj komori.",
 "dialogues:topics.t_marian_bell.prompt": "Šta ste videli kada se oglasilo zvono?",
 "dialogues:topics.t_marian_evening.lines.0": "U devet i dvadeset pet fotografisala sam Hester s pupoljkom, pre nego što se zaključala. Zatim sam od deset do otprilike jedanaest i deset bila u mračnoj komori i razvijala snimke — gospođa Pascoe je u jednom trenutku pokucala, jadna žena, a ja sam viknula na nju.",
 "dialogues:topics.t_marian_evening.lines.1": "Posle toga sam postavila stativ na terasi da sačekam zvono. Oglasilo se kasnije nego što sam očekivala. Zaklela bih se da će taj cvet biti otvoren do jedanaest.",
 "dialogues:topics.t_marian_evening.prompt": "Gde ste bili sinoć?",
 "dialogues:topics.t_marian_kew.lines.0": "Tako je. Herbarijum želi potpunu dokumentaciju o cvetu — fotografije, mere, vremenski tok. Hester i ja smo se pet godina dopisivale o toj biljci.",
 "dialogues:topics.t_marian_kew.lines.1": "Po novom testamentu orhideja je trebalo da pripadne Kewu. Zato sam ovde.",
 "dialogues:topics.t_marian_kew.prompt": "Vi ste ovde u ime Kewa?",
 "dialogues:topics.t_marian_lindqvist.lines.0": "Seme. Jedna čaura s tog cveta sadrži milion semenki, a svaki sejanac prodavao bi se na Floridi za sto dolara. Lindqvist je hteo da poseduje mesečevu orhideju, kao što čovek poseduje trkačkog konja.",
 "dialogues:topics.t_marian_lindqvist.lines.1": "Nameravala sam da zamolim Hester da mu proda deo semena. Zakonito i pošteno. Odbila bi, naravno. Već je sve ostavila Kewu.",
 "dialogues:topics.t_marian_lindqvist.prompt": "Šta je tačno Lindqvist hteo?",
 "dialogues:topics.t_marian_orchid.lines.0": "Edmund Penhallow sakupio ju je u Šanskim brdima 1938. Dolina iz koje potiče izgorela je u ratu. Koliko se zna, Hesterina biljka je poslednja živa. U Engleskoj nijednom nije procvetala.",
 "dialogues:topics.t_marian_orchid.lines.1": "Otvara se samo jednom, po mraku. Od prvog mirisa do otvorenog cveta prođe otprilike četrdeset minuta, a kad izađe sunce, zatvara se zauvek. Jedina prilika da se opraši jeste dok je otvorena — a trenutak kada se otvori najbolja je prilika od svih.",
 "dialogues:topics.t_marian_orchid.lines.2": "Hester je dvadeset pet godina čekala sinoćnu noć. Oprašila bi je istog trena kad se otvori. Pre bi umrla nego što bi to propustila.",
 "dialogues:topics.t_marian_orchid.prompt": "Recite mi nešto o mesečevoj orhideji.",
 "dialogues:topics.t_marian_scent.lines.0": "Sad kad pitate… da. Kada je ušla u salon, unela je sa sobom miris orhideje. Karanfilić i ljiljan — prepoznala bih ga bilo gde. Jak, kao da je stajala nad samim cvetom.",
 "dialogues:topics.t_marian_scent.lines.1": "Pomislila sam da je verovatno dopro kroz prozore. Ali prozori salona tada su već bili zatvoreni, a staklenik je četrdeset jardi daleko. Taj miris prianja uz sve što mu se približi. Ne putuje.",
 "dialogues:topics.t_marian_scent.prompt": "Kada je Celia u 23.45 sišla, da li ste nešto primetili?",
 "evidence:evidence.bank_demand.detail": "Zgužvano u unutrašnjem džepu Julianovog smokinga: pismo banke Westminster Bank iz Plymoutha, s datumom 22. jul 1963.\n\n„Poštovani gospodine Penhallow — moramo Vam ponovo skrenuti pažnju na prekoračenje po računu firme Penhallow Motors, koje sada iznosi £6.412 7 šil. 2 p. Ukoliko ono ne bude izmireno do 31. jula, nećemo imati drugog izbora nego da pokrenemo sudski postupak…“\n\nPismo je mnogo puta savijano i razvijano.",
 "evidence:evidence.bank_demand.name": "Pismo banke Westminster Bank",
 "evidence:evidence.bank_demand.summary": "Poslednja opomena firmi Penhallow Motors, uz pretnju da će biti pokrenut „sudski postupak“.",
 "evidence:evidence.bloom_log.detail": "Hesterin dnevnik cvetanja, pisan zelenim mastilom, sitnim, uspravnim rukopisom:\n\n„21.30 — Zaključana. Lampa upaljena. Pupoljak bubri.\n21.45 — Vrh pupoljka poprima boju.\n22.00 — Edmundov čas. Pupoljak se opušta.\n22.15 — Agnes s kakaom, protivno naređenju. Bog da je blagoslovi.\n22.25 — Čašični listići se razdvajaju. Prvi miris: karanfilić i ljiljan. Četrdeset minuta, uvek je govorio Edmund. Oprašiću ga čim se otvori.“\n\nPosle 22.25 stranica je prazna. Nalivpero joj leži pored dnevnika, zatvoreno. Uz njega je i njena četkica od samurove dlake za oprašivanje.",
 "evidence:evidence.bloom_log.name": "Dnevnik cvetanja",
 "evidence:evidence.bloom_log.summary": "Zeleno mastilo svakih četvrt sata — do 22.25, a onda ništa.",
 "evidence:evidence.blue_room_window.detail": "Plava soba, u kojoj spavaju Julian i Celia, nalazi se na severnom pročelju. Njen jedini prozor gleda na prilazni put posut šljunkom i na drvored bukava.\n\nStaklenik je na jugu, u dnu travnjaka, s druge strane kuće. Iz ove sobe ne vidi se čak ni vetrokaz na njegovom krovu.",
 "evidence:evidence.blue_room_window.name": "Prozor Plave sobe",
 "evidence:evidence.blue_room_window.summary": "Celijin prozor gleda na sever, na prilazni put. Staklenik je s druge strane kuće.",
 "evidence:evidence.celia_mules.detail": "U dnu ormana, gurnuti iza večernjih haljina: par bledoplavih satenskih papuča i kućni ogrtač iste boje.\n\nĐonovi papuča sivi su od koksne prašine utrljane u saten. Rub kućnog ogrtača svuda je umrljan crnim. Neko je pokušao da ga očetka, ali je prljavštinu samo razmazao.",
 "evidence:evidence.celia_mules.name": "Celijin kućni ogrtač i papuče",
 "evidence:evidence.celia_mules.summary": "Bledoplavi saten — i crna koksna prašina na đonovima i na rubu.",
 "evidence:evidence.deed_fragment.detail": "Nagoreli ugao debelog papira za pravne isprave, koji je kroz rešetku ložišta propao u posudu za pepeo:\n\n„…HIPOTEKA na nepokretnosti poznatoj kao Home Farm, Penhallow… iznos od dvadeset hiljada funti… Lorimer & Dane… potpisala navedena Hester Penhallow…“\n\nNa samoj ivici sačuvao se potpis, smeđ od vatre: „Hester Penhallow“, crnim mastilom.",
 "evidence:evidence.deed_fragment.name": "Nagoreli ugovor",
 "evidence:evidence.deed_fragment.summary": "Iz posude za pepeo ispod kotla: „…Home Farm… dvadeset hiljada funti… Hester Penhallow“ — potpisano crnim mastilom.",
 "evidence:evidence.ebony_stick.detail": "Njen štap od abonosa, pronađen ispod stalaže za orhideje. Jabuka mu je od punog srebra, okrugla, otprilike veličine novčića od pola krune, i cela je ukrašena gravurom lišća.\n\nJabuka je obrisana. Ali duboko u gravuri ostala je tamna mrlja osušene krvi, a u njoj su se zaplele dve sede vlasi.",
 "evidence:evidence.ebony_stick.name": "Štap ledi Penhallow",
 "evidence:evidence.ebony_stick.summary": "Teška srebrna jabuka, veličine novčića od pola krune — s krvlju u gravuri.",
 "evidence:evidence.finance_letter.detail": "Lorimer & Dane, finansijska kuća, London E.C.2, 19. jul 1963.\n\n„Poštovana ledi Penhallow — radi Vaše evidencije prilažemo primerak ugovora o hipoteci na Vaše imanje Home Farm, zaključenog 2. maja, prema kojem je iznos od £20.000 isplaćen Vašem sinovcu, gospodinu Julianu Penhallowu, kao Vašem punomoćniku…“\n\nPreko dna stranice, zelenim mastilom:\n\n„Ovo nikada nisam potpisala. Julian, naravno. Reći ću Celiji u petak u šest i daću mu tu noć da sam od sebe dođe k meni. U subotu ide Edwinu, a od Edwina u policiju.“\n\nSamog primerka ugovora nema uz pismo.",
 "evidence:evidence.finance_letter.name": "Pismo firme Lorimer & Dane",
 "evidence:evidence.finance_letter.summary": "O „njenoj“ hipoteci od £20.000 na imanje Home Farm — i njena beleška zelenim mastilom: „Ovo nikada nisam potpisala.“",
 "evidence:evidence.hester_letter.detail": "Penhallow House, St Austell, 23. jul 1963.\n\n„Poštovani gospodine ili gospođo — rečeno mi je da ste diskretni. Otkrila sam da je jedan član moje porodice učinio nešto kriminalno. U subotu ujutru nameravam da dokaz predam u ruke svom advokatu, zajedno s novim testamentom. Do tada bih se osećala spokojnije kada bi u kući bio neko ko nije iz porodice.\n\nMesečeva orhideja koju mi je suprug 1938. poslao kući procvetaće u petak noću, prvi put u ovoj zemlji. Dođite u petak, pa ćete je videti.\n\nS poštovanjem, Hester Penhallow“\n\nNapisano zelenim mastilom. U vašu kancelariju stiglo je u petak po podne.",
 "evidence:evidence.hester_letter.name": "Pismo ledi Penhallow",
 "evidence:evidence.hester_letter.summary": "Poslato u utorak: „Otkrila sam da je jedan član moje porodice učinio nešto kriminalno.“",
 "evidence:evidence.iron_staging.detail": "Livenogvozdena ivica stalaže, o koju je, kako kaže doktor Tresidder, udarila glavom dok je padala. Pregledate je lupom.\n\nNema krvi, nema vlasi, ni ogrebotine na staroj zelenoj boji. A ivica joj je oštar pravi ugao — nimalo nalik okrugloj rani veličine novčića od pola krune.",
 "evidence:evidence.iron_staging.name": "Gvozdena stalaža",
 "evidence:evidence.iron_staging.summary": "Mesto gde je navodno udarila glavom: na njoj nema ni traga.",
 "evidence:evidence.jory_pipe.detail": "Kod vrata ograđenog vrta, na stepeniku: gomilica ostataka duvana istresenih iz lule i pola tuceta izgorelih šibica. Duvan je kornvolski, uvijen u svitak, crn i jak. Jory Trevenna ne puši ništa drugo.\n\nS ovog stepenika vidi se ceo istočni kraj staklenika — i vrata kotlarnice ispod njega.",
 "evidence:evidence.jory_pipe.name": "Ostaci iz lule kod vrata ograđenog vrta",
 "evidence:evidence.jory_pipe.summary": "Svež pepeo iz lule i izgorele šibice, tamo odakle se iz ograđenog vrta vidi staklenik.",
 "evidence:evidence.kittow_letter.detail": "Presavijeno u njenoj bugačici, brižljivim rukopisom pravnika:\n\n„Draga moja Hester — dakle u subotu, kad testament bude potpisan i tvoja orhideja na sigurnom, recimo im. Četrdeset godina sam čekao; mogu da sačekam i dok cvet ne proživi svoju noć. Septembar u crkvi Svetog Mewana, kako si želela. — Tvoj Edwin“",
 "evidence:evidence.kittow_letter.name": "Pismo Edwina Kittowa",
 "evidence:evidence.kittow_letter.summary": "„…kad testament bude potpisan i tvoja orhideja na sigurnom, recimo im.“",
 "evidence:evidence.lindqvist_cable.detail": "Telegram, sitno presavijen u torbi doktorke Ellery, primljen u St Austellu u četvrtak:\n\n„ELLERY PENHALLOW HOUSE ST AUSTELL — PONUDA VAŽI DVADESET HILJADA DOLARA EKSKLUZIVNO PRAVO PRVI SEJANCI STOP OBEZBEDITI ČAURU PO SVAKU CENU STOP — LINDQVIST ORCHIDS MIAMI“",
 "evidence:evidence.lindqvist_cable.name": "Telegram iz Miamija",
 "evidence:evidence.lindqvist_cable.summary": "Za doktorku Ellery: „Dvadeset hiljada dolara … obezbediti čauru po svaku cenu.“",
 "evidence:evidence.moon_orchid.detail": "Edmundova orhideja, s etiketom ispisanom njegovom rukom: „No. 7 — Shan Hills, 1938“. Veliki beli cvet se zatvorio i mlitavo visi. Vazduh oko njega još blago miriše na karanfilić i ljiljan.\n\nOko stabljike je nedavno vezan uvojak zelenog baštenskog kanapa — baštovanski znak da je cvet oprašen. Ledi Penhallow je za to koristila svilenu uzicu, belu.",
 "evidence:evidence.moon_orchid.name": "Mesečeva orhideja",
 "evidence:evidence.moon_orchid.summary": "Sada zatvorena i klonula. Uvojak zelenog kanapa označava da je oprašena.",
 "evidence:evidence.pascoe_statement.detail": "Izjava gospođe Morwenne Pascoe, kuvarice i domaćice, koju je uzeo narednik Polglase:\n\n„Od deset i petnaest bila sam u batlerovoj ostavi pored biblioteke i čistila srebrninu za jutro. Gospodin Julian i gospodin Kittow sve vreme su se svađali na sav glas oko testamenta — kroz zid sam čula svaku reč. U dvadeset do jedanaest odnela sam im poslužavnik s viskijem, a još su bili u tome u jedanaest i deset, kad sam sišla u svoju kuhinju.\n\nU deset do jedanaest svratila sam do stare perionice koju je doktorka Ellery pretvorila u mračnu komoru, da je pitam hoće li kakao. Doviknula mi je kroz vrata da joj je papir u razvijaču i da ih ni pod kojim uslovom ne otvaram.\n\nPosle toga sam bila u svojoj kuhinji dok nisam čula zvono.“",
 "evidence:evidence.pascoe_statement.name": "Izjava gospođe Pascoe",
 "evidence:evidence.pascoe_statement.summary": "Kuvarica i domaćica: svađa u biblioteci od 22.15 do 23.10, i doktorka Ellery u mračnoj komori u 22.50.",
 "evidence:evidence.photo_bell.detail": "Jedini snimak s dugom ekspozicijom koji je doktorka Ellery napravila s terase kada se oglasilo zvono, kroz zamagljeno staklo, sa četrdeset jardi. Zrnast je, ali se oblici jasno razaznaju: stalaža za orhideje, gvozdeni nosač lampe iznad nje i bela zvezda otvorenog cveta.\n\nPored njega stoji prilika u crnom velu i šalu; u jednoj ruci visoko drži lampu, a drugu je podigla. Stoji uspravno, toliko visoka da joj je glava u ravni s nosačem lampe. Štapa nema. A ispod crnog šala nazire se rub, svetao naspram tame.",
 "evidence:evidence.photo_bell.name": "Fotografija, 23.32",
 "evidence:evidence.photo_bell.summary": "„Udovica“ kod zvona: visoka, uspravna, bez štapa — i svetao rub ispod crnine.",
 "evidence:evidence.photo_bud.detail": "Fotografija koju je doktorka Ellery snimila u stakleniku u 21.25, neposredno pre nego što se Hester zaključala.\n\nSitna, pogrbljena žena u crnini oslanja se na svoj štap od abonosa pored stalaže za orhideje. Vrh vela jedva joj dopire do police ispod gvozdenog nosača lampe. Sva je u crnom, od vela do ruba.",
 "evidence:evidence.photo_bud.name": "Fotografija, 21.25",
 "evidence:evidence.photo_bud.summary": "Ledi Penhallow s orhidejom u pupoljku: sitna, pogrbljena nad štapom, u crnom od vela do ruba.",
 "evidence:evidence.sergeant_notes.detail": "Petak, 26. jul. Vedro, toplo, bez vetra.\n\n20.00 — Večera. Prisutni: pokojnica, g. J. Penhallow (sinovac), gđa C. Penhallow, dr M. Ellery, g. E. Kittow (advokat), gđica A. Quill (družbenica). Prepirka pokojnice i sinovca oko novog testamenta.\n21.30 — Pokojnica se zaključava u stakleniku da gleda kako joj cveta orhideja. Kaže da će zazvoniti jednom kad se cvet otvori, i ponovo kad ukućani mogu da siđu da ga vide.\n22.15 — Gđica Quill joj nosi kakao.\n22.30 — Gđa C. Penhallow se povlači zbog glavobolje.\n23.32 — Zvono u stakleniku. Pokojnicu pored cveta, s lampom u ruci, s terase videli: g. J. Penhallow, g. Kittow, gđica Quill i dr Ellery. Lampa spuštena cca 23.35.\n23.45 — Gđa C. Penhallow silazi u salon.\n00.15 — Sinovac viđen na travnjaku kako ide ka stakleniku (gđica Quill, sa svog prozora).\n05.45 — Baštovan J. Trevenna nalazi pokojnicu u podnožju merdevina ispod stalaže za orhideje. Vrata staklenika zaključana iznutra, ključ u bravi. Reza na vratima kotlarnice otvorena.\n\nDr Tresidder: pala s merdevina i udarila glavom o gvozdenu stalažu. Rana iznad levog uha, okrugla, veličine novčića od pola krune. Smrt između 23.30 i 02.00.\n\nSinovac je imao motiv, posle ponoći bio je sam napolju, a kotlarnica je bila otvorena. — Narednik W. Polglase",
 "evidence:evidence.sergeant_notes.name": "Beleške narednika Polglasea",
 "evidence:evidence.sergeant_notes.summary": "Noć onako kako je vidi policija — i njen osumnjičeni.",
 "evidence:evidence.slipper_prints.detail": "Stepenice kotlarnice prekrivene su debelim slojem koksne prašine. Joryjeve čizme okovane ekserima izgazile su je gotovo svu. Ali uz ivice gazišta ima otisaka sasvim druge vrste: malih, glatkih i bez potpetice, kao od ženske papuče, i vode nadole.\n\nNiko ne silazi do kotla u papučama.",
 "evidence:evidence.slipper_prints.name": "Otisci u koksnoj prašini",
 "evidence:evidence.slipper_prints.summary": "Mala papuča bez potpetice sišla je niz stepenice kotlarnice.",
 "evidence:evidence.stepladder.detail": "Drvene merdevine leže na boku pored obrisa iscrtanog kredom. Obično vise na kuki kraj vrata.\n\nGazišta su im siva od letnje prašine, a prašina je netaknuta: nijednog otiska stopala, nijedne mrlje. Sinoć se na ove merdevine niko nije popeo.",
 "evidence:evidence.stepladder.name": "Merdevine",
 "evidence:evidence.stepladder.summary": "Leže pored tela — ali niko se nije penjao na njih.",
 "evidence:evidence.stokehole_door.detail": "Stepenice na istočnom kraju staklenika vode dole, u kotlarnicu, gde je kotao. Odatle čvrsta hrastova vrata vode napolje, u podnožje zida ograđenog vrta.\n\nJedina reza im je s unutrašnje strane. Iz vrta se ne mogu ni zatvoriti ni otvoriti. U zoru su zatečena s otvorenom rezom.",
 "evidence:evidence.stokehole_door.name": "Vrata kotlarnice",
 "evidence:evidence.stokehole_door.summary": "Izlaz ispod staklenika: reza samo s unutrašnje strane — a zatečena je otvorena.",
 "evidence:evidence.will_draft.detail": "Nacrt iz aktovke gospodina Kittowa, spreman za potpisivanje „u 10.00, subota, 27. jul 1963.“, kojim se opoziva testament iz 1950. (po kome Penhallow pripada Julianu):\n\n— Penhallow House, s vrtovima i staklenicima, fondaciji National Trust, uz £40.000 za njihovo održavanje.\n— Julianu Penhallowu: £1.000 i knjige ser Edmunda.\n— Agnes Quill: kućica kod kapije doživotno i £300 godišnje.\n— Joryju Trevenni: njegova kuća i £500.\n— Edwinu Kittowu: zlatni sat ser Edmunda.\n— Mesečeva orhideja, sa svim svojim semenom, Kewu.",
 "evidence:evidence.will_draft.name": "Nacrt novog testamenta",
 "evidence:evidence.will_draft.summary": "Trebalo je da bude potpisan jutros u deset: Penhallow fondaciji National Trust; Julianu £1.000.",
 "suspects:suspects.agnes.bio": "Družbenica ledi Penhallow već dvadeset godina, od telegrama iz Burme. Vodi domaćinstvo, uveče čita naglas i zna svaku Hesterinu naviku. Sinoć joj je, uprkos zabrani, odnela termos s kakaom.",
 "suspects:suspects.agnes.dismissal": "Izvinite. Ne razumem na šta mislite.",
 "suspects:suspects.agnes.name": "Agnes Quill",
 "suspects:suspects.agnes.rebuttal": "Stajala sam na terasi s ostalima kada se oglasilo zvono. Dvadeset godina sam se brinula o njoj. Po novom testamentu dobila bih kućicu kod kapije — imala sam svaki razlog da želim da ga potpiše.",
 "suspects:suspects.agnes.role": "Družbenica",
 "suspects:suspects.celia.bio": "Julianova supruga već osam godina. Pre udaje bila je glumica u repertoarskim pozorištima — Bristol, Bath, jedna sezona u Stratfordu. Graciozna, hitra i budnog oka. Sinoć se rano povukla gore zbog glavobolje.",
 "suspects:suspects.celia.dismissal": "Dušo, moraćete da se potrudite više od toga.",
 "suspects:suspects.celia.name": "Celia Penhallow",
 "suspects:suspects.celia.rebuttal": "Ja? Četvoro ljudi videlo je Hester živu u pola dvanaest, a ja sam ostatak noći bila s njima. Čitali ste previše detektivskih priča.",
 "suspects:suspects.celia.role": "Sinovčeva supruga",
 "suspects:suspects.jory.bio": "U Penhallow je došao kao četrnaestogodišnji baštovanski šegrt, one godine kada je ser Edmund sagradio staklenik, a već trideset godina je glavni baštovan. U sumrak i u zoru loži kotao u stakleniku. Jutros u petnaest do šest pronašao je milostivu.",
 "suspects:suspects.jory.dismissal": "To ništa ne dokaziva, s oproštenjem.",
 "suspects:suspects.jory.name": "Jory Trevenna",
 "suspects:suspects.jory.rebuttal": "Ja? Ja bih za nju dao život, i za onu orhideju. Ko god da je izaš’o iz te kotlarnice, žurio je mnogo više nego što može jedan starac s bolesnim kolenom.",
 "suspects:suspects.jory.role": "Glavni baštovan",
 "suspects:suspects.julian.bio": "Sinovac ser Edmunda i, po sadašnjem testamentu, naslednik Penhallowa. Prodaje automobile u Plymouthu, a za imanje već ima spremnog kupca: firmu koja pravi kampove za odmor. Za večerom se posvađao sa strinom.",
 "suspects:suspects.julian.dismissal": "Bi to trebalo nešto da znači? Ja prodajem automobile, stara dušo. Prepoznam krntiju čim je vidim.",
 "suspects:suspects.julian.name": "Julian Penhallow",
 "suspects:suspects.julian.rebuttal": "Od deset i petnaest bio sam u biblioteci s Kittowom — pitajte njega, pitajte gospođu Pascoe. Radio sam stvari kojih se stidim. Ali strinu Hester nisam ni prstom dotakao.",
 "suspects:suspects.julian.role": "Sinovac",
 "suspects:suspects.kittow.bio": "Viši partner advokatske kancelarije Kittow & Pengelly iz Trura i već četrdeset godina advokat porodice Penhallow. Udovac, uljudan i staložen. Došao je da odsedne u kući kako bi novi testament mogao da bude potpisan jutros u deset.",
 "suspects:suspects.kittow.dismissal": "Četrdeset godina slušam argumente. S tim ne biste zadržali pažnju ni mirovnog sudije.",
 "suspects:suspects.kittow.name": "Edwin Kittow",
 "suspects:suspects.kittow.rebuttal": "Kada je, kako vi kažete, umrla, bio sam u biblioteci i raspravljao se s Julianom, a gospođa Pascoe nas je videla obojicu. U septembru bih se njome oženio. Tražite na drugom mestu — i tražite pažljivo.",
 "suspects:suspects.kittow.role": "Advokat",
 "suspects:suspects.marian.bio": "Stručnjakinja za orhideje, ovde — kako kaže — u ime ustanove Royal Botanic Gardens u Kewu, da fotografiše i zabeleži cvetanje. Već pet godina dopisuje se s ledi Penhallow i njena je štićenica.",
 "suspects:suspects.marian.dismissal": "To nije dokaz. To je anegdota.",
 "suspects:suspects.marian.name": "dr Marian Ellery",
 "suspects:suspects.marian.rebuttal": "Bila sam na terasi i snimala kada je ona zazvonila tim zvonom — videli ste fotografiju. A ja nikada, ali nikada ne bih dozvolila da se taj cvet zatvori netaknut. Ko god da je ovo uradio, do njega mu uopšte nije bilo stalo.",
 "suspects:suspects.marian.role": "Botaničarka"
}
