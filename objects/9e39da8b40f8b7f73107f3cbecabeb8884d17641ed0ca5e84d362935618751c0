{
 "case:accusation.methods.0": "काँसे के बुकएंड से वार किया",
 "case:accusation.methods.1": "जूताघर के साइनाइड से उसकी व्हिस्की में ज़हर मिलाया",
 "case:accusation.methods.2": "उसकी डिजिटैलिस की गोलियाँ दुगनी कर दीं",
 "case:accusation.methods.3": "दम घोंटा और गिरने का नाटक रचा",
 "case:accusation.motives.0": "सोमवार को नई वसीयत पर दस्तख़त होने से रोकने के लिए",
 "case:accusation.motives.1": "आधी रात को हार्टली वाले सौदे का भंडाफोड़ रोकने के लिए",
 "case:accusation.motives.2": "बरसों का ग़बन सोमवार के ऑडिट से छिपाने के लिए",
 "case:accusation.motives.3": "एक गुप्त प्रेम-संबंध को बचाने के लिए",
 "case:accusation.motives.4": "जुए के भारी क़र्ज़ से छुटकारा पाने के लिए",
 "case:accusation.proofLabels.0": "मौक़ा — मौत के वक़्त अध्ययन-कक्ष में मौजूद",
 "case:accusation.proofLabels.1": "झूठी एलिबाई — 10:15 की आवाज़ कैसे गढ़ी गई",
 "case:accusation.proofLabels.2": "मक़सद — यह इसी सप्ताहांत क्यों होना था",
 "case:accusation.successTitle": "केस बंद",
 "case:briefing.0": "लार्कस्पर हाउस, विल्टशायर। रविवार, 18 नवंबर 1962, सुबह के नौ बजे।",
 "case:briefing.1": "कल रात लायनल थॉर्न — तिरसठ बरस का, अपने दम पर उठा आदमी, Thorne Instruments का संस्थापक — अपने अध्ययन-कक्ष की मेज़ पर मृत पाया गया। आधी रात के जाम में एक घंटे से भी कम बाकी था; उसी जाम पर वह एक घोषणा करके ‘मैदान साफ़ करने’ वाला था।",
 "case:briefing.2": "तूफ़ान ने घाटी से बाहर जाने वाले इकलौते पुल को पानी में डुबो दिया। न कोई आया, न कोई गया। घर में उसके साथ छह लोग थे।",
 "case:briefing.3": "कॉन्स्टेबल पाइक ने — जो घुटनों तक भीगा है और जिसके लिए यह मामला बहुत भारी है — अध्ययन-कक्ष सील कर दिया है और आपसे कहा है कि काउंटी की पुलिस के पहुँचने से पहले आप इसकी छानबीन कर लें। उसके नोट्स फ़ाइल में हैं। उसका कहना है कि हर किसी के पास छिपाने को कुछ न कुछ है।",
 "case:briefing.4": "पता लगाइए कि लायनल थॉर्न की हत्या किसने की, कैसे की और क्यों — और इसे साबित करने के लिए तैयार रहिए।",
 "case:epilogue.0": "जब कॉन्स्टेबल पाइक ने एलेनॉर वॉस की बाँह थामी, तो वह एक शब्द नहीं बोली। काउंटी के थाने में जाकर ही, टाइम स्विच और अधूरे दस्तख़त वाली चिट्ठी के सामने, उसने बोलना शुरू किया — नपे-तुले ढंग से, जैसे वह हर काम करती थी।",
 "case:epilogue.1": "आठ साल से वह Calder & Rowe के ज़रिए पैसे निकाल रही थी: चालीस हज़ार पाउंड, एक-एक बिल टाइप करके गढ़े हुए। जब लायनल ने एक बिल पर लाल घेरा बनाया और सोमवार के लिए ऑडिटरों को बुला लिया, तो वह समझ गई कि उसके पास बस एक सप्ताहांत है।",
 "case:epilogue.2": "चार बजे ख़रगोश मारने का पाउडर। फिर चिट्ठियाँ, ताकि जब वह पास खड़ी हो, लायनल अपनी मेज़ पर झुका हो और व्हिस्की उसकी कोहनी के पास रखी हो। 15 नवंबर की रील, क्योंकि हॉब्स ने वह डिक्टेशन कभी नहीं सुना था। और सवा दस बजे के लिए सेट किया गया टाइम स्विच, क्योंकि घर में सब जानते थे कि हॉब्स उसी वक़्त अध्ययन-कक्ष की आग दबाने आता है — और यह भी कि वह मालिक के डिक्टेशन में कभी ख़लल नहीं डालेगा।",
 "case:epilogue.3": "उसने हर बात की योजना बनाई थी — सिवाय इसके कि लायनल थॉर्न उसी की चिट्ठी पर क़लम थामे दम तोड़ देगा।",
 "case:epilogue.4": "वसंत में डेनियल थॉर्न ने Thorne Instruments में काम शुरू किया — एक जूनियर क्लर्क के तौर पर। जेराल्ड फ़िंच ने अपने शेयर हार्टली को बेच दिए। मार्गरेट थॉर्न और फ़ेलिक्स हैरो ने अगले साल, बहुत चुपचाप, शादी कर ली।",
 "case:epilogue.5": "हॉब्स आज भी हर रात सवा दस बजे अध्ययन-कक्ष की आग दबाता है। उसका कहना है कि ऐसा न करे तो घर ठीक नहीं लगता।",
 "case:hints.h_accuse.levels.0": "अपना बोर्ड फिर से देखिए। लायनल की मौत के वक़्त अध्ययन-कक्ष में कौन था, 10:15 की ‘आवाज़’ से किसे एलिबाई मिली, और सोमवार से पहले किसके लिए उसका चुप हो जाना ज़रूरी था?",
 "case:hints.h_accuse.levels.1": "आरोप के हर हिस्से के लिए एक कार्ड चाहिए: मौक़ा, झूठी एलिबाई और मक़सद। अगर कोई कमी है, तो ऊपर के संकेत उसकी ओर इशारा कर चुके होंगे — अपनी नोटबुक दोबारा पढ़िए।",
 "case:hints.h_accuse.levels.2": "क़ातिल एलेनॉर वॉस है: व्हिस्की में साइनाइड, ताकि सोमवार के ऑडिट से उसका ग़बन छिपा रहे। इसे अधूरे दस्तख़त वाली चिट्ठी या फ़िंच के आँखों-देखे बयान, टाइम स्विच, और Calder & Rowe वाले निष्कर्ष (लायनल की मेज़ पर रखे बिल और एलेनॉर के टाइपराइटर से) के साथ साबित कीजिए।",
 "case:hints.h_accuse_ready.levels.0": "हो सकता है कि गिरफ़्तारी के लिए आपके पास काफ़ी कुछ हो। लायनल की मौत के वक़्त अध्ययन-कक्ष में कौन था, और 10:15 की ‘आवाज़’ से किसे एलिबाई मिली?",
 "case:hints.h_accuse_ready.levels.1": "सिर्फ़ एक ही व्यक्ति 10:15 पर ब्रिज की मेज़ पर था और 9:25 से 10:00 के बीच अध्ययन-कक्ष में भी। सोमवार से पहले उसे लायनल की मौत क्यों चाहिए थी?",
 "case:hints.h_accuse_ready.levels.2": "एलेनॉर वॉस पर आरोप लगाइए: व्हिस्की में साइनाइड, ताकि सोमवार के ऑडिट से उसका ग़बन छिपा रहे। इसे अधूरे दस्तख़त वाली चिट्ठी (या फ़िंच के आँखों-देखे बयान), टाइम स्विच (या टाइम स्विच वाले अपने निष्कर्ष) और Calder & Rowe वाले निष्कर्ष से साबित कीजिए।",
 "case:hints.h_affair.levels.0": "मार्गरेट और डॉ. हैरो बैठक के बारे में एक ही कहानी सुनाते हैं। शायद कुछ ज़्यादा ही सफ़ाई से।",
 "case:hints.h_affair.levels.1": "बैठक में मार्गरेट की चीज़ें टटोलिए — और शीशाघर भी देख आइए।",
 "case:hints.h_affair.levels.2": "मार्गरेट और हैरो के बैठक वाले बयानों को सिलाई की टोकरी में रखे पर्चे, या शॉल और सिगरेट-केस से चुनौती दीजिए।",
 "case:hints.h_calder.levels.0": "लायनल ने एक बिल पर लाल घेरा बनाया था। क्यों?",
 "case:hints.h_calder.levels.1": "Calder & Rowe के बिलों की छपाई कुछ अजीब है। क्या आपने ऐसी छपाई घर में कहीं और देखी है?",
 "case:hints.h_calder.levels.2": "Calder & Rowe के बिल और एलेनॉर के टाइपराइटर के साथ ‘एक फ़र्ज़ी फ़र्म’ जवाब दीजिए।",
 "case:hints.h_daniel.levels.0": "सबको डेनियल पर शक है। पर क्या उस शाम का उसका अपना ब्योरा सच है?",
 "case:hints.h_daniel.levels.1": "डेनियल कहता है कि वह अध्ययन-कक्ष के पास भी नहीं गया। अध्ययन-कक्ष की कोई चीज़ कुछ और ही कहती है।",
 "case:hints.h_daniel.levels.2": "डेनियल से पूछिए कि रात के खाने के बाद वह कहाँ गया, फिर उस बयान को जले हुए रुक्के या काँसे के बुकएंड से चुनौती दीजिए।",
 "case:hints.h_daniel_cleared.levels.0": "अब जब आपको पता है कि लायनल की मौत कब हुई, तो सबसे ज़ाहिर संदिग्ध पर फिर से नज़र डालिए।",
 "case:hints.h_daniel_cleared.levels.1": "रोज़ी का बयान बताता है कि उस निर्णायक आधे घंटे में डेनियल कहाँ था।",
 "case:hints.h_daniel_cleared.levels.2": "रोज़ी डन के बयान और मौत के समय वाले अपने निष्कर्ष के साथ ‘नहीं — वह बिलियर्ड्स के कमरे में था’ जवाब दीजिए।",
 "case:hints.h_eleanor_letters.levels.0": "एलेनॉर ज़ोर देकर कहती है कि जब वह निकली, तब लायनल ठीक था। क्या उसके वहाँ रहते हुए जो हुआ, उसका कोई निशान बचा है?",
 "case:hints.h_eleanor_letters.levels.1": "उस रात वह जो चिट्ठियाँ उसके पास ले गई थी, उन्हें ध्यान से देखिए। वे उसके दफ़्तर में हैं।",
 "case:hints.h_eleanor_letters.levels.2": "एलेनॉर के ‘तब वे बिल्कुल ठीक थे’ वाले बयान को उसकी जावक-ट्रे में रखी अधूरे दस्तख़त वाली चिट्ठी से चुनौती दीजिए।",
 "case:hints.h_eleanor_typing.levels.0": "एलेनॉर कहती है कि उसने शाम टाइप करते हुए बिताई। क्या किसी का बयान इससे मेल नहीं खाता?",
 "case:hints.h_eleanor_typing.levels.1": "अपनी केस फ़ाइल में नौकरानी का बयान दोबारा पढ़िए — या एलेनॉर का आतिशदान देखिए।",
 "case:hints.h_eleanor_typing.levels.2": "एलेनॉर के ‘अपने दफ़्तर में टाइप कर रही थी’ वाले बयान को रोज़ी डन के बयान या ठंडे आतिशदान से चुनौती दीजिए।",
 "case:hints.h_embezzle.levels.0": "एलेनॉर चाहती है कि आप Calder & Rowe को बिल्कुल मामूली फ़र्म मान लें। पर असलियत आपको पता है।",
 "case:hints.h_embezzle.levels.1": "आपके निष्कर्ष भी कार्ड हैं। पूछताछ में उन्हें भी पेश किया जा सकता है।",
 "case:hints.h_embezzle.levels.2": "एलेनॉर से Calder & Rowe के बारे में पूछिए, फिर उसके जवाब को अपने ‘Calder & Rowe फ़र्ज़ी है’ निष्कर्ष से चुनौती दीजिए।",
 "case:hints.h_finch.levels.0": "पुस्तकालय में जेराल्ड फ़िंच की वह शांत शाम कुछ ज़्यादा ही सुविधाजनक है।",
 "case:hints.h_finch.levels.1": "हॉल का टेलीफ़ोन जितना लगता है, उससे कहीं ज़्यादा राज़ छिपाए बैठा है।",
 "case:hints.h_finch.levels.2": "हॉल में टेलीफ़ोन पैड की जाँच कीजिए, फिर उससे फ़िंच के पुस्तकालय वाले बयान को चुनौती दीजिए।",
 "case:hints.h_finch_saw.levels.0": "फ़िंच बीस मिनट हॉल में खड़ा रहा। उसने क्या देखा होगा?",
 "case:hints.h_finch_saw.levels.1": "हॉल के टेलीफ़ोन के पास से अध्ययन-कक्ष का गलियारा सीधा दिखता है।",
 "case:hints.h_finch_saw.levels.2": "फ़िंच से पूछिए कि टेलीफ़ोन के पास से उसे क्या दिख रहा था।",
 "case:hints.h_harrow_blow.levels.0": "डॉ. हैरो ने मौत की वजह बताने में बड़ी जल्दी दिखाई।",
 "case:hints.h_harrow_blow.levels.1": "अध्ययन-कक्ष में किसी चीज़ से आती गंध महज़ वार से मारे गए आदमी की कहानी से मेल नहीं खाती।",
 "case:hints.h_harrow_blow.levels.2": "डॉ. हैरो से पूछिए कि लायनल की मौत कैसे हुई, फिर उसके बयान को मुरझाए फ़र्न से चुनौती दीजिए।",
 "case:hints.h_hobbs.levels.0": "जो बातें घरवालों से छूट जाती हैं, नौकर अक्सर उन्हें देख लेते हैं।",
 "case:hints.h_hobbs.levels.1": "लायनल को ‘ज़िंदा’ सुनने वाला आख़िरी व्यक्ति हॉब्स था।",
 "case:hints.h_hobbs.levels.2": "हॉब्स से पूछताछ कीजिए और उससे सवा दस बजे के बारे में पूछिए।",
 "case:hints.h_knees.levels.0": "जिसने भी टाइम स्विच लगाया, उसके लिए सुबह से पहले उसे हटाना ज़रूरी था। यह कब किया जा सकता था?",
 "case:hints.h_knees.levels.1": "शव मिलने के बाद की अफ़रा-तफ़री में शायद किसी ने कुछ देखा हो।",
 "case:hints.h_knees.levels.2": "जेराल्ड फ़िंच से पूछिए कि जब सब दौड़कर अध्ययन-कक्ष में घुसे, तब उसने क्या देखा।",
 "case:hints.h_office.levels.0": "लायनल का पत्राचार और डिक्टेशन ऐसी जगह रखे हैं, जहाँ अभी तक आपका जाना नहीं हुआ।",
 "case:hints.h_office.levels.1": "एलेनॉर वॉस के पास उसके दफ़्तर की चाबी है।",
 "case:hints.h_office.levels.2": "एलेनॉर से पूछिए कि रात के खाने के बाद वह कहाँ थी — वह आपको चाबी दे देगी।",
 "case:hints.h_papers.levels.0": "लायनल के अपने काग़ज़ उसके आख़िरी हफ़्ते के बारे में किसी भी गवाह से ज़्यादा बता सकते हैं।",
 "case:hints.h_papers.levels.1": "लायनल की मेज़ पर जो कुछ है, उसे देखिए: उसकी डायरी, और वे बिल जिनकी वह जाँच कर रहा था।",
 "case:hints.h_papers.levels.2": "अध्ययन-कक्ष में डेस्क-डायरी और चिट्ठियों की ट्रे की जाँच कीजिए।",
 "case:hints.h_poisoned.levels.0": "अब आपको पता है कि उसकी मौत कैसे हुई। इसे सबूत-बोर्ड पर पक्का कीजिए।",
 "case:hints.h_poisoned.levels.1": "बोर्ड पर ‘लायनल थॉर्न की असल में मौत कैसे हुई?’ सवाल खोलिए।",
 "case:hints.h_poisoned.levels.2": "‘ज़हर — उसकी व्हिस्की में साइनाइड’ जवाब दीजिए, और सबूत के तौर पर हैरो का साइनाइड वाला बयान (या फ़र्न) और चमकाया हुआ व्हिस्की का गिलास लगाइए।",
 "case:hints.h_recording.levels.0": "हॉब्स को लायनल के शब्द हू-ब-हू याद हैं। क्या आपने उन्हें कहीं लिखा हुआ देखा है?",
 "case:hints.h_recording.levels.1": "लायनल की पुरानी चिट्ठियाँ और डिक्टेशन की रीलें एलेनॉर के दफ़्तर में रखी हैं। उनका मिलान हॉब्स की सुनी बात से कीजिए।",
 "case:hints.h_recording.levels.2": "हॉब्स के बयान, 15 नवंबर की कार्बन कॉपी और टेप रिकॉर्डर (या रील के ख़ाली डिब्बे) के साथ ‘टेप रिकॉर्डर पर बजती डिक्टेशन की एक पुरानी रील’ जवाब दीजिए।",
 "case:hints.h_study.levels.0": "जो दोबारा देखते हैं, उन पर घटनास्थल मेहरबान रहता है। क्या आपने अध्ययन-कक्ष को ठीक से छाना है?",
 "case:hints.h_study.levels.1": "लायनल की मेज़ और उसके आसपास काग़ज़ों से ज़्यादा कुछ है। सोचिए कि उसने क्या पिया, और कौन-सी दवा ली।",
 "case:hints.h_study.levels.2": "अध्ययन-कक्ष में व्हिस्की का गिलास, गमले का फ़र्न और चाँदी की गोली-डिबिया जाँचिए।",
 "case:hints.h_switch.levels.0": "अगर आवाज़ रिकॉर्डिंग थी, तो वह ठीक सही पल पर शुरू कैसे हुई?",
 "case:hints.h_switch.levels.1": "देखिए कि रिकॉर्डर का प्लग कहाँ लगा था, और हॉब्स से पूछिए कि साहब का लैंप आम तौर पर कैसे लगा रहता है। फिर हॉल की तलाशी लीजिए।",
 "case:hints.h_switch.levels.2": "हॉल में टेलीफ़ोन-मेज़ की दराज़ जाँचकर टाइम स्विच ढूँढ़िए, फिर उसे प्लग निकले मेज़-लैंप के साथ जोड़िए।",
 "case:hints.h_timeline.levels.0": "शाम की हर घटना अब दर्ज हो चुकी है। क्या अब इन्हें सही क्रम में लगाया जा सकता है?",
 "case:hints.h_timeline.levels.1": "अपनी नोटबुक में घटनाक्रम खोलिए। जिन घटनाओं का समय पता है, उन्हें पहले जमाइए, फिर बाकी के बारे में तर्क से सोचिए।",
 "case:hints.h_timeline.levels.2": "सही क्रम: झगड़ा, बर्फ़, फ़िंच की कॉल, एलेनॉर की चिट्ठियाँ, ज़हर, ब्रिज, पुरानी रील, डेनियल, हॉब्स को शव मिलना, एलेनॉर का घुटनों के बल बैठना।",
 "case:hints.h_tod.levels.0": "लायनल पक्की आदतों वाला आदमी था। क्या शनिवार की रात उसने वे सब निभाईं?",
 "case:hints.h_tod.levels.1": "पता लगाइए कि लायनल को आख़िरी बार ज़िंदा कब देखा गया, और वह दिल की गोली कब लेता था। हॉब्स, मार्गरेट और डॉ. हैरो मदद कर सकते हैं।",
 "case:hints.h_tod.levels.2": "हॉब्स के 9:25 वाले बयान, गोली-डिबिया, और दस बजे की गोली के बारे में हैरो (या मार्गरेट) के बयान के साथ ‘रात 9:25 से 10:00 के बीच’ जवाब दीजिए।",
 "case:locations.conservatory.art.props.0.label": "शीशे की दीवार",
 "case:locations.conservatory.art.props.1.label": "शीशे की दीवार",
 "case:locations.conservatory.art.props.2.label": "शीशे की दीवार",
 "case:locations.conservatory.art.props.3.label": "ताड़",
 "case:locations.conservatory.art.props.4.label": "ऑर्किड की बेंच",
 "case:locations.conservatory.art.props.5.label": "टाइलों वाला फ़र्श",
 "case:locations.conservatory.art.props.6.label": "बेंत का सोफ़ा",
 "case:locations.conservatory.art.props.7.label": "हॉल की ओर शीशे का दरवाज़ा",
 "case:locations.conservatory.description": "लायनल का शीशाघर, जो हॉल से खुलता है। छत पर अब भी बारिश ढोल-सी बज रही है। यहाँ गरमाहट है, हरियाली है और — अँधेरा होने के बाद — पूरा एकांत।",
 "case:locations.conservatory.hotspots.hs_glass_door.label": "शीशे का दरवाज़ा",
 "case:locations.conservatory.hotspots.hs_glass_door.text": "शीशाघर के शीशे के दरवाज़े से हॉल के पार सीधे टेलीफ़ोन की मेज़ दिखती है। कल रात वहाँ खड़े किसी भी व्यक्ति ने यहाँ बैठे लोगों को ज़रूर देखा होगा — और ख़ुद भी देखा गया होगा।",
 "case:locations.conservatory.hotspots.hs_orchids.label": "ऑर्किड",
 "case:locations.conservatory.hotspots.hs_orchids.text": "लायनल के इनामी ऑर्किड, हर एक पर उसकी सधी लिखावट में पर्ची लगी है। एक पर्ची पर बस इतना लिखा है: ‘धीरज एक सटीक यंत्र है।’",
 "case:locations.conservatory.hotspots.hs_roof.label": "शीशे की छत",
 "case:locations.conservatory.hotspots.hs_roof.text": "शीशे की छत पर बारिश हथौड़े-सी बरस रही है। कल रात नौ बजे से मूसलाधार पानी गिरा था। चबूतरे पर टहलकर कोई सूखा नहीं लौट सकता था।",
 "case:locations.conservatory.hotspots.hs_wicker.label": "बेंत का सोफ़ा",
 "case:locations.conservatory.hotspots.hs_wicker.text": "ताड़ के पौधों के पीछे आधा छिपा बेंत का सोफ़ा, जिसकी गद्दियों में अब भी गड्ढे पड़े हैं।",
 "case:locations.conservatory.name": "शीशाघर",
 "case:locations.conservatory.summary": "शीशा, ऑर्किड और बारिश।",
 "case:locations.drawing_room.art.props.0.label": "आतिशदान",
 "case:locations.drawing_room.art.props.1.label": "सोफ़ा",
