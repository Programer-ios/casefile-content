 "case:timeline.title": "उस शाम की कड़ियाँ",
 "case:title": "आधी रात का जाम",
 "deductions:contradictions.c_daniel_study.insight": "डेनियल ने झूठ बोला: 10:45 पर वह अध्ययन-कक्ष में था। पर उसके मुताबिक़ उसका पिता तब तक मर चुका था — इसी से बुकएंड पर उँगलियों के निशान और आतिशदान में रुक्के की बात समझ में आती है।",
 "deductions:contradictions.c_daniel_study.response.0": "…ठीक है। ठीक है!",
 "deductions:contradictions.c_daniel_study.response.1": "पौने ग्यारह बजे मैं माफ़ी माँगने अंदर गया था। शराब की दी हुई हिम्मत थी, शायद। पिताजी मेज़ पर लुढ़के पड़े थे। मरे हुए। उनका हाथ छूते ही मैं समझ गया।",
 "deductions:contradictions.c_daniel_study.response.2": "वह बुकएंड फ़र्श पर पड़ा था। बिना सोचे मैंने उसे उठा लिया — फिर मैंने उनके सोख़्ते पर अपना रुक्का पड़ा देखा और… भगवान मुझे माफ़ करे, मैंने उसे आग में फेंक दिया। फिर मैं भाग निकला।",
 "deductions:contradictions.c_daniel_study.response.3": "मैंने उन्हें नहीं मारा। जब मैं पहुँचा, वे मर चुके थे। क़सम से।",
 "deductions:contradictions.c_daniel_study.title": "10:45 पर डेनियल अध्ययन-कक्ष में था",
 "deductions:contradictions.c_eleanor_calder.insight": "एलेनॉर एक फ़र्ज़ी सप्लायर के ज़रिए ग़बन करना क़बूल करती है — पर हत्या के मामले में अपनी एलिबाई के तौर पर 10:15 के ‘डिक्टेशन’ से चिपकी रहती है।",
 "deductions:contradictions.c_eleanor_calder.response.0": "…",
 "deductions:contradictions.c_eleanor_calder.response.1": "उन्नीस साल। उन्नीस साल उनकी चिट्ठियाँ, उनके मिज़ाज, और हज़ार चेकों पर मेरे हाथ से किए उनके दस्तख़त। आपको पता है वे मुझे कितना देते थे?",
 "deductions:contradictions.c_eleanor_calder.response.2": "हाँ। Calder & Rowe मैंने गढ़ी थी। मैंने वही लिया जो मेरा हक़ था। पर मैंने उन्हें नहीं मारा। सवा दस बजे वे ज़िंदा थे — हॉब्स ने उनकी आवाज़ सुनी थी।",
 "deductions:contradictions.c_eleanor_calder.title": "Calder & Rowe एलेनॉर की गढ़ी हुई थी",
 "deductions:contradictions.c_eleanor_letters.insight": "एलेनॉर जो चिट्ठियाँ लाई थी, उनमें से आख़िरी पर दस्तख़त है ‘लायनल थॉ—’, निब पन्ने से बाहर फिसलती हुई। वह थकान की वजह से नहीं रुका था। वह तब गिरा, जब एलेनॉर उसके पास खड़ी थी।",
 "deductions:contradictions.c_eleanor_letters.response.0": "वह? वे — वे थक गए होंगे। पूरा करने से पहले ही उन्होंने हाथ हिलाकर मुझे जाने को कह दिया। मिस्टर थॉर्न अक्सर काम अधूरे छोड़ देते थे।",
 "deductions:contradictions.c_eleanor_letters.response.1": "उसका हाथ सरककर गले तक जा पहुँचा है। हर किसी के कहे मुताबिक़, लायनल थॉर्न ने ज़िंदगी में कभी कोई काम अधूरा नहीं छोड़ा।",
 "deductions:contradictions.c_eleanor_letters.title": "दस्तख़त करते-करते लायनल की मौत हुई",
 "deductions:contradictions.c_eleanor_typing.insight": "एलेनॉर का दफ़्तर पूरी शाम अँधेरा और ठंडा रहा। अब वह मानती है कि लगभग नौ बजकर चालीस मिनट पर वह लायनल के साथ अध्ययन-कक्ष में थी — पर ज़ोर देती है कि जब वह निकली, तब लायनल ज़िंदा था।",
 "deductions:contradictions.c_eleanor_typing.response.0": "…समझी।",
 "deductions:contradictions.c_eleanor_typing.response.1": "ठीक है। मैं टाइप नहीं कर रही थी। लगभग नौ बजकर चालीस मिनट पर मैं दिन भर की चिट्ठियाँ मिस्टर थॉर्न के पास दस्तख़त के लिए ले गई थी। मैंने इसका ज़िक्र नहीं किया, क्योंकि मैं जानती थी कि यह कैसा लगेगा।",
 "deductions:contradictions.c_eleanor_typing.response.2": "पौने दस बजे जब मैं उन्हें छोड़कर आई, तब वे बिल्कुल ठीक थे। और सवा दस बजे तो वे डिक्टेशन दे रहे थे, है न? हॉब्स ने सुना था।",
 "deductions:contradictions.c_eleanor_typing.title": "एलेनॉर अपने दफ़्तर में नहीं थी",
 "deductions:contradictions.c_finch_library.insight": "फ़िंच ने अपना गुप्त सौदा छिपाने के लिए झूठ बोला। एक्सचेंज के बिल के हिसाब से वह 9:32 से 9:51 तक हॉल के टेलीफ़ोन पर था — जहाँ से अध्ययन-कक्ष का गलियारा साफ़ दिखता है।",
 "deductions:contradictions.c_finch_library.response.0": "…टेलीफ़ोन पैड पर उभरी छाप। आपकी नज़र तो बड़ी बारीक है।",
 "deductions:contradictions.c_finch_library.response.1": "ठीक है। मैं पुस्तकालय में नहीं था। साढ़े नौ बजे से मैं हॉल के टेलीफ़ोन पर रूपर्ट हार्टली से बात कर रहा था, उसे अपने शेयर बेचने का इंतज़ाम कर रहा था — लायनल इस बारे में चाहे जो सोचता।",
 "deductions:contradictions.c_finch_library.response.2": "उन्नीस मिनट, एक्सचेंज ने बताया। कारोबार था, क़त्ल नहीं।",
 "deductions:contradictions.c_finch_library.title": "फ़िंच टेलीफ़ोन पर हार्टली से बात कर रहा था",
 "deductions:contradictions.c_harrow_blow.insight": "लायनल पर वार नहीं हुआ था। उसे साइनाइड से ज़हर दिया गया था, और गिरते समय बुकएंड से उसकी कनपटी छिल गई।",
 "deductions:contradictions.c_harrow_blow.response.0": "…मुझे फिर से सोचने दीजिए।",
 "deductions:contradictions.c_harrow_blow.response.1": "घाव से ख़ून मुश्किल से निकला था, है न? जो आदमी पहले से मर रहा हो, उसका ख़ून ज़्यादा नहीं बहता। और कल रात कमरे में वह गंध — मैंने उसे ब्रांडी की गंध समझा। कड़वे बादाम। हे भगवान। साइनाइड।",
 "deductions:contradictions.c_harrow_blow.response.2": "वह उस चोट से नहीं मरा; गिरते हुए उसका सिर टकराया था। साइनाइड कुछ ही मिनटों में जान ले लेता है। लायनल को ज़हर दिया गया था — और मुझे यह देख लेना चाहिए था।",
 "deductions:contradictions.c_harrow_blow.title": "हैरो ने मौत की वजह ग़लत आँकी",
 "deductions:contradictions.c_harrow_room.insight": "डॉ. हैरो ने आधा घंटा बैठक में नहीं, शीशाघर में मार्गरेट के साथ बिताया।",
 "deductions:contradictions.c_harrow_room.response.0": "ओह।",
 "deductions:contradictions.c_harrow_room.response.1": "हाँ। साढ़े नौ से दस बजने में पाँच मिनट तक मैं शीशाघर में मार्गरेट के साथ था। हम अलग-अलग बैठक में लौटे।",
 "deductions:contradictions.c_harrow_room.response.2": "वह बेवक़ूफ़ी थी, और ग़लत थी। पर क़त्ल नहीं था।",
 "deductions:contradictions.c_harrow_room.title": "हैरो शीशाघर में था",
 "deductions:contradictions.c_margaret_room.insight": "साढ़े नौ और दस के बीच मार्गरेट बैठक में नहीं थी। वह शीशाघर में डॉ. हैरो के साथ थी।",
 "deductions:contradictions.c_margaret_room.response.0": "…यह आपको कहाँ मिला?",
 "deductions:contradictions.c_margaret_room.response.1": "ठीक है। फ़ेलिक्स और मैं लगभग साढ़े नौ से क़रीब दस बजे तक शीशाघर में थे। हम — एक-दूसरे को चाहते हैं। कुछ समय से।",
 "deductions:contradictions.c_margaret_room.response.2": "हम अलग-अलग लौटे ताकि किसी का ध्यान न जाए। हम पूरे समय साथ थे। फ़ेलिक्स से पूछ लीजिए।",
 "deductions:contradictions.c_margaret_room.title": "मार्गरेट शीशाघर में थी",
 "deductions:deductions.d_calder.conclusion": "Calder & Rowe के हर बिल पर वही ‘e’ है जो एलेनॉर के अपने टाइपराइटर पर ज़रा ऊपर और फीका छपता है। फ़र्म उसी ने गढ़ी और पैसा ख़ुद को दिया — और सोमवार के ऑडिट में यह पकड़ा जाता।",
 "deductions:deductions.d_calder.options.0": "पीतल की फ़िटिंग्स का एक असली सप्लायर",
 "deductions:deductions.d_calder.options.1": "Hartley Precision का एक मुखौटा",
 "deductions:deductions.d_calder.options.2": "एक फ़र्ज़ी फ़र्म, जिसके बिल एलेनॉर के टाइपराइटर पर टाइप हुए",
 "deductions:deductions.d_calder.options.3": "दूसरे नाम से डेनियल का सट्टेबाज़",
 "deductions:deductions.d_calder.proofLabels.0": "बिल",
 "deductions:deductions.d_calder.proofLabels.1": "जिस मशीन पर यह टाइप हुआ",
 "deductions:deductions.d_calder.question": "Calder & Rowe Supplies असल में क्या थी?",
 "deductions:deductions.d_calder.title": "Calder & Rowe फ़र्ज़ी है",
 "deductions:deductions.d_daniel_innocent.conclusion": "रोज़ी 9:30 से दस के बाद तक बिलियर्ड्स के कमरे में आती-जाती रही, और डेनियल वहाँ से कहीं नहीं गया। 10:45 पर जब वह लड़खड़ाता हुआ अध्ययन-कक्ष में पहुँचा, तब तक उसके पिता को मरे एक घंटा हो चुका था।",
 "deductions:deductions.d_daniel_innocent.options.0": "हाँ — 10:45 पर वह अध्ययन-कक्ष में अकेला था",
 "deductions:deductions.d_daniel_innocent.options.1": "हाँ — वह चुपके से बिलियर्ड्स के कमरे से निकल गया था",
 "deductions:deductions.d_daniel_innocent.options.2": "नहीं — वह बिलियर्ड्स के कमरे में था, जब लायनल को ज़हर दिया गया",
 "deductions:deductions.d_daniel_innocent.proofLabels.0": "डेनियल कहाँ था",
 "deductions:deductions.d_daniel_innocent.proofLabels.1": "लायनल की मौत कब हुई",
 "deductions:deductions.d_daniel_innocent.question": "क्या डेनियल अपने पिता को ज़हर दे सकता था?",
 "deductions:deductions.d_daniel_innocent.title": "यह डेनियल ने नहीं किया",
 "deductions:deductions.d_poison_source.conclusion": "जूताघर में रखा Vermitox का डिब्बा शुक्रवार को माली के जाने के बाद खोला गया। घर का कोई भी उस तक पहुँच सकता था — पर हॉब्स ने वहाँ से सिर्फ़ एलेनॉर और डेनियल को गुज़रते देखा।",
 "deductions:deductions.d_poison_source.options.0": "डॉ. हैरो का डॉक्टरी बैग",
 "deductions:deductions.d_poison_source.options.1": "जूताघर में रखा माली का ख़रगोश मारने वाले ज़हर का डिब्बा",
 "deductions:deductions.d_poison_source.options.2": "लायनल की अपनी दिल की गोलियाँ",
 "deductions:deductions.d_poison_source.options.3": "उसे लंदन से लाया गया था",
 "deductions:deductions.d_poison_source.proofLabels.0": "ज़हर का स्रोत",
 "deductions:deductions.d_poison_source.proofLabels.1": "मौत से जुड़ती कड़ी",
 "deductions:deductions.d_poison_source.question": "साइनाइड कहाँ से आया?",
 "deductions:deductions.d_poison_source.title": "जूताघर का ख़रगोश मारने वाला ज़हर",
 "deductions:deductions.d_poisoned.conclusion": "किसी ने लायनल की व्हिस्की में साइनाइड मिलाया, बची हुई तलछट फ़र्न में उँडेल दी और गिलास चमकाकर साफ़ कर दिया। कनपटी का घाव गिरने से लगा था।",
 "deductions:deductions.d_poisoned.options.0": "काँसे के बुकएंड के वार से",
 "deductions:deductions.d_poisoned.options.1": "ज़हर — उसकी व्हिस्की में साइनाइड",
 "deductions:deductions.d_poisoned.options.2": "झगड़े की वजह से पड़ा दिल का दौरा",
 "deductions:deductions.d_poisoned.options.3": "दम घोंटकर, फिर गिरने का नाटक रचकर",
 "deductions:deductions.d_poisoned.proofLabels.0": "साइनाइड के निशान",
 "deductions:deductions.d_poisoned.proofLabels.1": "उसने क्या पिया",
 "deductions:deductions.d_poisoned.question": "लायनल थॉर्न की असल में मौत कैसे हुई?",
 "deductions:deductions.d_poisoned.title": "व्हिस्की में साइनाइड",
 "deductions:deductions.d_recording.conclusion": "हॉब्स ने जो शब्द सुने, वे 15 नवंबर को डिक्टेट किए गए थे, और वही रील रिकॉर्डर में चढ़ी थी। 10:15 की ‘आवाज़’ से यह कुछ भी साबित नहीं होता कि लायनल की मौत कब हुई।",
 "deductions:deductions.d_recording.options.0": "लायनल एक नई चिट्ठी डिक्टेट कर रहा था",
 "deductions:deductions.d_recording.options.1": "कोई लायनल की आवाज़ की नक़ल कर रहा था",
 "deductions:deductions.d_recording.options.2": "टेप रिकॉर्डर पर बजती डिक्टेशन की एक पुरानी रील",
 "deductions:deductions.d_recording.options.3": "बैठक का रेडियो",
 "deductions:deductions.d_recording.proofLabels.0": "हॉब्स ने क्या सुना",
 "deductions:deductions.d_recording.proofLabels.1": "आवाज़ उसी पल की क्यों नहीं थी",
 "deductions:deductions.d_recording.proofLabels.2": "उसे किस चीज़ ने बजाया",
 "deductions:deductions.d_recording.question": "10:15 पर हॉब्स ने अध्ययन-कक्ष के दरवाज़े के पार असल में क्या सुना?",
 "deductions:deductions.d_recording.title": "आवाज़ एक रिकॉर्डिंग थी",
 "deductions:deductions.d_switch.conclusion": "रिकॉर्डर का तार 10:14 से 10:22 तक के लिए सेट किए गए टाइम स्विच के ज़रिए मेज़ के पीछे छिपे सॉकेट तक ले जाया गया था। जिसने भी इसे सेट किया, उसने ब्रिज की मेज़ पर अपने लिए एलिबाई ख़रीद ली — और फिर शव मिलने के बाद उसे स्विच हटाना पड़ा।",
 "deductions:deductions.d_switch.options.0": "मरने से पहले लायनल ने ख़ुद उसे चालू किया था",
 "deductions:deductions.d_switch.options.1": "मेज़-लैंप के सॉकेट में लगाया गया चाबी वाला टाइम स्विच",
 "deductions:deductions.d_switch.options.2": "10:14 पर कोई चुपके से अध्ययन-कक्ष में घुसा",
 "deductions:deductions.d_switch.options.3": "टेलीफ़ोन लाइन से वह चालू हो गया",
 "deductions:deductions.d_switch.proofLabels.0": "यंत्र",
 "deductions:deductions.d_switch.proofLabels.1": "उसे कैसे जोड़ा गया था",
 "deductions:deductions.d_switch.question": "जब लायनल मर चुका था, तो 10:14 पर रिकॉर्डर बजना कैसे शुरू हुआ?",
 "deductions:deductions.d_switch.title": "टाइम स्विच से गढ़ी गई एलिबाई",
 "deductions:deductions.d_time_of_death.conclusion": "हॉब्स ने उसे 9:25 पर भला-चंगा देखा था। वह दस बजे की अपनी गोली कभी नहीं भूलता था, फिर भी शनिवार की गोली डिबिया में ही थी। लायनल की मौत 9:25 से 10:00 के बीच हुई।",
 "deductions:deductions.d_time_of_death.options.0": "रात 9:25 से 10:00 के बीच",
 "deductions:deductions.d_time_of_death.options.1": "रात 10:15 से 10:45 के बीच",
 "deductions:deductions.d_time_of_death.options.2": "रात 10:45 से 11:10 के बीच",
 "deductions:deductions.d_time_of_death.options.3": "खाने की मेज़ से उठने से पहले",
 "deductions:deductions.d_time_of_death.proofLabels.0": "आख़िरी बार ज़िंदा देखा गया",
 "deductions:deductions.d_time_of_death.proofLabels.1": "वह गोली, जो उसने कभी नहीं ली",
 "deductions:deductions.d_time_of_death.proofLabels.2": "दस बजे की उसकी आदत",
 "deductions:deductions.d_time_of_death.question": "लायनल की मौत असल में कब हुई?",
 "deductions:deductions.d_time_of_death.title": "दस बजे से पहले मौत",
 "dialogues:statements.st_daniel_billiards.text": "खाने के बाद मैं बिलियर्ड्स के कमरे में पीता रहा। अध्ययन-कक्ष में मैंने क़दम तक नहीं रखा।",
 "dialogues:statements.st_daniel_boot_room.text": "झगड़े के बाद मैं चबूतरे से जूताघर के रास्ते अंदर आया।",
 "dialogues:statements.st_daniel_found_body.text": "पौने ग्यारह बजे पिताजी अँधेरे अध्ययन-कक्ष में पहले ही मर चुके थे। मैंने फ़र्श से बुकएंड उठाया और अपना रुक्का जला दिया।",
 "dialogues:statements.st_daniel_will.text": "सोमवार को पिताजी अपनी वसीयत बदलकर मुझे बेदख़ल करने वाले थे।",
 "dialogues:statements.st_eleanor_calder.text": "Calder & Rowe पीतल की फ़िटिंग्स का एक मामूली सप्लायर है।",
 "dialogues:statements.st_eleanor_embezzle.text": "Calder & Rowe मैंने गढ़ी थी और पैसा मैंने लिया। पर मैंने उन्हें नहीं मारा।",
 "dialogues:statements.st_eleanor_hall.text": "जब शव मिला, मैं टेलीफ़ोन करने हॉल में गई। लाइन ठप थी।",
 "dialogues:statements.st_eleanor_letters.text": "लगभग नौ बजकर चालीस मिनट पर मैं मिस्टर थॉर्न के पास दस्तख़त के लिए चिट्ठियाँ ले गई थी। पौने दस बजे जब मैं निकली, तब वे बिल्कुल ठीक थे।",
 "dialogues:statements.st_eleanor_reels.text": "हर सुबह मैं मिस्टर थॉर्न का डिक्टेशन टाइप करती हूँ और रीलें अपनी शेल्फ़ पर रखती हूँ।",
 "dialogues:statements.st_eleanor_typing.text": "खाना ख़त्म होने से दस बजे तक मैं अपने दफ़्तर में टाइप कर रही थी — जाम का भाषण।",
 "dialogues:statements.st_finch_eleanor_knees.text": "जब हम दौड़कर अध्ययन-कक्ष में घुसे, एलेनॉर मेज़ के पीछे घुटनों के बल बैठी थी; फिर वह टेलीफ़ोन करने चली गई।",
 "dialogues:statements.st_finch_library.text": "खाने और ब्रिज के बीच मैं पुस्तकालय में अकेला था, एक किताब के साथ।",
 "dialogues:statements.st_finch_phone.text": "9:32 से 9:51 तक मैं हॉल के टेलीफ़ोन पर रूपर्ट हार्टली से बात कर रहा था।",
 "dialogues:statements.st_finch_saw_eleanor.text": "क़रीब नौ बजकर चालीस मिनट पर एलेनॉर एक फ़ोल्डर लेकर अध्ययन-कक्ष की ओर गई, और कोई दस मिनट बाद लौटी।",
 "dialogues:statements.st_harrow_blow.text": "कनपटी पर हुए वार से उसकी मौत हुई, 11:15 से एक घंटे से भी कम पहले।",
 "dialogues:statements.st_harrow_conservatory.text": "साढ़े नौ से दस बजने में पाँच मिनट तक मैं शीशाघर में मार्गरेट के साथ था।",
 "dialogues:statements.st_harrow_cyanide.text": "लायनल को साइनाइड से ज़हर दिया गया था, जो कुछ ही मिनटों में जान ले लेता है। कनपटी का घाव गिरते समय लगा।",
 "dialogues:statements.st_harrow_drawing_room.text": "मैं पूरी शाम बैठक में था।",
 "dialogues:statements.st_harrow_earlier.text": "डॉक्टरी नज़र से, लायनल साढ़े नौ बजे से ही मरा हुआ हो सकता था।",
 "dialogues:statements.st_harrow_pill.text": "लायनल हर रात ठीक दस बजे डिजिटैलिस की एक गोली लेता था। कभी नहीं चूका।",
 "dialogues:statements.st_hobbs_boot_room.text": "शुक्रवार के बाद से जूताघर से होकर सिर्फ़ मिस वॉस (शनिवार को चार बजे) और मिस्टर डेनियल (झगड़े के बाद) गुज़रे।",
 "dialogues:statements.st_hobbs_ice.text": "9:25 पर मैं साहब के लिए ताज़ा बर्फ़ लेकर गया। उन्होंने अपनी व्हिस्की ख़ुद डाली और वे भले-चंगे थे।",
 "dialogues:statements.st_hobbs_lamp.text": "साहब कभी अँधेरे में काम नहीं करते थे, और रिकॉर्डर का प्लग हमेशा किताबों की अलमारी के पास ही लगता है।",
 "dialogues:statements.st_hobbs_voice.text": "10:15 पर मैंने साहब को डिक्टेशन देते सुना: ‘खेद है कि चौदह तारीख़ का आपका प्रस्ताव मुझे अस्वीकार करना पड़ रहा है।’",
 "dialogues:statements.st_margaret_conservatory.text": "फ़ेलिक्स और मैं साढ़े नौ से क़रीब दस बजे तक शीशाघर में साथ थे।",
 "dialogues:statements.st_margaret_drawing_room.text": "खाने के बाद मैं शोर मचने तक बैठक में ही रही।",
 "dialogues:statements.st_margaret_eleanor_hall.text": "शव मिलने के बाद एलेनॉर अकेली हॉल के टेलीफ़ोन की ओर गई।",
 "dialogues:statements.st_margaret_pill.text": "लायनल हर रात ठीक दस बजे अपनी डिजिटैलिस लेते थे। पाँच साल में एक बार भी नहीं चूके।",
 "dialogues:statements.st_margaret_toast.text": "लायनल ने कहा था कि यह जाम ‘पुराने हिसाब चुकता करेगा और मैदान साफ़ कर देगा’।",
 "dialogues:topics.t_daniel_boot_room.lines.0": "झगड़े के बाद मैं ठंडा होने के लिए चबूतरे पर निकल गया। बारिश में, किसी बेवक़ूफ़ की तरह। फिर टपकता हुआ जूताघर के रास्ते लौटा और जूते वहीं उतार फेंके।",
 "dialogues:topics.t_daniel_boot_room.lines.1": "अगर बात उस तरफ़ जा रही है, तो सुन लीजिए — मैंने ख़रगोश मारने के किसी ज़हर को हाथ तक नहीं लगाया। मुझे तो यह भी नहीं पता था कि घर में ऐसा कुछ रखा है।",
 "dialogues:topics.t_daniel_boot_room.prompt": "क्या कल रात आप जूताघर में गए थे?",
 "dialogues:topics.t_daniel_evening.lines.0": "खाने के बाद आप कहाँ गए थे, मिस्टर थॉर्न?",
 "dialogues:topics.t_daniel_evening.lines.1": "पिताजी के मुझे ज़लील कर चुकने के बाद? बिलियर्ड्स के कमरे में, उनकी सबसे बढ़िया स्कॉच की बोतल के साथ। हॉब्स के चीख़ने तक वहीं रहा।",
 "dialogues:topics.t_daniel_evening.lines.2": "खाने के बाद मैंने अध्ययन-कक्ष में क़दम तक नहीं रखा, अगर आपका इशारा उसी तरफ़ है।",
 "dialogues:topics.t_daniel_evening.prompt": "रात के खाने के बाद आप कहाँ गए?",
 "dialogues:topics.t_daniel_father.lines.0": "हर बात में सटीक। इस घर की हर घड़ी वे ख़ुद मिलाते थे, हर इतवार। उन्हें पसंद था कि हर चीज़ वक़्त पर चले — और हर आदमी उनके इशारे पर दौड़े।",
 "dialogues:topics.t_daniel_father.lines.1": "वे ठीक दो लोगों पर भरोसा करते थे: हॉब्स पर, और अपनी उस सेक्रेटरी पर। मुझ पर तो हरगिज़ नहीं।",
 "dialogues:topics.t_daniel_father.prompt": "आपके पिता कैसे इंसान थे?",
 "dialogues:topics.t_daniel_found.lines.0": "अँधेरा था। मेज़-लैंप बुझा था — बस आतिशदान की आग सुलग रही थी। वे मेज़ पर लुढ़के पड़े थे। मैंने दो बार उन्हें पुकारा।",
 "dialogues:topics.t_daniel_found.lines.1": "टेप मशीन चुप थी। कमरे में व्हिस्की और कोयले के धुएँ की गंध थी। मुझे बस इतना ही याद है। यह, और भागना।",
 "dialogues:topics.t_daniel_found.prompt": "मुझे ठीक-ठीक बताइए कि आपने अध्ययन-कक्ष में क्या देखा।",
 "dialogues:topics.t_daniel_quarrel.lines.0": "पूरी मेज़ ने आपको उन्हें धमकाते सुना।",
 "dialogues:topics.t_daniel_quarrel.lines.1": "उन्होंने सोहो के एक आदमी से मेरा रुक्का ख़रीद लिया था — पूरे तीन हज़ार पाउंड का। सूप के ऊपर से वह काग़ज़ मेरी ओर लहराया।",
 "dialogues:topics.t_daniel_quarrel.lines.2": "सोमवार को वे अपनी वसीयत बदलकर मुझे बेदख़ल करने वाले थे — जब तक कि मैं कारख़ाने में जूनियर क्लर्क बनकर काम शुरू न करूँ। क्लर्क! बत्तीस की उम्र में!",
 "dialogues:topics.t_daniel_quarrel.lines.3": "तो हाँ, मैंने कहा था कि इससे अच्छा तो मैं उन्हें क़ब्र में देखूँ। लोग कह देते हैं ऐसी बातें।",
 "dialogues:topics.t_daniel_quarrel.prompt": "खाने पर झगड़ा किस बात पर हुआ था?",
 "dialogues:topics.t_daniel_suspicion.lines.0": "एक तो जेराल्ड। पिताजी को उसके और हार्टली के बारे में कुछ पता चल गया था — खाने से पहले वे इस पर ख़ूब इतरा रहे थे।",
 "dialogues:topics.t_daniel_suspicion.lines.1": "और एलेनॉर पूरे हफ़्ते बिल्ली की तरह चौंकती रही है। उन्नीस साल से वही उनकी ज़िंदगी चला रही है। उससे पूछिए कि उसे किस बात का डर है।",
 "dialogues:topics.t_daniel_suspicion.prompt": "आपके ख़याल से आपके पिता की मौत कौन चाहता था?",
 "dialogues:topics.t_eleanor_alarm.lines.0": "मैं पुलिस को टेलीफ़ोन करने हॉल में गई। लाइन ठप थी — तूफ़ान की वजह से। फिर मैं लौटकर मिसेज़ थॉर्न के पास बैठ गई।",
 "dialogues:topics.t_eleanor_alarm.prompt": "जब शव मिला, तब आपने क्या किया?",
 "dialogues:topics.t_eleanor_calder.lines.0": "पीतल की फ़िटिंग्स का सप्लायर। बिल्कुल मामूली। बरसों से मैं उनके बिल चुकाती आई हूँ।",
 "dialogues:topics.t_eleanor_calder.lines.1": "शायद इस हफ़्ते मिस्टर थॉर्न ने एक बिल पर सवाल उठाया था। वे हर चीज़ पर सवाल उठाते थे।",
 "dialogues:topics.t_eleanor_calder.prompt": "Calder & Rowe Supplies क्या है?",
 "dialogues:topics.t_eleanor_duties.lines.0": "सब कुछ। उनकी डायरी, उनकी चिट्ठियाँ, हिसाब-किताब। हर शाम वे रीलों पर डिक्टेशन देते थे; हर सुबह मैं उन्हें टाइप करती और रीलें अपनी शेल्फ़ पर रख देती।",
 "dialogues:topics.t_eleanor_duties.lines.1": "उन्नीस साल। किसी-किसी दिन तो मैं उनका मन उनसे बेहतर जानती थी।",
 "dialogues:topics.t_eleanor_duties.prompt": "मिस्टर थॉर्न के लिए आपके काम में क्या-क्या शामिल था?",
 "dialogues:topics.t_eleanor_evening.lines.0": "अपने दफ़्तर में, आधी रात के जाम के लिए मिस्टर थॉर्न का भाषण टाइप कर रही थी। खाना ख़त्म होने से दस बजे तक — फिर मैं ब्रिज के लिए बाकी लोगों के पास चली गई।",
 "dialogues:topics.t_eleanor_evening.lines.1": "मेरा ख़याल है, आपको मेरा दफ़्तर भी देखना होगा — कॉन्स्टेबल पाइक दो बार चाबी माँग चुके हैं। यह लीजिए। रात को मैं इसे बंद रखती हूँ; मिस्टर थॉर्न के काग़ज़ात गोपनीय हैं।",
 "dialogues:topics.t_eleanor_evening.lines.2": "वह आपको पीतल की एक छोटी-सी चाबी थमा देती है। सचिव का दफ़्तर अब आपके लिए खुला है।",
 "dialogues:topics.t_eleanor_evening.prompt": "रात के खाने के बाद आप कहाँ थीं?",
 "dialogues:topics.t_eleanor_reel.lines.0": "तो किसी ने उसे मेरी शेल्फ़ से उठाया होगा। दिन में मैं दफ़्तर बंद नहीं करती — घर का कोई भी अंदर आ सकता था।",
 "dialogues:topics.t_eleanor_reel.lines.1": "मैं भला अपनी ही रीलों पर लेबल लगाकर उनमें से एक को मशीन में यूँ छोड़ देती कि वह आपको मिल जाए?",
 "dialogues:topics.t_eleanor_reel.prompt": "रिकॉर्डर में चढ़ी रील आपकी शेल्फ़ से आई थी।",
 "dialogues:topics.t_eleanor_switch.lines.0": "कितनी चतुराई की बात है। और उसके लिए कितनी सुविधाजनक, जो सवा दस बजे अध्ययन-कक्ष के आसपास भी नहीं था।",
 "dialogues:topics.t_eleanor_switch.lines.1": "ऐसे तो हम चार हैं — मिसेज़ थॉर्न, डॉ. हैरो, मिस्टर फ़िंच और मैं। आपको इससे बेहतर कुछ लाना होगा।",
 "dialogues:topics.t_eleanor_switch.prompt": "किसी ने टाइम स्विच के सहारे लायनल की आवाज़ का धोखा रचा।",
 "dialogues:topics.t_eleanor_toast.lines.0": "उनका रिटायरमेंट, और उनके उत्तराधिकारी का नाम। किसका, यह उन्होंने मुझे नहीं बताया था — नाम वे ख़ुद लिखने वाले थे।",
 "dialogues:topics.t_eleanor_toast.lines.1": "मिस्टर थॉर्न को लोगों को चौंकाना पसंद था।",
 "dialogues:topics.t_eleanor_toast.prompt": "आधी रात की घोषणा क्या थी?",
 "dialogues:topics.t_finch_alarm.lines.0": "फ़ेलिक्स लायनल पर झुक गया। मार्गरेट का चेहरा काग़ज़ जैसा सफ़ेद पड़ गया। और मैं — कहते शर्म आती है — दरवाज़े पर ही खड़ा रह गया।",
 "dialogues:topics.t_finch_alarm.lines.1": "एलेनॉर — अब आपने ज़िक्र छेड़ा है तो याद आता है — मेज़ के पीछे, दीवार की निचली पट्टी के पास घुटनों के बल बैठी थी। मुझे लगा, उसे चक्कर आ गया है। फिर वह बड़े इत्मीनान से उठी और बोली कि वह पुलिस को टेलीफ़ोन करेगी।",
 "dialogues:topics.t_finch_alarm.prompt": "जब आप सब दौड़कर अध्ययन-कक्ष में घुसे, तब आपने क्या देखा?",
 "dialogues:topics.t_finch_company.lines.0": "लायनल और मैंने इसे मिलकर खड़ा किया था। आगे इसे किस दिशा में ले जाना है, इस पर हमारी राय अलग थी। साझेदारों में ऐसा होता है।",
 "dialogues:topics.t_finch_company.lines.1": "इस महीने Hartley Precision ने हमें एक प्रस्ताव दिया। लायनल ने मुझसे पूछे बिना उसे ठुकरा दिया। लायनल ऐसा ही था।",
 "dialogues:topics.t_finch_company.prompt": "Thorne Instruments में हालात कैसे थे?",
 "dialogues:topics.t_finch_evening.lines.0": "पुस्तकालय में, एक किताब के साथ। ट्रोलोप। अकेला ही, अफ़सोस — मेरी गवाही देने वाला कोई नहीं। फिर दस बजे से ब्रिज।",
 "dialogues:topics.t_finch_evening.prompt": "खाने और ब्रिज के बीच आप कहाँ थे?",
 "dialogues:topics.t_finch_note.lines.0": "तो उसे पता चल गया था। वह उसी रात मुझसे इस्तीफ़ा दिलवाना चाहता था — या फिर अपने उस लाडले आधी रात के जाम पर मेरी तरफ़ से ख़ुद ऐलान कर देता।",
 "dialogues:topics.t_finch_note.lines.1": "यह अपमानजनक होता। पर चालीस साल पुराने दोस्त की जान लेने लायक़ नहीं। मैं साठ का हूँ; थोड़ा-बहुत अपमान झेल सकता हूँ।",
 "dialogues:topics.t_finch_note.prompt": "लायनल ने आपके लिए एक पर्चा छोड़ा था। उन्हें हार्टली के बारे में पता था।",
 "dialogues:topics.t_finch_saw.lines.0": "टेलीफ़ोन की मेज़ से गलियारे में सीधे अध्ययन-कक्ष तक दिखता है, और शीशे के दरवाज़े से उस पार शीशाघर के भीतर भी।",
 "dialogues:topics.t_finch_saw.lines.1": "मार्गरेट और फ़ेलिक्स शीशाघर में थे — एक-दूसरे में मगन, जैसे महीनों से हैं। और कोई नौ बजकर चालीस मिनट पर एलेनॉर बग़ल में फ़ोल्डर दबाए वहाँ से गुज़री, अध्ययन-कक्ष की ओर।",
 "dialogues:topics.t_finch_saw.lines.2": "दस मिनट बाद वह लौटी, शायद कुछ ज़्यादा। मेरी तरफ़ देखे बिना ठीक मेरे बग़ल से निकल गई। मैंने सोचा, लायनल को चिट्ठियों पर दस्तख़त करने होंगे।",
 "dialogues:topics.t_finch_saw.prompt": "टेलीफ़ोन के पास से आपको क्या दिख रहा था?",
 "dialogues:topics.t_harrow_cause.lines.0": "बाईं कनपटी पर वार। मेरे हिसाब से काँसे का बुकएंड — वह ठीक उसके बग़ल में पड़ा था। बेचारे को उसकी अपनी ही मेज़ पर मार गिराया गया।",
 "dialogues:topics.t_harrow_cause.lines.1": "सवा ग्यारह बजे जब मैंने उसकी जाँच की, तब उसे मरे एक घंटे से कम हुआ था। सवा दस बजे हॉब्स ने उसे डिक्टेशन देते सुना था, तो यही रहा आपका दायरा।",
 "dialogues:topics.t_harrow_cause.prompt": "लायनल की मौत कैसे हुई?",
 "dialogues:topics.t_harrow_earlier.lines.0": "अगर साइनाइड था — तो हाँ। आराम से। वह मिनटों में जान ले लेता है, और आग की वजह से वह कमरा भट्ठी जैसा गरम था।",
 "dialogues:topics.t_harrow_earlier.lines.1": "सवा दस बजे के हॉब्स वाले ‘डिक्टेशन’ को मैंने पत्थर की लकीर मान लिया था। डॉक्टरी नज़र से, लायनल साढ़े नौ बजे से ही मरा हुआ हो सकता था।",
 "dialogues:topics.t_harrow_earlier.prompt": "क्या उनकी मौत आपके अंदाज़े से पहले हुई हो सकती है?",
 "dialogues:topics.t_harrow_evening.lines.0": "बैठक में, पूरी शाम। ब्रांडी, फिर दस बजे से ब्रिज। मार्गरेट और मैं जोड़ीदार थे, एलेनॉर और जेराल्ड के ख़िलाफ़।",
 "dialogues:topics.t_harrow_evening.prompt": "रात के खाने के बाद आप कहाँ थे?",
 "dialogues:topics.t_harrow_lionel.lines.0": "प्रतिभाशाली। और असहनीय। उसने कोवेंट्री के एक शेड से Thorne Instruments खड़ी की, और जो भी उससे धीमा था, उसे कभी माफ़ नहीं किया।",
 "dialogues:topics.t_harrow_lionel.lines.1": "’42 में हम साथ-साथ रेगिस्तान में थे। उसने एक बार मेरी जान बचाई थी। मुझे वह कभी भूलने नहीं दिया गया।",
 "dialogues:topics.t_harrow_lionel.prompt": "लायनल कैसे इंसान थे?",
 "dialogues:topics.t_harrow_margaret.lines.0": "मुझे इस पर गर्व नहीं है। लायनल मेरा दोस्त था। पर मैं उससे प्यार करता हूँ — और लायनल अपनी कंपनी से प्यार करता था।",
 "dialogues:topics.t_harrow_margaret.prompt": "आप और मार्गरेट…",
 "dialogues:topics.t_harrow_pills.lines.0": "डिजिटैलिस। हर रात ठीक दस बजे एक गोली, एक गिलास पानी के साथ। 1957 में उसे दिल का दौरा पड़ने के बाद मैंने उससे इसकी क़सम ली थी।",
 "dialogues:topics.t_harrow_pills.lines.1": "वह कभी नहीं चूका। एक बार भी नहीं। उसे अपने दिल से बेहद डर लगता था।",
 "dialogues:topics.t_harrow_pills.prompt": "लायनल की दिल की गोलियों के बारे में बताइए।",
 "dialogues:topics.t_harrow_poisons.lines.0": "मेरे बैग से तो नहीं, अगर आपके मन में यही है — मैं ऐसी कोई चीज़ साथ नहीं रखता। पर हर देहाती हवेली में कुछ न कुछ होता है। ततैया मारने की दवा। ख़रगोशों के लिए गैस।",
 "dialogues:topics.t_harrow_poisons.lines.1": "हॉब्स से पूछिए कि माली जूताघर में क्या रखता है।",
 "dialogues:topics.t_harrow_poisons.prompt": "ऐसे घर में किसी को साइनाइड कहाँ से मिलेगा?",
 "dialogues:topics.t_hobbs_affair.lines.0": "यह कहना मेरा काम नहीं है।",
 "dialogues:topics.t_hobbs_affair.lines.1": "…मैंने उन्हें शीशाघर में देखा है। एक से ज़्यादा बार। मैं नहीं चाहता था कि साहब को इससे ठेस पहुँचे, इसलिए मैंने ज़बान बंद रखी।",
 "dialogues:topics.t_hobbs_affair.prompt": "क्या आपको मिसेज़ थॉर्न और डॉ. हैरो के बारे में पता था?",
 "dialogues:topics.t_hobbs_body.lines.0": "ग्यारह बजकर दस मिनट पर मिसेज़ थॉर्न ने मुझे जाम के लिए साहब को बुला लाने भेजा। अंगारों के सिवा कमरे में अँधेरा था। वे अपनी मेज़ पर लुढ़के पड़े थे।",
 "dialogues:topics.t_hobbs_body.lines.1": "तीस साल से मैं इस घर की सेवा कर रहा हूँ। मैंने ख़ुद को कभी इस तरह चीख़ते नहीं सुना था।",
 "dialogues:topics.t_hobbs_body.prompt": "आपको वे किस हाल में मिले?",
 "dialogues:topics.t_hobbs_boot_room.lines.0": "शुक्रवार को जब माली जेन्किन्स गया, तब वह डिब्बा बंद था। भंडार मैंने ख़ुद जाँचा था।",
 "dialogues:topics.t_hobbs_boot_room.lines.1": "उसके बाद? कल चार बजे मिस वॉस अपने रबर के जूते लेने आई थीं — बोलीं, बारिश से पहले ज़रा टहल आऊँ। और झगड़े के बाद मिस्टर डेनियल उसी रास्ते अंदर आए थे, सिर से पाँव तक भीगे हुए।",
 "dialogues:topics.t_hobbs_boot_room.prompt": "जूताघर में कौन-कौन गया था?",
 "dialogues:topics.t_hobbs_ice.lines.0": "नौ बजकर पच्चीस मिनट पर मैं उनके लिए ताज़ा बर्फ़ ले गया। उन्होंने अपनी व्हिस्की ख़ुद डाली — हमेशा ख़ुद ही डालते थे — और बड़े अच्छे मिज़ाज में थे। गुनगुना भी रहे थे।",
 "dialogues:topics.t_hobbs_ice.lines.1": "फिर साढ़े नौ बजे मैं नीचे मिसेज़ बेल के साथ खाना खाने चला गया।",
 "dialogues:topics.t_hobbs_ice.prompt": "आपने मिस्टर थॉर्न को आख़िरी बार कब देखा?",
 "dialogues:topics.t_hobbs_lamp.lines.0": "प्लग निकला हुआ? साहब कभी अँधेरे में नहीं बैठते थे। जब वे काम करते, वह लैंप हमेशा जलता रहता था।",
 "dialogues:topics.t_hobbs_lamp.lines.1": "और रिकॉर्डर की जगह किताबों की अलमारी के पास वाली छोटी मेज़ है। उसका प्लग वहीं बग़ल में लगता है। तार को पूरे कमरे के आर-पार ले जाने की कोई ज़रूरत नहीं।",
 "dialogues:topics.t_hobbs_lamp.prompt": "मेज़-लैंप का प्लग निकला हुआ था।",
 "dialogues:topics.t_hobbs_routine.lines.0": "साढ़े नौ बजे व्हिस्की। ठीक दस बजे उनकी गोली। सवा दस बजे आग दबाई जाती थी। हर इतवार वे रेडियो के समय-संकेत से घर की हर घड़ी मिलाते थे।",
 "dialogues:topics.t_hobbs_routine.lines.1": "साहब आदतों के पक्के थे। जो भी उन्हें जानता था, उनकी आदतें भी जानता था।",
 "dialogues:topics.t_hobbs_routine.prompt": "मिस्टर थॉर्न की शाम की दिनचर्या क्या थी?",
 "dialogues:topics.t_hobbs_switches.lines.0": "यह हमारा ही है। हॉल की अलमारी में हम तीन रखते हैं — लैंपों के लिए, जब परिवार लंदन में होता है। चोरों को दूर रखने के लिए।",
 "dialogues:topics.t_hobbs_switches.lines.1": "घर के हर व्यक्ति को पता होगा कि वे कहाँ रखे रहते हैं।",
 "dialogues:topics.t_hobbs_switches.prompt": "क्या आप इस टाइम स्विच को पहचानते हैं?",
 "dialogues:topics.t_hobbs_voice.lines.0": "सवा दस बजे मैं अध्ययन-कक्ष की आग दबाने ऊपर गया, जैसे हर रात जाता हूँ।",
 "dialogues:topics.t_hobbs_voice.lines.1": "दरवाज़े के पार मैंने साहब को डिक्टेशन देते सुना। एकदम साफ़: ‘खेद है कि चौदह तारीख़ का आपका प्रस्ताव मुझे अस्वीकार करना पड़ रहा है।’ सो मैं लौट आया। डिक्टेशन के दौरान साहब कभी कोई ख़लल बर्दाश्त नहीं करते थे।",
 "dialogues:topics.t_hobbs_voice.lines.2": "घर में हर कोई यह नियम जानता है।",
 "dialogues:topics.t_hobbs_voice.prompt": "कल रात सवा दस बजे के बारे में बताइए।",
 "dialogues:topics.t_margaret_alarm.lines.0": "हॉब्स चीख़ा और हम सब दौड़कर अंदर पहुँचे। फ़ेलिक्स सीधा लायनल के पास गया। जेराल्ड दरवाज़े पर बुत बना खड़ा रहा।",
 "dialogues:topics.t_margaret_alarm.lines.1": "एलेनॉर ने कहा कि वह पुलिस को टेलीफ़ोन करेगी और हॉल में चली गई — अकेली। लाइन तो ठप थी ही। और मुझे अफ़सोस है, मैं बेहोश हो गई।",
 "dialogues:topics.t_margaret_alarm.prompt": "जब शव मिला, तब क्या हुआ?",
 "dialogues:topics.t_margaret_daniel.lines.0": "डेनियल कमज़ोर है, बुरा नहीं। कैम्ब्रिज के दिनों से क़र्ज़ में डूबा है।",
 "dialogues:topics.t_margaret_daniel.lines.1": "अगर आपको जानना ही है, तो उसमें से कुछ मैं ख़ुद चुकाती आई हूँ। लायनल को कभी पता नहीं चला। कृपया डेनियल को मत बताइएगा कि मैंने आपको बताया।",
 "dialogues:topics.t_margaret_daniel.prompt": "क्या यह डेनियल का काम हो सकता है?",
 "dialogues:topics.t_margaret_eleanor.lines.0": "लायनल हर बात में उस पर भरोसा करते थे। बही-खाते, बैंक, उनके दस्तख़त, उनकी डायरी। मुझ पर जितना कभी नहीं किया, उससे कहीं ज़्यादा।",
 "dialogues:topics.t_margaret_eleanor.lines.1": "उन्नीस साल उनके साथ-साथ। कभी-कभी मुझे लगता है कि उनकी असली ब्याहता वह थी, मैं नहीं।",
 "dialogues:topics.t_margaret_eleanor.prompt": "एलेनॉर वॉस के बारे में आपकी क्या राय है?",
 "dialogues:topics.t_margaret_evening.lines.0": "बैठक में, बाकी लोगों के साथ। कॉफ़ी, थोड़ी ब्रांडी, फिर दस बजे से ब्रिज।",
 "dialogues:topics.t_margaret_evening.lines.1": "जब तक हॉब्स ने शोर नहीं मचाया, मैं वहाँ से हिली तक नहीं।",
 "dialogues:topics.t_margaret_evening.prompt": "रात के खाने के बाद आप कहाँ थीं?",
 "dialogues:topics.t_margaret_felix.lines.0": "दो साल से। मुझसे शादी करने से बहुत पहले ही लायनल की शादी Thorne Instruments से हो चुकी थी।",
 "dialogues:topics.t_margaret_felix.lines.1": "आख़िरकार मैं उनसे तलाक़ माँग ही लेती। उसके लिए मुझे उन्हें मारने की कभी ज़रूरत न पड़ती। कृपया — यह बात अपने तक रखिएगा।",
 "dialogues:topics.t_margaret_felix.prompt": "आप और डॉ. हैरो कब से…?",
 "dialogues:topics.t_margaret_health.lines.0": "उनका दिल कमज़ोर था। फ़ेलिक्स ने उन्हें डिजिटैलिस पर रखा था — हर रात दस बजे एक गोली, ठीक समय पर।",
 "dialogues:topics.t_margaret_health.lines.1": "लायनल कभी नहीं चूके। पाँच साल में एक बार भी नहीं। दुनिया की किसी भी चीज़ से ज़्यादा उन्हें अपने दिल का डर था।",
 "dialogues:topics.t_margaret_health.prompt": "क्या आपके पति की सेहत ठीक थी?",
 "dialogues:topics.t_margaret_toast.lines.0": "उन्होंने मुझे बताया ही नहीं। इस बात पर वे अपने आप से बेहद ख़ुश थे।",
 "dialogues:topics.t_margaret_toast.lines.1": "उन्होंने कहा था कि यह जाम ‘पुराने हिसाब चुकता करेगा और मैदान साफ़ कर देगा’। लायनल को रहस्य बहुत पसंद थे — बशर्ते राज़ उनके पास हो।",
 "dialogues:topics.t_margaret_toast.prompt": "आधी रात को लायनल क्या घोषणा करने वाले थे?",
 "evidence:evidence.bridge_scorepad.detail": "कल रात के खेल का स्कोर-पैड: ‘रबर 1 — 10:00’। एम.टी. और एफ़.एच. की जोड़ी बनाम ई.वी. और जी.एफ़. की जोड़ी। तीन रबर; आख़िरी प्रविष्टि का समय 11:05 है।\n\nदस बजे के बाद के घंटे भर के लिए चार लोगों ने एक-दूसरे को एलिबाई दी।",
 "evidence:evidence.bridge_scorepad.name": "ब्रिज का स्कोर-पैड",
 "evidence:evidence.bridge_scorepad.summary": "10:00 से 11:05 तक ब्रिज: मार्गरेट और हैरो बनाम एलेनॉर और फ़िंच।",
 "evidence:evidence.bronze_bookend.detail": "काँसे का एक भारी घोड़ा, जोड़ी में से एक, जिस पर कॉन्स्टेबल पाइक ने टैग लगाया है। एक कोने पर थोड़ा-सा ख़ून है। पाइक ने उस पर पाउडर छिड़ककर उँगलियों के निशानों का बिलियर्ड्स के कमरे में छोड़े गए डेनियल के व्हिस्की के गिलास से मोटा-मोटा मिलान किया है: ‘उसी के हैं, लगभग पक्का।’\n\nजानलेवा वार के हिसाब से, इससे कथित रूप से लगा घाव छोटा था। उससे मुश्किल से ख़ून निकला।",
 "evidence:evidence.bronze_bookend.name": "काँसे का बुकएंड",
 "evidence:evidence.bronze_bookend.summary": "एक कोने पर ख़ून — और डेनियल की उँगलियों के निशान।",
 "evidence:evidence.burnt_iou.detail": "अध्ययन-कक्ष के आतिशदान की राख में एक झुलसा टुकड़ा, जो पूरा नहीं जल पाया: ‘…अदा करने का वचन देता हूँ… £3,000 की रक़म… डेनियल थॉर्न’।\n\nयह राख के ऊपर पड़ा है, नीचे नहीं। इसे शाम को देर से आग में फेंका गया, जब आग मंद पड़ चुकी थी।",
 "evidence:evidence.burnt_iou.name": "जला हुआ रुक्का",
 "evidence:evidence.burnt_iou.summary": "एक झुलसा टुकड़ा: ‘…£3,000… डेनियल थॉर्न’।",
 "evidence:evidence.calder_invoice.detail": "‘Calder & Rowe Supplies — पीतल की फ़िटिंग्स, बर्मिंघम’ का £1,140 का बिल, जिस पर ‘भुगतान हो गया’ लिखा है। लायनल ने लाल पेंसिल से कुल रक़म पर घेरा बनाया है और एक प्रश्नचिह्न लगाया है।\n\nटाइपिंग थोड़ी असमान है: एक अक्षर जहाँ भी आता है, ज़रा ऊपर उठा रहता है और फीका छपता है।",
 "evidence:evidence.calder_invoice.name": "Calder & Rowe का बिल",
 "evidence:evidence.calder_invoice.summary": "लायनल ने इस पर लाल घेरा बनाकर प्रश्नचिह्न लगाया है।",
 "evidence:evidence.carbon_hartley.detail": "15 नवंबर की तारीख़ वाली एक कार्बन कॉपी, सर रूपर्ट हार्टली, Hartley Precision Ltd. के नाम (टेलीफ़ोन WHItehall 4021):\n\n‘प्रिय रूपर्ट — खेद है कि चौदह तारीख़ का आपका प्रस्ताव मुझे अस्वीकार करना पड़ रहा है। Thorne Instruments बिकाऊ नहीं है — जब तक मेरी साँस चल रही है, तब तक तो नहीं। — एल. थॉर्न’\n\nगुरुवार के डिक्टेशन से एलेनॉर ने टाइप की।",
 "evidence:evidence.carbon_hartley.name": "हार्टली के नाम कार्बन कॉपी",
 "evidence:evidence.carbon_hartley.summary": "15 नवंबर: ‘खेद है कि चौदह तारीख़ का आपका प्रस्ताव मुझे अस्वीकार करना पड़ रहा है।’",
 "evidence:evidence.cold_grate.detail": "एलेनॉर के दफ़्तर के आतिशदान में आग की पूरी तैयारी है — काग़ज़, खपच्चियाँ और कोयला — पर उसे कभी जलाया नहीं गया। आतिशदान पत्थर-सा ठंडा है।\n\nकल रात एलेनॉर ने जो भी किया हो, नवंबर की वह कड़कड़ाती शाम उसने यहाँ बैठकर टाइप करते हुए नहीं बिताई।",
 "evidence:evidence.cold_grate.name": "ठंडा आतिशदान",
 "evidence:evidence.cold_grate.summary": "एलेनॉर के दफ़्तर में आग की तैयारी थी, पर कल रात वह जलाई ही नहीं गई।",
 "evidence:evidence.constable_notes.detail": "शनिवार, 17 नवंबर। रात 9 बजे से भारी बारिश।\n\nशाम 7:30 — रात्रिभोज। उपस्थित: मृतक, मिसेज़ मार्गरेट थॉर्न, मिस्टर डेनियल थॉर्न, मिस एलेनॉर वॉस, मिस्टर जेराल्ड फ़िंच, डॉ. फ़ेलिक्स हैरो। परोसने वाला: बटलर ए. हॉब्स।\nरात 8:45 — मृतक और बेटे में झगड़ा। बेटे को कहते सुना गया: ‘इससे अच्छा तो मैं आपको क़ब्र में देखूँ।’\nरात 9:00 — मृतक अध्ययन-कक्ष में गया। निर्देश: आधी रात के जाम तक ख़लल न डाला जाए।\nरात 10:00 — बैठक में ब्रिज, 11:05 तक।\nरात 10:15 — बटलर ने अध्ययन-कक्ष के दरवाज़े के पार मृतक को डिक्टेशन देते सुना।\nरात 10:45 — नौकरानी ने बेटे को अध्ययन-कक्ष से निकलते देखा।\nरात 11:10 — बटलर ने मृतक को मेज़ पर लुढ़का पाया। बाईं कनपटी पर घाव; काँसे का बुकएंड फ़र्श पर। डॉ. हैरो: मौत ‘घंटे भर के भीतर’।\nरात 11:15 — टेलीफ़ोन लाइन ठप पाई गई (तूफ़ान)।\nरात 12:30 — अध्ययन-कक्ष मेरे द्वारा सील।\n\n— कॉन्स्टे. आर. पाइक",
 "evidence:evidence.constable_notes.name": "कॉन्स्टेबल पाइक के नोट्स",
 "evidence:evidence.constable_notes.summary": "कॉन्स्टेबल की नज़र से उस रात की घटनाएँ।",
 "evidence:evidence.cook_statement.detail": "बावर्चिन मिसेज़ बेल का बयान, कॉन्स्टे. पाइक द्वारा दर्ज:\n\n‘मिस्टर हॉब्स साढ़े नौ बजे नीचे आए और नौकरों के कमरे में मेरे साथ खाना खाया। सवा दस बजे वे अध्ययन-कक्ष की आग देखने ऊपर गए और दो मिनट के अंदर लौट आए, बोले कि साहब डिक्टेशन दे रहे हैं और उन्हें छेड़ना नहीं है। फिर ग्यारह बजकर दस मिनट तक, जब मिसेज़ थॉर्न ने घंटी बजाकर उन्हें बुलाया, वे अपनी जगह से हिले तक नहीं।’",
 "evidence:evidence.cook_statement.name": "मिसेज़ बेल का बयान",
 "evidence:evidence.cook_statement.summary": "बावर्चिन: 10:15 के दो मिनटों को छोड़कर, हॉब्स 9:30 से नौकरों के कमरे में था।",
 "evidence:evidence.desk_diary.detail": "गुरु 15 — हार्टली का प्रस्ताव: अस्वीकार (डिक्टेट किया)। Calder & Rowe?? व्यापार-निर्देशिका में ऐसी कोई फ़र्म नहीं।\n\nशनि 17 — आधी रात को जाम। मैदान साफ़।\n\nसोम 19 — 10:00 Pemberton & Co.: बही-खातों का पूरा ऑडिट। 3:00 ऑसगुड: नई वसीयत।",
 "evidence:evidence.desk_diary.name": "लायनल की डेस्क-डायरी",
 "evidence:evidence.desk_diary.summary": "सोमवार: दस बजे ऑडिट, तीन बजे नई वसीयत।",
 "evidence:evidence.finch_note.detail": "मेज़ की दराज़ में तह किया हुआ, लायनल के हाथ का लिखा एक पर्चा, जो कभी भेजा नहीं गया:\n\n‘जेराल्ड — मुझे हार्टली के बारे में पता है। जाम से पहले चुपचाप इस्तीफ़ा दे दो, वरना आधी रात को मैं तुम्हारी तरफ़ से इसका ऐलान कर दूँगा। — एल.’",
 "evidence:evidence.finch_note.name": "फ़िंच के नाम न भेजा गया पर्चा",
 "evidence:evidence.finch_note.summary": "लायनल को हार्टली के साथ फ़िंच की साँठ-गाँठ का पता था।",
 "evidence:evidence.half_signature.detail": "एलेनॉर की जावक-ट्रे में शनिवार की चिट्ठियों का एक फ़ोल्डर — टाइप की हुई, और लायनल के हाथ से दस्तख़त की हुई।\n\nआख़िरी चिट्ठी पर दस्तख़त आधा ही है — ‘लायनल थॉ—’ — स्याही एक लंबी, काँपती लकीर बनकर पन्ने के किनारे से बाहर निकल गई है।",
 "evidence:evidence.half_signature.name": "अधूरे दस्तख़त वाली चिट्ठी",
 "evidence:evidence.half_signature.summary": "‘लायनल थॉ—’, निब पन्ने से बाहर फिसलती हुई।",
 "evidence:evidence.love_note.detail": "मार्गरेट की सिलाई की टोकरी में, कढ़ाई के रेशमी धागों के नीचे, छोटा-सा तह करके खोंसा हुआ:\n\n‘मेरी प्यारी एम. — साढ़े नौ बजे शीशाघर में, जब सब अपनी ब्रांडी में लगे हों। इसे जला देना। — एफ़.’",
 "evidence:evidence.love_note.name": "सिलाई की टोकरी में रखा पर्चा",
 "evidence:evidence.love_note.summary": "‘साढ़े नौ बजे शीशाघर में… इसे जला देना। — एफ़.’",
 "evidence:evidence.maid_statement.detail": "नौकरानी रोज़ी डन का बयान, कॉन्स्टे. पाइक द्वारा दर्ज:\n\n‘साढ़े नौ बजे से मैं बिलियर्ड्स के कमरे के चक्कर लगाती रही — मिस्टर डेनियल बार-बार घंटी बजाकर सोडा और बर्फ़ मँगाते रहे। दस बजे के बाद तक वे उस कमरे से निकले ही नहीं, साहब; उनकी हालत ही ऐसी नहीं थी।\n\nनौ बजकर चालीस मिनट पर मैंने मिस वॉस के दफ़्तर में झाँका कि उनकी आग जला दूँ। वहाँ कोई नहीं था — लैंप बुझा हुआ, टाइपराइटर पर कवर चढ़ा हुआ।\n\nपौने ग्यारह बजे मैंने मिस्टर डेनियल को अध्ययन-कक्ष से निकलते देखा, चेहरा चादर-सा सफ़ेद।’",
 "evidence:evidence.maid_statement.name": "रोज़ी डन का बयान",
 "evidence:evidence.maid_statement.summary": "नौकरानी: डेनियल बिलियर्ड्स के कमरे से निकला ही नहीं; 9:40 पर एलेनॉर का दफ़्तर ख़ाली था।",
 "evidence:evidence.phone_pad.detail": "टेलीफ़ोन पैड का सबसे ऊपर का पन्ना फाड़ लिया गया है, पर पेंसिल का दबाव नीचे तक उतर आया था। नीचे वाले पन्ने पर हल्के से पेंसिल फेरते ही लिखावट उभर आती है:\n\n‘हार्टली — WHI 4021 — बुक 9:32 — 19 मिनट — 4 शि. 9 पें. — जी.एफ़.’",
 "evidence:evidence.phone_pad.name": "टेलीफ़ोन पैड पर उभरी छाप",
 "evidence:evidence.phone_pad.summary": "WHItehall 4021 पर 19 मिनट की कॉल, 9:32 पर ‘जी.एफ़.’ द्वारा बुक।",
 "evidence:evidence.pill_box.detail": "सात छोटे ढक्कनों वाली चाँदी की गोली-डिबिया, जिन पर हफ़्ते के दिन खुदे हैं। हर ख़ाने में डिजिटैलिस की एक गोली आती है।\n\nरविवार की गोली मौजूद है — और शनिवार की भी।",
 "evidence:evidence.pill_box.name": "चाँदी की गोली-डिबिया",
 "evidence:evidence.pill_box.summary": "शनिवार की गोली कभी ली ही नहीं गई।",
 "evidence:evidence.rabbit_poison.detail": "जूताघर की टाँड़ पर: ख़रगोशों के बिलों में गैस छोड़ने वाले Vermitox पाउडर का एक डिब्बा। लेबल चेतावनी देता है: साइनाइड — ज़हर।\n\nढक्कन हाल ही में उचकाकर खोला गया है — खरोंचें ताज़ा और चमकदार हैं — और भीतर के पाउडर पर चम्मच से निकाले जाने का निशान है।",
 "evidence:evidence.rabbit_poison.name": "ख़रगोश मारने वाले ज़हर का डिब्बा",
 "evidence:evidence.rabbit_poison.summary": "Vermitox का साइनाइड पाउडर, हाल ही में खोला गया।",
 "evidence:evidence.shawl_case.detail": "बेंत के सोफ़े पर: मार्गरेट की स्लेटी कश्मीरी शॉल। एक गद्दी के नीचे चाँदी का सिगरेट-केस, जिस पर ‘एफ़.एच.’ खुदा है।\n\nऑर्किड के गमले में सिगरेट के दो टोटे हैं, एक पर लिपस्टिक का निशान।",
 "evidence:evidence.shawl_case.name": "शॉल और सिगरेट-केस",
 "evidence:evidence.shawl_case.summary": "शीशाघर में मार्गरेट की शॉल, और ‘एफ़.एच.’ खुदा एक सिगरेट-केस।",
 "evidence:evidence.tape_recorder.detail": "किताबों की अलमारी के पास वाली छोटी मेज़ पर एक Grundig रील-टू-रील टेप रिकॉर्डर। रील पर साफ़ लिखावट में लेबल है ‘15 NOV — HARTLEY / BANK / MISC’, और वह लगभग एक-तिहाई चल चुकी है।\n\nअजीब बात है कि तार ठीक बग़ल वाले सॉकेट में नहीं लगा है। वह कालीन के आर-पार मेज़ के पीछे वाले सॉकेट तक जाता है।",
 "evidence:evidence.tape_recorder.name": "टेप रिकॉर्डर",
 "evidence:evidence.tape_recorder.summary": "इसमें ‘15 NOV — HARTLEY’ लेबल वाली रील चढ़ी है, और प्लग कमरे के उस पार लगा है।",
 "evidence:evidence.tape_shelf.detail": "लेबल लगे डिब्बों में लायनल के डिक्टेशन की रीलें, एलेनॉर की लिखावट में तारीख़वार एक सधी हुई क़तार। एक डिब्बा ख़ाली मुँह बाए पड़ा है: ‘15 NOV — HARTLEY / BANK / MISC’।\n\nएलेनॉर हर सुबह रीलों को टाइप करती है। उसके अलावा, वे इस शेल्फ़ से कभी नहीं हटतीं।",
 "evidence:evidence.tape_shelf.name": "डिक्टेशन रीलों की शेल्फ़",
 "evidence:evidence.tape_shelf.summary": "एक डिब्बा ख़ाली है: ‘15 NOV — HARTLEY / BANK / MISC’।",
 "evidence:evidence.time_switch.detail": "टेलीफ़ोन-मेज़ की दराज़ में डायरेक्टरी के नीचे फँसाया हुआ: चाबी वाला एक टाइम स्विच, उस तरह का जिससे घर ख़ाली रहने पर लैंप जलाए जाते हैं।\n\nउसके डायल की खूँटियाँ सेट हैं: रात 10:14 पर चालू, रात 10:22 पर बंद।",
 "evidence:evidence.time_switch.name": "चाबी वाला टाइम स्विच",
 "evidence:evidence.time_switch.summary": "टेलीफ़ोन की दराज़ में छिपा हुआ। 10:14 पर चालू और 10:22 पर बंद होने के लिए सेट।",
 "evidence:evidence.typewriter_flaw.detail": "एलेनॉर का Imperial टाइपराइटर। मशीन में अब भी लगी एक परीक्षण-पंक्ति इसकी ख़ामी दिखाती है: हर छोटा ‘e’ ज़रा ऊपर और फीका छपता है।",
 "evidence:evidence.typewriter_flaw.name": "एलेनॉर का टाइपराइटर",
 "evidence:evidence.typewriter_flaw.summary": "इसका छोटा ‘e’ ज़रा ऊपर और फीका छपता है।",
 "evidence:evidence.unplugged_lamp.detail": "हरे शेड वाले मेज़-लैंप का स्विच ऑन है — पर वह बुझा हुआ है। उसका प्लग मेज़ के पीछे कालीन पर पड़ा है।\n\nवहाँ पीछे का इकलौता सॉकेट, जो मेज़ की ओट में होने से दरवाज़े से नहीं दिखता, उसमें टेप रिकॉर्डर का तार लगा है — जिसे पूरे कमरे के आर-पार खींचकर लाया गया है।",
 "evidence:evidence.unplugged_lamp.name": "प्लग निकला मेज़-लैंप",
 "evidence:evidence.unplugged_lamp.summary": "स्विच ऑन, फिर भी बुझा। इसके सॉकेट में रिकॉर्डर का तार लगा है।",
 "evidence:evidence.whisky_glass.detail": "मेज़ पर तराशे काँच का गिलास, चमकाकर बेदाग़ और एकदम सूखा — उस पर उँगली का एक निशान तक नहीं। फिर भी बग़ल की सुराही, जिसे हॉब्स ने खाने से पहले भरा था, अच्छा-ख़ासा एक पैग कम है।\n\nलायनल ने अपने लिए पैग बनाया था। बाद में किसी ने सफ़ाई कर दी।",
 "evidence:evidence.whisky_glass.name": "चमकाया हुआ व्हिस्की का गिलास",
 "evidence:evidence.whisky_glass.summary": "बेदाग़ और सूखा, जबकि सुराही से एक पैग कम है।",
 "evidence:evidence.wilted_fern.detail": "मेज़ के पास गमले का फ़र्न रात भर में ढह गया है, उसकी पत्तियाँ सिरों पर भूरी पड़ रही हैं। मिट्टी गीली है — किसी ने उसमें कुछ उँडेला है — और पास झुकने पर उसमें से कड़वे बादाम की हल्की, मीठी-सी गंध आती है।",
 "evidence:evidence.wilted_fern.name": "मुरझाया फ़र्न",
 "evidence:evidence.wilted_fern.summary": "रात भर में ढह गया; मिट्टी से कड़वे बादाम की गंध आती है।",
 "suspects:suspects.daniel.bio": "पहली शादी से लायनल का इकलौता बेटा। मनमोहक, निकम्मा, और लंदन के एक सट्टेबाज़ का तीन हज़ार पाउंड का क़र्ज़दार। रात के खाने पर उसने सबके सामने अपने पिता को धमकी दी।",
 "suspects:suspects.daniel.dismissal": "बस इतना ही है आपके पास? इससे कड़ी बातें तो मुझे मेरा दर्ज़ी सुना चुका है।",
 "suspects:suspects.daniel.name": "डेनियल थॉर्न",
 "suspects:suspects.daniel.rebuttal": "मैं? रोज़ी से पूछिए — वह पूरी शाम बिलियर्ड्स के कमरे में आती-जाती रही। जब तक मैं उस अध्ययन-कक्ष में गया, पिताजी जा चुके थे। आपने ग़लत थॉर्न को पकड़ा है।",
 "suspects:suspects.daniel.role": "बेटा",
 "suspects:suspects.eleanor.bio": "उन्नीस साल से लायनल की निजी सचिव। उसकी डायरी, उसका पत्राचार, उसके डिक्टेशन की रीलें और कंपनी का हिसाब-किताब वही सँभालती है। संयत, सटीक, और ऐसी कि उसके बिना काम न चले।",
 "suspects:suspects.eleanor.dismissal": "मुझे यक़ीन है, आपको यह बड़ी अहम बात लगी होगी।",
 "suspects:suspects.eleanor.name": "एलेनॉर वॉस",
 "suspects:suspects.eleanor.rebuttal": "जब हॉब्स ने मिस्टर थॉर्न को डिक्टेशन देते सुना, तब मैं ब्रिज की मेज़ पर थी — तीन गवाहों के साथ। आपकी कल्पना आपको बहुत दूर बहा ले गई है।",
 "suspects:suspects.eleanor.role": "सचिव",
 "suspects:suspects.finch.bio": "तीस साल से Thorne Instruments का सह-संस्थापक और साथी डायरेक्टर। चतुर और धीमे बोलने वाला, और इन दिनों कंपनी के भविष्य को लेकर लायनल से उसकी ठनी हुई थी।",
 "suspects:suspects.finch.dismissal": "बोर्डरूम की मेज़ों के उस पार मैंने आपसे कहीं बेहतर झाँसेबाज़ देखे हैं।",
 "suspects:suspects.finch.name": "जेराल्ड फ़िंच",
 "suspects:suspects.finch.rebuttal": "मैं बीस मिनट टेलीफ़ोन पर रूपर्ट हार्टली से बात कर रहा था — एक्सचेंज इसकी पुष्टि करेगा। हाँ, मैंने लायनल की कंपनी से दग़ा की। पर उसे ज़हर नहीं दिया। आपको उसे ढूँढ़ना चाहिए जो सचमुच उस कमरे में था।",
 "suspects:suspects.finch.role": "साझेदार",
 "suspects:suspects.harrow.bio": "परिवार का डॉक्टर और जंग के दिनों से लायनल का दोस्त। कल रात उसी ने शव की जाँच की और मौत की वजह बताई।",
 "suspects:suspects.harrow.dismissal": "मैं डॉक्टर हूँ, बेवक़ूफ़ नहीं। इससे कुछ भी साबित नहीं होता।",
 "suspects:suspects.harrow.name": "डॉ. फ़ेलिक्स हैरो",
 "suspects:suspects.harrow.rebuttal": "मैं मार्गरेट के साथ शीशाघर में था, भगवान मुझे माफ़ करे — और जेराल्ड ने हमें वहाँ देखा था। लायनल को ज़हर देना मेरे लिए अपनी माँ को ज़हर देने जैसा है। उसे देखिए जो उस अध्ययन-कक्ष में था।",
 "suspects:suspects.harrow.role": "डॉक्टर",
 "suspects:suspects.hobbs.bio": "तीस साल से लार्कस्पर हाउस का बटलर। राज़दार, वक़्त का पाबंद और बेहद वफ़ादार। लायनल थॉर्न को ज़िंदा सुनने वाला आख़िरी व्यक्ति — या ऐसा सब मानते हैं।",
 "suspects:suspects.hobbs.dismissal": "पूरे अदब के साथ, मैं ठीक से समझ नहीं पाया।",
 "suspects:suspects.hobbs.name": "ऐल्बर्ट हॉब्स",
 "suspects:suspects.hobbs.rebuttal": "साढ़े नौ बजे से मैं नौकरों के कमरे में था — मिसेज़ बेल आपको यही बताएँगी। मैंने तीस साल मिस्टर थॉर्न की सेवा की। ऐसा करने से पहले मैं अपना हाथ काट लेता।",
 "suspects:suspects.hobbs.role": "बटलर",
 "suspects:suspects.margaret.bio": "नौ साल से लायनल की दूसरी पत्नी। मिनट-मिनट के हिसाब से चलने वाले घर में सुरुचिपूर्ण, बेचैन और अकेली। मौजूदा वसीयत के तहत लार्कस्पर हाउस उसे मिलता है।",
 "suspects:suspects.margaret.dismissal": "मेरी समझ में नहीं आता कि इसका मुझसे क्या लेना-देना है।",
 "suspects:suspects.margaret.name": "मार्गरेट थॉर्न",
 "suspects:suspects.margaret.rebuttal": "आपकी यह हिम्मत! जब यह हुआ, मैं फ़ेलिक्स के साथ शीशाघर में थी — जेराल्ड ने हमें शीशे के पार देखा था। मैंने और जो भी किया हो, अपने पति की हत्या नहीं की।",
 "suspects:suspects.margaret.role": "पत्नी"
}
