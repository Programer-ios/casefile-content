 "dialogues:statements.st_agnes_stick.text": "بیگم صاحبہ اپنی چھڑی کے بغیر ایک قدم بھی نہیں اٹھا سکتی تھیں، اور دس برس سے کسی سیڑھی پر نہیں چڑھی تھیں۔",
 "dialogues:statements.st_celia_bed.text": "ساڑھے دس بجے سے میں بستر میں تھی۔ گھنٹی سے میری آنکھ کھلی، اور میں نے اپنی کھڑکی سے ہیسٹر کو دیکھا۔",
 "dialogues:statements.st_celia_didnt_know.text": "میں کسی جعل سازی کے بارے میں کچھ بھی نہیں جانتی، نہ کسی رہن کے بارے میں۔",
 "dialogues:statements.st_celia_knew.text": "ہیسٹر نے مجھے چھ بجے بتا دیا تھا کہ جولیئن نے ان کے جعلی دستخط کیے ہیں، اور یہ کہ صبح ثبوت مسٹر کٹو کے پاس جائے گا۔",
 "dialogues:statements.st_celia_plead.text": "گیارہ بجنے میں بیس منٹ پر میں وصیت کے معاملے پر ہیسٹر کی منت کرنے شیشہ گھر گئی۔ جب میں گیارہ بجنے میں دس منٹ پر وہاں سے نکلی تو وہ زندہ تھیں، اپنا روزنامچہ لکھ رہی تھیں۔",
 "dialogues:statements.st_celia_rose_walk.text": "مجھے نیند نہیں آ رہی تھی، اس لیے میں گلابوں کی روش پر ٹہلتی رہی، یہاں تک کہ گھنٹی سنائی دی، پھر اندر آ گئی۔ میں شیشہ گھر کے پاس بھی نہیں گئی۔",
 "dialogues:statements.st_jory_bed.text": "نو بجے میں نے بوائلر کی آگ دبائی اور دس بجے تک اپنے بستر میں تھا۔",
 "dialogues:statements.st_jory_dawn.text": "پونے چھ بجے چاندنی آرکڈ ابھی تک کھلا ہوا تھا، اور کسی نے اس کی زیرگی نہیں کی تھی۔ میں نے خود کر دی، انہی کے برش سے۔",
 "dialogues:statements.st_jory_figure.text": "لیمپ نیچے ہونے کے چند منٹ بعد میں نے ہلکے رنگ کا ایک ہیولا دیکھا، کوئی لمبی سی چیز پہنے، جو بھٹی خانے سے اوپر نکلا اور دیوار کے ساتھ ساتھ لپکتا ہوا گھر کی طرف چلا گیا۔",
 "dialogues:statements.st_jory_ladder.text": "بیگم صاحبہ اس سیڑھی پر کبھی نہیں چڑھتی تھیں۔ وہ دروازے کے پاس اپنی کھونٹی پر ٹنگی رہتی ہے، اور وٹسن کے تہوار سے نہیں اتری تھی۔",
 "dialogues:statements.st_jory_stokehole.text": "نو بجے میں نے بھٹی خانے کے دروازے کی چٹخنی لگائی تھی۔ پو پھٹے چٹخنی کھلی ہوئی تھی، اور کسی نے میرے بوائلر میں کچھ جلایا تھا۔",
 "dialogues:statements.st_julian_debts.text": "میری کمپنی Penhallow Motors مشکل میں ہے، مگر میں نے اسے ایمانداری سے ڈوبنے نہیں دیا۔ میں نے کبھی کوئی مجرمانہ حرکت نہیں کی۔",
 "dialogues:statements.st_julian_drawing_room.text": "گھنٹی کے بعد میں نے دیوان خانہ ایک بار بھی نہیں چھوڑا، یہاں تک کہ ایک بجے ہم سب اوپر چلے گئے۔",
 "dialogues:statements.st_julian_forgery.text": "میں نے ہوم فارم کے 20,000 پاؤنڈ کے رہن نامے پر آنٹ ہیسٹر کے جعلی دستخط کیے۔",
 "dialogues:statements.st_julian_glasshouse.text": "سوا بارہ بجے میں شیشہ گھر گیا۔ دروازہ مقفل تھا، لیمپ دھیما کیا ہوا تھا، اور انہوں نے کوئی جواب نہیں دیا۔",
 "dialogues:statements.st_julian_library.text": "سوا دس بجے سے سوا گیارہ بجے تک میں کتب خانے میں کٹو سے بحث کر رہا تھا۔",
 "dialogues:statements.st_julian_money.text": "میرے معاملات بالکل ٹھیک ٹھاک ہیں۔ مجھے آنٹ ہیسٹر کے پیسوں کی کوئی ضرورت نہیں تھی۔",
 "dialogues:statements.st_julian_will.text": "آنٹ ہیسٹر آج صبح ایک نئی وصیت پر دستخط کرنے والی تھیں جس میں مجھے پینہیلو سے بے دخل کر دیا گیا تھا۔",
 "dialogues:statements.st_kittow_engaged.text": "ستمبر میں ہیسٹر اور میری شادی ہونے والی تھی۔ انہوں نے مجھے بتایا تھا کہ وہ جمعے کو چھ بجے سیلیا کو جولیئن کے جرم کے بارے میں بتا دیں گی، تاکہ وہ ہفتے سے پہلے اعتراف کر سکے۔",
 "dialogues:statements.st_kittow_library.text": "سوا دس بجے سے سوا گیارہ بجے تک میں جولیئن کے ساتھ کتب خانے میں تھا۔",
 "dialogues:statements.st_kittow_professional.text": "لیڈی پینہیلو سے میرے تعلقات خالصتاً پیشہ ورانہ تھے۔",
 "dialogues:statements.st_kittow_will.text": "نئی وصیت کے تحت جولیئن کو 1,000 پاؤنڈ ملتے۔ پرانی وصیت کے تحت، جو اب نافذ ہے، پینہیلو اسے ورثے میں ملتا ہے۔",
 "dialogues:statements.st_marian_darkroom.text": "دس بجے سے گیارہ بج کر دس منٹ تک میں اپنے تاریک خانے میں تھی۔ پھر میں نے ٹیرس پر اپنا کیمرا لگایا۔",
 "dialogues:statements.st_marian_kew.text": "میں یہاں Kew کی طرف سے آئی ہوں، پھول کھلنے کا ریکارڈ مرتب کرنے۔",
 "dialogues:statements.st_marian_lindqvist.text": "پچھلے برس Kew نے مجھے برطرف کر دیا تھا۔ اب مجھے میامی کی Lindqvist Orchids والے تنخواہ دیتے ہیں، جنہیں بیج چاہیے۔",
 "dialogues:statements.st_marian_photo.text": "گھنٹی بجتے ہی میں نے ٹیرس سے ایک تصویر کھینچی۔ اس کا پرنٹ میرے تاریک خانے میں سوکھ رہا ہے۔",
 "dialogues:statements.st_marian_pollinate.text": "چاندنی آرکڈ اپنی پہلی خوشبو کے تقریباً چالیس منٹ بعد کھلتا ہے۔ ہیسٹر کھلتے ہی اس کی زیرگی کرتیں — یہ موقع گنوانے سے انہیں مر جانا گوارا تھا۔",
 "dialogues:statements.st_marian_scent.text": "جب سیلیا 23:45 پر دیوان خانے میں آئیں تو ان میں سے چاندنی آرکڈ کی تیز خوشبو آ رہی تھی، جیسے وہ اس کے اوپر جھکی کھڑی رہی ہوں۔",
 "dialogues:topics.t_agnes_evening.lines.0": "سوا دس بجے میں ان کے لیے کوکو کا تھرماس لے گئی۔ انہوں نے کہہ رکھا تھا کہ کوئی پاس نہ آئے، مگر کھانے پر انہوں نے کچھ نہیں کھایا تھا۔ انہوں نے مجھے ڈانٹا بھی اور اندر بھی آنے دیا، اور جب تک میں وہاں کھڑی رہی، ایک پیالی پی لی۔ وہ ہر پندرہ منٹ بعد اپنا روزنامچہ لکھ رہی تھیں، کسی لڑکی کی طرح خوش۔ پھر میرے پیچھے انہوں نے دروازہ مقفل کر لیا۔",
 "dialogues:topics.t_agnes_evening.lines.1": "جب گھنٹی بجی تو میں باقی سب کے ساتھ ٹیرس پر تھی۔ آدھی رات کو میں سونے اوپر چلی گئی، اور سوا بارہ بجے میں نے کھڑکی سے باہر جھانکا تو مسٹر جولیئن کو چاند کی روشنی میں لان پر دیکھا، نیچے شیشہ گھر کی طرف جاتے ہوئے۔ میں نے سارجنٹ کو یہی بتایا۔ اب مجھے اس کا افسوس ہے۔",
 "dialogues:topics.t_agnes_evening.prompt": "مجھے کل رات کے بارے میں بتائیے۔",
 "dialogues:topics.t_agnes_hester.lines.0": "ان کا کولہا بہت خراب تھا۔ وہ اپنی چھڑی کے بغیر ایک قدم بھی نہیں اٹھا سکتی تھیں، اپنے سونے کے کمرے میں بھی نہیں — اور دس برس سے کسی سیڑھی پر نہیں چڑھی تھیں۔ اس کام کے لیے جوری تھا۔",
 "dialogues:topics.t_agnes_hester.lines.1": "اور وہ سبز روشنائی سے لکھتی تھیں۔ صرف سبز، جب سے سن 43 میں وہ تار آیا تھا — یہ ایڈمنڈ کا رنگ تھا۔ ان کے خط، ان کے لیبل، ان کے چیک۔ سب سبز۔",
 "dialogues:topics.t_agnes_hester.prompt": "لیڈی پینہیلو کی عادتیں کیا تھیں؟",
 "dialogues:topics.t_agnes_rooms.lines.0": "ان کی نشست گاہ مقفل ہے۔ اس کی واحد فالتو چابی انہوں نے میرے پاس رکھوائی تھی۔ میرا خیال ہے، اب اس سے کیا فرق پڑتا ہے۔",
 "dialogues:topics.t_agnes_rooms.lines.1": "وہ جیب سے ایک چھوٹی سی چابی نکالتی ہے اور آپ کو دینے سے پہلے ایک لمحہ اسے تھامے رہتی ہے۔ لیڈی پینہیلو کی نشست گاہ اب آپ کے لیے کھلی ہے۔",
 "dialogues:topics.t_agnes_rooms.prompt": "کیا مجھے لیڈی پینہیلو کے کمرے دیکھنے کی اجازت ہے؟",
 "dialogues:topics.t_agnes_terrace.lines.0": "مسٹر جولیئن، مسٹر کٹو، اپنے کیمرے کے ساتھ ڈاکٹر ایلری، اور میں۔ ہم نے انہیں لیمپ اٹھاتے اور ہاتھ کے اشارے سے ہمیں جانے کو کہتے دیکھا، اور ہم اندر چلے گئے۔",
 "dialogues:topics.t_agnes_terrace.lines.1": "مسز سیلیا ساڑھے دس بجے سر درد کی وجہ سے اوپر جا چکی تھیں۔ وہ پونے بارہ بجے اپنا ہلکا نیلا ڈریسنگ گاؤن پہنے نیچے دیوان خانے میں آئیں، آنکھیں پھاڑے، اور کہنے لگیں کہ گھنٹی سے ان کی آنکھ کھل گئی تھی اور انہوں نے اپنی کھڑکی سے دیکھا تھا۔",
 "dialogues:topics.t_agnes_terrace.prompt": "جب گھنٹی بجی تو ٹیرس پر کون کون تھا؟",
 "dialogues:topics.t_agnes_will.lines.0": "پرانی وصیت کے تحت دو ہزار پاؤنڈ۔ نئی کے تحت تاحیات پھاٹک والا مکان اور تین سو پاؤنڈ سالانہ۔ انہوں نے جون میں مجھے یہ بتایا تھا، اور میں بچوں کی طرح روئی تھی۔",
 "dialogues:topics.t_agnes_will.lines.1": "تو اگر آپ کے ذہن میں یہ سوال ہے، تو میرے پاس اس بات کی ہر وجہ موجود تھی کہ میں انہیں آج صبح دس بجے تک زندہ دیکھنا چاہوں۔",
 "dialogues:topics.t_agnes_will.prompt": "کیا لیڈی پینہیلو نے وصیت میں آپ کا خیال رکھا تھا؟",
 "dialogues:topics.t_celia_evening.lines.0": "اوپر، بستر میں۔ میرے سر میں بلا کا درد تھا — ساڑھے دس بجے میں نے سب کو شب بخیر کہا اور سیدھی اوپر چلی گئی۔",
 "dialogues:topics.t_celia_evening.lines.1": "گھنٹی سے میری آنکھ کھلی۔ میں کھڑکی تک گئی، اور وہ وہاں تھیں — نیچے شیشہ گھر میں، اپنا لیمپ لیے، اس بڑے سے سفید پھول کے پاس۔ جیسے شیکسپیئر کا کوئی منظر ہو۔ پھر مجھے نیند نہیں آئی، اس لیے ڈریسنگ گاؤن پہن کر نیچے باقی لوگوں کے پاس آ گئی۔",
 "dialogues:topics.t_celia_evening.prompt": "کل رات آپ کہاں تھیں؟",
 "dialogues:topics.t_celia_forgery.lines.0": "جعل سازی؟ جولیئن؟ کیسی بے تکی بات ہے۔ جولیئن تو بیماری کی چھٹی کی عرضی بھی جعلی نہیں لکھ سکتا۔",
 "dialogues:topics.t_celia_forgery.lines.1": "میں کسی رہن کے بارے میں کچھ بھی نہیں جانتی۔ جولیئن کاروبار کی باتیں اپنے تک رکھتا ہے۔ اسی سے پوچھیے۔",
 "dialogues:topics.t_celia_forgery.prompt": "کیا آپ کو معلوم تھا کہ آپ کے شوہر نے اپنی چچی کے جعلی دستخط کیے تھے؟",
 "dialogues:topics.t_celia_hester.lines.0": "ان کا خیال تھا کہ جولیئن نے اپنے رتبے سے نیچے شادی کی ہے۔ ایک اداکارہ! انہوں نے کبھی کہا نہیں۔ ضرورت ہی نہیں تھی۔",
 "dialogues:topics.t_celia_hester.lines.1": "مگر وہ مہربان بھی ہو سکتی تھیں۔ ایک بار، مئی میں، انہوں نے مجھے اپنا آرکڈ دکھایا، اور اس سے یوں باتیں کیں جیسے ایڈمنڈ وہیں کھڑے ہوں۔ سچ پوچھیے تو مجھے ان پر کچھ رشک سا آیا تھا۔ ذرا سوچیے، کسی سے اتنی محبت!",
 "dialogues:topics.t_celia_hester.prompt": "لیڈی پینہیلو سے آپ کی کیسی بنتی تھی؟",
 "dialogues:topics.t_celia_stage.lines.0": "گیارہ برس ریپرٹری تھیٹر میں۔ برسٹل، باتھ، ایک سیزن اسٹریٹفورڈ میں۔ اپنے منہ میاں مٹھو بننا اچھا نہیں، مگر میں خاصی اچھی لیڈی میکبتھ تھی۔",
 "dialogues:topics.t_celia_stage.lines.1": "نیند میں چلنے والا منظر۔ ہر رات پورا ہال سانس روک لیتا تھا۔ پھر میں نے جولیئن سے شادی کر لی، اور Penhallow Motors سے بھی، اور بس قصہ ختم۔",
 "dialogues:topics.t_celia_stage.prompt": "سنا ہے آپ اسٹیج پر کام کرتی تھیں۔",
 "dialogues:topics.t_jory_dawn.lines.0": "میں پونے چھ بجے آگ میں کوئلہ جھونکنے آتا ہوں، ہر صبح کی طرح، بھٹی خانے کے راستے۔ باہر والے دروازے کی چٹخنی کھلی تھی — اس کی بات آگے کرتا ہوں۔ میں سیڑھیاں چڑھ کر اوپر گیا، اور وہاں بیگم صاحبہ پڑی تھیں، بینچ کے پاس، اور سیڑھی ان کے پہلو میں۔ ٹھنڈی۔",
 "dialogues:topics.t_jory_dawn.lines.1": "اور پھول ابھی تک کھلا تھا، بس ذرا سا۔ چینی کی پلیٹ جیسا سفید۔ کسی نے اسے ہاتھ نہیں لگایا تھا — ان کا برش کتاب کے پاس پڑا تھا، صاف، اور زردانہ ابھی تک پھول ہی میں دھرا تھا۔ پچیس برس انہوں نے اس رات کا انتظار کیا۔",
 "dialogues:topics.t_jory_dawn.lines.2": "سو میں نے ان کی خاطر کر دیا۔ انہی کے برش سے، جیسے انہوں نے مجھے سکھایا تھا، اور سُتلی کے ایک ٹکڑے سے باندھ دیا۔ پانچ منٹ بھی نہیں گزرے تھے کہ وہ بند ہو گیا۔ پھر میں گھر کی طرف بھاگا۔",
 "dialogues:topics.t_jory_dawn.prompt": "بتائیے، آپ نے انہیں کس حال میں پایا؟",
 "dialogues:topics.t_jory_evening.lines.0": "نو بجے بوائلر کی آگ دبائی اور گھر چلا گیا۔ دس بجے تک اپنے بستر میں، ہمیشہ کی طرح۔ بیگم صاحبہ کو منظور نہیں تھا کہ کوئی شیشے کے پاس بھی پھٹکے، اور میں تو جو کہا جائے وہی کرتا ہوں۔",
 "dialogues:topics.t_jory_evening.prompt": "کل رات آپ کہاں تھے؟",
 "dialogues:topics.t_jory_julian.lines.0": "ہالیڈے کیمپ۔ سر ایڈمنڈ کے لان پر کیبن، اور میرے سبزیوں کے باغ میں نہانے کا تالاب۔ یہ چاہیے اسے۔",
 "dialogues:topics.t_jory_julian.lines.1": "پر اس کے حق میں اتنا ضرور کہوں گا: خون دیکھنے کا اس میں مرغی جتنا بھی حوصلہ نہیں۔ بارہ برس کا تھا تو سؤر کٹتے دیکھ کر غش کھا گیا تھا۔",
 "dialogues:topics.t_jory_julian.prompt": "مسٹر جولیئن کے بارے میں آپ کی کیا رائے ہے؟",
 "dialogues:topics.t_jory_ladder.lines.0": "بیگم صاحبہ؟ دس برس سے نہیں۔ اس کولہے کے ساتھ چڑھ ہی نہیں سکتی تھیں۔ کوئی بھی اونچی چیز ہو، مجھے آواز دے لیتی تھیں۔",
 "dialogues:topics.t_jory_ladder.lines.1": "اور اوپر چڑھنے کو وہاں کچھ تھا بھی نہیں۔ لیمپ اسی کنڈے پر لٹکتا ہے جہاں میں نے لٹکایا۔ وہ سیڑھی دروازے کے پاس اپنی کھونٹی پر ٹنگی رہتی ہے۔ آخری بار وٹسن کے تہوار پر اتری تھی۔",
 "dialogues:topics.t_jory_ladder.prompt": "کیا وہ سیڑھی پر چڑھی ہوں گی؟",
 "dialogues:topics.t_jory_stokehole.lines.0": "اس دروازے کی چٹخنی میں زندگی بھر ہر رات نو بجے لگاتا آیا ہوں۔ اس میں بس اندر کی طرف ایک چٹخنی ہے، دیکھیے — باغ کی طرف سے نہ اسے کھولا جا سکتا ہے، نہ بند کیا جا سکتا ہے۔ آج صبح اس کی چٹخنی کھلی پڑی تھی۔",
 "dialogues:topics.t_jory_stokehole.lines.1": "اور کسی نے میرے بوائلر کو چھیڑا تھا۔ بوائلر کا منہ کھلا ہوا، اور آگ تنور کی طرح بھڑک رہی تھی، حالانکہ میں نے اسے دبا کر چھوڑا تھا۔ کسی نے اس میں کچھ جلایا تھا۔",
 "dialogues:topics.t_jory_stokehole.prompt": "اور بھٹی خانے کے دروازے کا کیا معاملہ ہے؟",
 "dialogues:topics.t_julian_aunt.lines.0": "بیس برس کی سیاہ پوشی، ایک ایسے آدمی کے لیے جو کسی جنگل میں مر گیا۔ وہ ان کے پودوں سے باتیں کرتی تھیں۔ میں سنگ دلی نہیں دکھا رہا — وہ واقعی کرتی تھیں۔ بلند آواز میں، ہر صبح۔",
 "dialogues:topics.t_julian_aunt.lines.1": "ذہین تھیں، یہ ماننا پڑے گا۔ کٹو کہتا ہے، انکل ایڈمنڈ سے بھی زیادہ ذہین، اور کٹو کو معلوم ہونا چاہیے۔ بس انہوں نے کبھی کسی پر یہ ظاہر نہیں ہونے دیا۔",
 "dialogues:topics.t_julian_aunt.prompt": "آپ کی چچی کیسی تھیں؟",
 "dialogues:topics.t_julian_celia.lines.0": "سیلیا؟ خدا کی پناہ، نہیں۔ اس سے پہلے میں مر جاتا۔ وہ سمجھتی ہے کہ کاروبار شاندار چل رہا ہے — سال بھر سے ہر ہفتے میں اسے یہی بتاتا آیا ہوں۔",
 "dialogues:topics.t_julian_celia.lines.1": "کل رات وہ اپنے کسی سر درد کے ساتھ جلدی اوپر چلی گئی۔ ساری گرمیاں اسے ٹھیک سے نیند نہیں آئی۔ اس میں بھی میرا ہی قصور ہوگا، شاید۔",
 "dialogues:topics.t_julian_celia.prompt": "کیا آپ کی بیوی کو رہن کا علم تھا؟",
 "dialogues:topics.t_julian_evening.lines.0": "کھانے کے بعد آپ کہاں تھے، مسٹر پینہیلو؟",
 "dialogues:topics.t_julian_evening.lines.1": "سوا دس بجے سے کتب خانے میں کٹو کے ساتھ، اسے اس وصیت کے بارے میں سمجھانے کی کوشش کر رہا تھا۔ افسوس، آوازیں کچھ اونچی ہو گئی تھیں۔ پھر ہم سب جلوس کی صورت ٹیرس پر نکل آئے کہ آنٹ ہیسٹر کی گھنٹی کا انتظار کریں۔",
 "dialogues:topics.t_julian_evening.lines.2": "جب گھنٹی بجی تو ہم نے انہیں دیکھا، دن کی طرح صاف، لیمپ اٹھائے ہوئے۔ پھر ہم اندر چلے گئے اور ایک بجے تک بیٹھے شیمپین پیتے رہے، اس انتظار میں کہ وہ دوبارہ گھنٹی بجائیں۔ جب تک ہم باقی لوگ اوپر نہیں گئے، میں نے دیوان خانہ ایک بار بھی نہیں چھوڑا۔",
 "dialogues:topics.t_julian_evening.prompt": "کل رات آپ کہاں تھے؟",
 "dialogues:topics.t_julian_glasshouse.lines.0": "دروازہ مقفل تھا۔ اندر لیمپ اتنا دھیما کر دیا گیا تھا کہ بس ٹمٹما رہا تھا؛ مجھے اس پھول کی سفیدی بمشکل دکھائی دی۔ میں نے دو بار دستک دی اور ان کا نام پکارا۔ کچھ نہیں۔",
 "dialogues:topics.t_julian_glasshouse.lines.1": "میں سمجھا وہ روٹھی بیٹھی ہیں، یا کرسی پر اونگھ گئی ہیں۔ میں پیچھے کی طرف نہیں گیا — مجھے معلوم ہی نہیں تھا کہ پیچھے بھی کچھ ہے۔ میں لوٹ آیا۔",
 "dialogues:topics.t_julian_glasshouse.lines.2": "البتہ وہ مہک۔ ان کا وہ آرکڈ۔ شیشے کے پار سے دیوار کی طرح آ ٹکراتی تھی۔",
 "dialogues:topics.t_julian_glasshouse.prompt": "مجھے ٹھیک ٹھیک بتائیے، شیشہ گھر پر آپ کو کیا ملا۔",
 "dialogues:topics.t_julian_money.lines.0": "کاروبار؟ Penhallow Motors تو شاندار چل رہی ہے۔ ہمارا اب تک کا بہترین سال ہے۔ ہر کوئی Zephyr چاہتا ہے۔",
 "dialogues:topics.t_julian_money.lines.1": "اگر آپ کا سوال یہ ہے کہ کیا مجھے آنٹ ہیسٹر کے پیسوں کی ضرورت تھی، تو جواب ہے نہیں۔ میرے معاملات بالکل ٹھیک ٹھاک ہیں۔",
 "dialogues:topics.t_julian_money.prompt": "آپ کا کاروبار کیسا چل رہا ہے؟",
 "dialogues:topics.t_julian_quarrel.lines.0": "سوپ کے دوران انہوں نے اعلان کیا کہ آج صبح دس بجے وہ ایک نئی وصیت پر دستخط کریں گی۔ پینہیلو National Trust کے نام، بوریا بستر اور شیشہ گھر سمیت۔ انکل ایڈمنڈ نے مجھ سے اس جگہ کا وعدہ تب کیا تھا جب میں نو برس کا تھا۔",
 "dialogues:topics.t_julian_quarrel.lines.1": "میرے پاس اس کی ایک معقول پیشکش ہے، Sunnyside Holiday Camps کی طرف سے۔ لان پر کیبن، اور جہاں سبزیوں کا باغ ہے وہاں سوئمنگ پول۔ لوگوں کو چھٹیاں بھی تو چاہییں۔ انہوں نے مجھے ایسے دیکھا جیسے میں نے ایڈمنڈ کی ہڈیاں بیچنے کا مشورہ دے دیا ہو۔",
 "dialogues:topics.t_julian_quarrel.lines.2": "تو ہاں، ہماری تلخ کلامی ہوئی۔ میں نے کہا کہ وہ پچھتائیں گی۔ یہ دھمکی نہیں تھی۔ لوگ کہہ ہی دیتے ہیں۔",
 "dialogues:topics.t_julian_quarrel.prompt": "کھانے پر جھگڑا کس بات پر ہوا تھا؟",
 "dialogues:topics.t_kittow_evening.lines.0": "سوا دس بجے سے سوا گیارہ بجے تک کتب خانے میں جولیئن کے ساتھ، اس کی چیخ پکار سنتے ہوئے۔ وہ چاہتا تھا کہ میں ہیسٹر کو دستخط نہ کرنے پر آمادہ کروں۔ میں نے اسے بتایا کہ وکیل کا فرض اپنے مؤکل کی خواہشات کا پاس ہے، اس کے وارث کی نہیں۔",
 "dialogues:topics.t_kittow_evening.lines.1": "گیارہ بجنے میں بیس منٹ پر مسز پاسکو ہمارے لیے وہسکی لائیں، اور غالباً انہوں نے ایک ایک لفظ سنا ہوگا۔ پھر ہم گھنٹی کے لیے ٹیرس پر نکل گئے، اور پھر ایک بجے تک دیوان خانے میں رہے۔",
 "dialogues:topics.t_kittow_evening.prompt": "کل رات آپ کہاں تھے؟",
 "dialogues:topics.t_kittow_hester.lines.0": "چالیس برس سے میں اس خاندان کا وکیل ہوں۔ 1941 میں سر ایڈمنڈ کے جہاز پر روانہ ہونے سے پہلے میں نے ان کی وصیت تیار کی تھی، اور تار آنے کے بعد ہیسٹر کی۔",
 "dialogues:topics.t_kittow_hester.lines.1": "یقین کیجیے، لیڈی پینہیلو سے میرے تعلقات خالصتاً پیشہ ورانہ تھے۔",
 "dialogues:topics.t_kittow_hester.prompt": "آپ لیڈی پینہیلو کو کتنی اچھی طرح جانتے تھے؟",
 "dialogues:topics.t_kittow_hester_heart.lines.0": "اس گرمی میں وہ اتنا ہنسیں جتنا اس سے پہلے کے پورے بیس برسوں میں نہیں ہنسی تھیں۔ انہوں نے طے کر لیا تھا کہ اب انہیں اس کی اجازت ہے۔",
 "dialogues:topics.t_kittow_hester_heart.lines.1": "کہتی تھیں کہ آرکڈ ایڈمنڈ کا ہے، اور کل رات کے بعد وہ انہیں آرام کرنے دیں گی۔ پھر وہ سرمئی پہنیں گی۔ شروع میں بس سرمئی۔",
 "dialogues:topics.t_kittow_hester_heart.prompt": "وہ کیسی تھیں، ایڈون — سچ مچ؟",
 "dialogues:topics.t_kittow_will.lines.0": "اس پر آج صبح دس بجے مسز پاسکو اور پادری کی موجودگی میں دستخط ہونے تھے۔ گواہ کبھی ایسا شخص نہیں ہوتا جسے وصیت سے کچھ ملے — مجھے ایڈمنڈ کی گھڑی ملنی ہے، اس لیے میں خود گواہ نہیں بن سکتا تھا۔ وصیت پینہیلو اور اس کے باغات National Trust کے نام کرتی ہے، دیکھ بھال کے لیے ایک وقف رقم کے ساتھ۔ جولیئن کو ایک ہزار پاؤنڈ اور اپنے چچا کی کتابیں ملتی ہیں۔",
 "dialogues:topics.t_kittow_will.lines.1": "پرانی وصیت کے تحت — 1950 کی وصیت، جو اب نافذ ہے — سب کچھ اسے ورثے میں ملتا ہے۔ مسودہ آپ کو کتب خانے میں میرے بریف کیس میں مل جائے گا۔ پولیس سے، یا آپ سے، میرا کوئی راز نہیں۔",
 "dialogues:topics.t_kittow_will.prompt": "مجھے نئی وصیت کے بارے میں بتائیے۔",
 "dialogues:topics.t_marian_bell.lines.0": "ہیسٹر، پھول کے پاس لیمپ بلند کیے ہوئے۔ انہوں نے ہماری طرف ہاتھ اٹھایا — میرے خیال میں ان کے مزاج کے حساب سے کچھ زیادہ ہی شان سے۔ پھر وہ مڑ گئیں اور لیمپ نیچے ہو گیا۔",
 "dialogues:topics.t_marian_bell.lines.1": "گھنٹی بجتے ہی میں نے ایک ایکسپوژر لیا۔ پورے اپرچر پر آدھا سیکنڈ، چالیس گز دور سے، دھندلے شیشے کے پار، اس لیے زیادہ امید مت رکھیے گا۔ آج صبح سب سے پہلے میں نے اسے ڈیولپ کیا۔ پرنٹ میرے تاریک خانے میں ڈوری پر لٹک رہا ہے۔",
 "dialogues:topics.t_marian_bell.prompt": "جب گھنٹی بجی تو آپ نے کیا دیکھا؟",
 "dialogues:topics.t_marian_evening.lines.0": "نو بج کر پچیس منٹ پر، ان کے خود کو اندر بند کرنے سے پہلے، میں نے کلی کے ساتھ ہیسٹر کی تصویر کھینچی۔ پھر دس بجے سے لگ بھگ گیارہ بج کر دس منٹ تک میں اپنے تاریک خانے میں اسے ڈیولپ کرتی رہی — بیچ میں کسی وقت مسز پاسکو نے دروازہ کھٹکھٹایا، بے چاری، اور میں ان پر چلّا پڑی۔",
 "dialogues:topics.t_marian_evening.lines.1": "اس کے بعد میں نے گھنٹی کے انتظار میں ٹیرس پر اپنی تپائی لگائی۔ گھنٹی میری توقع سے دیر میں بجی۔ میں قسم کھا کر کہہ سکتی تھی کہ وہ پھول گیارہ بجے تک کھل چکا ہوگا۔",
 "dialogues:topics.t_marian_evening.prompt": "کل رات آپ کہاں تھیں؟",
 "dialogues:topics.t_marian_kew.lines.0": "جی ہاں۔ ہربیریم کو پھول کا مکمل ریکارڈ چاہیے — تصویریں، پیمائشیں، اوقات۔ ہیسٹر اور میں پانچ برس سے اس پودے کے بارے میں خط و کتابت کرتے رہے ہیں۔",
 "dialogues:topics.t_marian_kew.lines.1": "نئی وصیت کے تحت آرکڈ Kew کو جانا تھا۔ اسی لیے میں یہاں ہوں۔",
 "dialogues:topics.t_marian_kew.prompt": "آپ یہاں Kew کی طرف سے آئی ہیں؟",
 "dialogues:topics.t_marian_lindqvist.lines.0": "بیج۔ اس پھول کی ایک پھلی میں دس لاکھ بیج ہوتے ہیں، اور فلوریڈا میں ہر ننھا پودا سو ڈالر میں بکتا۔ لنڈکوسٹ چاندنی آرکڈ کا مالک بننا چاہتا تھا، جیسے کوئی ریس کے گھوڑے کا مالک ہوتا ہے۔",
 "dialogues:topics.t_marian_lindqvist.lines.1": "میں ہیسٹر سے کہنے والی تھی کہ بیج کا کچھ حصہ اسے بیچ دیں۔ قانونی طور پر، اور ایمانداری سے۔ ظاہر ہے، وہ انکار کر دیتیں۔ وہ تو پہلے ہی سب کچھ Kew کے نام کر چکی تھیں۔",
 "dialogues:topics.t_marian_lindqvist.prompt": "لنڈکوسٹ آخر چاہتا کیا تھا؟",
 "dialogues:topics.t_marian_orchid.lines.0": "ایڈمنڈ پینہیلو نے اسے 1938 میں شان کی پہاڑیوں سے حاصل کیا تھا۔ جس وادی سے یہ آیا، وہ جنگ میں جل کر راکھ ہو گئی۔ جہاں تک کسی کو معلوم ہے، ہیسٹر کا پودا اپنی نسل کا آخری زندہ پودا ہے۔ انگلستان میں اس پر کبھی ایک بار بھی پھول نہیں آیا تھا۔",
 "dialogues:topics.t_marian_orchid.lines.1": "یہ اندھیرا ہونے کے بعد صرف ایک بار کھلتا ہے۔ پہلی خوشبو سے پھول کے پوری طرح کھلنے تک تقریباً چالیس منٹ لگتے ہیں، اور سورج نکلتے ہی یہ ہمیشہ کے لیے بند ہو جاتا ہے۔ اس کی زیرگی کا واحد موقع تب ہے جب یہ کھلا ہو — اور کھلنے کا لمحہ سب سے بہتر موقع ہے۔",
 "dialogues:topics.t_marian_orchid.lines.2": "ہیسٹر نے کل رات کا پچیس برس انتظار کیا تھا۔ کھلتے ہی وہ اس کی زیرگی کرتیں۔ یہ موقع گنوانے سے انہیں مر جانا گوارا تھا۔",
 "dialogues:topics.t_marian_orchid.prompt": "مجھے چاندنی آرکڈ کے بارے میں بتائیے۔",
 "dialogues:topics.t_marian_scent.lines.0": "اب جو آپ نے پوچھا ہے… ہاں۔ جب وہ دیوان خانے میں آئیں تو آرکڈ کی خوشبو بھی ان کے ساتھ اندر آئی۔ لونگ اور سوسن — میں اسے کہیں بھی پہچان لوں۔ تیز، جیسے وہ پھول کے اوپر جھکی کھڑی رہی ہوں۔",
 "dialogues:topics.t_marian_scent.lines.1": "میں سمجھی کہ کھڑکیوں سے اڑ کر آئی ہوگی۔ مگر تب تک دیوان خانے کی کھڑکیاں بند ہو چکی تھیں، اور شیشہ گھر چالیس گز دور ہے۔ وہ خوشبو ہر اس چیز سے لپٹ جاتی ہے جو اس کے قریب رہی ہو۔ وہ دور تک نہیں جاتی۔",
 "dialogues:topics.t_marian_scent.prompt": "جب سیلیا 23:45 پر نیچے آئیں تو کیا آپ نے کوئی خاص بات محسوس کی؟",
 "evidence:evidence.bank_demand.detail": "جولیئن کی ڈنر جیکٹ کی اندرونی جیب میں مڑا تڑا: پلیمتھ کے Westminster Bank کا ایک خط، مورخہ 22 جولائی 1963۔\n\n“محترم مسٹر پینہیلو — ہمیں ایک بار پھر آپ کی توجہ کمپنی Penhallow Motors کے اوور ڈرافٹ کھاتے کی جانب مبذول کرانی پڑ رہی ہے، جس پر واجب الادا رقم اب 6,412 پاؤنڈ 7 شلنگ 2 پنس ہو چکی ہے۔ اگر 31 جولائی تک یہ رقم ادا نہ کی گئی تو ہمارے پاس قانونی کارروائی شروع کرنے کے سوا کوئی چارہ نہ ہوگا…”\n\nاسے کئی بار تہہ کیا اور کھولا گیا ہے۔",
 "evidence:evidence.bank_demand.name": "پلیمتھ کے Westminster Bank کا خط",
 "evidence:evidence.bank_demand.summary": "ادائیگی کا آخری تقاضا، کمپنی Penhallow Motors کے نام، اور “قانونی کارروائی” کی دھمکی۔",
 "evidence:evidence.bloom_log.detail": "پھول کھلنے کا ہیسٹر کا روزنامچہ، سبز روشنائی میں، چھوٹی اور سیدھی لکھاوٹ میں:\n\n“21:30 — اندر سے تالا لگا لیا۔ لیمپ روشن۔ کلی پھول رہی ہے۔\n21:45 — کلی کی نوک پر رنگ آ رہا ہے۔\n22:00 — ایڈمنڈ کا وقت۔ کلی ڈھیلی پڑ رہی ہے۔\n22:15 — ایگنس کوکو لے آئی، حکم کے خلاف۔ خدا اسے خوش رکھے۔\n22:25 — کاس برگ جدا ہو رہے ہیں۔ پہلی خوشبو: لونگ اور سوسن۔ چالیس منٹ، ایڈمنڈ ہمیشہ کہا کرتے تھے۔ کھلتے ہی میں زیرگی کروں گی۔”\n\n22:25 کے بعد صفحہ خالی ہے۔ اس کا قلم روزنامچے کے پاس پڑا ہے، ڈھکن لگا ہوا۔ زیرگی کے لیے سمور کا اس کا برش بھی اسی کے پاس پڑا ہے۔",
 "evidence:evidence.bloom_log.name": "پھول کھلنے کا روزنامچہ",
 "evidence:evidence.bloom_log.summary": "ہر پندرہ منٹ بعد سبز روشنائی میں اندراج — 22:25 تک، پھر کچھ نہیں۔",
 "evidence:evidence.blue_room_window.detail": "نیلا کمرہ، جہاں جولیئن اور سیلیا سوتے ہیں، گھر کے شمالی رخ پر ہے۔ اس کی واحد کھڑکی بجری والے راستے اور بیچ کے درختوں کی قطار کی طرف کھلتی ہے۔\n\nشیشہ گھر جنوب میں ہے، لان کے نشیبی سرے پر، گھر کی دوسری جانب۔ اس کمرے سے اس کا بادنما تک نظر نہیں آتا۔",
 "evidence:evidence.blue_room_window.name": "نیلے کمرے کی کھڑکی",
 "evidence:evidence.blue_room_window.summary": "سیلیا کی کھڑکی شمال رخ ہے، بجری والے راستے کی طرف۔ شیشہ گھر گھر کی دوسری جانب ہے۔",
 "evidence:evidence.celia_mules.detail": "الماری کے پچھلے حصے میں، شام کے لباسوں کے پیچھے ٹھونسے ہوئے: ہلکے نیلے ساٹن کے سلیپروں کی ایک جوڑی اور ان سے میل کھاتا ڈریسنگ گاؤن۔\n\nسلیپروں کے تلے کوئلے کی گرد سے سرمئی ہیں، جو ساٹن میں رچ بس گئی ہے۔ ڈریسنگ گاؤن کا دامن چاروں طرف کالے دھبوں سے لتھڑا ہے۔ کسی نے اسے جھاڑنے کی کوشش کی ہے، اور یوں دھبے اور پھیل گئے ہیں۔",
 "evidence:evidence.celia_mules.name": "سیلیا کا ڈریسنگ گاؤن اور سلیپر",
 "evidence:evidence.celia_mules.summary": "ہلکا نیلا ساٹن — اور تلوں اور دامن پر کوئلے کی سیاہ گرد۔",
 "evidence:evidence.deed_fragment.detail": "موٹے قانونی کاغذ کا ایک جھلسا ہوا کونا، جو آگ کی سلاخوں سے نیچے راکھ دان میں جا گرا تھا:\n\n“…رہن نامہ بابت جائیداد موسوم بہ ہوم فارم، پینہیلو… مبلغ بیس ہزار پاؤنڈ… Lorimer & Dane… بدستخط مسماۃ ہیسٹر پینہیلو…”\n\nکنارے پر دستخط بچ گئے ہیں، جل کر بھورے پڑ چکے: “ہیسٹر پینہیلو”، سیاہ روشنائی میں۔",
 "evidence:evidence.deed_fragment.name": "ادھ جلا رہن نامہ",
 "evidence:evidence.deed_fragment.summary": "بوائلر کے راکھ دان سے: “…ہوم فارم… 20,000 پاؤنڈ… ہیسٹر پینہیلو” — دستخط سیاہ روشنائی میں۔",
 "evidence:evidence.ebony_stick.detail": "اس کی آبنوسی چھڑی، جو آرکڈ کی بینچ کے نیچے ملی۔ اس کی موٹھ ٹھوس چاندی کی ہے، گول، تقریباً ہاف کراؤن کے سکے کے برابر، اور اس پر ہر طرف پتیوں کے نقش کندہ ہیں۔\n\nموٹھ کو پونچھا گیا ہے۔ مگر نقش و نگار کی گہرائی میں سوکھے ہوئے خون کا ایک گہرا دھبا ہے، اور اس میں دو سفید بال اٹکے ہوئے ہیں۔",
 "evidence:evidence.ebony_stick.name": "لیڈی پینہیلو کی چھڑی",
 "evidence:evidence.ebony_stick.summary": "چاندی کی بھاری موٹھ، ہاف کراؤن کے سکے کے برابر — اور نقش و نگار میں خون۔",
 "evidence:evidence.finance_letter.detail": "فرم Lorimer & Dane، فنانس، لندن ای۔ سی۔ 2۔ 19 جولائی 1963۔\n\n“محترمہ لیڈی پینہیلو — آپ کے ریکارڈ کے لیے ہم ہوم فارم کے آپ کے رہن نامے کی مثنیٰ منسلک کر رہے ہیں، جس کی تکمیل 2 مئی کو ہوئی، اور جس کے تحت مبلغ 20,000 پاؤنڈ آپ کے بھتیجے مسٹر جولیئن پینہیلو کو، آپ کے مختار کی حیثیت سے، ادا کیے گئے…”\n\nنیچے، سبز روشنائی میں:\n\n“میں نے اس پر کبھی دستخط نہیں کیے۔ جولیئن، ظاہر ہے۔ جمعے کو چھ بجے میں سیلیا کو بتا دوں گی، اور اسے رات بھر کی مہلت دوں گی کہ خود میرے پاس آئے۔ ہفتے کو یہ ایڈون کے پاس جائے گا، اور ایڈون سے پولیس کے پاس۔”\n\nرہن نامے کی مثنیٰ خود خط کے ساتھ نہیں ہے۔",
 "evidence:evidence.finance_letter.name": "فرم Lorimer & Dane کا خط",
 "evidence:evidence.finance_letter.summary": "ہوم فارم پر “اس کے” 20,000 پاؤنڈ کے رہن کے بارے میں — اور سبز روشنائی میں اس کا نوٹ: “میں نے اس پر کبھی دستخط نہیں کیے۔”",
 "evidence:evidence.hester_letter.detail": "پینہیلو ہاؤس، سینٹ آسٹل۔ 23 جولائی 1963۔\n\n“محترم یا محترمہ — مجھے بتایا گیا ہے کہ رازداری آپ کا شیوہ ہے۔ مجھ پر یہ انکشاف ہوا ہے کہ میرے خاندان کے ایک فرد نے ایک مجرمانہ حرکت کی ہے۔ ہفتے کی صبح میں ایک نئی وصیت کے ساتھ اس کا ثبوت اپنے وکیل کے حوالے کرنے کا ارادہ رکھتی ہوں۔ تب تک گھر میں کسی ایسے شخص کی موجودگی سے مجھے اطمینان رہے گا جو خاندان سے نہ ہو۔\n\nوہ چاندنی آرکڈ جو میرے شوہر نے 1938 میں وطن بھیجا تھا، جمعے کی رات اس ملک میں پہلی بار پھول دے گا۔ جمعے کو تشریف لائیے، اور اس کا دیدار آپ کو بھی نصیب ہوگا۔\n\nآپ کی مخلص، ہیسٹر پینہیلو”\n\nسبز روشنائی میں لکھا ہوا۔ یہ جمعے کی سہ پہر آپ کے دفتر پہنچا۔",
 "evidence:evidence.hester_letter.name": "لیڈی پینہیلو کا خط",
 "evidence:evidence.hester_letter.summary": "منگل کو ڈاک میں ڈالا گیا: “میرے خاندان کے ایک فرد نے ایک مجرمانہ حرکت کی ہے”۔",
 "evidence:evidence.iron_staging.detail": "بینچ کا ڈھلے ہوئے لوہے کا کنارا، جہاں ڈاکٹر ٹریسیڈر کے بقول گرتے ہوئے اس کا سر ٹکرایا تھا۔ عدسے سے اس کا باریک بینی سے جائزہ لیا جاتا ہے۔\n\nنہ خون، نہ بال، پرانے سبز رنگ پر ایک خراش تک نہیں۔ اور اس کا کنارا ایک تیز قائمہ زاویہ ہے — ہاف کراؤن کے سکے کے برابر گول زخم سے اس کا کوئی میل نہیں۔",
 "evidence:evidence.iron_staging.name": "لوہے کی بینچ",
 "evidence:evidence.iron_staging.summary": "جہاں مبینہ طور پر اس کا سر ٹکرایا: اس پر ایک نشان تک نہیں۔",
 "evidence:evidence.jory_pipe.detail": "چار دیواری کے دروازے کے پاس، دہلیز پر: پائپ کی راکھ کی ایک ننھی سی ڈھیری اور آدھ درجن جلی ہوئی تیلیاں۔ تمباکو کارنوال کا بٹا ہوا ہے، سیاہ اور کڑوا۔ جوری ٹریوینا اس کے سوا کچھ نہیں پیتا۔\n\nاس دہلیز سے شیشہ گھر کا پورا مشرقی سرا نظر آتا ہے — اور اس کے نیچے بھٹی خانے کا دروازہ بھی۔",
 "evidence:evidence.jory_pipe.name": "چار دیواری کے دروازے پر پائپ کی راکھ",
 "evidence:evidence.jory_pipe.summary": "پائپ کی تازہ راکھ اور جلی ہوئی تیلیاں، وہاں جہاں سے چار دیواری والا باغ شیشہ گھر کے سامنے پڑتا ہے۔",
 "evidence:evidence.kittow_letter.detail": "اس کے سیاہی چوس میں تہہ کیا ہوا، ایک وکیل کی محتاط لکھاوٹ میں:\n\n“میری عزیز ہیسٹر — تو پھر ہفتے کو، جب وصیت پر دستخط ہو جائیں اور آپ کا آرکڈ محفوظ ہو جائے، آئیے انہیں بتا دیں۔ چالیس برس میں نے انتظار کیا ہے؛ اتنا اور انتظار کر سکتا ہوں کہ پھول اپنی رات گزار لے۔ ستمبر میں، سینٹ میوان کے گرجے میں، جیسا آپ نے چاہا تھا۔ — آپ کا ایڈون”",
