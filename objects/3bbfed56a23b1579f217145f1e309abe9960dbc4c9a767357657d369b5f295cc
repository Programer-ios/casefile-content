{
 "case:accusation.methods.0": "उसे सीढ़ी से धक्का देकर लोहे की बेंच पर गिरा दिया",
 "case:accusation.methods.1": "उसकी अपनी छड़ी की चाँदी की मूठ से वार करके उसे मार गिराया",
 "case:accusation.methods.2": "एग्नेस जो कोको उसके लिए ले गई थी, उसमें ज़हर मिलाया",
 "case:accusation.methods.3": "उसकी अपनी शॉल से उसका दम घोंट दिया",
 "case:accusation.motives.0": "अपने पति की जालसाज़ी को पुलिस से छिपाने के लिए — और पेनहैलो को उसके हाथ में रखने के लिए",
 "case:accusation.motives.1": "चंद्र-ऑर्किड के बीज एक अमरीकी नर्सरी को बेचने के लिए",
 "case:accusation.motives.2": "बग़ीचों को हॉलिडे कैंप के लिए बिकने से बचाने के लिए",
 "case:accusation.motives.3": "एक गुप्त सगाई को उजागर होने से रोकने के लिए",
 "case:accusation.motives.4": "बीस बरस तनख़्वाह पर संगिनी रहने के बाद आज़ाद होने के लिए",
 "case:accusation.proofLabels.0": "मौक़ा — मौत के वक़्त उसके साथ मौजूद",
 "case:accusation.proofLabels.1": "नक़ली विधवा — 11:32 पर घंटी किसने बजाई",
 "case:accusation.proofLabels.2": "मक़सद — यह शुक्रवार की रात ही क्यों होना था",
 "case:accusation.successTitle": "केस बंद",
 "case:briefing.0": "पेनहैलो हाउस, कॉर्नवॉल। शनिवार, 27 जुलाई 1963, सुबह के दस बजे।",
 "case:briefing.1": "बीस बरस से गाँव वाले लेडी हेस्टर पेनहैलो को ‘शीशाघर की विधवा’ कहते आए हैं। 1943 में बर्मा से आए तार के बाद से वह सिर से पाँव तक काले कपड़े पहनती आई है, नक़ाब समेत, और उन पौधों के बीच रहती आई है जो उसके पति ने परदेस से भेजे थे — और सबसे बढ़कर उस चंद्र-ऑर्किड के साथ, जो इंग्लैंड में आज तक एक बार भी नहीं खिला था। कल रात, सिर्फ़ एक रात के लिए, वह खिला।",
 "case:briefing.2": "वह शीशाघर में ख़ुद को बंद करके अकेली रतजगा कर रही थी, और उसने वादा किया था कि फूल खुलते ही घंटी बजाएगी। 11:32 पर घंटी बजी, और चबूतरे पर खड़े चार लोगों ने शीशे के पार उसे देखा — हाथ में लैंप लिए, उस बड़े सफ़ेद फूल के पास। आज सुबह पौने छह बजे माली ने उसे एक सीढ़ी के पास मरी पड़ी पाया।",
 "case:briefing.3": "मंगलवार को उसने आपको बुलाने के लिए चिट्ठी लिखी थी: उसके परिवार में किसी ने ‘कुछ आपराधिक’ किया था। चिट्ठी आप तक बहुत देर से पहुँची। सेंट ऑस्टल के सार्जेंट पॉलग्लेज़ के पास अपना एक अनुमान भी है और एक संदिग्ध भी, और कोरोनर के अफ़सर के पहुँचने से पहले उसने आपको सुबह भर का वक़्त दिया है।",
 "case:briefing.4": "पता लगाइए कि लेडी पेनहैलो की हत्या किसने की, कैसे की और क्यों — और इसे साबित करने के लिए तैयार रहिए।",
 "case:epilogue.0": "सीलिया पेनहैलो दो दिन तक डटी रही। फिर सार्जेंट पॉलग्लेज़ ने डॉ. एलरी की तस्वीर उसके सामने रख दी: लैंप ऊँचा उठाए वह लंबी काली आकृति। देर तक वह उसे देखती रही, फिर बड़े इत्मीनान से बोली, ‘तालियाँ बटोरने का शौक़ मुझे हमेशा से था।’",
 "case:epilogue.1": "छह बजे हेस्टर ने उसे बता दिया था: जूलियन ने होम फ़ार्म के रेहन पर उसके जाली दस्तख़त किए थे, और सुबह दस्तावेज़ मिस्टर किटो के पास जाएगा, और मिस्टर किटो से पुलिस के पास। ग्यारह बजने में बीस मिनट पर सीलिया मिन्नत करने नीचे शीशाघर गई। हेस्टर ने कहा कि जूलियन को इसका जवाब देना होगा, जैसा एडमंड चाहते। उसकी छड़ी बेंच से टिकी रखी थी।",
 "case:epilogue.2": "उसके बाद सीलिया ने वही किया जो रेपर्टरी थिएटर के ग्यारह बरसों ने उसे सिखाया था: वह अपनी एंट्री के इशारे का इंतज़ार करती रही। पौन घंटे तक वह शव के पास बैठी रही, और उसके बग़ल में चंद्र-ऑर्किड खुलता रहा। फिर उसने नक़ाब और शॉल पहने, घंटी बजाई और चार दर्शकों के सामने अपनी ज़िंदगी का सबसे शानदार अभिनय किया। फिर उसने वे दोनों दोबारा हेस्टर को पहना दिए, दरवाज़े पर ताला लगाया ताकि सुबह से पहले कोई डॉक्टर शव न देखे, बॉयलर-घर में दस्तावेज़ जला दिया, और भीतर जाकर शैंपेन पीने बैठ गई।",
 "case:epilogue.3": "उसने हेस्टर पेनहैलो की हर बात का बारीकी से अध्ययन किया था — सिवाय उस एक बात के, जो सबसे अहम थी। हेस्टर उस फूल को कभी यूँ अनछुआ खुलने और बंद होने न देती।",
 "case:epilogue.4": "जालसाज़ी के लिए जूलियन पेनहैलो को तीन साल की क़ैद हुई। नई वसीयत पर कभी दस्तख़त नहीं हुए, सो आख़िरकार पेनहैलो उसी को मिला, और जेल की अपनी कोठरी से उसने उसे National Trust को सौंप दिया — बग़ीचों, शीशाघर और सब कुछ समेत। मैरियन एलरी ने मिस्टर लिंडक्विस्ट के बीस हज़ार डॉलर ठुकरा दिए और बीज Kew ले गई। एडविन किटो ने वह अँगूठी अपने पास रख ली, जो उसने सितंबर के लिए ट्रूरो से ख़रीदी थी।",
 "case:epilogue.5": "नवंबर में चंद्र-ऑर्किड पर एक अकेली हरी फली पकी। पहले नन्हे पौधों पर 1971 के वसंत में Kew में फूल आए। जोरी ट्रेवेना अपना इतवारी सूट पहनकर उन्हें देखने लंदन गया, और उनका नाम उसी ने चुना: वे ‘शीशाघर की विधवा’ नाम से दर्ज हैं। हर जुलाई के आख़िरी शुक्रवार को वह आज भी पूरी रात शीशाघर में जागकर बैठता है। कहता है, किसी को तो बैठना चाहिए।",
 "case:hints.h_accuse.levels.0": "अपना बोर्ड फिर से देखिए। हेस्टर की मौत के वक़्त उसके साथ कौन था, 11:32 पर घंटी किसने बजाई, और सुबह से पहले किसके लिए उसका चुप हो जाना ज़रूरी था?",
 "case:hints.h_accuse.levels.1": "आरोप के हर हिस्से के लिए एक कार्ड चाहिए: मौक़ा, नक़ली विधवा और मक़सद। अगर कोई कमी है, तो ऊपर के संकेत उसकी ओर इशारा कर चुके होंगे। अपनी नोटबुक दोबारा पढ़िए।",
 "case:hints.h_accuse.levels.2": "क़ातिल सीलिया पेनहैलो है: हेस्टर की अपनी छड़ी की चाँदी की मूठ से वार, ताकि जूलियन की जालसाज़ी पुलिस तक न पहुँचे। इसे सीलिया के इस इक़बाल से कि वह शीशाघर गई थी, कोक की धूल से सने उसके ड्रेसिंग गाउन और चप्पलों से, और जालसाज़ी वाले निष्कर्ष से साबित कीजिए।",
 "case:hints.h_accuse_ready.levels.0": "हो सकता है कि गिरफ़्तारी के लिए आपके पास काफ़ी कुछ हो। हेस्टर की मौत के वक़्त उसके साथ कौन था, घंटी किसने बजाई, और यह शुक्रवार की रात ही क्यों होना था?",
 "case:hints.h_accuse_ready.levels.1": "सिर्फ़ एक ही व्यक्ति ऐसा है जो घंटी के वक़्त चबूतरे पर नहीं था, उस रात शीशाघर में था, और जानता था कि सुबह हेस्टर क्या करने वाली थी।",
 "case:hints.h_accuse_ready.levels.2": "सीलिया पेनहैलो पर आरोप लगाइए: हेस्टर की अपनी छड़ी की चाँदी की मूठ से वार, ताकि उसके पति की जालसाज़ी पुलिस तक न पहुँचे। इसे उसके इस इक़बाल से कि वह शीशाघर गई थी (या घटनाक्रम से), उसके ड्रेसिंग गाउन और चप्पलों से (या जोरी या डॉ. एलरी के बयान से), और जालसाज़ी वाले अपने निष्कर्ष से (या Lorimer & Dane की चिट्ठी से) साबित कीजिए।",
 "case:hints.h_bell_ringer.levels.0": "घंटी के पास दिखी औरत की तुलना 9:25 वाली तस्वीर की औरत से कीजिए।",
 "case:hints.h_bell_ringer.levels.1": "लैंप के ब्रैकेट के मुक़ाबले उसकी ऊँचाई देखिए, उसके हाथ देखिए, और उसका दामन। लेडी पेनहैलो किसी सहारे के बिना एक क़दम भी नहीं चल सकती थी।",
 "case:hints.h_bell_ringer.levels.2": "रात 11:32 की तस्वीर और रात 9:25 की तस्वीर (या आबनूस की छड़ी) के साथ ‘कोई, जिसने उसका नक़ाब और शॉल पहन रखे थे’ जवाब दीजिए।",
 "case:hints.h_bloom.levels.0": "हेस्टर ने उस फूल के लिए पच्चीस बरस इंतज़ार किया था। क्या उसे अपना मौक़ा मिला?",
 "case:hints.h_bloom.levels.1": "उसका खिलने का रोज़नामचा पढ़िए, या डॉ. एलरी से पूछिए कि फूल खुलते ही हेस्टर क्या करती। फिर याद कीजिए कि पौ फटने पर जोरी को क्या मिला।",
 "case:hints.h_bloom.levels.2": "पौ फटने के बारे में जोरी के बयान (या चंद्र-ऑर्किड) और खिलने के रोज़नामचे (या परागण के बारे में डॉ. एलरी के बयान) के साथ ‘नहीं — वह उसे बिना परागण के कभी न छोड़ती’ जवाब दीजिए।",
 "case:hints.h_celia_alive.levels.0": "सीलिया क़सम खाती है कि जब वह ग्यारह बजने में दस मिनट पर निकली, तब हेस्टर ज़िंदा थी और लिख रही थी। देखिए कि हेस्टर ने क्या लिखा।",
 "case:hints.h_celia_alive.levels.1": "हेस्टर हर पंद्रह मिनट पर फूल का हाल रोज़नामचे में लिखती थी।",
 "case:hints.h_celia_alive.levels.2": "सीलिया के ‘ज़िंदा थीं, अपना रोज़नामचा लिख रही थीं’ वाले बयान को खिलने के रोज़नामचे से, या मौत के समय वाले अपने निष्कर्ष से चुनौती दीजिए।",
 "case:hints.h_celia_knew.levels.0": "सीलिया कहती है कि उसे किसी जालसाज़ी के बारे में कुछ पता नहीं था। उसे बताता कौन?",
 "case:hints.h_celia_knew.levels.1": "Lorimer & Dane की चिट्ठी पर हेस्टर का लिखा नोट फिर से पढ़िए — या मिस्टर किटो से पूछिए कि हेस्टर ने उसे क्या बताया था।",
 "case:hints.h_celia_knew.levels.2": "सीलिया के ‘किसी जालसाज़ी के बारे में कुछ भी नहीं जानती’ वाले बयान को Lorimer & Dane की चिट्ठी से, या सगाई के बारे में मिस्टर किटो के बयान से चुनौती दीजिए।",
 "case:hints.h_celia_rose.levels.0": "सीलिया कहती है कि वह गुलाब-पथ पर टहल रही थी और शीशाघर के पास भी नहीं गई। क्या उसकी कोई चीज़ कुछ और कहती है?",
 "case:hints.h_celia_rose.levels.1": "जिसने भी घंटी बजाई, उसने शॉल के नीचे कुछ हल्के रंग का पहन रखा था और निकलने के लिए बॉयलर-घर का रास्ता लिया। नीले कमरे की अलमारी में देखिए, या डॉ. एलरी से महक के बारे में पूछिए।",
 "case:hints.h_celia_rose.levels.2": "सीलिया के ‘गुलाब-पथ’ वाले बयान को उसके ड्रेसिंग गाउन और चप्पलों, कोक की धूल में निशानों, या जोरी या डॉ. एलरी के बयान से चुनौती दीजिए।",
 "case:hints.h_forgery.levels.0": "उसकी चिट्ठी में लिखा ‘कुछ आपराधिक’ आख़िर क्या था?",
 "case:hints.h_forgery.levels.1": "जब पता हो कि वह कौन-सी स्याही इस्तेमाल करती थी, तो दस्तख़त और भी बहुत कुछ बताता है। एग्नेस से उसकी आदतों के बारे में पूछिए, और बॉयलर की राख-ट्रे खँगालिए।",
 "case:hints.h_forgery.levels.2": "Lorimer & Dane की चिट्ठी और झुलसे दस्तावेज़ (या हरी स्याही के बारे में एग्नेस के बयान) के साथ ‘सबूत कि जूलियन ने £20,000 के रेहन पर उसके जाली दस्तख़त किए’ जवाब दीजिए।",
 "case:hints.h_jory_dawn.levels.0": "पौ फटने पर, पुलिस से भी पहले, कोई शीशाघर में था। उसे वहाँ क्या दिखा?",
 "case:hints.h_jory_dawn.levels.1": "उसे जोरी ट्रेवेना ने पाया था।",
 "case:hints.h_jory_dawn.levels.2": "जोरी से पूछताछ कीजिए और पूछिए कि लेडी पेनहैलो उसे किस हाल में मिली।",
 "case:hints.h_jory_pipe.levels.0": "जोरी कहता है कि दस बजे तक वह अपने बिस्तर में था। क्या सचमुच?",
 "case:hints.h_jory_pipe.levels.1": "कल रात कोई चारदीवारी वाले बग़ीचे के दरवाज़े के पास देर तक खड़ा धुआँ उड़ाता रहा।",
 "case:hints.h_jory_pipe.levels.2": "‘चबूतरा और बग़ीचे’ में ‘चारदीवारी वाले बग़ीचे का दरवाज़ा’ जाँचिए, फिर जोरी के ‘दस बजे तक अपने बिस्तर में था’ वाले बयान को पाइप की राख से चुनौती दीजिए।",
 "case:hints.h_julian_alibi.levels.0": "अब जब आपको पता है कि उसकी मौत कब हुई, तो सार्जेंट के संदिग्ध पर फिर से नज़र डालिए।",
 "case:hints.h_julian_alibi.levels.1": "मिसेज़ पास्को का बयान बताता है कि सवा दस बजे से ग्यारह बजकर दस मिनट तक जूलियन कहाँ था।",
 "case:hints.h_julian_alibi.levels.2": "मिसेज़ पास्को के बयान (या मिस्टर किटो के बयान) और मौत के समय वाले अपने निष्कर्ष के साथ ‘नहीं — जब उसकी मौत हुई, वह पुस्तकालय में किटो के साथ था’ जवाब दीजिए।",
 "case:hints.h_julian_forgery.levels.0": "जूलियन क़सम खाता है कि उसने अपने कारोबार को ईमानदारी से डूबने नहीं दिया।",
 "case:hints.h_julian_forgery.levels.1": "लेडी पेनहैलो की लिखने की मेज़ कुछ और कहती है।",
 "case:hints.h_julian_forgery.levels.2": "जूलियन के ‘ईमानदारी से डूबने नहीं दिया’ वाले बयान को Lorimer & Dane की चिट्ठी से चुनौती दीजिए।",
 "case:hints.h_julian_lawn.levels.0": "जूलियन कहता है कि घंटी के बाद उसने बैठक एक बार भी नहीं छोड़ी। पुलिस का ख़याल कुछ और है।",
 "case:hints.h_julian_lawn.levels.1": "सार्जेंट पॉलग्लेज़ के नोट्स दोबारा पढ़िए, या एग्नेस क्विल से पूछिए कि उसने अपनी खिड़की से क्या देखा।",
 "case:hints.h_julian_lawn.levels.2": "जूलियन के ‘बैठक एक बार भी नहीं छोड़ी’ वाले बयान को सार्जेंट के नोट्स से, या लॉन के बारे में एग्नेस के बयान से चुनौती दीजिए।",
 "case:hints.h_julian_money.levels.0": "जूलियन कहता है कि उसका हिसाब-किताब बिल्कुल दुरुस्त है।",
 "case:hints.h_julian_money.levels.1": "उसकी डिनर जैकेट नीले कमरे में एक कुर्सी पर लापरवाही से डाली हुई है।",
 "case:hints.h_julian_money.levels.2": "जूलियन के ‘बिल्कुल दुरुस्त’ वाले बयान को Westminster Bank की चिट्ठी से चुनौती दीजिए।",
 "case:hints.h_kittow.levels.0": "मिस्टर किटो कहता है कि सब कुछ पूरी तरह पेशेवर था।",
 "case:hints.h_kittow.levels.1": "लेडी पेनहैलो ने अपने सोख़्ते में एक चिट्ठी रख छोड़ी थी।",
 "case:hints.h_kittow.levels.2": "मिस्टर किटो के ‘पूरी तरह पेशेवर’ वाले बयान को लेडी पेनहैलो के सोख़्ते में मिली एडविन किटो की चिट्ठी से चुनौती दीजिए।",
 "case:hints.h_marian.levels.0": "डॉ. एलरी कहती है कि वह Kew के लिए यहाँ आई है। क्या सचमुच?",
 "case:hints.h_marian.levels.1": "उसके झोले में एक तार है, जो कहीं ज़्यादा दूर से आया है।",
 "case:hints.h_marian.levels.2": "डॉ. एलरी के ‘Kew की ओर से’ वाले बयान को मियामी से आए तार से चुनौती दीजिए।",
 "case:hints.h_photo.levels.0": "11:32 पर चार लोगों ने उसे देखा। क्या उनमें से किसी ने अपनी देखी चीज़ को किसी तरह दर्ज किया?",
 "case:hints.h_photo.levels.1": "जब घंटी बजी, तब डॉ. एलरी का कैमरा चबूतरे पर था।",
 "case:hints.h_photo.levels.2": "डॉ. एलरी से पूछिए कि घंटी बजने पर उसने क्या देखा, फिर डार्करूम में ताज़ा प्रिंट देखिए।",
 "case:hints.h_scene.levels.0": "जो दोबारा देखते हैं, उन पर घटनास्थल मेहरबान रहता है। क्या आपने शीशाघर को ठीक से छाना है?",
 "case:hints.h_scene.levels.1": "देखिए कि वह कथित तौर पर किस चीज़ से गिरी, किसके सहारे चलती थी, और उसने क्या लिखा।",
 "case:hints.h_scene.levels.2": "शीशाघर में सीढ़ी, आबनूस की छड़ी और रोज़नामचे की मेज़ जाँचिए।",
 "case:hints.h_scent.levels.0": "चंद्र-ऑर्किड की महक हर उस व्यक्ति से लिपट जाती है, जो उसके पास गया हो।",
 "case:hints.h_scent.levels.1": "उस महक को डॉ. एलरी किसी से भी बेहतर पहचानती है। घंटी के बाद बैठक में कौन आया था?",
 "case:hints.h_scent.levels.2": "डॉ. एलरी से पूछिए कि जब सीलिया 11:45 पर नीचे आई, तो क्या उसने कुछ ग़ौर किया।",
 "case:hints.h_sitting.levels.0": "लेडी पेनहैलो के अपने काग़ज़ बता सकते हैं कि वह अपने वकील को क्या सौंपने वाली थी।",
 "case:hints.h_sitting.levels.1": "उसके निजी कक्ष पर ताला है। चाबी उसकी संगिनी के पास है।",
 "case:hints.h_sitting.levels.2": "एग्नेस क्विल से पूछिए कि क्या आपको लेडी पेनहैलो के कमरे देखने की इजाज़त मिलेगी।",
 "case:hints.h_struck.levels.0": "डॉ. ट्रेसिडर कहता है कि वह सीढ़ी से गिरी। क्या शीशाघर उसकी बात से सहमत है?",
 "case:hints.h_struck.levels.1": "सार्जेंट के नोट्स में दर्ज घाव की तुलना उसकी छड़ी से कीजिए। फिर ख़ुद से पूछिए कि क्या कोई उस सीढ़ी पर चढ़ा भी था।",
 "case:hints.h_struck.levels.2": "बोर्ड पर आबनूस की छड़ी और सीढ़ी (या लोहे की बेंच) के साथ ‘उसकी अपनी छड़ी की चाँदी की मूठ के वार से’ जवाब दीजिए।",
 "case:hints.h_timeline.levels.0": "रात की हर घटना अब दर्ज हो चुकी है। क्या अब इन्हें सही क्रम में लगाया जा सकता है?",
 "case:hints.h_timeline.levels.1": "अपनी नोटबुक में घटनाक्रम खोलिए। जिन घटनाओं का समय पता है, उन्हें पहले जमाइए, फिर बाकी के बारे में तर्क से सोचिए।",
 "case:hints.h_timeline.levels.2": "सही क्रम: वह ख़ुद को भीतर बंद करती है, एग्नेस की कोको, रोज़नामचे की आख़िरी प्रविष्टि, सीलिया का नीचे जाना, वार, फूल का खुलना, घंटी, बॉयलर-घर से निकली आकृति, बैठक में सीलिया, दरवाज़े पर जूलियन, पौ फटने पर जोरी।",
 "case:hints.h_tod.levels.0": "अगर उसकी मौत फूल खुलने से पहले हुई, तो फूल खुला कब?",
 "case:hints.h_tod.levels.1": "उसकी आख़िरी प्रविष्टि पहली महक का समय बताती है — और यह भी कि एडमंड के मुताबिक़ फूल को खुलने में कितना वक़्त लगता है।",
 "case:hints.h_tod.levels.2": "खिलने के रोज़नामचे और अपने ‘फूल खुलने से पहले ही मौत’ वाले निष्कर्ष के साथ ‘रात 10:25 से लगभग 11:05 के बीच’ जवाब दीजिए।",
 "case:hints.h_way_out.levels.0": "शीशाघर का दरवाज़ा भीतर से बंद था। तो घंटी बजाने वाला बाहर कैसे निकला?",
 "case:hints.h_way_out.levels.1": "जोरी से बॉयलर-घर के दरवाज़े के बारे में पूछिए, और बॉयलर-घर की सीढ़ियों को फिर से देखिए।",
 "case:hints.h_way_out.levels.2": "बॉयलर-घर के दरवाज़े (या उसके बारे में जोरी के बयान) और कोक की धूल में निशानों (या झुलसे दस्तावेज़) के साथ ‘नीचे बॉयलर-घर से होकर, उसके बाहरी दरवाज़े से बाहर’ जवाब दीजिए।",
 "case:hints.h_who_absent.levels.0": "घंटी बजी, तो चार लोग चबूतरे से देख रहे थे। कौन नहीं था?",
 "case:hints.h_who_absent.levels.1": "सार्जेंट के नोट्स बताते हैं कि घंटी के वक़्त कौन मौजूद नहीं था। उससे पूछिए कि वह कहाँ थी, फिर उसके सोने के कमरे की खिड़की से बाहर देखिए।",
 "case:hints.h_who_absent.levels.2": "सीलिया पेनहैलो से पूछिए कि कल रात वह कहाँ थी, नीले कमरे में खिड़की जाँचिए, और उसके ‘अपनी खिड़की से हेस्टर को देखा’ वाले बयान को उससे चुनौती दीजिए।",
 "case:locations.blue_room.art.props.0.label": "खिड़की — उत्तर",
 "case:locations.blue_room.art.props.1.label": "सिंगार-मेज़",
 "case:locations.blue_room.art.props.2.label": "पलंग",
 "case:locations.blue_room.art.props.3.label": "अलमारी",
 "case:locations.blue_room.art.props.4.label": "आरामकुर्सी",
 "case:locations.blue_room.art.props.5.label": "कालीन",
 "case:locations.blue_room.description": "घर के उत्तरी हिस्से में मेहमानों का सबसे अच्छा कमरा, जिसकी दीवारों पर फीके नीले रंग का काग़ज़ चढ़ा है। पलंग पर दोनों तरफ़ सोने के निशान हैं। जूलियन के कपड़े एक कुर्सी पर बेतरतीब पड़े हैं; सीलिया के कपड़े सलीक़े से रख दिए गए हैं।",
 "case:locations.blue_room.hotspots.hs_br_bed.label": "पलंग",
 "case:locations.blue_room.hotspots.hs_br_bed.text": "दोनों तरफ़ सोने के निशान। जूलियन की तरफ़ नींद की गोलियों की एक शीशी: उसने सार्जेंट को बताया कि एक बजे ऊपर आकर उसने दो गोलियाँ लीं और शोर मचने तक मुर्दे की तरह सोता रहा। रात में उसकी पत्नी ने जो भी किया हो, उसे पता तक न चलता।",
 "case:locations.blue_room.hotspots.hs_br_chair.label": "जूलियन की जैकेट",
 "case:locations.blue_room.hotspots.hs_br_chair.text": "जूलियन की डिनर जैकेट आरामकुर्सी पर लापरवाही से डाली हुई है। भीतरी जेब में कुछ खड़कता है।",
 "case:locations.blue_room.hotspots.hs_br_dressing.label": "सिंगार-मेज़",
 "case:locations.blue_room.hotspots.hs_br_dressing.text": "इत्र की शीशियों के बीच चाँदी के फ़्रेम में एक तस्वीर — मुकुट और लंबा गाउन पहने एक युवा अभिनेत्री: ‘सीलिया लेन, लेडी मैकबेथ की भूमिका में, Bristol Old Vic, 1954’। तस्वीर में भी वह निगाहें बाँध लेती है।",
 "case:locations.blue_room.hotspots.hs_br_wardrobe.label": "अलमारी",
 "case:locations.blue_room.hotspots.hs_br_wardrobe.text": "घंटी वाली आकृति की काली शॉल के नीचे हल्के रंग का दामन झलक रहा था, और वह बॉयलर-घर के रास्ते निकली थी। अलमारी का पल्ला खुलता है।",
 "case:locations.blue_room.hotspots.hs_br_window.label": "खिड़की",
 "case:locations.blue_room.hotspots.hs_br_window.text": "पर्दा हटाते ही बाहर का नज़ारा सामने आ जाता है।",
 "case:locations.blue_room.name": "नीला कमरा",
 "case:locations.blue_room.summary": "जूलियन और सीलिया का सोने का कमरा।",
 "case:locations.darkroom.art.props.0.label": "काली की गई खिड़की",
 "case:locations.darkroom.art.props.1.label": "पत्थर का सिंक",
 "case:locations.darkroom.art.props.2.label": "काम की मेज़",
 "case:locations.darkroom.art.props.3.label": "सेफ़लाइट",
 "case:locations.darkroom.art.props.4.label": "एनलार्जर",
 "case:locations.darkroom.art.props.5.label": "सुखाने की डोरी",
 "case:locations.darkroom.art.props.6.label": "बर्तनों की अलमारी",
 "case:locations.darkroom.art.props.7.label": "गलियारे की ओर",
 "case:locations.darkroom.description": "पिछले गलियारे से लगा पुराना बर्तन-घर, जिसकी खिड़की डॉ. एलरी ने काली कर दी है और जिसे रसायनों से भर दिया है। यहाँ सिरके और फ़िक्सर की गंध है। सिंक के ऊपर लाल सेफ़लाइट अब भी जल रही है।",
 "case:locations.darkroom.hotspots.hs_dr_line.label": "डोरी पर टँगे प्रिंट",
 "case:locations.darkroom.hotspots.hs_dr_line.text": "सुखाने की डोरी पर लकड़ी की चिमटियों से प्रिंट टँगे हैं: ऑर्किड की कली, दिन के उजाले में शीशाघर — और एक ख़ुद लेडी पेनहैलो का।",
 "case:locations.darkroom.hotspots.hs_dr_newprint.label": "ताज़ा प्रिंट",
 "case:locations.darkroom.hotspots.hs_dr_newprint.text": "डोरी के आख़िर में, अब भी गीला और किनारों से मुड़ता हुआ: वह प्रिंट जो डॉ. एलरी ने आज सुबह घंटी के वक़्त लिए अपने इकलौते एक्सपोज़र से बनाया है।",
 "case:locations.darkroom.hotspots.hs_dr_safelight.label": "सेफ़लाइट",
 "case:locations.darkroom.hotspots.hs_dr_safelight.text": "सिंक के ऊपर एक लाल लैंप। जब यह जलता है, तो दरवाज़ा बंद ही रहना चाहिए, वरना रात भर की मेहनत बर्बाद हो जाती है। अकेले रहने के लिए बेहतरीन जगह — और किसी को दिख नहीं सकता कि भीतर कोई है।",
 "case:locations.darkroom.hotspots.hs_dr_satchel.label": "डॉ. एलरी का झोला",
 "case:locations.darkroom.hotspots.hs_dr_satchel.text": "बर्तनों की अलमारी के पास एक खूँटी पर कैनवस का झोला टँगा है: नोटबुकें, लाइट मीटर, फ़ालतू फ़िल्म। और तार का एक फ़ॉर्म, ख़ूब छोटा तह किया हुआ।",
 "case:locations.darkroom.hotspots.hs_dr_trays.label": "डेवलपिंग ट्रे",
 "case:locations.darkroom.hotspots.hs_dr_trays.text": "इनैमल की तीन ट्रे और सधी लिखावट वाली एक नोटबुक: ‘10:05 — कली के नेगेटिव टैंक में। 10:40 — पहले प्रिंट। 10:50 — मिसेज़ पी. दरवाज़े पर!! 11:10 — धुलाई पूरी; बाहर चबूतरे पर।’ उन नेगेटिवों के प्रिंट तारीख़ और नंबर के साथ डोरी पर टँगे हैं।",
 "case:locations.darkroom.name": "डार्करूम",
 "case:locations.darkroom.summary": "पुराने बर्तन-घर में बना डॉ. एलरी का डार्करूम।",
 "case:locations.gardens.art.props.0.label": "घर — दक्षिणी हिस्सा",
 "case:locations.gardens.art.props.1.label": "बैठक",
 "case:locations.gardens.art.props.2.label": "बर्तन-घर का दरवाज़ा",
 "case:locations.gardens.art.props.3.label": "चबूतरा",
 "case:locations.gardens.art.props.4.label": "लॉन",
 "case:locations.gardens.art.props.5.label": "धूपघड़ी",
 "case:locations.gardens.art.props.6.label": "यू की बाड़",
 "case:locations.gardens.art.props.7.label": "गुलाब-पथ",
 "case:locations.gardens.art.props.8.label": "शीशाघर",
 "case:locations.gardens.art.props.9.label": "चारदीवारी वाला बग़ीचा",
 "case:locations.gardens.description": "चबूतरा घर के पूरे दक्षिणी हिस्से के साथ-साथ चलता है। उसके नीचे लॉन चालीस गज़ की ढलान उतरकर शीशाघर तक जाता है। पूरब में चारदीवारी वाला बग़ीचा है, और यू की ऊँची बाड़ के पीछे गुलाब-पथ। घास अब भी ओस से धूसर है।",
 "case:locations.gardens.hotspots.hs_gd_garden_door.label": "बर्तन-घर का दरवाज़ा",
 "case:locations.gardens.hotspots.hs_gd_garden_door.text": "घर के पूरबी छोर पर एक सादा दरवाज़ा, जो पुराने बर्तन-घर वाले गलियारे में खुलता है — पिछली सीढ़ियाँ, डार्करूम, नौकरों का रास्ता। कोई भी यहाँ से आ-जा सकता था, और बैठक या चबूतरे से उसे कोई न देख पाता।",
 "case:locations.gardens.hotspots.hs_gd_rose.label": "गुलाब-पथ",
 "case:locations.gardens.hotspots.hs_gd_rose.text": "पुराने गुलाबों के बीच घास का एक रास्ता, दस फ़ुट ऊँची और दीवार जितनी घनी यू की बाड़ के पीछे। यहाँ से शीशाघर की छत तक नहीं दिखती, हालाँकि उसकी घंटी अच्छी तरह सुनाई दे जाती। गरम रात में टहलने की सुहानी जगह — और यहाँ किसी की नज़र न पड़ती।",
 "case:locations.gardens.hotspots.hs_gd_stokehole.label": "बॉयलर-घर का दरवाज़ा",
 "case:locations.gardens.hotspots.hs_gd_stokehole.text": "शीशाघर के पूरबी छोर के नीचे ईंटों की कुछ सीढ़ियाँ उतरकर बॉयलर-घर के दरवाज़े तक जाती हैं। मज़बूत बलूत की लकड़ी; इस तरफ़ न ताले का छेद, न हत्था। भीतर से चिटकनी लग जाए, तो कोई अंदर नहीं जा सकता। चिटकनी खुली हो, तो कोई भी बाहर आ सकता है।",
 "case:locations.gardens.hotspots.hs_gd_tripod.label": "तिपाई के निशान",
 "case:locations.gardens.hotspots.hs_gd_tripod.text": "चबूतरे के किनारे बजरी में तीन छोटे-छोटे गड्ढे, जहाँ डॉ. एलरी की तिपाई खड़ी थी। घंटी बजी, तो वे चारों यहीं से देख रहे थे।",
 "case:locations.gardens.hotspots.hs_gd_view.label": "लॉन के पार का नज़ारा",
 "case:locations.gardens.hotspots.hs_gd_view.text": "चबूतरे से शीशाघर चालीस गज़ दूर है, लॉन की ढलान के नीचे। आज सुबह भी भीतर की गरमाहट से शीशे पर भाप जमी है। कल रात, लैंप जलने पर, वह ज़रूर किसी लालटेन की तरह दमक रहा होगा।",
 "case:locations.gardens.hotspots.hs_gd_wall_door.label": "चारदीवारी वाले बग़ीचे का दरवाज़ा",
 "case:locations.gardens.hotspots.hs_gd_wall_door.text": "सब्ज़ियों वाले बग़ीचे की चारदीवारी में बना दरवाज़ा, शीशाघर के पूरबी छोर के बग़ल में। देहरी पर किसी ने कुछ झाड़कर गिराया है और उसे पैरों तले रौंदा है।",
 "case:locations.gardens.name": "चबूतरा और बग़ीचे",
 "case:locations.gardens.summary": "जहाँ घर के लोग घंटी की राह देख रहे थे।",
 "case:locations.glasshouse.art.props.0.label": "शीशे की दीवार",
 "case:locations.glasshouse.art.props.1.label": "शीशे की दीवार",
 "case:locations.glasshouse.art.props.10.label": "बॉयलर-घर की सीढ़ियाँ",
 "case:locations.glasshouse.art.props.11.label": "बरसाती पानी की टंकी",
 "case:locations.glasshouse.art.props.12.label": "लॉन की ओर दरवाज़ा",
 "case:locations.glasshouse.art.props.2.label": "शीशे की दीवार",
 "case:locations.glasshouse.art.props.3.label": "गरम पानी के पाइप",
 "case:locations.glasshouse.art.props.4.label": "बेंच",
 "case:locations.glasshouse.art.props.5.label": "पेड़-फ़र्न",
 "case:locations.glasshouse.art.props.6.label": "बेंच",
 "case:locations.glasshouse.art.props.7.label": "लैंप का ब्रैकेट",
 "case:locations.glasshouse.art.props.8.label": "ऑर्किड की बेंच",
 "case:locations.glasshouse.art.props.9.label": "रोज़नामचे की मेज़",
 "case:locations.glasshouse.description": "लॉन के निचले छोर पर सर एडमंड का विशाल शीशाघर, जो 1912 में उन पौधों के लिए बना था जिन्हें वह परदेस से भेजता था। बॉयलर इसे किसी जंगली रात जैसा गरम रखता है। सार्जेंट पॉलग्लेज़ शव को सेंट ऑस्टल भिजवा चुका है। हवा में अब भी लौंग और लिली की महक है।",
 "case:locations.glasshouse.hotspots.hs_gh_ashpan.label": "बॉयलर की राख-ट्रे",
 "case:locations.glasshouse.hotspots.hs_gh_ashpan.text": "किसी ने जोरी के बॉयलर में कुछ जलाया था। अब सलाख़ों के नीचे की राख-ट्रे बाहर खींचनी है और उसे खुरपी से छानना है।",
 "case:locations.glasshouse.hotspots.hs_gh_bell.label": "घंटी की डोरी",
 "case:locations.glasshouse.hotspots.hs_gh_bell.text": "दरवाज़े के पास, पीतल की ज़ंजीर वाली घंटी की डोरी ऊपर छत की मुँडेर पर लगी जहाज़ी घंटी तक जाती है। एक बार खींचने भर से पूरा बग़ीचा सुन लेता है। भीतर खड़ा कोई भी इसे बजा सकता था।",
 "case:locations.glasshouse.hotspots.hs_gh_door.label": "शीशे का दरवाज़ा",
 "case:locations.glasshouse.hotspots.hs_gh_door.text": "लॉन की ओर वाला दरवाज़ा भीतर से बंद होता है। पौ फटने पर चाबी ताले में थी, भीतर की तरफ़, और दरवाज़ा बंद था। मदद के लिए भागने को जोरी ने ख़ुद उसे घुमाया। कल रात जो भी यहाँ से निकला, इस रास्ते से नहीं निकला।",
 "case:locations.glasshouse.hotspots.hs_gh_flask.label": "कोको का फ़्लास्क",
 "case:locations.glasshouse.hotspots.hs_gh_flask.text": "एग्नेस क्विल का कोको का फ़्लास्क; एक प्याला उँडेलकर पिया गया है। बाकी ठंडा हो चुका है, ऊपर मलाई की परत जमी है। सार्जेंट के मुताबिक़ इसमें कोको और ज़रूरत से ज़्यादा चीनी के सिवा कुछ नहीं। उसने चखकर देखा है।",
 "case:locations.glasshouse.hotspots.hs_gh_ladder.label": "सीढ़ी",
 "case:locations.glasshouse.hotspots.hs_gh_ladder.text": "लकड़ी की एक सीढ़ी टाइलों पर करवट के बल पड़ी है, जहाँ सार्जेंट ने उसे पाया था।",
 "case:locations.glasshouse.hotspots.hs_gh_lamp.label": "लैंप",
 "case:locations.glasshouse.hotspots.hs_gh_lamp.text": "मिट्टी के तेल का लैंप ऑर्किड की बेंच के ऊपर अपने लोहे के ब्रैकेट से लटका है; लौ घटाकर नीले मनके जितनी कर दी गई है। कल दोपहर जोरी ने इसमें तेल भरा था; इसमें अब भी एक और रात भर का तेल बचा है।",
 "case:locations.glasshouse.hotspots.hs_gh_log.label": "रोज़नामचे की मेज़",
 "case:locations.glasshouse.hotspots.hs_gh_log.text": "रास्ते के छोर पर बाँस की एक छोटी मेज़; उस पर एक रजिस्टर, एक फ़ाउंटेन पेन, सेबल के बालों का एक ब्रश और हरी स्याही की एक दवात।",
 "case:locations.glasshouse.hotspots.hs_gh_orchid.label": "चंद्र-ऑर्किड",
 "case:locations.glasshouse.hotspots.hs_gh_orchid.text": "बेंच पर सबसे ख़ास जगह, सागौन की पट्टियों वाली टोकरी में: चंद्र-ऑर्किड। एक ही फूल, और उसका वक़्त बीत चुका है।",
 "case:locations.glasshouse.hotspots.hs_gh_outline.label": "खड़िया का घेरा",
 "case:locations.glasshouse.hotspots.hs_gh_outline.text": "ऑर्किड की बेंच के पायों के पास सार्जेंट पॉलग्लेज़ का खड़िया से बनाया घेरा। जोरी कहता है, वह करवट के बल पड़ी थी, बालों पर नक़ाब और कंधों पर शॉल — ऐसे सलीक़े से, मानो सुस्ताने के लिए टाइलों पर बैठ गई हो।",
 "case:locations.glasshouse.hotspots.hs_gh_prints.label": "सीढ़ियों पर कोक की धूल",
 "case:locations.glasshouse.hotspots.hs_gh_prints.text": "लेडी पेनहैलो का भेस धरे किसी ने यह शीशाघर अपने पीछे बंद छोड़ा था। टॉर्च की रोशनी में बॉयलर-घर की सीढ़ियों को एक बार फिर, कहीं ज़्यादा ग़ौर से देखने की ज़रूरत है।",
 "case:locations.glasshouse.hotspots.hs_gh_staging.label": "बेंच का किनारा",
 "case:locations.glasshouse.hotspots.hs_gh_staging.text": "ऑर्किड की बेंच का लोहे का किनारा, एक बूढ़ी औरत के सिर की ऊँचाई पर — अगर वह तीसरे डंडे से गिरी हो।",
 "case:locations.glasshouse.hotspots.hs_gh_stick.label": "आबनूस की छड़ी",
 "case:locations.glasshouse.hotspots.hs_gh_stick.text": "बेंच के नीचे, काई और गिरी हुई पर्चियों के बीच, चाँदी की मूठ वाली एक छड़ी पड़ी है।",
 "case:locations.glasshouse.hotspots.hs_gh_stokehole.label": "बॉयलर-घर की सीढ़ियाँ",
 "case:locations.glasshouse.hotspots.hs_gh_stokehole.text": "पूरबी छोर पर लोहे की सीढ़ियाँ नीचे अँधेरे में उतरती हैं। बॉयलर-घर: बॉयलर, कोक का ढेर, और एक मज़बूत दरवाज़ा, जो चारदीवारी वाले बग़ीचे की दीवार के तले बाहर खुलता है।",
 "case:locations.glasshouse.name": "शीशाघर",
 "case:locations.glasshouse.summary": "जहाँ लेडी पेनहैलो ने रतजगा किया, और जहाँ उसकी मौत हुई।",
 "case:locations.library.art.props.0.label": "किताबों की अलमारियाँ",
 "case:locations.library.art.props.1.label": "सर एडमंड",
 "case:locations.library.art.props.2.label": "आतिशदान",
 "case:locations.library.art.props.3.label": "आरामकुर्सी",
 "case:locations.library.art.props.4.label": "आरामकुर्सी",
 "case:locations.library.art.props.5.label": "मेज़",
 "case:locations.library.art.props.6.label": "कालीन",
 "case:locations.library.art.props.7.label": "पेय की मेज़",
 "case:locations.library.art.props.8.label": "खिड़की",
 "case:locations.library.description": "सर एडमंड का पुस्तकालय: पौधों की खोज-यात्राओं की डायरियाँ, वनस्पतियों के चित्र-पट और चालीस बरस के Kew Bulletin। कल रात के बाद से किसी ने कुछ समेटा नहीं है। पेय की मेज़ पर अब भी दो गिलास रखे हैं, और कमरे में सिगार के धुएँ की गंध है।",
 "case:locations.library.hotspots.hs_lb_briefcase.label": "मिस्टर किटो का ब्रीफ़केस",
 "case:locations.library.hotspots.hs_lb_briefcase.text": "मेज़ के पास सूअर की खाल का एक ब्रीफ़केस रखा है, जिस पर ‘ई.के.’ छपा है; ताला खुला है। मिस्टर किटो ने आपसे कहा था कि बेझिझक देख लें।",
 "case:locations.library.hotspots.hs_lb_glasses.label": "दो गिलास",
 "case:locations.library.hotspots.hs_lb_glasses.text": "व्हिस्की के दो गिलास और मिसेज़ पास्को की ट्रे। लबालब भरी ऐशट्रे: सिगार के टुकड़े, और ढेर सारी सिगरेटों के टोटे। किटो सिगार पीता है; जूलियन एक के बाद एक सिगरेट फूँकता है। वे यहाँ देर तक रहे।",
 "case:locations.library.hotspots.hs_lb_portrait.label": "सर एडमंड का चित्र",
 "case:locations.library.hotspots.hs_lb_portrait.text": "1938 के सर एडमंड पेनहैलो — बुश जैकेट पहने, कंधे पर पौधे सहेजने का टिन का डिब्बा टाँगे, फ़्रेम से ज़रा बाहर किसी चीज़ पर हँसते हुए। नीचे एक कार्ड पर हरी स्याही में: ‘लापता, शान की पहाड़ियाँ, मार्च 1943। वे हमेशा घर लौट आते थे।’",
 "case:locations.library.hotspots.hs_lb_window.label": "खिड़की",
 "case:locations.library.hotspots.hs_lb_window.text": "पुस्तकालय की खिड़की पूरब में अस्तबल के आँगन की ओर खुलती है। यहाँ से न शीशाघर दिखता है, न चबूतरा, न लॉन। कल रात जो भी इस कमरे में बैठा था, उसे चबूतरे पर निकलने तक बग़ीचे का कुछ भी नहीं दिखा।",
 "case:locations.library.name": "पुस्तकालय",
 "case:locations.library.summary": "जहाँ जूलियन और मिस्टर किटो वसीयत को लेकर उलझते रहे।",
 "case:locations.sitting_room.art.props.0.label": "लॉन की ओर खिड़की",
 "case:locations.sitting_room.art.props.1.label": "लिखने की मेज़",
 "case:locations.sitting_room.art.props.2.label": "कुर्सी",
 "case:locations.sitting_room.art.props.3.label": "हर्बेरियम की अलमारी",
 "case:locations.sitting_room.art.props.4.label": "आतिशदान",
 "case:locations.sitting_room.art.props.5.label": "कालीन",
 "case:locations.sitting_room.art.props.6.label": "सोफ़ा",
 "case:locations.sitting_room.description": "दक्षिणी हिस्से में एक छोटा, उजला कमरा, जहाँ हेस्टर अपनी चिट्ठियाँ लिखती और वनस्पतियों का काम करती थी। हर दीवार पर दबाकर सुखाए पौधों के नमूने फ़्रेम में लगे हैं। खिड़की से वह लॉन के निचले छोर पर अपना शीशाघर देख सकती थी।",
 "case:locations.sitting_room.hotspots.hs_sr_blotter.label": "सोख़्ता",
 "case:locations.sitting_room.hotspots.hs_sr_blotter.text": "हरे चमड़े का सोख़्ता। उसके कवर के भीतर एक चिट्ठी तह करके रखी है — ऐसी जगह, जहाँ वह उसे ढूँढ़ ले और कोई और नहीं।",
 "case:locations.sitting_room.hotspots.hs_sr_cabinet.label": "हर्बेरियम की अलमारी",
 "case:locations.sitting_room.hotspots.hs_sr_cabinet.text": "महोगनी की दराज़ों में एडमंड के दबाकर सुखाए नमूने, हर एक पर दो बार नाम लिखा है — उसकी भूरी स्याही में और हेस्टर की हरी में। सबसे निचली दराज़ में एक अकेला, पीला पड़ चुका तार: ‘खेद सहित सूचित सर एडमंड पेनहैलो लापता मृत होने की आशंका।’",
 "case:locations.sitting_room.hotspots.hs_sr_desk.label": "लिखने की मेज़",
 "case:locations.sitting_room.hotspots.hs_sr_desk.text": "उसकी चिट्ठियाँ — जवाब दी हुई और बिना जवाब की — दो साफ़-सुथरी गड्डियों में। एक चिट्ठी बाकियों से अलग, घोंघे के आकार के पेपरवेट के नीचे दबी है।",
 "case:locations.sitting_room.hotspots.hs_sr_diary.label": "मुलाक़ातों की डायरी",
 "case:locations.sitting_room.hotspots.hs_sr_diary.text": "उसकी मुलाक़ातों की डायरी इसी हफ़्ते के पन्ने पर खुली है, हरी स्याही में: ‘शुक्र 26 — शाम 6:00, सीलिया। फूल खिलेगा!’ और ‘शनि 27 — सुबह 10:00, एडविन। वसीयत।’ शुक्रवार के नीचे, ज़रा छोटी लिखावट में: ‘आए, तो उसे माफ़ कर देना।’",
 "case:locations.sitting_room.hotspots.hs_sr_ink.label": "दवात-दान",
 "case:locations.sitting_room.hotspots.hs_sr_ink.text": "दो दवातों वाला चाँदी का दवात-दान। दोनों में हरी स्याही भरी है। कमरे में किसी और रंग की स्याही की एक शीशी तक नहीं, न कोई काली क़लम।",
 "case:locations.sitting_room.hotspots.hs_sr_window.label": "खिड़की",
 "case:locations.sitting_room.hotspots.hs_sr_window.text": "यहाँ से लॉन के पार सीधे शीशाघर तक नज़र जाती है। दक्षिण की ओर खुलती खिड़की, बग़ल वाले मिस क्विल के कमरे की तरह। घर की इस तरफ़ से घंटी, लैंप और सफ़ेद फूल — सब साफ़ दिखाई देते।",
 "case:locations.sitting_room.lockedHint": "ताला लगा है। चाबी एग्नेस क्विल के पास है।",
 "case:locations.sitting_room.name": "लेडी पेनहैलो का निजी कक्ष",
 "case:locations.sitting_room.summary": "चबूतरे के ऊपर उसका अपना कमरा।",
 "case:setting": "पेनहैलो हाउस · कॉर्नवॉल · जुलाई 1963",
 "case:sketchCredit": "रेखाचित्र: सार्जें. डब्ल्यू. पॉलग्लेज़ · पैमाने पर नहीं",
 "case:sketchTitle": "पेनहैलो हाउस",
 "case:stayLabel": "पेनहैलो में रुकें",
 "case:tagline": "एक महिला वनस्पति-विज्ञानी, एक वसीयत, और एक ऑर्किड जो सिर्फ़ रात में खिलता है।",
 "case:timeline.conclusion": "लेडी पेनहैलो 10:25 पर ज़िंदा थी, और लगभग 11:05 पर उसका ऑर्किड खुलने से पहले मर चुकी थी। उस बीच उसके साथ सिर्फ़ एक ही व्यक्ति के होने की जानकारी है: सीलिया, जो ग्यारह बजने में बीस मिनट पर नीचे गई थी और घंटी के कुछ मिनट बाद बॉयलर-घर के रास्ते निकली।",
 "case:timeline.events.tl_bell.text": "घंटी बजती है और ‘विधवा’ चबूतरे की ओर अपना लैंप उठाती है",
 "case:timeline.events.tl_bell.time": "रात 11:32",
 "case:timeline.events.tl_bloom.teaser": "फूल का क्या हुआ।",
 "case:timeline.events.tl_bloom.text": "चंद्र-ऑर्किड खुलता है — और कोई उसका परागण नहीं करता",
 "case:timeline.events.tl_celia_goes.teaser": "साढ़े दस और ग्यारह के बीच कोई शीशाघर गया — और इस बारे में चुप रहा है।",
 "case:timeline.events.tl_celia_goes.text": "सीलिया चुपके से नीचे शीशाघर जाती है",
 "case:timeline.events.tl_cocoa.teaser": "ख़ुद को भीतर बंद करने के बाद किसी ने उसे ज़िंदा देखा।",
 "case:timeline.events.tl_cocoa.text": "एग्नेस कोको लाती है — लेडी पेनहैलो ज़िंदा और भली-चंगी है",
 "case:timeline.events.tl_cocoa.time": "रात 10:15",
 "case:timeline.events.tl_drawing_room.text": "सीलिया ड्रेसिंग गाउन पहने नीचे बैठक में आती है",
 "case:timeline.events.tl_drawing_room.time": "रात 11:45",
 "case:timeline.events.tl_found.teaser": "पौ फटने पर माली ने क्या किया।",
 "case:timeline.events.tl_found.text": "जोरी को शव मिलता है — और वह ऑर्किड का परागण करता है",
 "case:timeline.events.tl_found.time": "सुबह 5:45",
 "case:timeline.events.tl_julian.teaser": "आधी रात के बाद कोई नीचे शीशाघर गया।",
 "case:timeline.events.tl_julian.text": "जूलियन शीशाघर को बंद और लैंप की लौ धीमी पाता है",
 "case:timeline.events.tl_julian.time": "रात 12:15",
 "case:timeline.events.tl_last_entry.teaser": "उसका आख़िरी काम, जिसकी हमें जानकारी है।",
 "case:timeline.events.tl_last_entry.text": "लेडी पेनहैलो खिलने के रोज़नामचे में आख़िरी प्रविष्टि लिखती है",
 "case:timeline.events.tl_last_entry.time": "रात 10:25",
 "case:timeline.events.tl_lock.text": "लेडी पेनहैलो अपने ऑर्किड के साथ ख़ुद को भीतर बंद कर लेती है",
 "case:timeline.events.tl_lock.time": "रात 9:30",
 "case:timeline.events.tl_stokehole.teaser": "बग़ीचे में किसी ने जितना बताया है, उससे ज़्यादा देखा था।",
 "case:timeline.events.tl_stokehole.text": "बॉयलर-घर से हल्के रंग की एक आकृति चुपके से निकलती है",
 "case:timeline.events.tl_struck.teaser": "उसकी असल में मौत कैसे हुई।",
 "case:timeline.events.tl_struck.text": "लेडी पेनहैलो पर उसकी अपनी छड़ी से वार होता है",
 "case:timeline.prompt": "शुक्रवार रात की घटनाओं को उसी क्रम में लगाइए जिसमें वे सचमुच घटीं। जिन समयों की पक्की जानकारी है, वे दिखाए गए हैं; बाकी तर्क से तय कीजिए।",
 "case:timeline.title": "खिलने की उस रात की कड़ियाँ",
 "case:title": "शीशाघर की विधवा",
 "deductions:contradictions.c_celia_alive.insight": "हेस्टर हर पंद्रह मिनट पर अपने ऑर्किड का हाल लिखती थी, और 10:25 के बाद उसने कुछ नहीं लिखा। बॉयलर-घर से जो भी निकला, वह घंटी के कुछ मिनट बाद निकला, ग्यारह बजने में दस मिनट पर नहीं। सीलिया अपने पीछे किसी ज़िंदा औरत को छोड़कर नहीं गई थी।",
 "deductions:contradictions.c_celia_alive.response.0": "तो उन्होंने… उन्होंने लिखना बंद कर दिया होगा। वे थकी हुई थीं। बूढ़ी औरतें थक ही जाती हैं।",
 "deductions:contradictions.c_celia_alive.response.1": "उसके हाथ गोद में एक-दूसरे को ढूँढ़कर कसकर जकड़े हुए हैं। हर किसी के कहे मुताबिक़, हेस्टर पेनहैलो ने अगली पंक्ति लिखने के लिए पच्चीस बरस इंतज़ार किया था।",
 "deductions:contradictions.c_celia_alive.title": "सीलिया के निकलने से पहले हेस्टर मर चुकी थी",
 "deductions:contradictions.c_celia_bed.insight": "नीला कमरा उत्तर की ओर, सामने के रास्ते पर खुलता है। सीलिया ने अपनी खिड़की से हेस्टर को कभी नहीं देखा। घंटी बजी, तब वह बिस्तर में नहीं थी।",
 "deductions:contradictions.c_celia_bed.response.0": "…शायद मैं उलझन में थी। मेरा सिर दर्द से फटा जा रहा था।",
 "deductions:contradictions.c_celia_bed.response.1": "अच्छा, ठीक है। मैं बिस्तर में नहीं थी। मुझसे लेटा नहीं जा रहा था, सो मैंने ड्रेसिंग गाउन पहना और चुपके से बग़ीचे में निकल गई — गुलाब-पथ पर, ज़रा हवा खाने। घंटी बजी, तब मैं वहीं थी, और फिर मैं अंदर आ गई।",
 "deductions:contradictions.c_celia_bed.response.2": "मैंने बताया नहीं, क्योंकि जूलियन बेवजह हंगामा खड़ा कर देता। बस इतनी-सी बात है।",
 "deductions:contradictions.c_celia_bed.title": "सीलिया को शीशाघर दिख ही नहीं सकता था",
 "deductions:contradictions.c_celia_knew.insight": "शुक्रवार शाम छह बजे हेस्टर ने सीलिया को जूलियन की जालसाज़ी के बारे में बता दिया था। सुबह सबूत मिस्टर किटो के पास जाना था, और उससे पुलिस के पास।",
 "deductions:contradictions.c_celia_knew.response.0": "…उन्होंने यह लिख रखा था? ज़ाहिर है, लिखा होगा। वे हर बात लिख लेती थीं।",
 "deductions:contradictions.c_celia_knew.response.1": "हाँ। छह बजे उन्होंने मुझे बुलवाया और वह चिट्ठी दिखाई। बोलीं कि जूलियन के पास रात भर का वक़्त है कि आकर उनके सामने अपना गुनाह क़बूल कर ले, और सुबह सब कुछ मिस्टर किटो के पास जाएगा। और फिर पुलिस के पास।",
 "deductions:contradictions.c_celia_knew.response.2": "मैंने जूलियन को नहीं बताया। मुझे लगा, मैं ख़ुद उन्हें मना लूँगी। लोगों को मनाना मुझे हमेशा आता था। हेस्टर को छोड़कर, सबको।",
 "deductions:contradictions.c_celia_knew.title": "सीलिया को जालसाज़ी का पता था",
 "deductions:contradictions.c_celia_rose_walk.insight": "सीलिया गुलाबों के बीच नहीं टहल रही थी। उस रात वह शीशाघर में थी और बॉयलर-घर के रास्ते निकली। अब वह मानती है कि ग्यारह बजने में बीस मिनट पर वह हेस्टर के पास गई थी, और क़सम खाती है कि जब वह निकली, तब हेस्टर ज़िंदा थी।",
 "deductions:contradictions.c_celia_rose_walk.response.0": "…",
 "deductions:contradictions.c_celia_rose_walk.response.1": "ठीक है। हाँ। ग्यारह बजने में बीस मिनट पर मैं नीचे शीशाघर गई, और उन्होंने मुझे अंदर आने दिया। मैंने उनकी मिन्नत की कि उस वसीयत पर दस्तख़त न करें — सोचें कि इससे जूलियन का क्या होगा। उन्होंने एक न सुनी। उन्होंने कभी मेरी नहीं सुनी।",
 "deductions:contradictions.c_celia_rose_walk.response.2": "ग्यारह बजने में दस मिनट पर मैं बॉयलर-घर के रास्ते निकल आई, ताकि कोई मुझे लॉन पार करते न देखे। वे ज़िंदा थीं। वहीं बैठी अपना वह रोज़नामचा लिख रही थीं, बड़े आराम से।",
 "deductions:contradictions.c_celia_rose_walk.title": "सीलिया शीशाघर के भीतर थी",
 "deductions:contradictions.c_jory_bed.insight": "जोरी बिस्तर में नहीं था। रात का बड़ा हिस्सा वह चारदीवारी वाले बग़ीचे के दरवाज़े पर खड़ा शीशाघर को ताकता रहा, और घंटी के बाद उसने किसी को बॉयलर-घर के रास्ते निकलते देखा।",
 "deductions:contradictions.c_jory_bed.response.0": "…वो मेरा ही है। मुकर नहीं सकता।",
 "deductions:contradictions.c_jory_bed.response.1": "नींद कहाँ आती, मालकिन का फूल जो खिलने वाला था। ग्यारह बजने से पहले से मैं चारदीवारी वाले बग़ीचे के दरवाज़े पर खड़ा था, पाइप फूँकता और शीशाघर को ताकता। घंटी सुनी, लैंप को ऊपर उठते और नीचे होते देखा। मालकिन ने कहा था दूर रहना, सो मैंने किसी से कुछ ना कहा।",
 "deductions:contradictions.c_jory_bed.response.2": "और कुछ मिनट बाद बॉयलर-घर से कुछ ऊपर निकला — लंबा और हल्के रंग का, रात के गाउन जैसा — और दीवार के साथ-साथ तेज़ी से घर की ओर चला गया। भगवान माफ़ करे, मैंने तो उसे मालकिन का भूत समझा। यह बात कहूँ, तो सारा गाँव मुझ पर हँसे।",
 "deductions:contradictions.c_jory_bed.title": "जोरी शीशाघर पर नज़र रखे था",
 "deductions:contradictions.c_julian_drawing_room.insight": "जूलियन ने झूठ बोला: सवा बारह बजे वह चुपके से शीशाघर गया था। वह कहता है कि दरवाज़ा बंद था, लैंप की लौ धीमी थी, और उसकी चाची ने कोई जवाब नहीं दिया।",
 "deductions:contradictions.c_julian_drawing_room.response.0": "…उफ़, भगवान के लिए। हाँ। ठीक है।",
 "deductions:contradictions.c_julian_drawing_room.response.1": "सवा बारह बजे मैं ज़रा हवा खाने निकला, और पैर अपने आप लॉन के नीचे की ओर ले गए। किटो के क़लम निकालने से पहले मैं उन्हें एक बार और मनाकर देखना चाहता था। दरवाज़ा बंद था और लैंप की लौ एकदम धीमी कर दी गई थी। मैंने दरवाज़ा खटखटाया, उन्हें पुकारा, पर उन्होंने कोई जवाब नहीं दिया।",
