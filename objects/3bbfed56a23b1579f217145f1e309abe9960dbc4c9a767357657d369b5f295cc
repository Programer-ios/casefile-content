 "deductions:deductions.d_way_out.conclusion": "शीशे का दरवाज़ा भीतर से बंद था, चाबी ताले में थी। बाहर निकलने का इकलौता दूसरा रास्ता बॉयलर-घर से होकर है, और उसके दरवाज़े की चिटकनी सिर्फ़ भीतर से खुलती है। घंटी के बाद कोई उन सीढ़ियों से नीचे उतरा, बाहरी दरवाज़े की चिटकनी खोली और अँधेरे में चुपके से निकल गया।",
 "deductions:deductions.d_way_out.options.0": "शीशे के दरवाज़े से, दूसरी चाबी से उसे पीछे से बंद करके",
 "deductions:deductions.d_way_out.options.1": "नीचे बॉयलर-घर से होकर, उसके बाहरी दरवाज़े से बाहर",
 "deductions:deductions.d_way_out.options.2": "पौ फटने पर जोरी के आने तक बॉयलर-घर में छिपे रहकर",
 "deductions:deductions.d_way_out.options.3": "ऊपर, छत के एक रोशनदान से होकर",
 "deductions:deductions.d_way_out.proofLabels.0": "बाहर का इकलौता दूसरा रास्ता",
 "deductions:deductions.d_way_out.proofLabels.1": "उस रात किसी ने उसे इस्तेमाल किया",
 "deductions:deductions.d_way_out.question": "भीतर से बंद शीशाघर से घंटी बजाने वाला बाहर कैसे निकला?",
 "deductions:deductions.d_way_out.title": "बॉयलर-घर के रास्ते बाहर",
 "dialogues:statements.st_agnes_celia.text": "मिसेज़ सीलिया घंटी के वक़्त नहीं थीं। पौने बारह बजे वे अपना हल्का नीला ड्रेसिंग गाउन पहने नीचे आईं और बोलीं कि घंटी से उनकी नींद खुल गई थी।",
 "dialogues:statements.st_agnes_cocoa.text": "सवा दस बजे मैं उनके लिए कोको ले गई। वे भली-चंगी थीं, और हर पंद्रह मिनट पर अपना रोज़नामचा लिख रही थीं।",
 "dialogues:statements.st_agnes_ink.text": "1943 से वे सब कुछ हरी स्याही में लिखती थीं — चिट्ठियाँ, पर्चियाँ, चेक। कभी किसी और रंग में नहीं।",
 "dialogues:statements.st_agnes_lawn.text": "सवा बारह बजे मैंने अपनी खिड़की से मिस्टर जूलियन को लॉन पर नीचे शीशाघर की ओर जाते देखा।",
 "dialogues:statements.st_agnes_stick.text": "लेडी साहिबा अपनी छड़ी के बिना एक क़दम नहीं चल सकती थीं, और दस साल से किसी सीढ़ी पर नहीं चढ़ी थीं।",
 "dialogues:statements.st_celia_bed.text": "साढ़े दस बजे से मैं बिस्तर में थी। घंटी से मेरी नींद खुली, और मैंने अपनी खिड़की से हेस्टर को देखा।",
 "dialogues:statements.st_celia_didnt_know.text": "मैं किसी जालसाज़ी के बारे में कुछ भी नहीं जानती, न किसी रेहन के बारे में।",
 "dialogues:statements.st_celia_knew.text": "छह बजे हेस्टर ने मुझे बताया कि जूलियन ने उनके जाली दस्तख़त किए हैं, और सुबह सबूत मिस्टर किटो के पास जाएगा।",
 "dialogues:statements.st_celia_plead.text": "ग्यारह बजने में बीस मिनट पर मैं वसीयत को लेकर हेस्टर की मिन्नत करने शीशाघर गई। ग्यारह बजने में दस मिनट पर जब मैं निकली, तब वे ज़िंदा थीं, अपना रोज़नामचा लिख रही थीं।",
 "dialogues:statements.st_celia_rose_walk.text": "मुझे नींद नहीं आ रही थी, सो घंटी सुनाई देने तक मैं गुलाब-पथ पर टहलती रही, फिर अंदर आ गई। मैं शीशाघर के पास भी नहीं गई।",
 "dialogues:statements.st_jory_bed.text": "नौ बजे मैंने बॉयलर की आग दबा दी और दस बजे तक अपने बिस्तर में था।",
 "dialogues:statements.st_jory_dawn.text": "पौने छह बजे चंद्र-ऑर्किड अब भी खुला था, और किसी ने उसका परागण नहीं किया था। मैंने ख़ुद किया, मालकिन के ब्रश से।",
 "dialogues:statements.st_jory_figure.text": "लैंप नीचे होने के कुछ मिनट बाद मैंने हल्के रंग की एक आकृति को, कुछ लंबा-सा पहने, बॉयलर-घर से ऊपर निकलते और दीवार के साथ-साथ तेज़ी से घर की ओर जाते देखा।",
 "dialogues:statements.st_jory_ladder.text": "मालकिन उस सीढ़ी पर कभी ना चढ़ीं। वो दरवाज़े के पास अपनी खूँटी पर टँगी रहती है, और व्हिटसन के त्योहार के बाद से उतारी ही ना गई थी।",
 "dialogues:statements.st_jory_stokehole.text": "नौ बजे मैंने बॉयलर-घर के दरवाज़े पर चिटकनी लगाई थी। पौ फटने पर चिटकनी खुली थी, और किसी ने मेरे बॉयलर में कुछ जलाया था।",
 "dialogues:statements.st_julian_debts.text": "Penhallow Motors मुसीबत में है, पर मैंने उसे ईमानदारी से डूबने नहीं दिया। मैंने कभी कुछ आपराधिक नहीं किया।",
 "dialogues:statements.st_julian_drawing_room.text": "घंटी के बाद, एक बजे हम सबके ऊपर जाने तक, मैंने बैठक एक बार भी नहीं छोड़ी।",
 "dialogues:statements.st_julian_forgery.text": "मैंने होम फ़ार्म के £20,000 के रेहन पर हेस्टर चाची के जाली दस्तख़त किए।",
 "dialogues:statements.st_julian_glasshouse.text": "सवा बारह बजे मैं नीचे शीशाघर गया। दरवाज़ा बंद था, लैंप की लौ धीमी थी, और उन्होंने कोई जवाब नहीं दिया।",
 "dialogues:statements.st_julian_library.text": "सवा दस से सवा ग्यारह बजे तक मैं पुस्तकालय में किटो से बहस कर रहा था।",
 "dialogues:statements.st_julian_money.text": "मेरा हिसाब-किताब बिल्कुल दुरुस्त है। मुझे हेस्टर चाची के पैसों की ज़रूरत नहीं थी।",
 "dialogues:statements.st_julian_will.text": "आज सुबह हेस्टर चाची एक नई वसीयत पर दस्तख़त करने वाली थीं, जिसमें मुझे पेनहैलो से बेदख़ल कर दिया गया था।",
 "dialogues:statements.st_kittow_engaged.text": "हेस्टर और मेरा विवाह सितंबर में होना था। उन्होंने मुझे बताया था कि शुक्रवार को छह बजे वे सीलिया को जूलियन के अपराध के बारे में बता देंगी, ताकि शनिवार से पहले वह क़बूल कर सके।",
 "dialogues:statements.st_kittow_library.text": "सवा दस से सवा ग्यारह बजे तक मैं पुस्तकालय में जूलियन के साथ था।",
 "dialogues:statements.st_kittow_professional.text": "लेडी पेनहैलो से मेरे संबंध पूरी तरह पेशेवर थे।",
 "dialogues:statements.st_kittow_will.text": "नई वसीयत के तहत जूलियन को £1,000 मिलते। पुरानी वसीयत के तहत, जो अब लागू है, पेनहैलो उसे मिलता है।",
 "dialogues:statements.st_marian_darkroom.text": "दस बजे से ग्यारह बजकर दस मिनट तक मैं अपने डार्करूम में थी। फिर मैंने चबूतरे पर अपना कैमरा लगाया।",
 "dialogues:statements.st_marian_kew.text": "मैं Kew की ओर से यहाँ आई हूँ, फूल के खिलने को दर्ज करने।",
 "dialogues:statements.st_marian_lindqvist.text": "पिछले साल Kew ने मुझे निकाल दिया। मुझे मियामी की Lindqvist Orchids से पैसे मिलते हैं, जिन्हें बीज चाहिए।",
 "dialogues:statements.st_marian_photo.text": "घंटी बजते ही मैंने चबूतरे से एक तस्वीर खींची। उसका प्रिंट मेरे डार्करूम में सूख रहा है।",
 "dialogues:statements.st_marian_pollinate.text": "चंद्र-ऑर्किड अपनी पहली महक के लगभग चालीस मिनट बाद खुलता है। खुलते ही हेस्टर उसका परागण कर देतीं — वह मौक़ा चूकने से तो वे मर जाना बेहतर समझतीं।",
 "dialogues:statements.st_marian_scent.text": "11:45 पर जब सीलिया बैठक में आईं, तो उनसे चंद्र-ऑर्किड की तेज़ महक आ रही थी, जैसे वे उस पर झुकी खड़ी रही हों।",
 "dialogues:topics.t_agnes_evening.lines.0": "सवा दस बजे मैं उनके लिए कोको का फ़्लास्क ले गई। उन्होंने कहा था कि कोई पास न फटके, पर रात के खाने पर उन्होंने कुछ खाया ही नहीं था। उन्होंने मुझे डाँटा, फिर अंदर आने दिया, और मेरे खड़े-खड़े एक प्याला पी गईं। वे हर पंद्रह मिनट पर अपना रोज़नामचा लिख रही थीं — किसी लड़की की तरह ख़ुश। फिर मेरे पीछे उन्होंने दरवाज़ा बंद कर लिया।",
 "dialogues:topics.t_agnes_evening.lines.1": "घंटी बजी, तब मैं बाकी लोगों के साथ चबूतरे पर थी। आधी रात को मैं सोने ऊपर चली गई, और सवा बारह बजे मैंने अपनी खिड़की से झाँका तो चाँदनी में मिस्टर जूलियन को लॉन पर नीचे शीशाघर की ओर जाते देखा। मैंने सार्जेंट को यह बता दिया। अब मुझे इसका अफ़सोस है।",
 "dialogues:topics.t_agnes_evening.prompt": "कल रात के बारे में बताइए।",
 "dialogues:topics.t_agnes_hester.lines.0": "उनका कूल्हा बहुत ख़राब था। अपनी छड़ी के बिना वे एक क़दम नहीं चल पाती थीं, अपने सोने के कमरे में भी नहीं — और दस साल से किसी सीढ़ी पर नहीं चढ़ी थीं। उसके लिए तो जोरी था।",
 "dialogues:topics.t_agnes_hester.lines.1": "और वे हरी स्याही में लिखती थीं। ’43 में तार आने के बाद से सिर्फ़ हरी — वह एडमंड का रंग था। उनकी चिट्ठियाँ, उनकी पर्चियाँ, उनके चेक। हरी।",
 "dialogues:topics.t_agnes_hester.prompt": "लेडी पेनहैलो की आदतें कैसी थीं?",
 "dialogues:topics.t_agnes_rooms.lines.0": "उनके निजी कक्ष पर ताला है। उसकी इकलौती फ़ालतू चाबी वे मेरे पास रखती थीं। अब तो शायद इससे कोई फ़र्क़ नहीं पड़ता।",
 "dialogues:topics.t_agnes_rooms.lines.1": "वह अपनी जेब से एक छोटी-सी चाबी निकालती है और आपको देने से पहले एक पल उसे थामे रहती है। लेडी पेनहैलो का निजी कक्ष अब आपके लिए खुला है।",
 "dialogues:topics.t_agnes_rooms.prompt": "क्या मुझे लेडी पेनहैलो के कमरे देखने की इजाज़त मिलेगी?",
 "dialogues:topics.t_agnes_terrace.lines.0": "मिस्टर जूलियन, मिस्टर किटो, कैमरे के साथ डॉ. एलरी, और मैं। हमने उन्हें लैंप उठाते और हाथ हिलाकर हमें लौट जाने का इशारा करते देखा, और हम अंदर चले गए।",
 "dialogues:topics.t_agnes_terrace.lines.1": "मिसेज़ सीलिया सिरदर्द की वजह से साढ़े दस बजे ऊपर चली गई थीं। पौने बारह बजे वे अपना हल्का नीला ड्रेसिंग गाउन पहने बैठक में आईं, आँखें फैलाए, और बोलीं कि घंटी से उनकी नींद खुल गई थी और उन्होंने अपनी खिड़की से सब देखा।",
 "dialogues:topics.t_agnes_terrace.prompt": "घंटी बजी, तब चबूतरे पर कौन-कौन था?",
 "dialogues:topics.t_agnes_will.lines.0": "पुरानी वसीयत में दो हज़ार पाउंड। नई में, उम्र भर के लिए लॉज और साल के तीन सौ। जून में उन्होंने मुझे यह बताया था, और मैं बच्चे की तरह रो पड़ी थी।",
 "dialogues:topics.t_agnes_will.lines.1": "तो अगर आपके मन में यह सवाल है, तो सुन लीजिए — आज सुबह दस बजे तक उन्हें ज़िंदा देखने की मेरे पास दुनिया भर की वजहें थीं।",
 "dialogues:topics.t_agnes_will.prompt": "क्या लेडी पेनहैलो ने आपके लिए कुछ इंतज़ाम किया था?",
 "dialogues:topics.t_celia_evening.lines.0": "ऊपर, बिस्तर में। मेरे सिर में भयानक दर्द था — साढ़े दस बजे मैंने सबको शुभरात्रि कही और सीधे ऊपर चली गई।",
 "dialogues:topics.t_celia_evening.lines.1": "घंटी से मेरी नींद खुली। मैं खिड़की पर गई, और वे वहाँ थीं — नीचे शीशाघर में, अपना लैंप लिए, उस बड़े-से सफ़ेद फूल के पास। बिल्कुल शेक्सपियर के किसी दृश्य जैसी। फिर मुझे नींद नहीं आई, सो मैं ड्रेसिंग गाउन पहनकर बाकी लोगों के पास नीचे आ गई।",
 "dialogues:topics.t_celia_evening.prompt": "कल रात आप कहाँ थीं?",
 "dialogues:topics.t_celia_forgery.lines.0": "जालसाज़ी? जूलियन? क्या बेतुकी बात है। जूलियन तो बीमारी का एक झूठा पर्चा तक नहीं गढ़ सकता।",
 "dialogues:topics.t_celia_forgery.lines.1": "किसी रेहन के बारे में मैं कुछ भी नहीं जानती। जूलियन कारोबार की बातें अपने तक रखता है। उसी से पूछिए।",
 "dialogues:topics.t_celia_forgery.prompt": "क्या आपको पता था कि आपके पति ने अपनी चाची के जाली दस्तख़त किए?",
 "dialogues:topics.t_celia_hester.lines.0": "उन्हें लगता था कि जूलियन ने अपने से नीचे शादी की है। एक अभिनेत्री! उन्होंने कभी कहा नहीं। कहने की ज़रूरत ही नहीं थी।",
 "dialogues:topics.t_celia_hester.lines.1": "पर वे मेहरबान भी हो सकती थीं। एक बार, मई में, उन्होंने मुझे अपना ऑर्किड दिखाया, और उससे ऐसे बातें कीं मानो एडमंड वहीं खड़े हों। सच कहूँ, तो मुझे उनसे थोड़ी जलन हुई। सोचिए, किसी को इतना चाहना।",
 "dialogues:topics.t_celia_hester.prompt": "लेडी पेनहैलो से आपकी कैसी बनती थी?",
 "dialogues:topics.t_celia_stage.lines.0": "ग्यारह बरस रेपर्टरी में। ब्रिस्टल, बाथ, एक सीज़न स्ट्रैटफ़र्ड में। अपने मुँह से कहूँ, तो मैं काफ़ी अच्छी लेडी मैकबेथ थी।",
 "dialogues:topics.t_celia_stage.lines.1": "नींद में चलने वाला दृश्य। हर रात पूरा हॉल साँस रोक लेता था। फिर मैंने जूलियन से शादी कर ली, और Penhallow Motors से भी, और बस, कहानी ख़त्म।",
 "dialogues:topics.t_celia_stage.prompt": "सुना है, आप मंच पर काम कर चुकी हैं।",
 "dialogues:topics.t_jory_dawn.lines.0": "पौने छह बजे मैं आग झोंकने आया, रोज़ सुबह की तरह, बॉयलर-घर के रास्ते। बाहर वाले दरवाज़े की चिटकनी खुली थी — उस पर भी आता हूँ। मैं सीढ़ियाँ चढ़कर ऊपर गया, और वहाँ मालकिन बेंच के पास पड़ी थीं, बग़ल में सीढ़ी पड़ी थी। ठंडी।",
 "dialogues:topics.t_jory_dawn.lines.1": "और फूल अब भी खुला था, बस किसी तरह। थाली जैसा सफ़ेद। किसी ने उसे छुआ ना था — उनका ब्रश रजिस्टर के पास पड़ा था, साफ़, पराग अब भी फूल में ही धरा था। पच्चीस बरस उन्होंने उस रात की राह देखी थी।",
 "dialogues:topics.t_jory_dawn.lines.2": "सो मैंने उनकी ख़ातिर कर दिया। उन्हीं के ब्रश से, जैसा उन्होंने मुझे सिखाया था, और सुतली का एक टुकड़ा बाँध दिया। पाँच मिनट भी ना बीते कि फूल बंद हो गया। फिर मैं घर की ओर भागा।",
 "dialogues:topics.t_jory_dawn.prompt": "बताइए, वे आपको किस हाल में मिलीं।",
 "dialogues:topics.t_jory_evening.lines.0": "नौ बजे बॉयलर की आग दबाई और घर चला गया। दस बजे तक अपने बिस्तर में, हमेशा की तरह। मालकिन ना चाहती थीं कि कोई भी शीशे के पास फटके, और मैं तो जो कहा जाए, सो करता हूँ।",
 "dialogues:topics.t_jory_evening.prompt": "कल रात आप कहाँ थे?",
 "dialogues:topics.t_jory_julian.lines.0": "हॉलिडे कैंप। सर एडमंड के लॉन पर छोटे-छोटे कॉटेज और मेरे सब्ज़ी-बाग़ में नहाने का तालाब। यही चाहिए उन्हें।",
 "dialogues:topics.t_jory_julian.lines.1": "पर उनके हक़ में इतना कहूँगा: ख़ून देखने का उनमें मुर्ग़ी जितना भी जिगरा ना है। बारह बरस के थे, तो सूअर कटते देख बेहोश हो गए थे।",
 "dialogues:topics.t_jory_julian.prompt": "मिस्टर जूलियन के बारे में आपकी क्या राय है?",
 "dialogues:topics.t_jory_ladder.lines.0": "मालकिन? दस बरस से तो ना। उस कूल्हे के साथ चढ़ ही ना सकती थीं। कुछ भी ऊँचे का काम हो, मुझे बुला लेती थीं।",
 "dialogues:topics.t_jory_ladder.lines.1": "और ऊपर चढ़ने लायक़ वहाँ कुछ था भी ना। लैंप ब्रैकेट पर टँगा रहता है, जहाँ मैंने टाँगा। वो सीढ़ी दरवाज़े के पास अपनी खूँटी पर ही रहती है। आख़िरी बार व्हिटसन के त्योहार पर उतरी थी।",
 "dialogues:topics.t_jory_ladder.prompt": "क्या वे सीढ़ी पर चढ़ सकती थीं?",
 "dialogues:topics.t_jory_stokehole.lines.0": "उस दरवाज़े पर मैं ज़िंदगी भर हर रात नौ बजे चिटकनी लगाता आया हूँ। देखिए, उसमें चिटकनी बस भीतर की तरफ़ है — बग़ीचे की ओर से ना खोला जा सके, ना बंद किया जा सके। आज सुबह उसकी चिटकनी खुली पड़ी थी।",
 "dialogues:topics.t_jory_stokehole.lines.1": "और किसी ने मेरे बॉयलर से छेड़छाड़ की थी। आग का दरवाज़ा खुला, और आग भट्ठी की तरह धधक रही थी, जबकि मैं उसे दबाकर गया था। किसी ने उसमें कुछ जलाया था।",
 "dialogues:topics.t_jory_stokehole.prompt": "और बॉयलर-घर का दरवाज़ा?",
 "dialogues:topics.t_julian_aunt.lines.0": "बीस बरस काले कपड़ों में, एक ऐसे आदमी के लिए जो किसी जंगल में मर गया। वे उसके पौधों से बातें करती थीं। मैं बेरहमी नहीं कर रहा — सचमुच करती थीं। ज़ोर-ज़ोर से, हर सुबह।",
 "dialogues:topics.t_julian_aunt.lines.1": "होशियार थीं, यह मानना पड़ेगा। किटो कहता है, एडमंड चाचा से भी ज़्यादा — और किटो को पता होना चाहिए। बस उन्होंने यह कभी किसी पर ज़ाहिर नहीं होने दिया।",
 "dialogues:topics.t_julian_aunt.prompt": "आपकी चाची कैसी थीं?",
 "dialogues:topics.t_julian_celia.lines.0": "सीलिया? हे भगवान, नहीं। उससे पहले मैं मर जाता। वह समझती है कि कारोबार शानदार चल रहा है — साल भर से हर हफ़्ते मैं उसे यही बताता आया हूँ।",
 "dialogues:topics.t_julian_celia.lines.1": "कल रात वह अपने एक सिरदर्द के चलते जल्दी ऊपर चली गई। पूरी गर्मियों उसे ठीक से नींद नहीं आई। उसमें भी शायद मेरा ही दोष है।",
 "dialogues:topics.t_julian_celia.prompt": "क्या आपकी पत्नी को रेहन के बारे में पता था?",
 "dialogues:topics.t_julian_evening.lines.0": "रात के खाने के बाद आप कहाँ थे, मिस्टर पेनहैलो?",
 "dialogues:topics.t_julian_evening.lines.1": "सवा दस बजे से पुस्तकालय में किटो के साथ, उसे उस वसीयत के बारे में समझाने की कोशिश में। माफ़ कीजिए, आवाज़ें कुछ ऊँची हो गई थीं। फिर हम सब क़तार बाँधकर चबूतरे पर निकल आए, हेस्टर चाची की घंटी का इंतज़ार करने।",
 "dialogues:topics.t_julian_evening.lines.2": "घंटी बजी, तो हमने उन्हें साफ़-साफ़ देखा, लैंप ऊपर उठाए हुए। फिर हम अंदर लौट आए और एक बजे तक बैठे शैंपेन पीते रहे, उनके दोबारा घंटी बजाने की राह देखते। बाकी सबके ऊपर जाने तक मैंने बैठक एक बार भी नहीं छोड़ी।",
 "dialogues:topics.t_julian_evening.prompt": "कल रात आप कहाँ थे?",
 "dialogues:topics.t_julian_glasshouse.lines.0": "दरवाज़ा बंद था। भीतर लैंप की लौ घटाकर बस एक टिमटिमाहट भर कर दी गई थी; उस फूल की सफ़ेदी मुझे बस धुँधली-सी दिख रही थी। मैंने दो बार खटखटाया और उनका नाम पुकारा। कुछ नहीं।",
 "dialogues:topics.t_julian_glasshouse.lines.1": "मुझे लगा, वे रूठी बैठी हैं, या कुर्सी पर ऊँघ गई हैं। मैं पीछे की तरफ़ नहीं गया — मुझे पता ही नहीं था कि पीछे भी कोई रास्ता है। मैं लौट आया।",
 "dialogues:topics.t_julian_glasshouse.lines.2": "पर वह महक! उनका वह ऑर्किड। शीशे के पार से भी दीवार की तरह आ टकराती थी।",
 "dialogues:topics.t_julian_glasshouse.prompt": "मुझे ठीक-ठीक बताइए कि शीशाघर पर आपको क्या मिला।",
 "dialogues:topics.t_julian_money.lines.0": "Penhallow Motors? शानदार। अब तक का सबसे अच्छा साल। हर किसी को Zephyr चाहिए।",
 "dialogues:topics.t_julian_money.lines.1": "अगर आपका सवाल यह है कि मुझे हेस्टर चाची के पैसों की ज़रूरत थी, तो जवाब है — नहीं। मेरा हिसाब-किताब बिल्कुल दुरुस्त है।",
 "dialogues:topics.t_julian_money.prompt": "आपका कारोबार कैसा चल रहा है?",
 "dialogues:topics.t_julian_quarrel.lines.0": "सूप के दौरान उन्होंने ऐलान किया कि आज सुबह दस बजे वे एक नई वसीयत पर दस्तख़त करेंगी। पेनहैलो National Trust को — घर, ज़मीन और शीशाघर, सब कुछ। एडमंड चाचा ने यह जगह मुझे तब देने का वादा किया था, जब मैं नौ बरस का था।",
 "dialogues:topics.t_julian_quarrel.lines.1": "इसके लिए मेरे पास Sunnyside Holiday Camps का एक बढ़िया प्रस्ताव है। लॉन पर कॉटेज, सब्ज़ी-बाग़ की जगह स्विमिंग पूल। लोगों को छुट्टियाँ चाहिए। उन्होंने मुझे ऐसे देखा, मानो मैंने एडमंड की हड्डियाँ बेचने की बात कह दी हो।",
 "dialogues:topics.t_julian_quarrel.lines.2": "तो हाँ, हमारी कहा-सुनी हुई। मैंने कहा कि उन्हें पछताना पड़ेगा। यह धमकी नहीं है। लोग कह देते हैं ऐसी बातें।",
 "dialogues:topics.t_julian_quarrel.prompt": "खाने पर झगड़ा किस बात पर हुआ था?",
 "dialogues:topics.t_kittow_evening.lines.0": "सवा दस से सवा ग्यारह बजे तक पुस्तकालय में जूलियन के साथ, उसकी चीख़-पुकार सुनते हुए। वह चाहता था कि मैं हेस्टर को दस्तख़त न करने के लिए राज़ी करूँ। मैंने उससे कहा कि वकील का फ़र्ज़ अपने मुवक्किल की इच्छा के प्रति होता है, उसके वारिस की इच्छा के प्रति नहीं।",
 "dialogues:topics.t_kittow_evening.lines.1": "ग्यारह बजने में बीस मिनट पर मिसेज़ पास्को हमारे लिए व्हिस्की लाईं, और मेरा ख़याल है कि उन्होंने एक-एक शब्द सुना होगा। फिर हम घंटी के लिए चबूतरे पर गए, और उसके बाद एक बजे तक बैठक में रहे।",
 "dialogues:topics.t_kittow_evening.prompt": "कल रात आप कहाँ थे?",
 "dialogues:topics.t_kittow_hester.lines.0": "चालीस बरस से मैं इस परिवार का वकील हूँ। 1941 में सर एडमंड के जहाज़ से रवाना होने से पहले मैंने उनकी वसीयत तैयार की थी, और तार आने के बाद हेस्टर की।",
 "dialogues:topics.t_kittow_hester.lines.1": "यक़ीन मानिए, लेडी पेनहैलो से मेरे संबंध पूरी तरह पेशेवर थे।",
 "dialogues:topics.t_kittow_hester.prompt": "आप लेडी पेनहैलो को कितनी अच्छी तरह जानते थे?",
 "dialogues:topics.t_kittow_hester_heart.lines.0": "इन गर्मियों में वे जितना हँसीं, उतना उससे पहले के पूरे बीस बरसों में नहीं हँसी थीं। उन्होंने तय कर लिया था कि अब उन्हें इसकी इजाज़त है।",
 "dialogues:topics.t_kittow_hester_heart.lines.1": "वे कहती थीं कि ऑर्किड एडमंड का है, और कल रात के बाद वे उन्हें चैन से सोने दे सकेंगी। फिर वे सलेटी पहनेंगी। शुरुआत में बस सलेटी।",
 "dialogues:topics.t_kittow_hester_heart.prompt": "एडविन, असल में वे कैसी थीं?",
 "dialogues:topics.t_kittow_will.lines.0": "इस पर आज सुबह दस बजे मिसेज़ पास्को और पादरी साहब के सामने दस्तख़त होने थे। गवाह कभी ऐसा नहीं होता जिसे कुछ मिलना हो — मुझे एडमंड की घड़ी मिलनी है, इसलिए मैं ख़ुद गवाही नहीं दे सकता था। यह वसीयत पेनहैलो और उसके बग़ीचे National Trust को देती है, रख-रखाव के लिए एक कोष के साथ। जूलियन को एक हज़ार पाउंड और उसके चाचा की किताबें मिलती हैं।",
 "dialogues:topics.t_kittow_will.lines.1": "पुरानी वसीयत के तहत — 1950 की वसीयत, जो अब लागू है — सब कुछ उसे मिलता है। मसौदा आपको पुस्तकालय में मेरे ब्रीफ़केस में मिल जाएगा। पुलिस से मेरा कोई राज़ नहीं, न आपसे।",
 "dialogues:topics.t_kittow_will.prompt": "नई वसीयत के बारे में बताइए।",
 "dialogues:topics.t_marian_bell.lines.0": "हेस्टर, फूल के पास लैंप ऊँचा उठाए। उन्होंने हमारी ओर हाथ उठाया — मुझे लगा, उनके हिसाब से कुछ ज़्यादा ही शान से। फिर वे मुड़ गईं और लैंप नीचे हो गया।",
 "dialogues:topics.t_marian_bell.lines.1": "घंटी बजते ही मैंने एक एक्सपोज़र लिया। पूरे एपर्चर पर आधा सेकंड, चालीस गज़ दूर से, भाप जमे शीशे के पार — इसलिए ज़्यादा उम्मीद मत रखिएगा। आज सुबह सबसे पहले मैंने उसे डेवलप किया। प्रिंट मेरे डार्करूम में डोरी पर टँगा है।",
 "dialogues:topics.t_marian_bell.prompt": "घंटी बजी, तो आपने क्या देखा?",
 "dialogues:topics.t_marian_evening.lines.0": "नौ बजकर पच्चीस मिनट पर मैंने कली के साथ हेस्टर की तस्वीर खींची, उनके ख़ुद को भीतर बंद करने से पहले। फिर दस बजे से लगभग ग्यारह बजकर दस मिनट तक मैं अपने डार्करूम में उसे डेवलप कर रही थी — बीच में एक बार बेचारी मिसेज़ पास्को दरवाज़ा खटखटाने आईं, और मैं उन पर चिल्ला पड़ी।",
 "dialogues:topics.t_marian_evening.lines.1": "उसके बाद मैंने घंटी के इंतज़ार में चबूतरे पर अपनी तिपाई जमा दी। घंटी मेरी उम्मीद से देर से बजी। मैं क़सम खाकर कह सकती थी कि वह फूल ग्यारह बजे तक खुल चुका होगा।",
 "dialogues:topics.t_marian_evening.prompt": "कल रात आप कहाँ थीं?",
 "dialogues:topics.t_marian_kew.lines.0": "जी हाँ। हर्बेरियम को फूल का पूरा रिकॉर्ड चाहिए — तस्वीरें, नाप-जोख, समय। हेस्टर और मैं पाँच साल से इस पौधे के बारे में ख़त-ओ-किताबत करती आई हैं।",
 "dialogues:topics.t_marian_kew.lines.1": "नई वसीयत के तहत ऑर्किड Kew को जाने वाला था। इसीलिए मैं यहाँ हूँ।",
 "dialogues:topics.t_marian_kew.prompt": "आप Kew की ओर से यहाँ आई हैं?",
 "dialogues:topics.t_marian_lindqvist.lines.0": "बीज। उस फूल की एक फली में दस लाख बीज होते हैं, और फ़्लोरिडा में हर नन्हा पौधा सौ डॉलर में बिकता। लिंडक्विस्ट चंद्र-ऑर्किड का मालिक बनना चाहता था, जैसे कोई रेस के घोड़े का मालिक होता है।",
 "dialogues:topics.t_marian_lindqvist.lines.1": "मैं हेस्टर से कहने वाली थी कि बीजों का एक हिस्सा उसे बेच दें। क़ानूनी तौर पर, और ईमानदारी से। ज़ाहिर है, वे मना कर देतीं। वे तो सब कुछ पहले ही Kew के नाम कर चुकी थीं।",
 "dialogues:topics.t_marian_lindqvist.prompt": "लिंडक्विस्ट असल में क्या चाहता था?",
 "dialogues:topics.t_marian_orchid.lines.0": "एडमंड पेनहैलो ने इसे 1938 में शान की पहाड़ियों से इकट्ठा किया था। जिस घाटी से यह आया था, वह जंग में जलकर राख हो गई। जहाँ तक किसी को पता है, हेस्टर का पौधा ही इसकी नस्ल का आख़िरी ज़िंदा पौधा है। इंग्लैंड में यह एक बार भी नहीं खिला था।",
 "dialogues:topics.t_marian_orchid.lines.1": "यह सिर्फ़ एक बार खुलता है, अँधेरा होने के बाद। पहली महक से फूल पूरा खुलने तक लगभग चालीस मिनट लगते हैं, और सूरज निकलते ही यह हमेशा के लिए बंद हो जाता है। इसके परागण का मौक़ा बस तभी है जब यह खुला हो — और खुलने का पल ही सबसे अच्छा मौक़ा है।",
 "dialogues:topics.t_marian_orchid.lines.2": "हेस्टर ने कल रात के लिए पच्चीस बरस इंतज़ार किया था। खुलते ही वे उसका परागण कर देतीं। वह मौक़ा चूकने से तो वे मर जाना बेहतर समझतीं।",
 "dialogues:topics.t_marian_orchid.prompt": "चंद्र-ऑर्किड के बारे में बताइए।",
 "dialogues:topics.t_marian_scent.lines.0": "अब जब आपने पूछा है… हाँ। जब वे बैठक में आईं, तो ऑर्किड की महक अपने साथ लाईं। लौंग और लिली — मैं इसे कहीं भी पहचान लूँ। तेज़, जैसे वे फूल पर झुकी खड़ी रही हों।",
 "dialogues:topics.t_marian_scent.lines.1": "मैंने सोचा, खिड़कियों से उड़कर ऊपर आ गई होगी। पर तब तक बैठक की खिड़कियाँ बंद हो चुकी थीं, और शीशाघर चालीस गज़ दूर है। वह महक हर उस चीज़ से लिपट जाती है जो उसके पास रही हो। वह दूर तक नहीं जाती।",
 "dialogues:topics.t_marian_scent.prompt": "जब सीलिया 11:45 पर नीचे आईं, तो क्या आपने कुछ ग़ौर किया?",
 "evidence:evidence.bank_demand.detail": "जूलियन की डिनर जैकेट की भीतरी जेब में मुड़ी-तुड़ी: Westminster Bank, प्लिमथ की एक चिट्ठी, तारीख़ 22 जुलाई 1963।\n\n‘प्रिय मिस्टर पेनहैलो — हमें एक बार फिर Penhallow Motors के ओवरड्रॉ खाते की ओर आपका ध्यान दिलाना पड़ रहा है, जिस पर अब £6,412 7 शि. 2 पें. बकाया है। अगर 31 जुलाई तक यह चुकता नहीं हुआ, तो हमारे पास क़ानूनी कार्रवाई शुरू करने के सिवा कोई चारा नहीं रहेगा…’\n\nइसे कई बार तह किया और खोला गया है।",
 "evidence:evidence.bank_demand.name": "Westminster Bank की चिट्ठी",
 "evidence:evidence.bank_demand.summary": "Penhallow Motors के नाम आख़िरी तक़ाज़ा, ‘क़ानूनी कार्रवाई’ की धमकी के साथ।",
 "evidence:evidence.bloom_log.detail": "फूल के खिलने का हेस्टर का रोज़नामचा, हरी स्याही में, छोटी, सीधी लिखावट में:\n\n‘9:30 — भीतर से ताला लगा लिया। लैंप जला दिया। कली फूल रही है।\n9:45 — कली की नोक पर रंग आने लगा।\n10:00 — एडमंड का पहर। कली ढीली पड़ रही है।\n10:15 — मना करने के बावजूद एग्नेस कोको ले आई। भगवान उसका भला करे।\n10:25 — बाह्यदल खुल रहे हैं। पहली महक: लौंग और लिली। चालीस मिनट, एडमंड हमेशा कहते थे। जैसे ही खुलेगा, मैं परागण करूँगी।’\n\n10:25 के बाद पन्ना कोरा है। उसका पेन ढक्कन लगाकर रोज़नामचे के पास रखा है। उसके बग़ल में सेबल के बालों वाला परागण का ब्रश पड़ा है।",
 "evidence:evidence.bloom_log.name": "खिलने का रोज़नामचा",
 "evidence:evidence.bloom_log.summary": "हर पंद्रह मिनट पर हरी स्याही — 10:25 तक, फिर कुछ नहीं।",
 "evidence:evidence.blue_room_window.detail": "नीला कमरा, जिसमें जूलियन और सीलिया सोते हैं, घर के उत्तरी हिस्से में है। इसकी इकलौती खिड़की बजरी वाले रास्ते और बीच-वृक्षों की क़तार की ओर खुलती है।\n\nशीशाघर दक्षिण में है, लॉन के निचले छोर पर, घर के दूसरी तरफ़। इस कमरे से उसकी छत का पवन-सूचक तक नहीं दिखता।",
 "evidence:evidence.blue_room_window.name": "नीले कमरे की खिड़की",
 "evidence:evidence.blue_room_window.summary": "सीलिया की खिड़की उत्तर की ओर, सामने के रास्ते पर खुलती है। शीशाघर घर के दूसरी तरफ़ है।",
 "evidence:evidence.celia_mules.detail": "अलमारी के पिछले हिस्से में, शाम की पोशाकों के पीछे ठूँसी हुई: हल्की नीली साटन की चप्पलों की एक जोड़ी और उसी रंग का ड्रेसिंग गाउन।\n\nचप्पलों के तले कोक की धूल से धूसर हैं; धूल साटन में रच-बस गई है। ड्रेसिंग गाउन का दामन चारों ओर से काला पुता है। किसी ने उसे झाड़ने की कोशिश की है, और धूल बस और फैल गई है।",
 "evidence:evidence.celia_mules.name": "सीलिया का ड्रेसिंग गाउन और चप्पलें",
 "evidence:evidence.celia_mules.summary": "हल्की नीली साटन — और तलों व दामन पर कोक की काली धूल।",
 "evidence:evidence.deed_fragment.detail": "भारी क़ानूनी काग़ज़ का एक झुलसा कोना, जो सलाख़ों के बीच से गिरकर राख-ट्रे में जा पड़ा था:\n\n‘…होम फ़ार्म, पेनहैलो नामक संपत्ति का रेहन… बीस हज़ार पाउंड की रक़म… Lorimer & Dane… उक्त हेस्टर पेनहैलो द्वारा हस्ताक्षरित…’\n\nकिनारे पर, झुलसकर भूरा पड़ा, दस्तख़त बचा है: ‘हेस्टर पेनहैलो’, काली स्याही में।",
 "evidence:evidence.deed_fragment.name": "झुलसा दस्तावेज़",
 "evidence:evidence.deed_fragment.summary": "बॉयलर की राख-ट्रे से: ‘…होम फ़ार्म… £20,000… हेस्टर पेनहैलो’ — काली स्याही में दस्तख़त।",
 "evidence:evidence.ebony_stick.detail": "उसकी आबनूस की छड़ी, जो ऑर्किड की बेंच के नीचे मिली। इसकी मूठ ठोस चाँदी की है, गोल, लगभग हाफ़-क्राउन के सिक्के के बराबर, और उस पर चारों ओर पत्तियों की नक़्क़ाशी है।\n\nमूठ को पोंछा गया है। पर नक़्क़ाशी की गहराई में सूखे ख़ून का एक गहरा धब्बा है, और उसमें दो सफ़ेद बाल फँसे हैं।",
 "evidence:evidence.ebony_stick.name": "लेडी पेनहैलो की छड़ी",
 "evidence:evidence.ebony_stick.summary": "चाँदी की भारी मूठ, हाफ़-क्राउन के सिक्के के बराबर — नक़्क़ाशी में ख़ून।",
 "evidence:evidence.finance_letter.detail": "Lorimer & Dane, Finance, लंदन E.C.2. 19 जुलाई 1963।\n\n‘आदरणीया लेडी पेनहैलो — आपके रिकॉर्ड के लिए हम होम फ़ार्म के आपके रेहन के रेहननामे की दूसरी प्रति संलग्न कर रहे हैं, जो 2 मई को निष्पादित हुआ था और जिसके तहत £20,000 की रक़म आपके एजेंट के तौर पर आपके भतीजे, मिस्टर जूलियन पेनहैलो, को दी गई थी…’\n\nनीचे, आर-पार, हरी स्याही में:\n\n‘मैंने इस पर कभी दस्तख़त नहीं किए। जूलियन, और कौन। शुक्रवार को छह बजे सीलिया को बताऊँगी, और उसे रात भर की मोहलत दूँगी कि वह ख़ुद मेरे पास आए। शनिवार को यह एडविन के पास जाएगा, और एडविन से पुलिस के पास।’\n\nरेहननामे की दूसरी प्रति ख़ुद चिट्ठी के साथ नहीं है।",
 "evidence:evidence.finance_letter.name": "Lorimer & Dane की चिट्ठी",
 "evidence:evidence.finance_letter.summary": "होम फ़ार्म के ‘उसके’ £20,000 के रेहन के बारे में, और हरी स्याही में उसका नोट: ‘मैंने इस पर कभी दस्तख़त नहीं किए।’",
 "evidence:evidence.hester_letter.detail": "पेनहैलो हाउस, सेंट ऑस्टल। 23 जुलाई 1963।\n\n‘प्रिय महोदय अथवा महोदया — मुझे बताया गया है कि आपके यहाँ बात बाहर नहीं जाती। मुझे पता चला है कि मेरे परिवार के एक सदस्य ने कुछ आपराधिक किया है। शनिवार सुबह मैं उसका सबूत एक नई वसीयत के साथ अपने वकील के हाथों में सौंपना चाहती हूँ। तब तक घर में परिवार से बाहर का कोई व्यक्ति रहे, तो मुझे कुछ तसल्ली रहेगी।\n\nमेरे पति ने 1938 में जो चंद्र-ऑर्किड घर भेजा था, वह शुक्रवार की रात खिलेगा — इस देश में पहली बार। शुक्रवार को आइए, वह आपको भी देखने को मिलेगा।\n\nभवदीया, हेस्टर पेनहैलो’\n\nहरी स्याही में लिखी हुई। यह शुक्रवार दोपहर आपके दफ़्तर पहुँची।",
 "evidence:evidence.hester_letter.name": "लेडी पेनहैलो की चिट्ठी",
 "evidence:evidence.hester_letter.summary": "मंगलवार को डाक में डाली गई: ‘मेरे परिवार के एक सदस्य ने कुछ आपराधिक किया है’।",
 "evidence:evidence.iron_staging.detail": "बेंच का ढलवाँ लोहे का किनारा, जहाँ डॉ. ट्रेसिडर के मुताबिक़ गिरते वक़्त उसका सिर टकराया था। लेंस से इसे बारीकी से जाँचने पर:\n\nन ख़ून, न बाल, पुराने हरे रंग पर एक खरोंच तक नहीं। और इसका किनारा एक तीखा समकोण है — हाफ़-क्राउन के सिक्के के बराबर गोल घाव से इसका कोई मेल नहीं।",
 "evidence:evidence.iron_staging.name": "लोहे की बेंच",
 "evidence:evidence.iron_staging.summary": "जहाँ कथित तौर पर उसका सिर टकराया था: उस पर एक निशान तक नहीं।",
 "evidence:evidence.jory_pipe.detail": "चारदीवारी वाले बग़ीचे के दरवाज़े के पास, देहरी पर: पाइप की राख और अधजले तंबाकू की एक छोटी-सी ढेरी, और आधा दर्जन जली हुई तीलियाँ। तंबाकू कॉर्नवॉल का बटा हुआ तंबाकू है, काला और कड़क। जोरी ट्रेवेना इसके सिवा कुछ नहीं पीता।\n\nइस देहरी से शीशाघर का पूरा पूरबी छोर दिखता है — और उसके नीचे बॉयलर-घर का दरवाज़ा भी।",
 "evidence:evidence.jory_pipe.name": "चारदीवारी वाले बग़ीचे के दरवाज़े पर पाइप की राख",
 "evidence:evidence.jory_pipe.summary": "जहाँ से चारदीवारी वाला बग़ीचा शीशाघर की ओर देखता है, वहाँ पाइप की ताज़ा राख और जली तीलियाँ।",
 "evidence:evidence.kittow_letter.detail": "उसके सोख़्ते में तह करके रखी, किसी वकील की सधी लिखावट में:\n\n‘मेरी प्रिय हेस्टर — तो शनिवार ही सही: जब वसीयत पर दस्तख़त हो जाएँ और तुम्हारा ऑर्किड सुरक्षित हो जाए, तब हम उन्हें बता दें। चालीस बरस मैंने इंतज़ार किया है; फूल की रात बीत जाने तक और रुक सकता हूँ। सितंबर में, सेंट म्यूअन के गिरजे में, जैसी तुम्हारी इच्छा थी। — तुम्हारा एडविन’",
 "evidence:evidence.kittow_letter.name": "एडविन किटो की चिट्ठी",
 "evidence:evidence.kittow_letter.summary": "‘…जब वसीयत पर दस्तख़त हो जाएँ और तुम्हारा ऑर्किड सुरक्षित हो जाए, तब हम उन्हें बता दें।’",
 "evidence:evidence.lindqvist_cable.detail": "डॉ. एलरी के झोले में छोटा तह किया हुआ तार का फ़ॉर्म, गुरुवार को सेंट ऑस्टल में मिला:\n\n‘एलरी पेनहैलो हाउस सेंट ऑस्टल — प्रस्ताव क़ायम बीस हज़ार डॉलर पहली पौध पर एकाधिकार स्टॉप फली हर क़ीमत पर हासिल करें स्टॉप — LINDQVIST ORCHIDS मियामी’",
 "evidence:evidence.lindqvist_cable.name": "मियामी से आया तार",
 "evidence:evidence.lindqvist_cable.summary": "डॉ. एलरी के नाम: ‘बीस हज़ार डॉलर … फली हर क़ीमत पर हासिल करें’।",
 "evidence:evidence.moon_orchid.detail": "एडमंड का ऑर्किड, उसके हाथ की लिखी पर्ची के साथ: ‘No. 7 — Shan Hills, 1938’। बड़ा सफ़ेद फूल बंद होकर ढीला लटक गया है। उसके आसपास की हवा में अब भी लौंग और लिली की हल्की महक है।\n\nडंठल पर बग़ीचे वाली हरी सुतली का एक फंदा हाल ही में बाँधा गया है — माली का इशारा कि फूल का परागण हो चुका है। लेडी पेनहैलो की अपनी डोरी रेशम की है, और सफ़ेद।",
 "evidence:evidence.moon_orchid.name": "चंद्र-ऑर्किड",
 "evidence:evidence.moon_orchid.summary": "अब बंद और लटका हुआ। हरी सुतली का फंदा बताता है कि इसका परागण हो चुका है।",
 "evidence:evidence.pascoe_statement.detail": "बावर्चिन और गृह-प्रबंधिका मिसेज़ मॉर्वेना पास्को का बयान, सार्जें. पॉलग्लेज़ द्वारा दर्ज:\n\n‘सवा दस बजे से मैं पुस्तकालय से लगे बटलर के भंडार में सुबह के लिए चाँदी के बर्तन चमका रही थी। मिस्टर जूलियन और मिस्टर किटो पूरे वक़्त वसीयत को लेकर ज़ोर-शोर से भिड़े रहे — दीवार के पार से मुझे एक-एक शब्द सुनाई दे रहा था। ग्यारह बजने में बीस मिनट पर मैं उनके लिए व्हिस्की की ट्रे लेकर गई, और ग्यारह बजकर दस मिनट पर, जब मैं नीचे अपनी रसोई में गई, तब भी वे उसी में लगे थे।\n\nग्यारह बजने में दस मिनट पर मैं उस पुराने बर्तन-घर तक गई, जिसे डॉ. एलरी ने अपना डार्करूम बना लिया है, यह पूछने कि उन्हें कोको चाहिए क्या। उन्होंने दरवाज़े के पार से पुकारकर कहा कि डेवलपर में काग़ज़ पड़ा है और मैं किसी भी हाल में दरवाज़ा न खोलूँ।\n\nउसके बाद घंटी सुनाई देने तक मैं अपनी रसोई में रही।’",
 "evidence:evidence.pascoe_statement.name": "मिसेज़ पास्को का बयान",
 "evidence:evidence.pascoe_statement.summary": "बावर्चिन और गृह-प्रबंधिका: पुस्तकालय में 10:15 से 11:10 तक झगड़ा, और 10:50 पर डॉ. एलरी अपने डार्करूम में।",
 "evidence:evidence.photo_bell.detail": "घंटी बजने पर चबूतरे से लिया गया डॉ. एलरी का इकलौता लंबा एक्सपोज़र, चालीस गज़ दूर से, भाप जमे शीशे के पार। दानेदार, पर आकार साफ़ हैं: ऑर्किड की बेंच, उसके ऊपर लैंप का लोहे का ब्रैकेट, और खुले फूल का सफ़ेद सितारा।\n\nउसके पास काला नक़ाब और शॉल ओढ़े एक आकृति खड़ी है — एक हाथ में लैंप ऊँचा उठाए, दूसरा हाथ उठा हुआ। वह तनकर खड़ी है, इतनी लंबी कि उसका सिर लैंप के ब्रैकेट के बराबर है। कोई छड़ी नहीं। और काली शॉल के नीचे, अँधेरे में, एक दामन हल्के रंग का झलकता है।",
 "evidence:evidence.photo_bell.name": "तस्वीर, रात 11:32",
 "evidence:evidence.photo_bell.summary": "घंटी पर ‘विधवा’: लंबी, तनी हुई, बिना छड़ी — और काले के नीचे हल्के रंग का दामन।",
 "evidence:evidence.photo_bud.detail": "9:25 पर शीशाघर के भीतर खींची गई डॉ. एलरी की तस्वीर, हेस्टर के ख़ुद को भीतर बंद करने से ठीक पहले की।\n\nकाले कपड़ों में एक छोटी, झुकी हुई औरत ऑर्किड की बेंच के पास अपनी आबनूस की छड़ी पर टिकी है। उसके नक़ाब का ऊपरी सिरा लैंप के लोहे के ब्रैकेट के नीचे वाले ताक़ तक मुश्किल से पहुँचता है। वह नक़ाब से दामन तक काली है।",
 "evidence:evidence.photo_bud.name": "तस्वीर, रात 9:25",
 "evidence:evidence.photo_bud.summary": "कली वाले ऑर्किड के साथ लेडी पेनहैलो: छोटी, छड़ी पर झुकी, नक़ाब से दामन तक काली।",
 "evidence:evidence.sergeant_notes.detail": "शुक्रवार, 26 जुलाई। मौसम साफ़, गरम, हवा नहीं।\n\nरात 8:00 — रात्रिभोज। उपस्थित: मृतका, मिस्टर जे. पेनहैलो (भतीजा), मिसेज़ सी. पेनहैलो, डॉ. एम. एलरी, मिस्टर ई. किटो (वकील), मिस ए. क्विल (संगिनी)। नई वसीयत को लेकर मृतका और भतीजे में कहा-सुनी।\nरात 9:30 — मृतका ऑर्किड का फूल खिलते देखने के लिए शीशाघर में ख़ुद को बंद करती है। कहती है कि फूल खुलने पर एक बार घंटी बजाएगी, और दोबारा तब, जब घर वाले देखने नीचे आ सकें।\nरात 10:15 — मिस क्विल उसके लिए कोको ले जाती है।\nरात 10:30 — मिसेज़ सी. पेनहैलो सिरदर्द के कारण सोने चली जाती है।\nरात 11:32 — शीशाघर की घंटी। मिस्टर जे. पेनहैलो, मिस्टर किटो, मिस क्विल और डॉ. एलरी ने चबूतरे से मृतका को फूल के पास, हाथ में लैंप लिए, देखा। लैंप लगभग 11:35 पर नीचे किया गया।\nरात 11:45 — मिसेज़ सी. पेनहैलो नीचे बैठक में आती है।\nरात 12:15 — भतीजा लॉन पर शीशाघर की ओर जाता दिखा (मिस क्विल, अपनी खिड़की से)।\nसुबह 5:45 — माली जे. ट्रेवेना को ऑर्किड की बेंच के पास, सीढ़ी के तले मृतका मिली। शीशाघर का दरवाज़ा भीतर से बंद, चाबी ताले में। बॉयलर-घर के दरवाज़े की चिटकनी खुली।\n\nडॉ. ट्रेसिडर: सीढ़ी से गिरी और सिर लोहे की बेंच से टकराया। घाव बाएँ कान के ऊपर, गोल, हाफ़-क्राउन के सिक्के के बराबर। मृत्यु रात 11:30 से 2:00 के बीच।\n\nभतीजे के पास मक़सद था, वह आधी रात के बाद अकेला बाहर था, और बॉयलर-घर खुला था। — सार्जें. डब्ल्यू. पॉलग्लेज़",
 "evidence:evidence.sergeant_notes.name": "सार्जेंट पॉलग्लेज़ के नोट्स",
 "evidence:evidence.sergeant_notes.summary": "पुलिस की नज़र से वह रात — और उसका संदिग्ध।",
 "evidence:evidence.slipper_prints.detail": "बॉयलर-घर की सीढ़ियों पर कोक की मोटी धूल जमी है। जोरी के कीलदार जूतों ने उसका ज़्यादातर हिस्सा रौंद डाला है। पर पायदानों के किनारों पर बिल्कुल दूसरी तरह के निशान हैं: छोटे, चिकने और बिना एड़ी के, किसी महिला की चप्पल जैसे, नीचे की ओर जाते हुए।\n\nचप्पल पहनकर कोई बॉयलर तक नीचे नहीं जाता।",
 "evidence:evidence.slipper_prints.name": "कोक की धूल में निशान",
 "evidence:evidence.slipper_prints.summary": "बिना एड़ी की एक छोटी चप्पल बॉयलर-घर की सीढ़ियों से नीचे उतरी।",
 "evidence:evidence.stepladder.detail": "खड़िया के घेरे के पास करवट के बल पड़ी लकड़ी की एक सीढ़ी। आम तौर पर यह दरवाज़े के पास एक खूँटी पर टँगी रहती है।\n\nइसके डंडे पूरी गर्मी की धूल से धूसर हैं, और धूल बिल्कुल अनछुई है: न एक पैर का निशान, न एक धब्बा। कल रात इस सीढ़ी पर कोई नहीं चढ़ा।",
 "evidence:evidence.stepladder.name": "सीढ़ी",
 "evidence:evidence.stepladder.summary": "शव के पास पड़ी है — पर उस पर कोई नहीं चढ़ा।",
 "evidence:evidence.stokehole_door.detail": "शीशाघर के पूरबी छोर पर सीढ़ियाँ नीचे बॉयलर-घर तक जाती हैं, जहाँ बॉयलर है। वहाँ से बलूत का एक मज़बूत दरवाज़ा चारदीवारी वाले बग़ीचे की दीवार के तले बाहर खुलता है।\n\nइसकी इकलौती चिटकनी भीतर की तरफ़ है। बग़ीचे की ओर से न इसे बंद किया जा सकता है, न खोला। पौ फटने पर इसकी चिटकनी खुली मिली।",
 "evidence:evidence.stokehole_door.name": "बॉयलर-घर का दरवाज़ा",
 "evidence:evidence.stokehole_door.summary": "शीशाघर के नीचे से बाहर का रास्ता: चिटकनी सिर्फ़ भीतर की तरफ़ — और वह खुली मिली।",
 "evidence:evidence.will_draft.detail": "मिस्टर किटो के ब्रीफ़केस से, ‘शनिवार, 27 जुलाई 1963, सुबह 10:00’ पर दस्तख़त के लिए तैयार; यह 1950 की वसीयत (जिसके तहत पेनहैलो जूलियन को मिलता है) को रद्द करती है:\n\n— पेनहैलो हाउस, उसके बग़ीचे और शीशाघर, National Trust को, उनके रख-रखाव के लिए £40,000 के साथ।\n— जूलियन पेनहैलो को: £1,000, और सर एडमंड की किताबें।\n— एग्नेस क्विल को: उम्र भर के लिए लॉज, और साल के £300।\n— जोरी ट्रेवेना को: उसका कॉटेज, और £500।\n— एडविन किटो को: सर एडमंड की सोने की घड़ी।\n— चंद्र-ऑर्किड, और उसके सारे बीज, Kew को।",
 "evidence:evidence.will_draft.name": "नई वसीयत का मसौदा",
 "evidence:evidence.will_draft.summary": "आज सुबह दस बजे दस्तख़त होने थे: पेनहैलो National Trust को; जूलियन को £1,000।",
 "suspects:suspects.agnes.bio": "बर्मा से तार आने के बाद से, बीस बरस से लेडी पेनहैलो की संगिनी। घर का कामकाज वही चलाती है, शाम को पढ़कर सुनाती है, और हेस्टर की हर एक आदत जानती है। कल रात मना करने के बावजूद वह उसके लिए कोको का फ़्लास्क ले गई थी।",
 "suspects:suspects.agnes.dismissal": "माफ़ कीजिए। मैं समझी नहीं कि आपका मतलब क्या है।",
 "suspects:suspects.agnes.name": "एग्नेस क्विल",
 "suspects:suspects.agnes.rebuttal": "घंटी बजी, तब मैं बाकी लोगों के साथ चबूतरे पर खड़ी थी। बीस बरस मैंने उनकी देखभाल की है। नई वसीयत में वे मुझे लॉज दे रही थीं — मेरे पास तो हर वजह थी कि वे उस पर दस्तख़त करें।",
 "suspects:suspects.agnes.role": "संगिनी",
 "suspects:suspects.celia.bio": "आठ बरस से जूलियन की पत्नी। शादी से पहले वह रेपर्टरी थिएटर में अभिनेत्री थी — ब्रिस्टल, बाथ, एक सीज़न स्ट्रैटफ़र्ड में। शालीन, फुर्तीली और चौकन्नी। कल रात वह सिरदर्द की वजह से जल्दी ऊपर चली गई थी।",
 "suspects:suspects.celia.dismissal": "डार्लिंग, इससे बेहतर कुछ लाना होगा आपको।",
 "suspects:suspects.celia.name": "सीलिया पेनहैलो",
 "suspects:suspects.celia.rebuttal": "मैं? साढ़े ग्यारह बजे चार लोगों ने हेस्टर को ज़िंदा देखा, और बाकी पूरी रात मैं उन्हीं के साथ थी। आपने जासूसी कहानियाँ कुछ ज़्यादा ही पढ़ ली हैं।",
 "suspects:suspects.celia.role": "भतीजे की पत्नी",
 "suspects:suspects.jory.bio": "जिस साल सर एडमंड ने शीशाघर बनवाया, उसी साल वह चौदह बरस का माली-लड़का बनकर पेनहैलो आया था, और तीस बरस से यहाँ का मुख्य माली है। शाम ढले और पौ फटे वह उसके बॉयलर में आग झोंकता है। आज सुबह पौने छह बजे मालकिन उसी को मिली थीं।",
 "suspects:suspects.jory.dismissal": "गुस्ताख़ी माफ़, पर इससे कुछ साबित ना होता।",
 "suspects:suspects.jory.name": "जोरी ट्रेवेना",
 "suspects:suspects.jory.rebuttal": "मैं? मैं तो उनके लिए जान दे देता, और उस ऑर्किड के लिए भी। उस बॉयलर-घर से जो भी निकला, उसे ख़राब घुटने वाले एक बूढ़े से कहीं ज़्यादा जल्दी थी।",
 "suspects:suspects.jory.role": "मुख्य माली",
 "suspects:suspects.julian.bio": "सर एडमंड का भतीजा और, मौजूदा वसीयत के तहत, पेनहैलो का वारिस। प्लिमथ में मोटरगाड़ियाँ बेचता है, और जायदाद के लिए एक ख़रीदार भी तैयार रखे है: हॉलिडे कैंप चलाने वाली एक कंपनी। रात के खाने पर अपनी चाची से उसकी कहा-सुनी हुई।",
 "suspects:suspects.julian.dismissal": "इसका कोई मतलब भी है? मैं गाड़ियाँ बेचता हूँ, यार। खोटा माल देखते ही पहचान लेता हूँ।",
 "suspects:suspects.julian.name": "जूलियन पेनहैलो",
 "suspects:suspects.julian.rebuttal": "सवा दस बजे से मैं पुस्तकालय में किटो के साथ था — उससे पूछिए, मिसेज़ पास्को से पूछिए। मैंने ऐसे काम किए हैं जिन पर मुझे शर्म है। पर हेस्टर चाची को मैंने उँगली तक नहीं लगाई।",
 "suspects:suspects.julian.role": "भतीजा",
 "suspects:suspects.kittow.bio": "ट्रूरो की Kittow & Pengelly का वरिष्ठ साझेदार, और चालीस बरस से पेनहैलो परिवार का वकील। विधुर, शिष्ट और इत्मीनान से चलने वाला। वह यहाँ इसलिए ठहरा था कि आज सुबह दस बजे नई वसीयत पर दस्तख़त हो सकें।",
 "suspects:suspects.kittow.dismissal": "चालीस बरस मैंने दलीलें सुनी हैं। यह दलील किसी मजिस्ट्रेट को एक पल भी न रोक पाती।",
 "suspects:suspects.kittow.name": "एडविन किटो",
 "suspects:suspects.kittow.rebuttal": "आपके हिसाब से जब उनकी मौत हुई, तब मैं पुस्तकालय में जूलियन से बहस कर रहा था, और मिसेज़ पास्को ने हम दोनों को देखा था। सितंबर में मैं उनसे विवाह करने वाला था। कहीं और देखिए — और ध्यान से देखिए।",
 "suspects:suspects.kittow.role": "वकील",
 "suspects:suspects.marian.bio": "ऑर्किड की विशेषज्ञ, जो — उसके अपने कहे मुताबिक़ — Royal Botanic Gardens, Kew की ओर से फूल के खिलने की तस्वीरें लेने और उसे दर्ज करने आई है। पाँच बरस से लेडी पेनहैलो से उसकी ख़त-ओ-किताबत रही है, और वह उसकी शागिर्द भी रही है।",
 "suspects:suspects.marian.dismissal": "यह सबूत नहीं है। यह एक क़िस्सा है।",
 "suspects:suspects.marian.name": "डॉ. मैरियन एलरी",
 "suspects:suspects.marian.rebuttal": "जब उन्होंने वह घंटी बजाई, मैं चबूतरे पर तस्वीर खींच रही थी — वह आपने देखी है। और मैं उस फूल को कभी, कभी भी, अनछुआ बंद न होने देती। जिसने भी यह किया, उसे उस फूल की ज़रा भी परवाह नहीं थी।",
 "suspects:suspects.marian.role": "वनस्पति-विज्ञानी"
}
